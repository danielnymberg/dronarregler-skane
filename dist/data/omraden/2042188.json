rl":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011678","dokument_sha256":"fb4a27596c4b8c51f47cb320b1c41ac4b9156133598800ef8413de8825a205a6","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Naturvärdet är högt med en artrik flora vid Gunnesboängen och stora mängder rastande änder\noch vadarfåglar i våtmarker och på strandängar. Området har varit under stark påverkan av\nmänskliga aktiviteter under lång tid. De första jordbrukarna röjde mossen och använde den för\nslåtter, bete och torvtäkt medan den under de senaste hundra åren genomgått dikningar och\nuppodling. Västkustbanan går genom mossens östra del.","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att:","inledning_offset":243,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1120,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1011678","dokument_namn":"Beslut komplett kompr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011678","dokument_sha256":"fb4a27596c4b8c51f47cb320b1c41ac4b9156133598800ef8413de8825a205a6","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Beträdandeförbud ska gälla under tiden 1 mars tom. 30 november inom skötselområde 5 och\n17 för att gynna häckande och rastande and- och vadarfåglar (bilaga 6).","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":27,"teckenoffset_pa_sidan":695,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1011678","dokument_namn":"Beslut komplett kompr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011678","dokument_sha256":"fb4a27596c4b8c51f47cb320b1c41ac4b9156133598800ef8413de8825a205a6","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"kommentarer: Reservatsbildningen innebär inte att området översvämmas mer frekvent. Frågan om\natt bygga en vall eller dylikt är snarare en fråga för VA Syd. Eftersom området översvämmas\nregelbundet så krävs det mycket stora resurser för att få en bra lösning vid upp- och nergången under\nbron. För närvarande finns inte sådana resurser. Förvaltningen planerar att bygga en utkiksplattform\ni området. Beträdnandsförbudet begränsas att gälla under våtmarksfåglarnas känsliga period.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":50,"teckenoffset_pa_sidan":1267,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1011678","dokument_namn":"Beslut komplett kompr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011678","dokument_sha256":"fb4a27596c4b8c51f47cb320b1c41ac4b9156133598800ef8413de8825a205a6","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"f13eb4aadf22b028cd51d2cb1125d37825b5dd57f35b26cfb40e43b9a52afb6c","hamtningsdatum":"2026-07-26","licens":"CC0"},"hamtningsdatum":"2026-07-26","geometri":{"type":"MultiPolygon","coordinates":[[[[13.14653635,55.7324506],[13.15009137,55.73297031],[13.15041768,55.73231441],[13.15041855,55.7323138],[13.15055501,55.73227366],[13.1510029,55.73127442],[13.15132219,55.73055862],[13.15186881,55.7293695],[13.1518696,55.7293689],[13.15187091,55.72936878],[13.1523721,55.7294355],[13.15365758,55.72967522],[13.15482061,55.73006853],[13.15482088,55.73006933],[13.15387248,55.73234335],[13.15757515,55.73283411],[13.15868292,55.73311902],[13.15868353,55.73311946],[13.15868363,55.73312],[13.15808115,55.73506058],[13.15981799,55.735139