gionen främmande arter, sjukdomar eller angrepp på växt- och djurliv bli ett pro-\n   blem inom naturreservatet ska detta hanteras på lämpligt sätt utifrån rådande kunskaps-\n   läge och erfarenheter. Vid bekämpning ska största möjliga hänsyn tas till områdets be-\n   varandevärden. Åtgärderna får inte hota naturreservatets bevarandesyften.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":41,"teckenoffset_pa_sidan":1172,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1024302","dokument_namn":"Mörrumsån Ebbamåla Beslut_20210511_m bilaga 1_3.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024302","dokument_sha256":"0021054e408b52dc4ed9e2819e5e44bee346357436112f58d9f06c15a8500e7b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.68010868,56.37131861],[14.68037315,56.37055892],[14.68057921,56.37053808],[14.68058014,56.37053782],[14.68058064,56.37053731],[14.68058037,56.37053656],[14.68048196,56.37045536],[14.68046246,56.37040734],[14.68044634,56.37031086],[14.6804445,56.37024437],[14.68043958,56.37015819],[14.68047597,56.3700698],[14.68051266,56.36997268],[14.68058673,56.36983575],[14.68062031,56.36977119],[14.68069165,56.3696311],[14.68072552,56.36953001],[14.68073286,56.36950573],[14.68074188,56.36946589],[14.68075242,56.36941599],[14.68076574,56.36933564],[14.68077916,56.36923996],[14.68079207,56.36913842],[14.68079818,56.36908459],[14.68079746,56.36904037],[14.6807961,56.36898357],[14.68078682,56.368901