est/dokument/1030900","dokument_sha256":"63e236558060d4bb138c353fb593f3eb3a9d5a8c1f78f205d28389bf557a3f4b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I reservatet har många sällsynta och rödlistade arter påträffats. Ett stort antal\nrödlistade skalbaggar knutna till gamla träd, död ved och vedsvampar finns i\nområdet, till exempel den starkt hotade svartoxen. Aspfjädermossa och lunglav är\nvanlig på askar i området, särskilt i den utdikande sumpskogen. Ett flertal rödlistade\nvedsvampar knutna till gran och asp, liksom flera sällsynta lavar knutna till gamla\nträd, förekommer också i området. Fågelfaunan i området är rik med förekomst av\nflertalet rödlistade arter och åtta arter som är utpekade i bilaga 1 till EU:s direktiv\nom bevarande av vilda fåglar.","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":851,"inledning_sidnummer":12,"punkt":null,"sidnummer":13,"teckenoffset_pa_sidan":1877,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1030900","dokument_namn":"Beslut om utvidgning Kodödkärret 2025-11-26.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1030900","dokument_sha256":"63e236558060d4bb138c353fb593f3eb3a9d5a8c1f78f205d28389bf557a3f4b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskrifterna under C ovan, enligt 7 kap. 30 § miljöbalken om rätten att färdas, vistas\noch om ordningen i övrigt inom naturreservatet, gäller omedelbart, även om de\növerklagas.","inledning":"Jägareförbundet stödjer inte jaktförbud efter fågel i reservatet. Länsstyrelsen anser att","inledning_offset":404,"inledning_sidnummer":17,"punkt":null,"sidnummer":17,"teckenoffset_pa_sidan":1531,"klassificering":"annat-läs-beslutet","konfidens":"medel","dokument_id":"nvdok-1030900","dokument_namn":"Beslut om utvidgning Kodödkärret 2025-11-26.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1030900","dokument_sha256":"63e236558060d4bb138c353fb593f3eb3a9d5a8c1f78f205d28389bf557a3f4b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":" Körning i terräng med motordrivet fordon enligt terrängkörningslagen (1975:1313).\n Fridlysning av vilda fåglar och däggdjur samt deras ägg, ungar och bon enligt\n  jaktlagen (1987:259). Vissa andra växt- och djurarter är fridlysta enligt 8 kap.\n  miljöbalken och artskyddsförordningen (2007:845).\n Vid rensning eller underhåll av diken gäller de allmänna hänsynsreglerna i 2 kap\n  miljöbalken (1998:808).\n Fornlämningar är skyddade enligt 2 kap. kulturmiljölagen (1988:950).","inledning":"Jägareförbundet stödjer inte jaktförbud efter fågel i reservatet. Länsstyrelsen anser att","inledning_offset":404,"inledning_sidnummer":17,"punkt":null,"sidnummer":18,"teckenoffset_pa_sidan":1333,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1030900","dokument_namn":"Beslut om utvidgning Kodödkärret 2025-11-26.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1030900","dokument_sha256":"63e236558060d4bb138c353fb593f3eb3a9d5a8c1f78f205d28389bf557a3f4b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.31706864,60.06583939],[18.31706754,60.06583972],[18.31706708,60.06584028],[18.31706393,60.06586054],[18.31709065,60.06590544],[18.3171309,60.06594499],[18.3171522