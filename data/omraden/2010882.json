ödra\ndelen. Det är främst fråga om granved och i stort sett alla\nnedbrytningsstadier finns representerade.\nOmrådets norra del är belägen på relativt djupa och rika jordar. Detta\navspeglas bland annat i ett örtrikt fältskikt med arter som skogsbingel,\nskärmstarr, stinksyska, ramslök, trolldruva och den rödlistade strävlostan\nBromopsis benekeni. Här finns också en intressant marksvampflora med\nflera rödlistade arter knutna till granskog på rika jordar.","inledning":"Det är vidare förbjudet att utan Länsstyrelsens tillstånd:","inledning_offset":1093,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":183,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1007294","dokument_namn":"Beslut_rabacks_sjoskog.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007294","dokument_sha256":"519f1970a7c761c85527c1f61539762f7fef3175cd9e9fdcf10d8224f631ea5e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.34549423,58.60562889],[13.34627103,58.60549178],[13.3466359,58.60528977],[13.34753297,58.60509903],[13.34753402,58.60509847],[13.34753395,58.60509769],[13.34577278,58.60391004],[13.34527774,58.60323957],[13.34479368,58.60274626],[13.34410492,58.60201236],[13.34365457,58.60142255],[13.34263074,58.60064121],[13.34248813,58.60052467],[13.3416202,58.59979175],[13.34088207,58.59869839],[13.34040427,58.5977631],[13.34027157,58.59742734],[13.340082,58.59686557],[13.3398929,58.59634599],[13.33989212,58.59634562],[13.33989109,58.59634553],[13.339