jeån Skönhult-webben.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011613","dokument_sha256":"1adb349bc8a608b7eabdf3792278451ff71e0399f62af4d4aff64900075d51b4","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsen vill upplysa om att föreskrifterna om begränsning av rätten att\nfärdas och vistas i reservatet gäller omedelbart och även om beslutet överklagas\n(7 kap. 30 § MB).","inledning":"Dessutom är det förbjudet att utan Länsstyrelsens tillstånd:","inledning_offset":357,"inledning_sidnummer":8,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":717,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["färdas","vistas"],"handlingar":["marken"],"dokument_id":"nvdok-1011613","dokument_namn":"Beslut om Smedjeån Skönhult-webben.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011613","dokument_sha256":"1adb349bc8a608b7eabdf3792278451ff71e0399f62af4d4aff64900075d51b4","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"7 kap. 13-18h §§ miljöbalken, strandskyddsbestämmelser\nStrandskyddsområde berör de delar av reservatet som ligger inom 100 meter från\nvattendrag, dvs en stor del av reservatet. Strandskyddsbestämmelsernas syfte är att\ntrygga förutsättningarna för allmänhetens friluftsliv samt att bevara goda\nlivsvillkor på land och i vatten för djur- och växtlivet. Åtgärder som kan skada\neller motverka syftet med strandskyddet är förbjudna.","inledning":"Dessutom är det förbjudet att utan Länsstyrelsens tillstånd:","inledning_offset":357,"inledning_sidnummer":8,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":174,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["stor","djur","förbjudna"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1011613","dokument_namn":"Beslut om Smedjeån Skönhult-webben.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011613","dokument_sha256":"1adb349bc8a608b7eabdf3792278451ff71e0399f62af4d4aff64900075d51b4","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4 - 9 §§ artskyddsförordningen (2007:845), fridlysta arter\nMånga arter är fridlysta. Det innebär att djuren och växterna inte får skadas eller\nstöras, och i många fall även att fortplantningsområden och viloplatser är\nskyddade. Alla fåglar, groddjur, kräldjur, fladdermöss samt orkidéer är fridlysta,\nliksom skirmossa och ett urval av andra organismer.","inledning":"Dessutom är det förbjudet att utan Länsstyrelsens tillstånd:","inledning_offset":357,"inledning_sidnummer":8,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":603,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["störas","djuren","fåglar"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1011613","dokument_namn":"Beslut om Smedjeån Skönhult-webben.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011613","dokument_sha256":"1adb349bc8a608b7eabdf3792278451ff71e0399f62af4d4aff64900075d51b4","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.21756461,56.43796833],[13.21756345,56.437968],[13.21756248,56.43796811],[13.21674783,56.43819883],[13.21674723,56.4381991],[13.2163839,56.43845609],[13.2162099,56.43864367],[13.21593542,56.43880872],[13.2156351,56.43895312],[13.2155046,56.439092