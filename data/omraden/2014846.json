t att:","inledning_offset":1905,"inledning_sidnummer":3,"punkt":"3.","sidnummer":3,"teckenoffset_pa_sidan":2196,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1008566","dokument_namn":"Beslut_Gardevare_091208.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008566","dokument_sha256":"ef9af35925e207c000ba848c87e5ea300ff1fc1ecc5ad3573668e4950bae68fc","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"6. Framföra motordrivna fordon utanför befintlig väg.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":1905,"inledning_sidnummer":3,"punkt":"6.","sidnummer":3,"teckenoffset_pa_sidan":2537,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1008566","dokument_namn":"Beslut_Gardevare_091208.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008566","dokument_sha256":"ef9af35925e207c000ba848c87e5ea300ff1fc1ecc5ad3573668e4950bae68fc","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Naturreservatet är ett sammanhängande naturskogsområde som till delar består av\nurskogsartad höjdlägesgranskog och lövrik grannaturskog på nordsluttningen. Inslaget\nav sälgar med lunglav är bitvis stort och dofttickor och skrovellav växer på många av\nträden. Det finns även grupper med asp och några mycket gamla tallöverståndare.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":1905,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1214,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1008566","dokument_namn":"Beslut_Gardevare_091208.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008566","dokument_sha256":"ef9af35925e207