nledning_sidnummer":null,"punkt":"C.","sidnummer":1,"teckenoffset_pa_sidan":757,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1027164","dokument_namn":"Gammelstilla-Bredmossen nytt beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027164","dokument_sha256":"6ce0e731dc14bf8b9b9363cbeb5b5dcbfe79615ae7faaeed1f74abf31ff5b44d","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Bakgrund och ärendets handläggning\nNaturreservatet Gammelstilla-Bredmossens domänreservat bildades 1996 efter\natt ha varit avsatt som domänreservat sedan 1983. Ändamålet med reservatet är\natt bevara ett myrkomplex av stort värde för naturvården. Våtmarkskomplexet\när mycket värdefullt, såväl för de olika våtmarkstyperna som för deras\nbetydelse som fågelbiotoper.\nEn stig leder fram till en skogbeklädd ”udde” mot våtmarken där folk\nåterkommande har byggt egna eldstäder och bänkar, trots att det är förbjudet att\nelda i naturreservatet. Dessa byggen har tagits bort av länsstyrelsen då det\nenligt beslut och skötselplan inte ska finnas några sådana anläggningar i\nreservatet.","inledning":"Utöver vad som gäller enligt andra författningar är det förbjudet att","inledning_offset":931,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":329,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1027164","dokument_namn":"Gammelstilla-Bredmossen nytt beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027164","dokument_sha256":"6ce0e731dc14bf8b9b9363cbeb5b5dcbfe79615ae7faaeed1f74abf31ff5b44d","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"BESLUT                                             3 (3)\n                                                  2022-05-02                          Fel! Hittar inte\n\n\n\n\nMotivering\nÄndringen av föreskriften bedöms inte vara i konflikt med naturreservatets\nsyfte att bevara ett myrkomplex av stort värde för naturvården och fågellivet.\nDetta då ändringen görs för att minska slitaget på naturen inom reservatet och\nmöjliggöra för besökare att uppleva naturen. Länsstyrelsen anser genom detta\natt ändringen är motiverad.\nLänsstyrelsen bedömer att ändringarna i detta beslut inte påverkar Natura 2000-\nområdet på sådant sätt att tillstånd enligt 7 kap. 28 a § miljöbalken krävs.","inledning":"återkommande har byggt egna eldstäder och bänkar, trots att det är förbjudet att","inledning_offset":766,"inledning_sidnummer":2,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":50,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1027164","dokument_namn":"Gammelstilla-Bredmossen nytt beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027164","dokument_sha256":"6ce0e731dc14bf8b9b9363cbeb5b5dcbfe79615ae7faaeed1f74abf31ff5b44d","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"3. medvetet störa djurlivet, skada eller bortföra hotade eller sällsynta växter och\ndjur","inledning":"Utöver vad som eljest gäller är det förbjudet att","inledning_offset":514,"inledning_sidnummer":3,"punkt":"3.","sidnummer":3,"teckenoffset_pa_sidan":712,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1017510","dokument_namn":"Gammelstilla-Bredmossens NR Beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1017510","dokument_sha256":"605d02178112b02a4946207c2a3488cdfbbd4e9d79b43697fb197d7d32161e60","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4. framföra motordrivet fordon","inledning":"Utöver vad som eljest gäller är det förbjudet att","inledning_offset":514,"inledning_sidnummer":3,"