{"nvrid":"2057467","slug":"andtraskets-vattenskyddsomrade","namn":"Andträskets vattenskyddsområde","skyddstyp":"Vattenskyddsområde","lager":"vattenskyddsomrade","karnlager":false,"kommun":"Luleå","lan":"Norrbottens Län","beslutsstatus":"Gällande","beslutsmyndighet":"Kommun","forvaltare":null,"tillsynsmyndighet":"Kommun","urspr_beslutsdatum":"2017-02-24","senaste_gallandedatum":"2017-02-24","area_ha":2554.48,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2057467","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Skyddsföreksrift.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046153","dokument_id":"nvdok-1046153","sha256":"ac754c1a6e407186469d18b05ea8a266e9edaa836ff58b874b66bbe44243993e","sidor":19,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"§2 HANTERING AV PETROLEUMPRODUKTER OCH ANDRA\nBRANDFARLIGA VÄTSKOR\nHantering av petroleumprodukter och andra brandfarliga vätskor i större\nvolym än 50 liter (samtidig hantering) är förbjuden.\nTransport av petroleumprodukter och andra brandfarliga vätskor genom\nskyddszonen samt drivmedel i fordon är undantaget förbudet. Hantering\nav petroleumprodukter och andra brandfarliga vätskor som krävs för\nvattentäktens drift är undantaget förbudet, under förutsättning att\nskyddsåtgärder i form av sekundärt skydd finns.\nFörvaringstankar, stationära förbränningsmotorer och liknande stationära\nanordningar innehållande petroleumprodukter eller andra brandfarliga\nvätskor är förbjudna.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§2","sidnummer":9,"teckenoffset_pa_sidan":209,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","förbjuden"],"dokument_id":"nvdok-1046153","dokument_namn":"Skyddsföreksrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046153","dokument_sha256":"ac754c1a6e407186469d18b05ea8a266e9edaa836ff58b874b66bbe44243993e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§10 UPPSTÄLLNING OCH SKÖTSEL AV FORDON OCH MASKINER\nUppställning med varaktighet längre än 8 timmar eller tankning av\nmotordrivna arbetsfordon och arbetsmaskiner är förbjuden om åtgärder\ninte vidtas för att hindra eventuellt läckage av olja eller andra kemikalier\natt tränga ner i underliggande mark eller vatten. Sådana åtgärder är till\nexempel att placera täta dukar med invallningar under uppställda\nmaskiner.\nTvätt av motordrivna fordon är förbjuden, om den inte utförs på plats där\nförbrukat vatten avleds till sluten tank för avlopp.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§10","sidnummer":11,"teckenoffset_pa_sidan":311,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivna","FORDON","fordon","förbjuden"],"dokument_id":"nvdok-1046153","dokument_namn":"Skyddsföreksrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046153","dokument_sha256":"ac754c1a6e407186469d18b05ea8a266e9edaa836ff58b874b66bbe44243993e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§13 BÅTTRAFIK\nLastning, lossning och tankning av båt är förbjuden om inte åtgärder\nvidtas för att minimera risken för att ytvatten ska förorenas genom t.ex.\nspill.\nBåttrafik vid hastigheter över 15 knop är förbjuden. Tävlingar med\nmotordriven båt, undantaget fisketävlingar, är förbjudet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§13","sidnummer":11,"teckenoffset_pa_sidan":1678,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordriven","förbjuden"],"dokument_id":"nvdok-1046153","dokument_namn":"Skyddsföreksrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046153","dokument_sha256":"ac754c1a6e407186469d18b05ea8a266e9edaa836ff58b874b66bbe44243993e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§17 FRILUFTSAKTIVITETER\nTävling med motordrivet fordon på is är förbjudet.\nSkoterkörning vid hastigheter över 30 km/h är förbjuden.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§17","sidnummer":12,"teckenoffset_pa_sidan":739,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbjudet"],"dokument_id":"nvdok-1046153","dokument_namn":"Skyddsföreksrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046153","dokument_sha256":"ac754c1a6e407186469d18b05ea8a266e9edaa836ff58b874b66bbe44243993e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[22.24343881,65.90829922],[22.22630198,65.90801889],[22.22630026,65.90801915],[22.20319081,65.92071065],[22.19693198,65.92341215],[22.19693188,65.92341272],[22.19693258,65.92341322],[22.19813844,65.92387976],[22.21056966,65.9388714],[22.208906,65.94423455],[22.20890625,65.94423512],[22.20890726,65.94423554],[22.24653453,65.95241449],[22.24653647,65.95241455],[22.25870511,65.94937816],[22.2766269,65.93683215],[22.29076041,65.93913734],[22.29799831,65.9519457],[22.29799871,65.95194607],[22.29799989,65.95194642],[22.2980018,65.95194635],[22.31984794,65.94453702],[22.31984869,65.94453657],[22.32750324,