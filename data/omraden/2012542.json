{"nvrid":"2012542","slug":"gota-alv","namn":"Göta älv","skyddstyp":"Vattenskyddsområde","lager":"vattenskyddsomrade","karnlager":false,"kommun":"Ale, Göteborg","lan":"Västra Götalands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":null,"tillsynsmyndighet":"Kommun","urspr_beslutsdatum":"1998-08-18","senaste_gallandedatum":"2004-06-01","area_ha":3041.79,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2012542","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":true,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"SF_Göteborg_Götaälv.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044866","dokument_id":"nvdok-1044866","sha256":"a6928d902d0666fb2ffcccacac954e132cc8b3eca381dceea95180012328453f","sidor":12,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"-Dagvattenbrunnar skall vara utformade på sådant sätt att risken för\nföroreningsutsläpp till dagvatten minimeras. Täck-/skyddslock skall\nfinnas tillgängliga för att det skall vara möjligt att snabbt förhindra att\nspill når dagvattennätet. En skyddszon med minst 2 m radie skall vara\nmarkerad med varaktig färg. Inom denna skyddszon får inte fordon,\nmaterial eller utrustning ställas upp.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":632,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","får inte"],"handlingar":["marken"],"dokument_id":"nvdok-1044866","dokument_namn":"SF_Göteborg_Götaälv.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044866","dokument_sha256":"a6928d902d0666fb2ffcccacac954e132cc8b3eca381dceea95180012328453f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"21 $ Tvätt av fordon, arbetsmaskiner och liknande, får inte ske på sådant\nsätt att Göta älv förorenas av avfettningsmedel, bilschampo eller liknande.\nInom skyddsområdet får fordonstvätt med biologiskt nedbrytbara tvättmedel\nske endast om tvättvattnet infiltreras i mark eller avleds till kommunens\nspillvattennät via av kommunen godkänd rening. Fordonstvätt med avfett-\nningsmedel får endast ske på spolplatta ansluten till av kommunen godkänd\nrening. På hårdgjorda ytor anslutna till dagvattennätet får endast vatten an-\nvändas vid fordonstvätt.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":268,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","får inte"],"handlingar":["marken"],"dokument_id":"nvdok-1044866","dokument_namn":"SF_Göteborg_Götaälv.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044866","dokument_sha256":"a6928d902d0666fb2ffcccacac954e132cc8b3eca381dceea95180012328453f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"30 $ Djurhållning av större omfattning än två djurenheter, skall anmälas till\nden kommunala tillsynsmyndigheten. Anmälan enligt dessa föreskrifter\nkrävs inte om djurhållningen är tillståndsprövad eller anmäld enligt","inledning":"får inte ske på sådant sätt att Göta älv kan förorenas. :","inledning_offset":191,"inledning_sidnummer":6,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":617,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurhållningen","Djurhållning","djurenheter"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1044866","dokument_namn":"SF_Göteborg_Götaälv.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044866","dokument_sha256":"a6928d902d0666fb2ffcccacac954e132cc8b3eca381dceea95180012328453f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},