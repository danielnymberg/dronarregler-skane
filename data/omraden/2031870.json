":["motordrivet","fordon"],"dokument_id":"nvdok-1022479","dokument_namn":"2031870ihopslagna beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1022479","dokument_sha256":"d8a6657f6b9bf3b336614e4ea0bdfea044643686d1cec9c1871b959b61dae5ea","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Föreskrifter enligt 7 kap 30 § miljöbalken om rätten att färdas och vistas inom\nreservatet samt om ordningen i övrigt inom reservatet.\n\nUtöver vad som för övrigt gäller är det förbjudet att:\n   1 fälla eller på amrnt sätt skada levande eller döda stående eller omkullfallna träd\n     och buskar.\n   2 insamla mossor, svampar eller lavar med undantag för plockning av matsvamp.\n   3 framföra motordrivet fordon utanför befintlig väg, annat än i samband med\n     uttransp01t av skjutna älgar, björnar och annat högvilt, varvid risken för skador på\n     mark och vegetation ska minimeras. Förbudet gäller ej snöskoterkörning på\n     snötäckt mark samt motorbåt i Stor- och Lill-Kärmsjön.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"C.","sidnummer":9,"teckenoffset_pa_sidan":0,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbjudet"],"dokument_id":"nvdok-1022479","dokument_namn":"2031870ihopslagna beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1022479","dokument_sha256":"d8a6657f6b9bf3b336614e4ea0bdfea044643686d1cec9c1871b959b61dae5ea","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens"