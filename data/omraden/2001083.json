17766","dokument_sha256":"3bd497353765363615e3148165d3e8e2deac4a572b83ad6bab4e63d3fa2b307e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4.2. Skötselområden\n    Skötselområde 1, sandstrand och öppna dyner\n    Areal 63 ha\n    Beskrivning\n    Skötselområdet består av sandstrand och öppna sanddyner med ett rikt växt- och\n    djurliv. Vegetationen domineras av gräs i stora delar och inslaget av öppen sand är\n    där litet. De mäktigaste dynerna med inslag av rörlig sand finns i norr. Vresros\n    förekommer spritt i området och riklig föryngring av tall och löv sker i dynerna där\n    flera större röjningar har gjorts under senare år. I nordöstra delen finns ett parti med\n    sandiga brinkar mot Genevadsån och i söder ingår även sandstrand utmed Lagan.","inledning":"Jakt är förbjudet i reservatet vilket är reglerat i föreskrifterna. Hög predation på\n    fågelägg/ungar av ex räv, grävling, mink, kråkfågel och trutar kan medföra att","inledning_offset":1452,"inledning_sidnummer":9,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":1670,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurliv","större","stora"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1017765","dokument_namn":"Tönnersa Bilagor till beslut 2010-03-16.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1017765","dokument_sha256":"bc71db18fd132cb5a9ae37710d0e79a469e6714f47989a983283981329bcc28d","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geome