ummer":4,"teckenoffset_pa_sidan":303,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1013877","dokument_namn":"Beslut_Kvarnbrännan_underskrivet.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1013877","dokument_sha256":"ed58177211a09406a5c3430d316a8ce156582c8c3d6195c5d5e9b405176ea9b3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"3. medvetet störa djurlivet, till exempel genom att klättra i boträd eller\n           uppehålla sig nära rovfågelbo, lya eller gryt,","inledning":"Det är förbjudet att:","inledning_offset":449,"inledning_sidnummer":4,"punkt":"3.","sidnummer":4,"teckenoffset_pa_sidan":745,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1013877","dokument_namn":"Beslut_Kvarnbrännan_underskrivet.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1013877","dokument_sha256":"ed58177211a09406a5c3430d316a8ce156582c8c3d6195c5d5e9b405176ea9b3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4. framföra motordrivet fordon annat än på befintliga skogsbilvägar, med\n           undantag för snöskoterkörning vintertid på snötäckt, väl tjälad mark eller\n           på is,","inledning":"Det är förbjudet att:","inledning_offset":449,"inledning_sidnummer":4,"punkt":"4.","sidnummer":4,"teckenoffset_pa_sidan":887,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1013877","dokument_namn":"Beslut_Kvarnbrännan_underskrivet.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1013877","dokument_sha256":"ed58177211a09406a5c3430d316a8ce156582c8c3d6195c5d5e9b405176ea9b3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Beskrivning av reservatet\n        Kvarnbrännans naturreservat ligger ca 2,5 km nordväst om Åmsele.\n        Området utgörs av ett stort sammanhängande naturskogsområde med bland\n        annat brandpräglade, talldominerade sandbarrskogar och lövinblandade\n        barrnaturskogar med förekomst av äldre asp och sälg. Området har mycket\n        höga naturvärden knutna till det naturskogsartade skogstillståndet, med god\n        förekomst av strukturer som gamla träd av både tall, gran och löv, god\n        trädkontinuitet, åldersspridning i trädskiktet samt stående och liggande död\n        ved.","inledning":"Det är förbjudet att:","inledning_offset":449,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":749,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1013877","dokument_namn":"Beslut_Kvarnbrännan_underskrivet.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1013877","dokument_sha256":"ed58177211a09406a5c3430d316a8ce156582c8c3d6195c5d5e9b405176ea9b3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsens motivering\n        Motiv för skyddet är att bevara områdets helhetsvärden och att motverka\n        exploatering. Området har egenskaper och strukturer som utvecklats under\n        förutsättning att naturliga processer fått verka relativt ostört under lång tid.\n        För att områdets värden ska bestå behöver det därför undantas från\n        skogsproduktion och annan exploatering som innebär att naturvärdena\n        påtagligt skulle skadas.\n        Områden med naturskog blir allt mer sällsynta i länet och att skydda dessa\n        kvarvarande fragment av det ursprungliga skogslandskapet är avgörande för\n        att bevara den biologiska mångfalden.","inledning":"Det är förbjudet att:","inledning_offset":449,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1895,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1013877","dokument_namn":"Beslut_Kvarnbrännan_underskrivet.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1013877","dokument_sha256":"ed58177211a09406a5c3430d316a8ce156582c8c3d6195c5d5e9b405176ea9b3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[19.24470053,64.54812159],[19.24493794,64.54586407],[19.24493759,64.54586349],[19.24493654,64.54586311],[19.231614,64.5458849],[19.23161237,64.5458852],[19.23161172,64.54588591],[19.23203155,64.55290795],[19.23203225,64.55290864],[19.23203385,64.55290892],[19.27831546,64.55283079],[19.29732645,64.55284018],[19.30957337,64.55281907],[19.30957418,64.55281892],[19.30957502,64.55281849],[19.30986418,64.55253208],[19.31040654,64.55229017],[19.31081448,64.55189753],[19.31078833,64.55173176],[19.31101098,64.55139204],[19.31073098,64.55101968],[19.3115049,64.55031891],[19.31213297,64.54939659],[19.3122069,64.54898999],[19.31188562,64.54835691],[19.31184002,64.5479648],[19.3118393,64.54796413],[19.31183771,64.54796386],[19.30911715,64.54796984],[19.27390264,64.54803942],[19.27299811,64.54804078],[19.24470053,64.54812159]]]]},"beraknad_area_ha":218.41,"arealavvikelse_procent":-0.68,"bbox":[19.231612,64.545863,19.312207,64.552909]}