{"nvrid":"2003892","slug":"fiskviksholmens-skar","namn":"Fiskviksholmens skär","skyddstyp":"Djur- och växtskyddsområde","lager":"djur-och-vaxtskydd","karnlager":true,"kommun":"Hammarö","lan":"Värmlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Värmlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2003-06-10","senaste_gallandedatum":"2003-06-27","area_ha":4.67,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2003892","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":true,"foreskriftsomraden":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"31/7"}],"sasongsdata":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"31/7"}],"dokument":[{"namn":"Norra Vänern_Hammarrö.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040601","dokument_id":"nvdok-1040601","sha256":"f043b9c949d5d6f16bcb328c48ffec0918823091d9c8e80158dbd01d6792f91f","sidor":14,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Länsstyrelsen beslutar med stöd av 7 kap 12 8 Miljöbalken att förbud skall\ngälla under tiden 1 april — 31 juli att landstiga på följande öar och delområden\neller varaktigt vistas i vattenområden där intill.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":134,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["vistas","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1040601","dokument_namn":"Norra Vänern_Hammarrö.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040601","dokument_sha256":"f043b9c949d5d6f16bcb328c48ffec0918823091d9c8e80158dbd01d6792f91f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I Länsstyrelsens beslut 1980-10-20 om reservatsbildning för Värmlandsskär-\ngården föreskrivs ett förbud för allmänheten att under tiden 1 april — 31 juli\nlandstiga på öar och delområden eller varaktigt vistas på vattenområde intill\ndessa enligt markering på karta till beslutet. Syftet med dessa s k fågelskydds-\nområden är att ge skydd åt vissa, särskilt känsliga fågelarters häckningsloka-\nler. Det rör sig ofta om måsfågelkolonier eller häckande fiskgjuse. Dessa få-\ngelskyddsområden har senare reviderats 1986-07-02.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":618,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["vistas","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1040601","dokument_namn":"Norra Vänern_Hammarrö.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040601","dokument_sha256":"f043b9c949d5d6f16bcb328c48ffec0918823091d9c8e80158dbd01d6792f91f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Intressekonflikter kan uppstå om alltför många attraktiva utflyktsmål beläggs\nmed tillträdesförbud. Önskemål om tillgängliga utflyktsmål är ytterst berätti-\ngade och måste beaktas. Samtidigt höjer ett rikt fågelliv i hög grad ett skär-\ngårdsområdes kvalitéer som rekreationsområde. Den nu föreslagna utökningen\nav fågelskyddet bedöms vara positiv för fågellivet och samtidigt endast mar-\nginellt påverka friluftslivet i den aktuella delen av Vänern.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":68,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1040601","dokument_namn":"Norra Vänern_Hammarrö.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040601","dokument_sha256":"f043b9c949d5d6f16bcb328c48ffec0918823091d9c8e80158dbd01d6792f91f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"trycket ”varaktigt vistas” innefattar ej förbud att med båt passera genom om-\nrådet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":1986,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["vistas","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1040601","dokument_namn":"Norra Vänern_Hammarrö.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040601","dokument_sha256":"f043b9c949d5d6f16bcb328c48ffec0918823091d9c8e80158dbd01d6792f91f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Undantag från tillträdesförbudet gäller för respektive markägare.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":2072,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","Undantag från"],"handlingar":["marken"],"dokument_id":"nvdok-1040601","dokument_namn":"Norra Vänern_Hammarrö.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040601","dokument_sha256":"f043b9c949d5d6f16bcb328c48ffec0918823091d9c8e80158dbd01d6792f91f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Undantag från tillträdesförbudet gäller även för Vänerns seglationsstyrelse,\nsjöräddningen, tullverket och polisen, Verksamhet inom utpekade områden\nskall dock i största möjliga utsträckning undvikas under förbudstiden.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer"