ån"],"handlingar":["marken"],"dokument_id":"nvdok-1047131","dokument_namn":"Beslut_Svartliden_20260615us.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047131","dokument_sha256":"538e9e5d400f8d17dbbaf90a182ac7cb17e616ee216a5bfa63d69336c4c9a0b0","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"•   Västerbottens ornitologiska förening (VOF) välkomnar skyddet av\n    barrnaturskogen med bl.a. tjäder och tretåig hackspett. För att\n    stärka skyddet för områdets fågelfauna har VOF synpunkter på\n    åtgärder i beslut och skötselplan. VOF vill bl.a. ha förbud mot\n    användning av drönare, fågelsäkring vid naturvårdande\n    skötselåtgärder, behov av skyddszoner runt reservatet för att stärka\n    fågellivet, tydligare mål och riktlinjer för uppföljning av\n    fågelpopulationer.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":773,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"hög","traffade_ord":["drönare","förbud"],"handlingar":["flyga"],"dokument_id":"nvdok-1047131","dokument_namn":"Beslut_Svartliden_20260615us.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047131","dokument_sha256":"538e9e5d400f8d17dbbaf90a182ac7cb17e616ee216a5bfa63d69336c4c9a0b0","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Några av VOF:s åtgärdsförslag regleras, åtminstone till en del, i\n    annan lagstiftning eller av andra aktörer och myndigheter, exempel-\n    vis drönare av Transportstyrelsen. Avsnittet ”Upplysningar” har\n    kompletterats med några av dessa. Ett naturreservats föreskrifter\n    gäller enbart innanför naturreservatets gränser. Naturreservatets\n    föreskrifter och skötselplan kan därmed inte föreskriva hur mark\n    utanför reservatet ska nyttjas eller brukas. Uppföljning av\n    naturreservatets livsmiljötyper och arter, nyttjade för friluftsliv\n    m.m. sker enligt Naturvårdsverkets riktlinjer utifrån tillgängliga\n    resurser och prioriteringar i länets samtliga naturreservat. Eftersom","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":1836,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","traffade_ord":["drönare"],"handlingar":["flyga"],"dokument_id":"nvdok-1047131","dokument_namn":"Beslut_Svartliden_20260615us.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047131","dokument_sha256":"538e9e5d400f8d17dbbaf90a182ac7cb17e616ee216a5bfa63d69336c4c9a0b0","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.89473833,64.74691097],[17.89515913,64.74739474],[17.8950367,64.74791948],[17.89503693,64.74792002],[17.89660698,64.7488044],[17.8979359,64.74922538],[17.89793716,64.74922558],[17.89793846,64.74922544],[17.89936492,64.74867795],[17.89936532,64.74867755],[17.89959178,64.7481575],[17.89959163,64.74815693],[17.89959037,64.7481564],[17.89765346,64.74782751],[17.8957587,64.74682752],[17.89549199,64.74669547],[17.89837039,64.74580887],[17.89943698,64.74493257],[17.89996368,64.74483418],[17.89996473,64.74483378],[17.90168262,64.7436023],[17.90171667,64.74211206],[17.90247092,64.74144251],[17.90247113,64.74144197],[17.90100409,64.74028438],[17.90100303,64.74028396],[17.89521525,64.74024733],[17.89521392,64.7402475],[17.89521306,64.74024797],[17.89521291,64.74024837],[17