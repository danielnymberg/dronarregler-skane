ering"},{"citat":"Beslut 511-9300-16\n2017-04-07\n\nBakgrunden är att dessa öar är häckningsplatser för storlom, fiskgjuse och lärkfalk\noch att störning förekommer här under häckningstid.\n\nDe aktuella öarna bedöms tillhöra fastigheten Bondesätter 1:1 som kommer att\növergå i Holmen Skog AB:s ägo enligt avtal med Naturvårdsverket och efter slutförd\nlantmäteriförrättning.\n\nMotiv\n\nLänsstyrelsen anser att de aktuella platserna är störningskänsliga och att fågellivet på\ndessa platser är beroende av ett skydd för att ha möjlighet till reproduktion. Beslutet\ntorde endast marginellt inverka negativt på det rörliga friluftslivet i sjön Käxten.","inledning":"Inom fågelskyddsområdena är det förbjudet att:","inledning_offset":693,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":0,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["störningskänsliga","häckningsplatser","häckningstid"],"dokument_id":"nvdok-1036648","dokument_namn":"511-9300-16 käxten dso signerat.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1036648","dokument_sha256":"7f02b69938eaaf7158aa9126efb4be260f8b3c1d723afd682732575a97986685","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[15.98519653,58.70566588],[15.98511815,58.70569744],[15.98504895,58.70573665],[15.98504853,58.70573703],[15.98504091,58.70579096],[15.98504521,58.70588093],[15.98503964,58.70596153],[15.98502342,58.70600808],[15.98496942,58.70605055],[15.98494592,58.70609947],[15.98494629,58.70610008],[15.98