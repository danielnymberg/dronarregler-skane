d":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"•   Enligt 1 § terrängkörningslagen (1975:1313) är det förbjudet att\n       köra på barmark i terräng med motordrivna fordon. Vissa\n       elcyklar, elskotrar och liknande fordon räknas som motordrivna\n       fordon enligt 2 § lag (2001:559) om vägtrafikdefinitioner och är\n       därmed förbjudna att framföras i terrängen på barmark.","inledning":"(1988:950). Enligt 2 kap. 6 § kulturmiljölagen är det förbjudet att","inledning_offset":1067,"inledning_sidnummer":15,"punkt":null,"sidnummer":15,"teckenoffset_pa_sidan":1719,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivna","fordon","förbjudet"],"dokument_id":"nvdok-1027986","dokument_namn":"liden_beslut_20250224us.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027986","dokument_sha256":"bca78e0b6b8b8cf77221efe3ccc70f935edec5ba62cb7b500b8bf23581ff9aec","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[20.62549316,63.84637243],[20.62555336,63.84676472],[20.62555416,63.84676541],[20.62555586,63.84676563],[20.64022141,63.84598582],[20.64022268,63.84598556],[20.64022334,63.84598502],[20.64022644,63.8459774],[20.64038116,63.84558246],[20.64038479,63.84557817],[20.6426508,63.84545717],[20.64265226,63.84545681],[20.64265275,63.84545611],[20.64212719,63.84461677],[20.64212609,63.84461616],[20.64212477,63.84461605],[20.62385912,63.84558218],[20.62255048,63.84565285],[20.6225493,63.84565307],[20.62254