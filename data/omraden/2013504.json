_pa_sidan":944,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1007330","dokument_namn":"Kråksten Beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007330","dokument_sha256":"16ea51772d0dba341e69f6c2692e26eb27116e6ed87b80fcca528544a0255828","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Föreskrifter enligt 7 kap. 30 $ miljöbalken om rätten att färdas och vistas inom\nreservatet och om ordningen i övrigt inom reservatet\n\nUtöver vad som i övrigt gäller är det förbjudet att:","inledning":"Utöver vad som annars gäller är det förbjudet att:","inledning_offset":258,"inledning_sidnummer":4,"punkt":"C.","sidnummer":5,"teckenoffset_pa_sidan":744,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","förbjudet"],"dokument_id":"nvdok-1007330","dokument_namn":"Kråksten Beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007330","dokument_sha256":"16ea51772d0dba341e69f6c2692e26eb27116e6ed87b80fcca528544a0255828","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Jägarförbundet Västmanland har inkommit med ett yttrande. Jägarförbundet är kritiska\ntill det föreslagna förbudet mot fågeljakt men ser positivt på att motordrivet fordon får\nanvändas vid uttransport av klövvilt samt att jakt med lös hund får bedrivas inom\nområdet.","inledning":"Utöver vad som i övrigt gäller är det förbjudet att:","inledning_offset":882,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":2563,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbudet"],"dokument_id":"nvdok-1007330","dokument_namn":"Kråksten Beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007330","dokument_sha256":"16ea51772d0dba341e69f6c2692e26eb27116e6ed87b80fcca528544a0255828","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Jägarförbundet anser att jakten på hönsfågel inte bör inskränkas i området. Länsstyrelsen\ndelar inte denna uppfattning. Jägarförbundet pekar i sitt yttrande på att jakten på\nhönsfågel inom området är av stor betydelse för jägarna i området. Jaktlaget, som också\nfått förslaget på remiss, har inte inkommit med några sådana synpunkter. Länsstyrelsen\nmotiverar förbudet mot jakt på hönsfågel med att tjäder och orre är utpekade i EU:s\nfågeldirektiv. Ytterligare ett tungt vägande motiv till förbudet är att öka allmänhetens\nmöjlighet att få se tjäder eller orre i området.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":1808,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågeldirektiv","stor","förbudet"],"dokument_id":"nvdok-1007330","dokument_namn":"Kråksten Beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007330","dokument_sha256":"16ea51772d0dba341e69f6c2692e26eb27116e6ed87b80fcca528544a0255828","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[15.88128487,59.98529266],[15.88070473,59.98838318],[15.88079286,59.99004452],[15.88083247,59.9904172],[15.88083322,59.99041793],[15.8812397,59.99057739],[15.88257317,59.9909266],[15.88257473,59.9909265],[15.88257564