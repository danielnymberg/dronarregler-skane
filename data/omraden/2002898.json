dsverket.se/handlingar/rest/dokument/1025824","dokument_sha256":"dcd64c4aee16e6b60ad37d3283c6463b88a70c64a918f76e826a62f3d3d22f1e","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.9520747,59.38979155],[17.95197429,59.38969647],[17.95197319,59.38969601],[17.95197176,59.38969605],[17.95171763,59.38975699],[17.94897775,59.39039939],[17.94897687,59.39039981],[17.94897663,59.39040041],[17.94942864,59.39107333],[17.95067551,59.39289904],[17.95113038,59.39348216],[17.9517593,59.39416608],[17.95293653,59.39541026],[17.95360199,59.39608444],[17.95414478,59.39662645],[17.9541459,59.39662694],[17.95483253,59.39660308],[17.95634193,59.39681021],[17.9568883,59.39677817],[17.95758758,59.39650652],[17.95837003,59.39611855],[17.95879894,59.39600333],[17.95943239,59.39599116],[17.9594336,59.39599091],[17.96360833,59.39408683],[17.9650164,59.39471371],[17.96501749,59.39471395],[17.96501829,59.39471391],[17.96501925,59.39471354],[17.96584789,59.39412117],[17.96656414,59.39419807],[17.96552973,59.39492969],[17.96552937,59.39493021],[17.96552946,59.39493058],[17.96553008,59.39493103],[17.9663517,59.39527131],[17.96538011,59.39684262],[17.9653803,59.39684317],[17.96586136,59.39733571],[17.96730872,59.39757007],[17.97101296,59.39703349],[17.97243929,59.39710723],[17.97400572,59.3978904],[17.97400631,59.3978906],[17.97400736,59.39789067],[17.9749349,59.39761845],[17.97636233,59.39727355],[17.97768259,59.39701955],[17.97854044,59.39687807],[17.98175351,59.3951144],[17.98175358,59.39511383],[17.98104495,59.39355592],[17.98104441,59.39355544]