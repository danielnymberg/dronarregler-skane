{"nvrid":"2063661","slug":"messaurebacken","namn":"Messaurebäcken","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Jokkmokk","lan":"Norrbottens Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Norrbottens län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2024-12-09","senaste_gallandedatum":"2024-12-31","area_ha":143.63,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2063661","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"beslut241209.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024132","dokument_id":"nvdok-1024132","sha256":"ecf78425c5fad5a786928dfcc33353c45e67b75b7229c0132691d12bae9273b0","sidor":26,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"1. fälla eller på annat sätt skada levande eller döda träd och\n                     buskar,\n                  2. samla in vedsvampar, mossor, lavar eller ryggradslösa djur,\n                  3. skada vegetationen i övrigt genom att till exempel gräva upp\n                     växter,\n                  4. fånga, skada eller döda ryggradsdjur. Ta ägg eller störa\n                     djurlivet genom att exempelvis klättra i boträd eller medvetet\n                     uppehålla sig i närheten av fågelbo, lya eller gryt,","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":2257,"inledning_sidnummer":4,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":2339,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1024132","dokument_namn":"beslut241209.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024132","dokument_sha256":"ecf78425c5fad5a786928dfcc33353c45e67b75b7229c0132691d12bae9273b0","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"5. skräpa ner, samt\n                  6. framföra motordrivna fordon utanför befintlig väg.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":2257,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":211,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1024132","dokument_namn":"beslut241209.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024132","dokument_sha256":"ecf78425c5fad5a786928dfcc33353c45e67b75b7229c0132691d12bae9273b0","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Utöver de föreskrifter som gäller Messaurebäckens naturreservat\n              gäller även annan lagstiftning som vanligt och därmed även\n              terrängkörningslagen (1975:1313) och terrängkörningsförordningen\n              (1978:594). Det innebär att det är förbjudet att framföra motordrivet\n              fordon på barmark i terräng. Undantag finns bland annat för\n              skogsbruksändamål, jordbruksändamål, renskötsel samt vid\n              uttransport av fällt vilt.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":14,"teckenoffset_pa_sidan":1201,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1024132","dokument_namn":"beslut241209.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024132","dokument_sha256":"ecf78425c5fad5a786928dfcc33353c45e67b75b7229c0132691d12bae9273b0","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsen anser inte att reservatsbildningen kommer att utgöra\n              ett hot mot rennäringens behov av att låta renarna beta i fred, då\n              Messaurebäcken inte är tänkt som ett besöksreservat. Vägen till\n              reservatet är bommad och det saknas informationsskylt och\n              anläggningar för friluftsliv, så antalet besökare till reservatet\n              förväntas bli begränsat. Dock gäller allemansrätten inom reservatet,\n              vilket innebär att besökare har rätt att vistas inom området och idka\n              friluftsliv om de önskar.","inledning":"förbjuden enligt terrängkörningslagen. Det finns möjlighet att","inledning_offset":2064,"inledning_sidnummer":14,"punkt":null,"sidnummer":15,"teckenoffset_pa_sidan":1942,"klassificering":"annat-läs-beslutet","konfidens":"medel","dokument_id":"nvdok-1024132","dokument_namn":"beslut241209.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024132","dokument_sha256":"ecf78425c5fad5a786928dfcc33353c45e67b75b7229c0132691d12bae9273b0","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[20.30399748,66.65671929],[20.30299956,66.65974958],[20.30300046,66.65975008],[20.30782731,66.6611692],[20.30858955,66.66129531],[20.30859125,66.66129507],[20.31011729,66.66076707],[20.31175414,66.66035459],[20.31279204,66.66008735],[20.31353478,66.65991343],[20.31429717,66.6598995],[20.31525206,66.65994451],[20.31602021,66.65996012],[20.31602147,66.65996001],[20.31662498,66.65983845],[20.31716017,66.65960608],[20.31770578,66.65949238],[20.31844639,66.659378],[20.31879911,66.6593422],[20.319289,66.65924821],[20.31979965,66.65911191],[20.32045973,66.65904192],[20.3207684,66.65904885],[20.32076974,66.65904873],[20.3230