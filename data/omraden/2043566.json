okumenterad normalisering"},{"citat":"11 § Biltvätt m.m.\nTvätt av motorfordon och maskiner får inte utföras på sådan plats där avrinning sker\ndirekt till sjöar eller vattendrag. Se § 5.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":1491,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motorfordon","får inte"],"dokument_id":"nvdok-1044317","dokument_namn":"Örken vattenskyddsföreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044317","dokument_sha256":"1c45f74b34e6da3449ada385f5f79a61e44bda54f049983bc9e60112fa744b95","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.95325916,57.13791148],[14.9532851,57.1397508],[14.95410571,57.1403644],[14.95341663,57.14076035],[14.95228782,57.14105301],[14.95149038,57.14115089],[14.95040055,57.14136213],[14.95039986,57.14136237],[14.94994685,57.14161414],[14.948727,57.14194856],[14.94768994,57.14293332],[14.94769008,57.14293386],[14.9482884,57.14366846],[14.94851483,57.14417754],[14.95162493,57.14972157],[14.95427561,57.15228086],[14.9568145,57.15467747],[14.9568153,57.15467776],[14.95681595,57.15467782],[14.95931103,57.15463185],[14.96115947,57.15761623],[14.96116,57.15761666],[14.96211424,57.1578117],[14.96892437,57.15772263],[14.97260176,57.15806139],[14.97150171,57.15922999],[14.97150164,57.1592308],[14.97782116,57.1677943],[14.97646669,57.17217652],[14.97305599,57.17387803],[14.96487035,57.17546655],[14.96486931,57.17546707],[