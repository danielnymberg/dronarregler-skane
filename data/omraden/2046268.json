{"nvrid":"2046268","slug":"blocktjarnsasen","namn":"Blocktjärnsåsen","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Älvdalen","lan":"Dalarnas Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Dalarnas län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2017-05-24","senaste_gallandedatum":"2017-07-18","area_ha":601.57,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2046268","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Blocktjärn-beslut-skotsel-ejsänd.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023074","dokument_id":"nvdok-1023074","sha256":"f69255107e37532399bf8676de3d3af8b774c3a6a97954759c33d13d6c55c111","sidor":51,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"SV-Blocktjärnsåsen.jpg","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023073","orsak":"ej föreskriftsbärande dokumenttyp"}],"citat":[{"citat":"6. framföra motordrivet fordon i terrängen, vilket gäller både barmark och\n   snötäckt mark, med följande undantag:\n       − Transportera ut älg, björn, hjort eller vildsvin med fordon som inte ger\n           skador på mark eller vegetation.\n       − För tjänstemän i sjukvårds-, polis- eller räddningsärende. Insatsen ska\n           omgående anmälas till Länsstyrelsen.\n        -   För nyttjare av stuga på Strådalens fäbodar att med snöskoter färdas\n            genom naturreservatet kortaste sträcka till fäboden från lämplig\n            angöringspunkt","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att:","inledning_offset":559,"inledning_sidnummer":3,"punkt":"6.","sidnummer":3,"teckenoffset_pa_sidan":1320,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1023074","dokument_namn":"Blocktjärn-beslut-skotsel-ejsänd.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023074","dokument_sha256":"f69255107e37532399bf8676de3d3af8b774c3a6a97954759c33d13d6c55c111","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"2. framföra motordrivet fordon i terrängen. Detta gäller både barmark och\n   snötäckt mark,","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att:","inledning_offset":946,"inledning_sidnummer":4,"punkt":"2.","sidnummer":4,"teckenoffset_pa_sidan":1250,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1023074","dokument_namn":"Blocktjärn-beslut-skotsel-ejsänd.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023074","dokument_sha256":"f69255107e37532399bf8676de3d3af8b774c3a6a97954759c33d13d6c55c111","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Snöskoteråkning förbjuds i området frånsett stugägarens färd till Strådalens fäbodar.\nFörbudet motiveras av detta områdes känslighet för störning. Ett påtagligt hot utgör den\npå senare år populära brantåkning som utövas i omgivningen. För dem som önskar färdas\nmellan Drevfjällen och Fuludalen kan reservatet passeras på ömse sidor. Branternas\nkänsliga flora och fauna är också skälet till att klättring i dessa förbjuds.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":1269,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","förbjuds"],"handlingar":["marken"],"dokument_id":"nvdok-1023074","dokument_namn":"Blocktjärn-beslut-skotsel-ejsänd.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023074","dokument_sha256":"f69255107e37532399bf8676de3d3af8b774c3a6a97954759c33d13d6c55c111","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreningen önskar vidare kunna köra snöskoter som är en förutsättning för att nyttja\nfisket vintertid. – Länsstyrelsen menar dock att den enda tjärnen av någorlunda storlek,\nKnittjärnen, kan nås med skoter utan att man behöver färdas genom naturreservatet.\nSkoterförbudet är angeläget med hänsyn till störningskänslig fauna och bör därför finnas\nkvar.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":1439,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1023074","dokument_namn":"Blocktjärn-beslut-skotsel-ejsänd.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023074","dokument_sha256":"f69255107e37532399bf8676de3d3af8b774c3a6a97954759c33d13d6c55c111","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[12.55517394,61.73156801],[12.55498842,61.7315642],[12.55472349,61.73155927],[12.55458982,61.73156424],[12.55414207,61.73167373],[12.55376423,61.73172401],[12.55339894,61.73179491],[12.55303419,61.73183849],[12.55258103,61.73189232],[12.55229437,61.73191933],[12.55164404,61.73198485],[12.55140849,61.73206384],[12.55119211,61.73217103],[12.5509122,61.73248207],[12.55083487,61.73252068],[12.55059544,61.73266472],[12.5