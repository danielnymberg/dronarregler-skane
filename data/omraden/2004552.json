{"nvrid":"2004552","slug":"skavasen","namn":"Skavåsen","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Torsby","lan":"Värmlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Värmlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2006-09-06","senaste_gallandedatum":"2006-11-13","area_ha":20.84,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2004552","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"beslut - skavåsen.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1006471","dokument_id":"nvdok-1006471","sha256":"1c3da62009faad035a44ff60a59c9492e5cb83bbae5cf1988253bdb548dc78b7","sidor":7,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"skötselplan skavåsen.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1006665","orsak":"ej föreskriftsbärande dokumenttyp"},{"namn":"skötselplanekarta-ny skavåsen.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1006472","orsak":"ej föreskriftsbärande dokumenttyp"}],"citat":[{"citat":"C. Ordningsföreskrifter enligt 7 kap. 30 § MB om rätten att färdas och vistas i,\nsamt om ordningen i reservatet i övrigt (gäller även markägare och innehavare av\nsärskild rätt).\nUtöver vad som annars gäller i lagar och författningar är det i naturreservatet förbjudet att:","inledning":"Utöver vad som annars gäller i lagar och författningar är det i naturreservatet förbjudet att:","inledning_offset":1256,"inledning_sidnummer":1,"punkt":"C.","sidnummer":2,"teckenoffset_pa_sidan":423,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1006471","dokument_namn":"beslut - skavåsen.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1006471","dokument_sha256":"1c3da62009faad035a44ff60a59c9492e5cb83bbae5cf1988253bdb548dc78b7","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Tidigare förknippades områdets gammelskogar mest med fåglar som gråspett, vitryggig\nhackspett, slaguggla och videsparv. Under nyckelbiotopsinventeringen på 1990-talet visade det\nsig att många områden också var hemvist för ovanliga kryptogamer som till exempel lunglav,\nbroktagel, violettgrå tagellav, norsk näverlav, brokig tagellav, grönsticka, skrovellav,\ngammelgranskål och dvärgbägarlav.\nI de skogar som fortfarande är talldominerade och mer öppna påträffas ofta, om bestånden har\nnågon död ved, rödlistade vedskalbaggar knutna till just solexponerad ved. Som exempel kan\nnämnas raggbock, skrovlig flatbagge och större flatbagge.","inledning":"Utöver vad som annars gäller i lagar och författningar är det i naturreservatet förbjudet att:","inledning_offset":601,"inledning_sidnummer":2,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":309,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1006471","dokument_namn":"beslut - skavåsen.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1006471","dokument_sha256":"1c3da62009faad035a44ff60a59c9492e5cb83bbae5cf1988253bdb548dc78b7","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.33613441,60.43980465],[13.33613413,60.43980536],[13.33613493,60.43980598],[13.35315569,60.4458143],[13.3537842,60.44603606],[13.35378574,60.44603623],[13.35378704,60.44603579],[13.35515582,60.44427969