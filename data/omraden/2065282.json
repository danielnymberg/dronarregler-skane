slutet ska också anges de inskränkningar i\n               rätten att använda mark- och vattenområden som behövs för att\n               uppnå syftet med naturreservatet, såsom förbud mot bebyggelse,\n               uppförande av stängsel, upplag, schaktning, täkt, uppodling, dikning,\n               plantering, avverkning, jakt, fiske och användning av\n               bekämpningsmedel. En inskränkning får innebära att tillträde till\n               området förbjuds under hela eller delar av året.","inledning":"bedömer att föreskrifterna inte går längre än vad som krävs för att","inledning_offset":898,"inledning_sidnummer":9,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":2237,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträde","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1027999","dokument_namn":"beslut kungshult naturreservat.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027999","dokument_sha256":"45e3720801a58efd0f6738bf32ae02d4fcfffd18c6741fd65f211a073ba9cdaa","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.89917236,58.08541875],[14.89853887,58.08534727],[14.89853742,58.08534742],[14.89853664,58.08534809],[14.89843855,58.08569081],[14.89843869,58.08569136],[14.89843936,58.08569178],[14.89844035,58.08569195],[14.90005741,58.08571619],[14.90032861,58.08700461],[14.90032903,58.08700513],[14.90032991,58.08700545],[14.90033098,58.08700546],[14.90350646,58.08652665],[14.90410519,58.08673013],[14.905266,58.08677807],[14.90526705,58.0867