ortsätta sköta markerna med betesdjur, vilket i många fall\när en förutsättning för att bevara de naturvärden som avses skyddas, dels skyddas värdefullt\nfågelliv. Naturreservaten är i många fall även till för allmänhetens friluftsliv, vilket i huvudsak\nbedöms gynnas av förslaget.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":648,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelliv","stor","förbuden"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1023804","dokument_namn":"Kopplingskrav för hund infört i 22 reservat 2019.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023804","dokument_sha256":"a60493468238de8f32a0092df50e189178bf83280b6d0f8e3728ea80c2222741","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[12.24896411,57.06389246],[12.25446764,57.06294186],[12.25446866,57.06294142],[12.25446891,57.0629409],[12.25436878,57.05950401],[12.25436864,57.05950365],[12.254368,57.05950321],[12.25436703,57.05950304],[12.25058011,57.05943062],[12.23974693,57.06331893],[12.23974639,57.06331963],[12.23967768,57.06690375],[12.23967797,57.06690429],[12.23967845,57.06690456],[12.23967944,57.06690475],[12.24868839,57.06707042],[12.24868934,57.06707029],[12.24958318,57.06648325],[12.2495836,57.06648269],[12.24896411,57.06389246]]]]},"beraknad_area_ha":47.92,"arealavvikelse_procent":-0.73,"bbox":[12.239678,57.059431,12.254469,57.06707]}