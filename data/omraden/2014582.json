,"punkt":"3.","sidnummer":3,"teckenoffset_pa_sidan":1996,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurlivet","fågelbo","Störa"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1008645","dokument_namn":"091029 Beslut Hirvivaara inkl alla bilagor_påskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008645","dokument_sha256":"8509bc6cbfc1222c706cb3bc499f2fc6af9e1d3b43a1d56c651d5114bf1b3f02","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"6. Framföra motordrivna fordon.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":1705,"inledning_sidnummer":3,"punkt":"6.","sidnummer":3,"teckenoffset_pa_sidan":2337,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivna","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1008645","dokument_namn":"091029 Beslut Hirvivaara inkl alla bilagor_påskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008645","dokument_sha256":"8509bc6cbfc1222c706cb3bc499f2fc6af9e1d3b43a1d56c651d5114bf1b3f02","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Skogen på Hirvivaara utgörs av barrblandskog med stort lövinslag. Skogen har vuxit\nupp efter en hårdare brand för ca 150 år sedan. Genomgående finns gamla överståndare\noch rikligt med lövträd av både vårtbjörk och asp. Den döda veden utgörs främst av löv\nsamt en del tall. Området är tydligt brandpräglat och det finns genomgående rikligt med\ngrova, gamla tallågor och naturliga stubbar. I området har flera sällsynta arter hittats,\nsom till exempel reliktbock och dvärgbägarlav på tall och stiftgelélav på asp.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":1705,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1056,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sällsynta","stort"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1008645","dokument_namn":"091029 Beslut Hirvivaara inkl alla bilagor_påskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008645","dokument_sha256":"8509bc6cbfc1222c706cb3bc499f2fc6af9e1d3b43a1d56c651d5114bf1b3f02","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I de norra och östra delarna övergår skogen till att bli allt mer grandominerad och\nlövinslaget är mycket stort av björk, asp och sälg. Mindre partier är nära nog helt\nlövdominerade. Här finns rikligt med asp och i markskiktet finns inslag av lågörter som\nbergslok och skogsnäva. Områdets främsta värden är det genomgående höga inslaget av\nolika lövträd som vårtbjörk, asp och sälg.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":1705,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1569,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["stort","sälg"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1008645","dokument_namn":"091029 Beslut Hirvivaara inkl alla bilagor_påskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008645","dokument_sha256":"8509bc6cbfc1222c706cb3bc499f2fc6af9e1d3b43a1d56c651d5114bf1b3f02","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"ham