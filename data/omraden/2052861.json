t/dokument/1027464","dokument_sha256":"abcb4ed3326041023a51fcdee2e25ee642cea218ccd4189defd2590ad3967bce","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"−   I Bilaga 1, sid 3, del C, punkt 11, anser vi att det bör stå följande: framföra farkost på vattnet,\n      under vattenytan eller i luften, såväl bemannat som obemannat.\n               SVAR: Vi kan inte reglera bemannad flygaktivitet förutom gällande landning.\n               Gällande obemannade luftfartyg har föreskriften justerats enligt följande:\n               ”11. framföra fjärrmanövrerade obemannade luftfartyg såsom modellflygplan eller\n               drönare på en höjd understigande 120 meter över marken,”","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":37,"teckenoffset_pa_sidan":1733,"klassificering":"start-landningsförbud","konfidens":"låg","traffade_ord":["obemannade luftfartyg","modellflygplan","landning"],"dokument_id":"nvdok-1027464","dokument_namn":"Kustdammarna kompl.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027464","dokument_sha256":"abcb4ed3326041023a51fcdee2e25ee642cea218ccd4189defd2590ad3967bce","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.0593308,55.68328084],[13.05937127,55.68315545],[13.05937115,55.68315489],[13.05937021,55.68315436],[13.05809561,55.68301505],[13.05809456,55.68301512],[13.05809398,55.68301536],[13.05793513,55.68317122],[13.05774073,55.68334837],[13.05619751,