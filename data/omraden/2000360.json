ull,"sidnummer":2,"teckenoffset_pa_sidan":1685,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelfaunan","storlom","förbud"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1008161","dokument_namn":"Beslut Fegen med kartor 2010.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008161","dokument_sha256":"334e0e2553e623fa448d4a7270e45721a94501721c7dc5a8dfafd1c6e7972264","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Beslut                 Diarienummer:     Sida\n                                                                    511-43627-2005   3(10)\n\n\n\n\nSyftet ska tryggas genom att:\n vissa åtgärder inom skogsbruket, som kan påverka vattenkvalitén nega-\n   tivt, regleras;\n Länsstyrelsen ska verka för en ändring av vattenregleringen till en som\n   är mer gynnsam för sjöns växt- och djurliv;\n tiden för tillträdesförbud inom fågelskyddsområdena förlängs. Även\n   andra naturvårdsinsatser, till exempel anläggning av boplatser för vissa\n   fågelarter kan komma att genomföras;","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":45,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1008161","dokument_namn":"Beslut Fegen med kartor 2010.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008161","dokument_sha256":"334e0e2553e623fa448d4a7270e45721a94501721c7dc5a8dfafd1c6e7972264","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Ordningsföreskrifter om rätten att färdas och vistas inom naturreserva-\n   tet samt om ordningen i övrigt inom naturreservatet (7 kap 30 §)\nDet är förbjudet att inom naturreservatet:","inledning":"tor bilaga 2 A-F, förbjudet att:","inledning_offset":518,"inledning_sidnummer":4,"punkt":"C.","sidnummer":5,"teckenoffset_pa_sidan":309,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1008161","dokument_namn":"Beslut Fegen med kartor 2010.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008161","dokument_sha256":"334e0e2553e623fa448d4a7270e45721a94501721c7dc5a8dfafd1c6e7972264","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"1. framföra motordriven farkost på sjön Fegen med högre hastighet än 5\n   knop under tiden 1 april – 31 juli, undantag gäller markerat område en-\n   ligt karta 2A;","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":452,"inledning_sidnummer":5,"punkt":"1.","sidnummer":5,"teckenoffset_pa_sidan":495,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordriven","farkost"],"handlingar":["marken"],"dokument_id":"nvdok-1008161","dokument_namn":"Beslut Fegen med kartor 2010.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008161","dokument_sha256":"334e0e2553e623fa448d4a7270e45721a94501721c7dc5a8dfafd1c6e7972264","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4. färdas eller uppehålla sig under tiden 1 april – 31 juli.","inledning":"bilaga 2 A, förbjudet att:","inledning_offset":988,"inledning_sidnummer":5,"punkt":"4.","sidnummer":5,"teckenoffset_pa_sidan":1015,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["färdas"],"handlingar":["marken"],"dokument_id":"nvdok-1008161","dokument_namn":"Beslut Fegen med kartor 2010.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008161","dokument_sha256":"334e0e2553e623fa448d4a7270e45721a94501721c7dc5a8dfafd