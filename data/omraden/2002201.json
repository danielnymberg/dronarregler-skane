an":840,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["beträda"],"handlingar":["marken"],"dokument_id":"nvdok-1021382","dokument_namn":"Biskopso_1986-03-07_andring_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021382","dokument_sha256":"f9e666cb50ad13d1610ef720665f3552e483f87d43a8bfb513c2851f3600c9fa","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Djurlivet inom reservatet är det för ytters-ärgården nor-\nmala, utöver den på 1920-talet inplanterade dovhjortstammen.\nStammen utgörs numera av cirka 40 djur. Huggorm och snok\när vanliga. Fågellivet är rikt med de vanliga arterna sjö-\nfågel såsom ejder, svärta, vigg, skrak och olika mås- och\ntrutfåglar. På de yttre skären häckar grågås. Tordmule och\ntobisgrissla ses regelbundet i reservatet. På de större\nöarna finns orre och om vårarna kan flera sällsynta fågel-\narter observeras då de tillfälligt passeras skärgården.\nGråsäl vistas regelbundet inom reservatet vid Själberget\nsom är skyddat som sälskyddsområde med tillträdesförbud\nunder viss del av året.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":14,"teckenoffset_pa_sidan":893,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","vistas","förbud"],"handlingar":["flyga","landa","lyfta","marken"],"dokument_id":"nvdok-1021382","dokument_namn":"Biskopso_1986-03-07_andring_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021382","dokument_sha256":"f9e666cb50ad13d1610ef720665f3552e483f87d43a8bfb513c2851f3600c9fa","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Dovviltstammen utfodras med 3-4 ton foder under vinter-\nhalvåret. Utfodringen sker på Biskopsön. Tillträdesförbud,\njakt- och fiskeförbud råder inom hela sälskyddsområdet.\nJakt- och fiskeförbudet gäller hela året medan tillträdes-\nförbudet gäller under tiden 1/2 - 15/8.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":15,"teckenoffset_pa_sidan":1025,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["Tillträdesförbud","tillträdes","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1021382","dokument_namn":"Biskopso_1986-03-07_andring_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021382","dokument_sha256":"f9e666cb50ad13d1610ef720665f3552e483f87d43a8bfb513c2851f3600c9fa","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Under våren och sommarens häckningsperiod är fågellivet\nstörningskänsligt, särskilt de mindre öarna och skären.\nInom ett området vid Själberget råder tillträdesförbud\nunder tiden 1/2 - 15/8 (Sälskyddsområde). Området är\nmarkerat på reservatskartan.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":17,"teckenoffset_pa_sidan":224,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["störningskänsligt","häckningsperiod","Sälskyddsområde","förbud"],"handlingar":["flyga","landa","lyfta","marken"],"dokument_id":"nvdok-1021382","dokument_namn":"Biskopso_1986-03-07_andring_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021382","dokument_sha256":"f9e666cb50ad13d1610ef720665f3552e483f87d43a8bfb513c2851f3600c9fa","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Till skydd för djurlivet, främst säl, har ett \"djurskydds-\nområde\" inrättats vid Själberget med tillträdesförbud för\nsåväl markägaren som allmänheten under tiden 1/2 - 15/8.\nFörbudet skall dock inte utgöra hinder mot tillsyn etc i\nenlighet med vad som anges i reservatsbeslutet. (se bilaga 1).","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":19,"teckenoffset_pa_sidan":848,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1021382","dokument_namn":"Biskopso_1986-03-07_andring_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021382","dokument_sha256":"f9e666cb50ad13d1610ef720665f3552e483f87d43a8bfb513c2851f3600c9fa","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"IEC) sopmaja ICD helikopterland-\nningsplats\nInformation","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":21,"teckenoffset_pa_sidan":373,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","traffade_ord":["helikopterland"],"handlingar":["flyga"],"dokument_id":"nvdok-1021382","dokument_namn":"Biskopso_1986-03-07_andring_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021382","dokument_sha256":"f9e666cb50ad13d1610ef720665f3552e483f87d43a8bfb513c2851f3600c9fa","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.69211256,59.09976844],[18.69651972,59.10659502],[18.69652055,59.10659556],[18.72898475,59.11295475],[18.74448862,59.12536017],[18.74448978,59.12536033],[18.74463252,59.12535589],[18.76317006,59.12129697],[18.76317098,59.12129654],[1