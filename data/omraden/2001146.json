{"nvrid":"2001146","slug":"gronskar","namn":"Grönskär","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Värmdö","lan":"Stockholms Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Skärgårdsstiftelsen i Stockholms län","tillsynsmyndighet":null,"urspr_beslutsdatum":"1965-11-08","senaste_gallandedatum":"1965-12-06","area_ha":1.56,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2001146","svarslage":"reglerat-las-beslutet","luftfartslage":"luftfart","ocr":true,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Gronskar_1965-11-08_beslut_NR.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019745","dokument_id":"nvdok-1019745","sha256":"ba3151c2334cdea739d1c2d4865a2079b98159dad6f9ef6ff38cd529299166b2","sidor":3,"ocr":true,"beslutsstatus":"Gällande","fel":null},{"namn":"Gronskar_2004-05-27_ny_foreskrift.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019746","dokument_id":"nvdok-1019746","sha256":"c2a22d7f19ddb01fb01c98e6dd9410650b5394a8176d03000ec1e2ba4bd5f5b5","sidor":6,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet att\nstarta eller landa med luftfartyg.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":571,"klassificering":"start-landningsförbud","konfidens":"hög","traffade_ord":["luftfartyg","starta","landa","förbud"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1019746","dokument_namn":"Gronskar_2004-05-27_ny_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019746","dokument_sha256":"c2a22d7f19ddb01fb01c98e6dd9410650b5394a8176d03000ec1e2ba4bd5f5b5","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Skärgårdsstiftelsen i Stockholms län har hos Länsstyrelsen begärt att en ny\nordningsföreskrift för allmänheten enligt 7 kap. 30 $ miljöbalken införs i de tre\nnaturreservaten Bullerö, Långviksskär och Grönskär. Den föreslagna föreskriften\nskulle gälla förbud mot att starta och landa med luftfarkost inom reservaten.\nMotivet är att förhindra störningar genom buller i områdena, en fråga som bland\nannat tagits upp i Europarådets rapport för Diploma-området Bullerö-Långviks-\nskär. När det gäller Grönskär är syftet främst att minska risken för olyckor.","inledning":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet att","inledning_offset":571,"inledning_sidnummer":1,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":1065,"klassificering":"start-landningsförbud","konfidens":"hög","traffade_ord":["luftfarkost","starta","landa","förbud"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1019746","dokument_namn":"Gronskar_2004-05-27_ny_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019746","dokument_sha256":"c2a22d7f19ddb01fb01c98e6dd9410650b5394a8176d03000ec1e2ba4bd5f5b5","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Arlanda helicopter ombesörjer helikoptertransport vintertid för bofasta. Detta sker\npå Waxholms Ångfartygs AB:s uppdrag. Arlanda helicopter anhåller om dispens\nfrån föreskriften för att kunna sköta dessa transporter.","inledning":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet att","inledning_offset":571,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":495,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"medel","traffade_ord":["helikoptertransport"],"handlingar":["flyga"],"dokument_id":"nvdok-1019746","dokument_namn":"Gronskar_2004-05-27_ny_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019746","dokument_sha256":"c2a22d7f19ddb01fb01c98e6dd9410650b5394a8176d03000ec1e2ba4bd5f5b5","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Viamare sjöflyg motsätter sig ett förbud. Företaget bedriver bl.a. personbefordran\ntill Bullerön och framför bl.a. att flygplanstypen i fråga är miljöanpassad och har\nen låg bullernivå,","inledning":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet att","inledning_offset":571,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":713,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"hög","traffade_ord":["flygplanstypen","förbud"],"handlingar":["flyga"],"dokument_id":"nvdok-1019746","dokument_namn":"Gronskar_2004-05-27_ny_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019746","dokument_sha256":"c2a22d7f19ddb01fb01c98e6dd9410650b5394a8176d03000ec1e2ba4bd5f5b5","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Bullerö och Långviksskärs naturreservat hör till de från naturvårdssynpunkt\nvärdefullaste områdena i Stockholms skärgård. Flygtrafik, i synnerhet med\nhelikopter, är mycket störande från bullersynpunkt, särskilt i samband med start\noch landning. Det finns skäl att i dessa mycket speciella skärgårdsområden\nbegränsa bullret så långt möjligt. Det kan nämnas att hastighetsbegränsning råder\nför båttrafiken i både Bullerö och Långviksskär, vilket också minskar bullret från\nden trafiken. Besökare har god möjlighet att ta sig till områdena med båt istället","inledning":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet att","inledning_offset":571,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":926,"klassificering":"start-landningsförbud","konfidens":"medel","traffade_ord":["helikopter","landning","start"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1019746","dokument_namn":"Gronskar_2004-05-27_ny_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019746","dokument_sha256":"c2a22d7f19ddb01fb01c98e6dd9410650b5394a8176d03000ec1e2ba4bd5f5b5","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[19.02420466,59.27786489],[19.0242043,59.27786416],[19.02420304,59.27786377],[19.02393069,59.2778424],[19.02392965,59.27784246],[19.0232683,59.27806474],[19.02326757,59.2780652],[19.02326749,59.27806579],[19.02326809,59.2780663],[19.02465959,59.27869562],[19.02466103,59.27869573],[19.02608101,59.27851711],[19.02608217,59.27851669],[19.02608244,59.27851597],[19.0258894,59.27800119],[19.02588854,59.27800054],[19.02459608,59.27789552],[19.02459503,59.2778957],[19.02459425,59.27789634],[19.02453985,59.2780602],[19.02415662,59.27803091],[19.02420466,59.27786489]]],[[[19.02742026,59.27948016],[19.02742074,59.27948088],[19.02742169,59.27948118],[19.02865867,59.27964765],[19.0286602,59.27964753],[19.02866095,59.27964707],[19.02919681,59.27897061],[19.02919678,59.27896983],[19.02919567,59.27896931],[19.02782357,59.27871657],[19.02782202,59.27871662],[19.02782105,59.27871724],[19.02742026,59.27948016]]]]},"beraknad_area_ha":1.58,"arealavvikelse_procent":1.44,"bbox":[19.023267,59.277842,19.029197,59.279648]}