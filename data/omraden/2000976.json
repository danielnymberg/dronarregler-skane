del","traffade_ord":["djurlivet","fågelbo","störa"],"dokument_id":"nvdok-1027893","dokument_namn":"Beslut C-föreskrifter_NR Nabben_inkl bil_GDPR_22 okt 2020.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027893","dokument_sha256":"6dbd92c32cab81bfaf36ba51a56bd3631fe263e0c0f671b44a3f76a7981967f5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"9. framföra motordrivet fordon annat än på anvisadevägar och\n        parkeringsplatser","inledning":"författningar skall förbud gälla att:","inledning_offset":1427,"inledning_sidnummer":5,"punkt":"9.","sidnummer":5,"teckenoffset_pa_sidan":2091,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1027893","dokument_namn":"Beslut C-föreskrifter_NR Nabben_inkl bil_GDPR_22 okt 2020.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027893","dokument_sha256":"6dbd92c32cab81bfaf36ba51a56bd3631fe263e0c0f671b44a3f76a7981967f5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Det finns även anledning att förbjuda motordriven cykel annat än på allmän eller\nenskild väg, med hänvisning till skälen ovan.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":2160,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordriven","förbjuda"],"dokument_id":"nvdok-1027893","dokument_namn":"Beslut C-föreskrifter_NR Nabben_inkl bil_GDPR_22 okt 2020.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027893","dokument_sha256":"6dbd92c32cab81bfaf36ba51a56bd3631fe263e0c0f671b44a3f76a7981967f5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskriften att man avsiktligt inte får störa djurlivet omformuleras och specificeras\nså att det gäller att det är förbjudet att störa betesdjuren. För att bevara värdena som\när knutna till reservatet är det viktigt att reservatet betas, och därför är det viktigt\nbesökare inte stör betesdjuren.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":1265,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["djurlivet","störa","stör","förbjudet"],"dokument_id":"nvdok-1027893","dokument_namn":"Beslut C-föreskrifter_NR Nabben_inkl bil_GDPR_22 okt 2020.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027893","dokument_sha256":"6dbd92c32cab81bfaf36ba51a56bd3631fe263e0c0f671b44a3f76a7981967f5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"En reglering införs som gäller flygning med drönare och andra luftfartyg, både\nobemannade och bemannade. Dessa företeelser blir allt vanligare och kan upplevas\nstörande för besökare som söker ostörda naturupplevelser. Lågt flygande\nluftfarkoster över områden med häckande fåglar kan störa fåglarna så att deras\nhäckning spolieras. Dessutom finns det betesdjur som kan bli skrämda inom\nreservatet och det finns därför anledning att reglera motordrivna luftfartyg.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":400,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","traffade_ord":["luftfarkoster","luftfartyg","drönare"],"dokument_id":"nvdok-1027893","dokument_namn":"Beslut C-föreskrifter_NR Nabben_inkl bil_GDPR_22 okt 2020.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027893","dokument_sha256":"6dbd92c32cab81bfaf36ba51a56bd3631fe263e0c0f671b44a3f76a7981967f5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsen anser heller att det inte längre finns behov av föreskriften som gäller\nförbud att framföra motordrivet fordon annat än på anvisad väg eller\nparkeringsplats. Det finns relativt få vägar, parkeringsplatser eller möjlighet att\nkomma in med obehöriga fordon i betesmarken, därför anser inte Länsstyrelsen att\ndet finns anledning att förbjuda motorfordonstrafik, eller parkering, då\nterrängkörning är reglerad i annan lagstiftning (terrängkörningslagen), därför tas\ntidigare föreskrift bort.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":864,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motorfordonstrafik","motordrivet","fordon","förbud"],"dokument_id":"nvdok-1027893","dokument_namn":"Beslut C-föreskrifter_NR Nabben_inkl bil_GDPR_22 okt 2020.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027893","dokument_sha256":"6dbd92c32cab81bfaf36ba51a56bd3631fe263e0c0f671b44a3f76a7981967f5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Regleringar av cykling och av motordriven cykling är nya för naturreservatet.\nFörbuden mot att medföra okopplad hund, köra vattenskoter samt att flyga\nluftfartyg som drönare är nya föreskrifter för naturreservatet.","inledning":"förbud att framföra motordrivet fordon annat än på anvisad väg eller\nparkeringsplats. Det finns relativt få vägar, parkeringsplatser eller möjlighet att","inledning_offset":952,"inledning_sidnummer":9,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":2776,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"hög","traffade_ord":["luftfartyg","drönare","Förbuden"],"dokument_id":"nvdok-1027893","dokument_namn":"Beslut C-föreskrifter_NR Nabben_inkl bil_GDPR_22 okt 2020.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027893","dokument_sha256":"6dbd92c32cab81bfaf36ba51a56bd3631fe263e0c0f671b44a3f76a7981967f5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Naturskyddsföreningen framför också att ovanstående givetvis ska ses mot bakgrund av\natt ”naturupplevelse” idag inte är lika med stillsam promenad och kaffekorg i kanten av\nstigen. Naturen har blivit en arena. De poängterar att Länsstyrelsen givetvis inte är\nobekant med denna utveckling med mountainbike, klättring, hang-gliding,\ndrönarflygning, allehanda flytetyg m fl aktiviteter. De hävdar också att det är extra\nviktigt att i reservatföreskrifter och tillsyn ha med detta perspektiv.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":18,"teckenoffset_pa_sidan":305,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","traffade_ord":["drönarflygning"],"dokument_id":"nvdok-1027893","dokument_namn":"Beslut C-föreskrifter_NR Nabben_inkl bil_GDPR_22 okt 2020.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027893","dokument_sha256":"6dbd92c32cab81bfaf36ba51a56bd3631fe263e0c0f671b44a3f76a7981967f5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4. avsiktligt störa djurlivet t ex genom närgången foto-\ngrafering av fågelbo","inledning":"fattningar skall förbud gälla att","inledning_offset":288,"inledning_sidnummer":5,"punkt":"4.","sidnummer":5,"teckenoffset_pa_sidan":538,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurlivet","fågelbo","störa"],"dokument_id":"nvdok-1010256","dokument_namn":"Nabbens naturreservat BESLUT och SKÖTSELPLAN 1994 Webb.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010256","dokument_sha256":"3ff69fdcd88223cb63bef8973ff7ffab595eafca86d59bdbeb2913b4d16690e4","ocr":true,"verifierad":true,"verifie