dokument/1025640","orsak":"namnet matchar inget föreskriftsmönster"},{"namn":"Langviksskar_1983-12-22_beslut_skotselplan.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025639","orsak":"ej föreskriftsbärande dokumenttyp"},{"namn":"Langviksskar_2022-03-16_byte_forvaltare_utan_sandlista.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027832","orsak":"namnet matchar inget föreskriftsmönster"}],"citat":[{"citat":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet att\nstarta eller landa med luftfartyg.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":562,"klassificering":"start-landningsförbud","konfidens":"hög","dokument_id":"nvdok-1010889","dokument_namn":"Langviksskar_2004-05-27_ny_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010889","dokument_sha256":"bd9f69a39d4fc21a300f7958713a478644015df00df87234475b2055bfae8bc1","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Skärgårdsstiftelsen i Stockholms län har hos Länsstyrelsen begärt att en ny\nordningsföreskrift för allmänheten enligt 7 kap. 30 $ miljöbalken införs i de tre\nnaturreservaten Bullerö, Långviksskär och Grönskär. Den föreslagna föreskriften\nskulle gälla förbud mot att starta och landa med luftfarkost inom reservaten.\nMotivet är att förhindra störningar genom buller i områdena, en fråga som bland\nannat tagits upp i Europarådets rapport för Diploma-området Bullerö-Långviks-\nskär. När det gäller Grönskär är syftet främst att minska risken för olyckor.","inledning":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet att","inledning_offset":562,"inledning_sidnummer":1,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":1058,"klassificering":"start-landningsförbud","konfidens":"hög","dokument_id":"nvdok-1010889","dokument_namn":"Langviksskar_2004-05-27_ny_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010889","dokument_sha256":"bd9f69a39d4fc21a300f7958713a478644015df00df87234475b2055bfae8bc1","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Arlanda helicopter ombesörjer helikoptertransport vintertid för bofasta. Detta sker\npå Waxholms Ångfartygs AB:s uppdrag. Arlanda helicopter anhåller om dispens\nfrån föreskriften för att kunna sköta dessa transporter.","inledning":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet att","inledning_offset":562,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":492,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"medel","dokument_id":"nvdok-1010889","dokument_namn":"Langviksskar_2004-05-27_ny_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010889","dokument_sha256":"bd9f69a39d4fc21a300f7958713a478644015df00df87234475b2055bfae8bc1","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Viamare sjöflyg motsätter sig ett förbud. Företaget bedriver bl.a. personbefordran\ntill Bullerön och framför bl.a. att flygplanstypen i fråga är miljöanpassad och har\nen låg bullernivå.","inledning":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet att","inledning_offset":562,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":710,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"hög","dokument_id":"nvdok-1010889","dokument_namn":"Langviksskar_2004-05-27_ny_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010889","dokument_sha256":"bd9f69a39d4fc21a300f7958713a478644015df00df87234475b2055bfae8bc1","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Bullerö och Långviksskärs naturreservat hör till de från naturvårdssynpunkt\nvärdefullaste områdena i Stockholms skärgård. Flygtrafik, i synnerhet med\nhelikopter, är mycket störande från bullersynpunkt, särskilt i samband med start\noch landning. Det finns skäl att i dessa mycket speciella skärgårdsområden\nbegränsa bullret så långt möjligt. Det kan nämnas att hastighetsbegränsning råder\nför båttrafiken i både Bullerö och Långviksskär, vilket också minskar bullret från\nden trafiken. Besökare har god möjlighet att ta sig till områdena med båt istället","inledning":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet att","inledning_offset":562,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":923,"klassificering":"start-landningsförbud","konfidens":"medel","dokument_id":"nvdok-1010889","dokument_namn":"Langviksskar_2004-05-27_ny_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010889","dokument_sha256":"bd9f69a39d4fc21a300f7958713a478644015df00df87234475b2055bfae8bc1","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C14. framföra båt i lagunen på Tärnskär, se bifogad karta.","inledning":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet\n             att","inledning_offset":940,"inledning_sidnummer":1,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":1048,"klassificering":"annat-läs-beslutet","konfidens":"medel","dokument_id":"nvdok-1010891","dokument_namn":"Langviksskar_2007-07-03_ny_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010891","dokument_sha256":"80b521cb6740f9a0a001462a5a73caf69937b2c49517c175c095a60447d50d0f","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Bakgrund\n             Skärgårdsstiftelsen i Stockholms län har hos Länsstyrelsen begärt att båttrafik\n             förbjuds i lagunen på Tärnskär. Det har på senare år blivit ett problem att båtar\n             körs med motor eller ankrar i den trånga viken, vilket får ses som helt olämpligt\n             för den marina miljön. Lagunen är en mycket populär badplats. Konflikter uppstår\n             och ankare och linor kan också vara en säkerhetsrisk på de grunda vattnen.","inledning":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet\n             att","inledning_offset":940,"inledning_sidnummer":1,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":1250,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1010891","dokument_namn":"Langviksskar_2007-07-03_ny_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010891","dokument_sha256":"80b521cb6740f9a0a001462a5a73caf69937b2c49517c175c095a60447d50d0f","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.80145603,59.14673438],[18.79947043,59.14564582],[18.79946943,59.14564573],[18.79741225,59.14573264],[18.79741122,59.14573284],[18.79741074,59.14573313],[18.79741049,59.14573368],[18.79753624,59.14686753],[18.79672547,59.14784167],[18.79671009,59.14821917],[18.79671064,59.14821969],[18.79794642,59.14883553],[18.80028232,59.14907718],[18.80028312,59.14907708],[18.80240379,59.14855537],[18.80286277,59.14823241],[18.80286313,59.1482319],[18.8030265,59.14713864],[18.80302627,59.14713828],