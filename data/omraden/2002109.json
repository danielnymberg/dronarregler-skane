erifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"En förutsättning för att mångformigheten skall behållas är bl. a. att\nskogsbruk inte bedrivs på myrholmar eller i anslutande skogsmark. En\nannan är att de hydrologiska förutsättningarna förblir opåverkade. Det\nrika fågellivet ute på myrplanet är känsligt för störningar. Området\nmåste därför skyddas som naturreservat. Hästingsflottens västra delar\nskyddades som reservat 1992. Detta beslut fullföljer skyddet av","inledning":"Utöver vad som för övrigt gäller är det förbjudet att","inledning_offset":704,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1363,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1014846","dokument_namn":"Hästingsflottens_Beslut_20011217.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014846","dokument_sha256":"c7722fc9127c084a5a43d60e07a71f80ef9ca7a590ab83fbda26dacd1f907de1","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Turismen får inte medföra slitage på de naturvärden som finns i\nområdet. Fågellivet ute på myrplanet är känslig för störningar.\nEftersom framkomligheten är begränsad i större delen av området\nkommer slitaget naturligt vara begränsat till vandringsleder och övriga\nanläggningar. Ytterligare vandringsleder bör inte anläggas i området.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":14,"teckenoffset_pa_sidan":1048,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1014846","dokument_namn":"Hästingsflottens_Beslut_20011217.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014846","dokument_sha256":"c7722fc9127c084a5a43d60e07a71f80ef9ca7a590ab83fbda26dacd1f907de1","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter