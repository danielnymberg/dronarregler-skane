,"punkt":"B.","sidnummer":3,"teckenoffset_pa_sidan":1164,"klassificering":"start-landningsförbud","konfidens":"hög","traffade_ord":["luftfarkost","landa","förbud"],"handlingar":["flyga","landa","lyfta","marken"],"dokument_id":"nvdok-1035564","dokument_namn":"Skuleskogen Föreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1035564","dokument_sha256":"84d76ed291047d26c100587310f2c85439003bc5490cc5820fa5c7a22b11f230","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"A. Syftet med förvaltningen\n     Nationalparken skall förvaltas så att mark, vatten, vegetation och djurliv i\nprincip lämnas till fri utveckling. Den skall genom lämpliga åtgärder göras\ntillgänglig för allmänheten inom attraktiva partier under förutsättning att\nnaturvärden inte skadas. Inom nationalparkens övriga delar skall slitage och\nstörningar undvikas. Inom ramen för syftet får nationalparken nyttjas för\nforskning och undervisning.","inledning":"Utöver förbud och föreskrifter i lagar och andra författningar skall förbud\ngälla att","inledning_offset":1200,"inledning_sidnummer":3,"punkt":"A.","sidnummer":4,"teckenoffset_pa_sidan":91,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["störningar","djurliv"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1035564","dokument_namn":"Skuleskogen Föreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1035564","dokument_sha256":"84d76ed291047d26c100587310f2c85439003bc5490cc5820fa5c7a22b11f230","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc"