vikas, men om de uppstår ska\n       de återställas så fort som möjligt, dock senast inom 3 månader.\n\n\n\n\n1\n Vid drift, underhåll och akuta reparationer får motordrivna maskiner och fordon köras och parkeras i, till och från\nledningsgatan. Träd och buskar får fällas och beskäras i ledningsgatan i den utsträckning som krävs för elsäkerheten.","inledning":"Dessutom är det förbjudet att utan Länsstyrelsens tillstånd:","inledning_offset":405,"inledning_sidnummer":4,"punkt":"d)","sidnummer":4,"teckenoffset_pa_sidan":1406,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivna","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1028659","dokument_namn":"joastorp beslut med bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028659","dokument_sha256":"449ead7c4ffa4519535880c59782b905145e6e775b678c325b25c7e0ced327ae","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"1 § terrängkörningslagen (1975:1313) och terrängkörningsförordningen\n(1978:594)\nKörning i terräng med motordrivet fordon för annat ändamål än jordbruk eller\nskogsbruk är, med vissa undantag, förbjuden.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":10,"teckenoffset_pa_sidan":573,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1028659","dokument_namn":"joastorp beslut med bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028659","dokument_sha256":"449ead7c4ffa4519535880c59782b905145e6e775b678c325b25c7e0ced327ae","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Yrkanden\n   Att det i undantagen från föreskrifter framgår att:\n   - Normalt underhåll omfattas av akut och skogligt underhåll\n   - Tillåter motordrivna maskiner i, till och från ledningsstråket, även innefattande parkering av\n   fordon\n   - Akuta åtgärder får ske men att samråd/meddelande till Länsstyrelsen kan ske i efterhand\n   - Det ska framgå i föreskrifterna att förändring av elnätet får tillståndsprövas\n   - Toppning och beskärning utanför skogsgatan inte ska vara tillståndspliktigt\n   - Drönare är tillåtet vid ledning vid besiktning","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":45,"teckenoffset_pa_sidan":599,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","traffade_ord":["Drönare"],"handlingar":["flyga","marken"],"dokument_id":"nvdok-1028659","dokument_namn":"joastorp beslut med bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028659","dokument_sha256":"449ead7c4ffa4519535880c59782b905145e6e775b678c325b25c7e0ced327ae","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Det finns inget förbud mot att flyga drönare.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":46,"teckenoffset_pa_sidan":2638,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"hög","traffade_ord":["drönare","förbud"],"handlingar":["flyga"],"dokument_id":"nvdok-1028659","dokument_namn":"joastorp beslut med bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028659","dokument_sha256":"449ead7c4ffa4519535880c59782b905145e6e775b678c325b25c7e0ced327ae","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatu