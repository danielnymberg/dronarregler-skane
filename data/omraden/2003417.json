{"nvrid":"2003417","slug":"drags-udde-2003417","namn":"Drags udde","skyddstyp":"Djur- och växtskyddsområde","lager":"djur-och-vaxtskydd","karnlager":true,"kommun":"Vetlanda","lan":"Jönköpings Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Jönköpings län","tillsynsmyndighet":null,"urspr_beslutsdatum":"1995-12-21","senaste_gallandedatum":"1995-12-21","area_ha":7.89,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2003417","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":true,"foreskriftsomraden":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"15/8"}],"sasongsdata":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"15/8"}],"dokument":[{"namn":"0609025_Drags udde.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040766","dokument_id":"nvdok-1040766","sha256":"ce6e8a8ddc4d4df4d1e0b3645b1c9d673ce1376443a754d92ddf29ec4ca3ab1b","sidor":4,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"å\nNr\nMIN BESLUT 1 (3)\n\n1995-12-21 231-362-91\nLÄN: Jfr 231-2342-95\nISSTYRELSEN - OM ;\nJÖNKÖPINGS LÄN [NA DT (ÖVA I08\nSe sändlista\n\nAngående ansökan om bildande av fågelskyddsområde inom\ndel av Drags udde naturreservat i Karlstorps försam-\nling, Vetlanda kommun\n\nLÄNSSTYRELSENS AVGÖRANDE\n\nMed stöd av 14 b 8 naturvårdslagen (1964:822, NVL) och\n15 & naturvårdsförordningen (1976:484, NVF) meddelar\nLänsstyrelsen förbud att under tiden den\n\n1 april - den 15 augusti inom det område vid Drags udde\nsom punktmarkerats på bifogad karta (bilaga 1)","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":0,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelskyddsområde","storps","förbud"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1040766","dokument_namn":"0609025_Drags udde.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040766","dokument_sha256":"ce6e8a8ddc4d4df4d1e0b3645b1c9d673ce1376443a754d92ddf29ec4ca3ab1b","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"har beretts tillfälle att yttra sig angående ansökan.\nAssi Domän har inget att erinra mot ett eventuellt få-\ngelskyddsområde inom reservatet. Vetlanda kommun, Mil-\njö- och hälsoskyddskontoret, bedömer att ett fågel-\nskyddsområde inom den del av reservatet som föreningar-\nna föreslagit skulle ge ett gott skydd för de häckande\nfåglarna utan alltför stora inskränkningar i det rör-\nliga friluftslivet inom området. Beträdelseförbud mel-\nlan den 1 april - den 15 augusti bedöms som rimligt.\nFlens fiskevårdsområdesförening stödjer förslaget men\nvill gärna se att ett bildande av fågelskyddsområde in-\nte tar bort möjligheten att fiska kräftor inom området\nunder första halvan av augusti månad.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":76,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelskyddsområde","fåglarna","stora","förbud"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1040766","dokument_namn":"0609025_Drags udde.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040766","dokument_sha256":"ce6e8a8ddc4d4df4d1e0b3645b1c9d673ce1376443a754d92ddf29ec4ca3ab1b","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Enligt 14 b $ NVL får länsstyrelsen om det behövs sär-\nskilt skydd för en djurart inom ett visst område med-\ndela föreskrifter som inskränker allmänhetens eller\nmarkägarens rätt att uppehålla sig inom området. Av 15\n$ NVF framgår att föreskrifterna får avse förbud att\nfärdas eller uppehålla sig inom området, landa med båt\neller annan farkost, jaga eller medföra jaktredskap el-\nler hund, fiska, bortföra eller skada ägg, rom eller\nbon, ofreda djur genom fotografering eller liknande åt-\ngärd. Om inte något annat föreskrivs, gäller förbud som\navses i punkt 1 eller 2 inte markinnehavaren eller hans\nfolk och inte heller statliga eller kommunala tjänste-\nmän i tjänsteärende.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":971,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["farkost","förbud"],"handlingar":["flyga","landa","lyfta","marken"],"dokument_id":"nvdok-1040766","dokument_namn":"0609025_Drags udde.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040766","dokument_sha256":"ce6e8a8ddc4d4df4d1e0b3645b1c9d673ce1376443a754d92ddf29ec4ca3ab1b","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[15.58455655,57.49299015],[15.58361508,57.4926351],[15.5836139,57.49263492],[15.58329198,57.49264695],[15.58284158,57.49273117],[15.5822854,57.49304233],[15.58205852,57.49338721],[15.58205845,57.49338772],[15.58222716,57.49388004],[15.58266152,57.49421921],[15.5832428,57.49437224],[15.58324359,57.49437234],[15.58342136,57.49437317],[15.58393066,57.49431205],[15.58535188,57.49441013],[15.58535266,57.49440999],[15.58588062,57.49423529],[15.58643695,57.49437009