 aktualiserats.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":457,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":2321,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["större","störs","stor"],"dokument_id":"nvdok-1016336","dokument_namn":"Ballekvare_Beslut_110428.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016336","dokument_sha256":"4c8f25b4610592e6dd4bfb258df8a1713bac65bd1a3af392c179762757ec1742","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.89650035,66.12090521],[18.89281715,66.12632255],[18.89149188,66.12804771],[18.89149201,66.12804843],[18.89149332,66.12804892],[18.90109809,66.12956607],[18.91148207,66.13117594],[18.91447377,66.13310312],[18.91447466,66.13310336],[18.91558197,66.13326872],[18.9140121,66.1336518],[18.91199755,66.13402494],[18.91199641,66.13402537],[18.911594,66.1346058],[18.91096179,66.13553216],[18.91068669,66.13760622],[18.91020172,66.13796026],[18.91020144,66.13796086],[18.91079721,66.13835313],[18.91198264,66.13884966],[18.91192789,66.13967193],[18.91192846,66.13967259],[18.91427786,66.14080946],[18.9167037,66.14146071],[18.91528557,66.14270887],[18.91528593,66.14270943],[18.91528699,66.14270981],[18.91686423,66.14300446],[18.91686514,66.14300441],[18.91686625,66.14300409],[18.92268571,66.14010015],[18.92353181,66.14082581],[18.92353318,66.14082632],[18.92353503,66.14082629],[18.92919637,66.13916835],[18.92919699,66.1391676],[18.92919641,