3","dokument_sha256":"cf9d6ba2a0b034e934838860f786f19c8d624dec1bb156fceac994d911cd6260","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"5. framföra motorfordon\n\nFöreskriften C3 utgör inte hinder för röjning av befintliga jaktpass under förutsättning att inte\nnaturvärden påverkas negativt och att åtgärden sker i samråd med reservatsförvaltaren.\nFöreskriften C5 utgör inte hinder för uttransport av fällt vilt enligt terrängkörningsförordningen\n(1975:594 1§) under förutsättning att fordon med lågt marktryck (t ex älgdragare, järnhäst, eller\nfyrhjuling) används så att skador på mark och vegetation inte orsakas. C5 utgör inte heller något\nhinder för framförande av snöskoter på markerad skoterled.\nI samband med vetenskapliga undersökningar kan Länsstyrelsen meddela undantag från\nordningsföreskrifterna under C.","inledning":"Utöver vad som annars gäller i lagar och författningar är det i naturreservatet förbjudet att:","inledning_offset":1732,"inledning_sidnummer":2,"punkt":"5.","sidnummer":2,"teckenoffset_pa_sidan":2295,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motorfordon","fordon","undantag från"],"handlingar":["marken"],"dokument_id":"nvdok-1014673","dokument_namn":"Beslut Krokolaknölen.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014673","dokument_sha256":"cf9d6ba2a0b034e934838860f786f19c8d624dec1bb156fceac994d911cd6260","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Ordningsföreskrifter enligt 7 kap. 30 § miljöbalken om rätten\n              att färdas och vistas i, samt om ordningen i reservatet i övrigt\n              (gäller även markägare och innehavare av särskild rätt).\n              Utöver vad som annars gäller i lagar och författningar är det i\n              naturreservatet förbjudet att:\n              1. samla in ryggradslösa djur, t ex insekter, snäckor och fjärilar\n              2. samla in mossor, lavar och vedsvampar\n              3. skada eller ta bort träd och buskar, inklusive död ved såsom lågor,\n              torrträd och torra grenar, samt skada eller ta bort döda träd eller\n              träddelar\n              4.","inledning":"naturreservatet förbjudet att:","inledning_offset":292,"inledning_sidnummer":2,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":947,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1027293","dokument_namn":"beslut om föreskriftsändring 2024-03-25.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027293","dokument_sha256":"c3af50c7f2f1aa1af9c73114ccc2b14c8dc878d49239009a7657038852ba3bfe","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[12.60792684,60.80081642],[12.60689656,60.80150777],[12.6068962,60.8015085],[12.60689699,60.80150914],[12.60689809,60.80150934],[12.60795133,60.8015382],[12.6110931,60.80164144],[12.61109434,60.80164128],[12.61109495,60.80164098],[12.61122695,60.80153831],[12.61134222,60.80148732],[12.61143555,60.80147151],[12.61164581,60.80148542],[12.61187114,60.80143696],[12.61196265,60.80143914],[12.61205187,60.80146819],[12.61218013,60.80147123],[12.61242396,60.80142317],[12.61261637,60.80142775],[12.61276958,60.80145836],[12.61284319,60.80146016],[12.61292644,60.80145306],[12.61304096,60.8014109],[12.6130775,60.80141178],[12.6131493,60.8014314