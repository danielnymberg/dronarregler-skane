n":1894,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","Förbudet"],"dokument_id":"nvdok-1024135","dokument_namn":"sällevadsåns dalgång beslut utökning mm inkl. karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024135","dokument_sha256":"b35e52897a7e6765d9b870e12e4fc48a284ab2b943db68fd4f35a924f9c080da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. FÖRESKRIFTER ENLIGT 7 KAP. 30 § MB OM\n                      RÄTTEN ATT FÄRDAS OCH VISTAS INOM\n                      NATURRESERVATET SAMT OM ORDNINGEN I\n                      ÖVRIGT INOM NATURRESERVATET\n              Inom naturreservatet är det förbjudet att","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":1364,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["FÄRDAS","VISTAS","förbjudet"],"dokument_id":"nvdok-1024135","dokument_namn":"sällevadsåns dalgång beslut utökning mm inkl. karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024135","dokument_sha256":"b35e52897a7e6765d9b870e12e4fc48a284ab2b943db68fd4f35a924f9c080da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"vattendraget Sällevadsån även skog på båda sidor av länsgränsen.\n              Området är kuperat och varierat med flera olika skogstyper och en\n              stor mångfald av ovanliga och rödlistade arter. Vattendraget har\n              höga naturvärden och hyser bland annat livskraftiga bestånd av\n              flodpärlmussla och utter. Hela åsträckan utgörs av ett naturligt\n              vattendrag och i anslutning till ån identifieras bland annat örtrika\n              bäckdråg, källpåverkade översilningsmarker, gransumpskog,\n              bergbranter och hällmarkstallskog.","inledning":"Inom naturreservatet är det utan Länsstyrelsens tillstånd förbjudet\n              att:","inledning_offset":272,"inledning_sidnummer":7,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":204,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["Sällevadsån","stor"],"dokument_id":"nvdok-1024135","dokument_namn":"sällevadsåns dalgång beslut utökning mm inkl. karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024135","dokument_sha256":"b35e52897a7e6765d9b870e12e4fc48a284ab2b943db68fd4f35a924f9c080da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Beskrivning av ärendet\n              Länsstyrelsen beslutade den 15 november 1999 om bildande av\n              naturreservatet Sällevadsåns dalgång. Under 2018 påbörjades\n              arbetet med att utöka naturreservatet i samband med en\n              avverkningsanmälan. I samband med avverkningsanmälan\n              avgränsades ett 5 ha stort område. Efter 2018 har ytterligare skog","inledning":"Inom naturreservatet är det utan Länsstyrelsens tillstånd förbjudet\n              att:","inledning_offset":272,"inledning_sidnummer":7,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":2862,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["Sällevadsåns","stort"],"dokument_id":"nvdok-1024135","dokument_namn":"sällevadsåns dalgång beslut utökning mm inkl. karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024135","dokument_sha256":"b35e52897a7e6765d9b870e12e4fc48a284ab2b943db68fd4f35a924f9c080da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Grannen är positiv till det nya förslaget i stort. De är kritiska till att\n              det är förbjudet att paddla kanot eller använda annan farkost. De\n              tycker att det kan vara förbjudet att framföra motorbåt men inte båt\n              med muskelkraft. De efterlyser också hur länsstyrelsen ska ta hand\n              om kvicksilverbelastningen vid Flenshults kvarn och ån nedströms.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":11,"teckenoffset_pa_sidan":808,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["farkost","förbjudet"],"dokument_id":"nvdok-1024135","dokument_namn":"sällevadsåns dalgång beslut utökning mm inkl. karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024135","dokument_sha256":"b35e52897a7e6765d9b870e12e4fc48a284ab2b943db68fd4f35a924f9c080da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Det är sedan beslutet om bildande av naturreservatet togs 1999\n              förbjudet att paddla kanot eller framföra annan farkost i ån. Det är\n              ett viktigt syfte med naturreservatet att bevara vattendraget med\n              dess biologiska mångfald med bland annat flodpärlmussla och öring.\n              När det är lågt vatten i ån skulle en kanot kunna skrapa i botten och\n              riskera att skada flodpärlmusslor. Länsstyrelsen ser därför att det\n              saknas synnerliga skäl att upphäva förbudet mot att paddla kanot\n              eller framföra annan farkost i ån.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":11,"teckenoffset_pa_sidan":1859,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["farkost","förbjudet"],"dokument_id":"nvdok-1024135","dokument_namn":"sällevadsåns dalgång beslut utökning mm inkl. karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024135","dokument_sha256":"b35e52897a7e6765d9b870e12e4fc48a284ab2b943db68fd4f35a924f9c080da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I beslutet från 1999 framgår det i föreskrifterna att det är tillåtet att\n              framföra motorfordon på befintliga vägar som finns i\n              naturreservatet. Två länsvägar och en mindre grusväg passerar\n              igenom det ursprungliga naturreservatet och dessutom finns det\n              några grusvägar och brukningsvägar som sträcker sig in i\n              naturreservatet. I beslutet saknas undantag i föreskrifterna för att få\n              underhålla dessa vägar. Länsstyrelsens bedömning är att man i\n              beslutet har missat att skriva in ett sådant undantag. Det rättas till i\n              detta beslut.","inledning":"Föreskrifterna enligt 8 § och 10 § naturvårdslagen om förbud mot att","inledning_offset":661,"inledning_sidnummer":14,"punkt":null,"sidnummer":14,"teckenoffset_pa_sidan":1222,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motorfordon"],"dokument_id":"nvdok-1024135","dokument_namn":"sällevadsåns dalgång beslut utökning mm inkl. karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024135","dokument_sha256":"b35e52897a7e6765d9b870e12e4fc48a284ab2b943db68fd4f35a924f9c080da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Upphävande av C-föreskrifter\n              Antalet föreskrifter enligt 10 § naturvårdslagen om vad allmänheten\n              har att iaktta inom naturreservatet har minskats ner. Föreskrifterna\n              C1, C4 och C5, enligt beslutet från 1999, om förbud mot att framföra","inledning":"Föreskrifterna enligt 8 § och 10 § naturvårdslagen om förbud mot att","inledning_offset":661,"inledning_sidnummer":14,"punkt":null,"sidnummer":15,"teckenoffset_pa_sidan":2883,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["framföra","förbud"],"dokument_id":"nvdok-1024135","dokument_namn":"sällevadsåns dalgång beslut utökning mm inkl. karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024135","dokument_sha256":"b35e52897a7e6765d9b870e12e4fc48a284ab2b943db68fd4f35a924f9c080da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"motordrivet fordon annat än på anvisad väg och parkeringsplats,\n              förbud mot att störa djurlivet med mera samt förbud mot att\n              medföra okopplad hund bedöms som onödig dubbelreglering då\n              annan lagstiftning reglerar detta. Förbuden mot att tälta eller elda\n              annat än på anvisad plats, föreskrift C3 och C7 enligt beslutet från\n              1999, bedöms som en omotiverad inskränkning av friluftslivet.\n              Förbudet mot att elda annat än på anvisad plats ändras till förbud\n              mot att elda med annat än medhavd ved.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":16,"teckenoffset_pa_sidan":205,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbud"],"dokument_id":"nvdok-1024135","dokument_namn":"sällevadsåns dalgång beslut utökning mm inkl. karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024135","dokument_sha256":"b35e52897a7e6765d9b870e12e4fc48a284ab2b943db68fd4f35a924f9c080da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Enligt 7 kap. 5 § MB ska i ett beslut om att bilda naturreservat skälen\n              för beslutet anges. I beslutet ska också anges de inskränkningar i\n              rätten att använda mark- och vattenområden som behövs för att\n              uppnå syftet med naturreservatet, såsom förbud mot bebyggelse,\n              uppförande av stängsel, upplag, schaktning, täkt, uppodling, dikning,\n              plantering, avverkning, jakt, fiske och användning av\n              bekämpningsmedel. En inskränkning får innebära att tillträde till\n              området förbjuds under hela eller delar av året.","inledning":"förbud mot att störa djurlivet med mera samt förbud mot att","inledning_offset":284,"inledning_sidnummer":16,"punkt":null,"sidnummer":17,"teckenoffset_pa_sidan":865,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträde","förbud"],"dokument_id":"nvdok-1024135","dokument_namn":"sällevadsåns dalgång beslut utökning mm inkl. karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024135","dokument_sha256":"b35e52897a7e6765d9b870e12e4fc48a284ab2b943db68fd4f35a924f9c080da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"2. bereds tillträde till mark för allmänheten där allmänheten annars\n              inte har rätt att vistas,","inledning":"förbud mot att störa djurlivet med mera samt förbud mot att","inledning_offset":284,"inledning_sidnummer":16,"punkt":null,"sidnummer":17,"teckenoffset_pa_sidan":1940,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["tillträde","vistas"],"dokument_id":"nvdok-1024135","dokument_namn":"sällevadsåns dalgång beslut utökning mm inkl. karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024135","dokument_sha256":"b35e52897a7e6765d9b870e12e4fc48a284ab2b943db68fd4f35a924f9c080da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geome