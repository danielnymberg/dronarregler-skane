{"nvrid":"2003415","slug":"vissa-oar-i-forsjon","namn":"Vissa öar i Försjön","skyddstyp":"Djur- och växtskyddsområde","lager":"djur-och-vaxtskydd","karnlager":true,"kommun":"Eksjö","lan":"Jönköpings Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Jönköpings län","tillsynsmyndighet":null,"urspr_beslutsdatum":"1977-02-28","senaste_gallandedatum":"1978-03-28","area_ha":4.75,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2003415","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":true,"foreskriftsomraden":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"1/8"}],"sasongsdata":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"1/8"}],"dokument":[{"namn":"0609020_Försjön öar_beslut2och1.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040787","dokument_id":"nvdok-1040787","sha256":"05b261b948fe5a72e2a818590e942512995288172230ed072bb9fac68d526eac","sidor":5,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Rävebergs Jaktvårdsområde = har hemställt att förbud utfärdas\n\"Matt under tiden 1 april - 1 augusti dels landa med båt eller\nannan farkost på de öar i Försjön, som utmärkts å bifogade\nkarta samt dels färdas eller uppehålla sig inom område som\nutnärkts å bifogade karta\" (bilaga 1). Som skäl för framställ-\nningen har jaktvårdsområdet anfört att fiskgjuse häckar inom\nområdet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":246,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["farkost","förbud"],"handlingar":["landa","lyfta","marken"],"dokument_id":"nvdok-1040787","dokument_namn":"0609020_Försjön öar_beslut2och1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040787","dokument_sha256":"05b261b948fe5a72e2a818590e942512995288172230ed072bb9fac68d526eac","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"\"I södra hälften av sjön häckar enligt uppgift fiskgjuse på\nDuvö och på det lilla näset omedelbart öster om Tällås. Enligt\nförslaget skulle åen stora ön i sjöns syddel, där gjushäckning\nnumera upphört, beläggas med tillträdesförbud under sommar-\nperioden. Ön är belägen ca 100 m från ett sommarstugeområde och\nmåste på nära håll passeras med båt av besökare på väg till\neller från bad- och campingplatsen vid Movänta. Naturvårdsverket\nifrågasätter därför möjligheterna att på denna plats skapa\nförutsättningar för framgångsrika fiskgjusehäckningar.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":937,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["häckningar","häckning","stora","förbud"],"handlingar":["flyga","landa","lyfta","marken"],"dokument_id":"nvdok-1040787","dokument_namn":"0609020_Försjön öar_beslut2och1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040787","dokument_sha256":"05b261b948fe5a72e2a818590e942512995288172230ed072bb9fac68d526eac","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[15.11816717,57.66738214],[15.11779438,57.66739598],[15.11751714,57.6674640