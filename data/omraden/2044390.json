rden och inägan utgör ett ovanligt välbevarat exempel på lövängsbruk.\n      Området uppmärksammades redan på 1970-talet tack vare dess rika vegetation\n      som inkluderar en lång rad sällsynta arter, t.ex. smörbollar, brudsporre, granspira\n      och slåttergubbe. Här finns även ett större antal värdefulla hagmarksträd, varav","inledning":"Utöver vad som annars gäller i lagar och författningar är det i naturreservatet\n      förbjudet att:","inledning_offset":1054,"inledning_sidnummer":3,"punkt":"B3.","sidnummer":4,"teckenoffset_pa_sidan":2065,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sällsynta","större"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1018130","dokument_namn":"Tegen slutligt beslut med bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1018130","dokument_sha256":"e13e9cd03fa489b224fc4c317abe70b0050a0bffb9c9b458a92145c7117164de","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[12.18844471,59.28927305],[12.19158302,59.28868839],[12.19158379,59.28868812],[12.19178105,59.28857559],[12.19208137,59.28825379],[12.19213377,59.28816302],[12.19213017,59.2880436],[12.19212184,59.28798139],[12.19213739,59.2879015],[12.19213243,59.28785308],[12.19214979,59.2878053],[12.19213108,59.28772765],[12.19219535,59.28763463],[12.19216793,59.2875853],[12.19209287,59.28746207],[12.19207798,59.28742504],[12.19219636,59.28729447],[12.19219958,59.28709257],[12.19222084,59.28698246],[12.19248469,59.28689016],[12.19248517,59.28688991],[12