servatet är det förbjudet att","inledning_offset":665,"inledning_sidnummer":7,"punkt":"12.","sidnummer":8,"teckenoffset_pa_sidan":236,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["fordon"],"dokument_id":"nvdok-1047485","dokument_namn":"kyrkhamn-riddersviks_naturreservat_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047485","dokument_sha256":"28f74e3c61251305f355cb8614b643e307d408750b0fc641b8235f66d8a1b930","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Ordningsföreskrifter med stöd av 7 kap. 30 §\n   miljöbalken om rätten att färdas och vistas inom\n   naturreservatet\n\nFöreskrifter under punkt C gäller såväl allmänheten som markägare\noch innehavare av särskild rätt.\n\nUndantag från föreskrifterna anges under punkt D nedan.\nI naturreservatet är det förbjudet att","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"C.","sidnummer":11,"teckenoffset_pa_sidan":1362,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","Undantag från"],"dokument_id":"nvdok-1047485","dokument_namn":"kyrkhamn-riddersviks_naturreservat_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047485","dokument_sha256":"28f74e3c61251305f355cb8614b643e307d408750b0fc641b8235f66d8a1b930","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"5.   störa eller skada djurlivet, till exempel genom att klättra i\n     boträd, skada bon eller störa ungar","inledning":"I naturreservatet är det förbjudet att","inledning_offset":1638,"inledning_sidnummer":11,"punkt":"5.","sidnummer":11,"teckenoffset_pa_sidan":2162,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurlivet","störa","bon"],"dokument_id":"nvdok-1047485","dokument_namn":"kyrkhamn-riddersviks_naturreservat_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047485","dokument_sha256":"28f74e3c61251305f355cb8614b643e307d408750b0fc641b8235f66d8a1b930","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"10. använda musikanläggning eller annan ljudalstrande anordning\n    på för djurliv och/eller människor störande sätt","inledning":"I naturreservatet är det förbjudet att","inledning_offset":1638,"inledning_sidnummer":11,"punkt":"10.","sidnummer":12,"teckenoffset_pa_sidan":532,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["störande","djurliv"],"dokument_id":"nvdok-1047485","dokument_namn":"kyrkhamn-riddersviks_naturreservat_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047485","dokument_sha256":"28f74e3c61251305f355cb8614b643e307d408750b0fc641b8235f66d8a1b930","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"14. starta och landa med luftfarkost såsom drönare","inledning":"I naturreservatet är det förbjudet att","inledning_offset":1638,"inledning_sidnummer":11,"punkt":"14.","sidnummer":12,"teckenoffset_pa_sidan":934,"klassificering":"start-landningsförbud","konfidens":"medel","traffade_ord":["luftfarkost","drönare","starta"],"dokument_id":"nvdok-1047485","dokument_namn":"kyrkhamn-riddersviks_naturreservat_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047485","dokument_sha256":"28f74e3c61251305f355cb8614b643e307d408750b0fc641b8235f66d8a1b930","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"6. tillsynsmyndigheten, viltvården, reservatsförvaltaren eller den\n    som förvaltaren utser får starta och landa med drönare, trots\n    vad som anges i C14","inledning":"Utan Stockholms stads tillstånd är det förbjudet att:","inledning_offset":1031,"inledning_sidnummer":12,"punkt":"6.","sidnummer":13,"teckenoffset_pa_sidan":603,"klassificering":"start-landningsförbud","konfidens":"medel","traffade_ord":["drönare","starta","landa"],"dokument_id":"nvdok-1047485","dokument_namn":"kyrkhamn-riddersviks_naturreservat_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047485","dokument_sha256":"28f74e3c61251305f355cb8614b643e307d408750b0fc641b8235f66d8a1b930","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Allemansrätt\nAllemansrätten ger tillgång till naturen under ansvar.\nAllemansrätten är grundlagsskyddad genom 2 kap. 15 §\nregeringsformen. Av 7 kap. 1 § miljöbalken framgår det att var och\nen som utnyttjar allemansrätten eller annars vistas i naturen ska visa\nhänsyn och varsamhet i sitt umgänge med den. I ett naturreservat\nkan allemansrätten begränsas av reservatsföreskrifterna.\nAllemansrätten innebär att alla kan vistas på annans mark för att\nkomma ut i naturen, men det är inte tillåtet att störa eller förstöra.\nHemfriden ska respekteras liksom markägarens ekonomiska\nintressen. Hänsyn ska också tas till naturvärden och andra\nmänniskor som ägnar sig åt friluftsliv.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":16,"teckenoffset_pa_sidan":577,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["vistas","är inte tillåtet"],"dokument_id":"nvdok-1047485","dokument_namn":"kyrkhamn-riddersviks_naturreservat_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047485","dokument_sha256":"28f74e3c61251305f355cb8614b643e307d408750b0fc641b8235f66d8a1b930","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Förbudet att skräpa ned\nEnligt 15 kap. 26 § miljöbalken är det förbjudet att skräpa ned\nutomhus på en plats som allmänheten har tillträde eller insyn till.\nSkräp riskerar att skada både människor och djur. Allt avfall ska\nhanteras enligt gällande regelverk i avfallsförordningen (2020:614).","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":16,"teckenoffset_pa_sidan":1251,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträde","Förbudet"],"dokument_id":"nvdok-1047485","dokument_namn":"kyrkhamn-riddersviks_naturreservat_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047485","dokument_sha256":"28f74e3c61251305f355cb8614b643e307d408750b0fc641b8235f66d8a1b930","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Terrängkörningslagen (1975:1313)\nEnligt terrängkörningslagen är det förbjudet att köra motordrivna\nfordon på barmark i terrängen. All mark utanför väg, t.ex. park,\nåker, äng, skog och stränder, räknas som terräng. Också stigar är\nterräng i lagens mening. Generella undantag från förbudet finns i\nterrängkörningsförordningen (1978:594), bland annat för statlig och\nkommunal tjänsteman vid skötsel- och anläggningsarbete, om\nåtgärden ej kan utföras på annat lämpligt sätt, samt för\nräddningstjänst, läkare och brandkår. Länsstyrelsen kan efter\nansökan medge enskilda undantag om särskilda skäl föreligger.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":16,"teckenoffset_pa_sidan":1543,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivna","fordon","förbjudet"],"dokument_id":"nvdok-1047485","dokument_namn":"kyrkhamn-riddersviks_naturreservat_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047485","dokument_sha256":"28f74e3c61251305f355cb8614b643e307d408750b0fc641b8235f66d8a1b930","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Lokala trafikföreskrifter för Stockholm\nStockholms stads lokala trafikföreskrifter innebär bland annat\nföljande:\nI terräng är all fordonstrafik förbjuden om inte annat anges genom\ntrafikföreskrift eller vägmärke. Som fordon betraktas även cyklar.\nInom reservatet gäller förbudet inte cykel på de sträckor som anges\ni kartorna i Stockholms stads allmänna lokala trafikföreskrifter.\nFordon får om så erfordras framföras på parkväg i samband med\nunderhållsarbete, väghållningsarbete eller liknande.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":17,"teckenoffset_pa_sidan":147,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","Fordon","förbjuden"],"dokument_id":"nvdok-1047485","dokument_namn":"kyrkhamn-riddersviks_naturreservat_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047485","dokument_sha256":"28f74e3c61251305f355cb8614b643e307d408750b0fc641b8235f66d8a1b930","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Lokala ordningsföreskrifter om hundar och camping\nI lokala ordningsföreskrifter för Stockholms stad reglerar\nkommunen vad som gäller för att upprätthålla ordningen på\noffentlig plats. Det som är aktuellt för området är följande:\n    •    Hundar ska hållas kopplade på offentlig plats, med\n         undan¬tag av de områden där kommunen anordnat\n         hundrastområde¬ eller hundrastgård.\n    •    Tikar skall under löptid hållas kopplade när de vistas\n         utanför inhägnade områden.\n    •    Camping får inte ske på offentlig plats.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":17,"teckenoffset_pa_sidan":644,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["vistas","får inte"],"dokument_id":"nvdok-1047485","dokument_namn":"kyrkhamn-riddersviks_naturreservat_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047485","dokument_sha256":"28f74e3c61251305f355cb8614b643e307d408750b0fc641b8235f66d8a1b930","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.77783446,59.38768146],[17.77783346,59.38768087],[17.7778327,59.38768078],[17.77783158,59.38768093],[17.76807731,59.39083748],[17.76807676,59.39083798],[17.76671587,59.39391575],[17.76671666,59.39391639],[17.76810749,59.39441236],[17.76842388,59.39451355],[17.76884578,59.39466295],[17.76909053,59.39474602],[17.77116919,59.3954851],[17.77344834,59.39629359],[17.77356549,59.39633501],[17.77381854,59.3964249],[17.77936872,59.39839337],[17.77946939,59.39842905],[17.77947074,59.39842922],[17.77947171,59.39842901],[17.78182317,59.39745998],[17.78205929,59.39736252],[17.78222028,59.39729632],[17.78350079,59.39676857],[17.78363517,59.39671302],[17.783815,59.39663907],[17.78739827,59.3951621],[17.78810118,59.39487154],[17.78857695,59.3946756],[17.78918916,59.39442275],[17.78955951,59.39427116],[17.79371487,59.39255794],[17.79859066,59.39054611],[17.7985908,59.39054535],[17.79852247,59.39043297],[17.79860318,59.39026294],[17.79898597,59.39005116],[17.79898648,59.39005057],[17.79887256,59.3896311],[17.79887148,59.38963052],[17.79865333,59.38958403],[17.79855595,59.38925421],[17.79855517,59.38925372],[17.79802237,59.3890821],[17.79803453,59.3889209],[17.79790371,59.38879273],[17.7976174,59.3887169],[17.79727475,59.38870554],[17.79699839,59.38857211],[17.79