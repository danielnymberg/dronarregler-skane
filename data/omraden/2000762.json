et:","inledning_offset":685,"inledning_sidnummer":5,"punkt":"1.","sidnummer":5,"teckenoffset_pa_sidan":728,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1008896","dokument_namn":"Beslut och skötselplan Kalvön 2010.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008896","dokument_sha256":"2054cbd483ca36a6c8908a710b7f83fa75aa9f313ca255f609ec884c1a5a317e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4.2 Information och anläggningar\nSpången som leder till Kalvön från fastlandet på Bokenäset är gammal och\nbör bytas snarast för att förhindra att olyckor sker. För de skötselåtgärder\nsom ska göras på Kalvön skulle det underlätta om en ny spång var bred nog\nför att köra över med fyrhjuling. En avvägning måste dock göras av fördelar\noch nackdelar med att öka möjligheterna till fyrhjulingstrafik på ön. Mark-\nägare på ön har efterlyst möjligheter att ta sig till sina fastigheter med fyrh-\njuling för att underlätta transporter. Mycket av marken på Kalvön är dock\nkänslig för markskador och i reservatet råder enligt de nya föreskrifterna\nförbud mot motorfordon annat än för reservatskötselns behov.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":75,"teckenoffset_pa_sidan":187,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motorfordon","förbud"],"dokument_id":"nvdok-1008896","dokument_namn":"Beslut och skötselplan Kalvön 2010.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008896","dokument_sha256":"2054cbd483ca36a6c8908a710b7f83fa75aa9f313ca255f609ec884c1a5a317e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"5. Fornlämningar och övriga kulturlämningar\nBoplatser och gravar är registrerade fornlämningar och får inte täckas över\neller förstöras. På eller inom boplatsytorna är det viktigt att inte köra med\nfordon så att det blir markskador.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"5.","sidnummer":76,"teckenoffset_pa_sidan":189,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","får inte"],"dokument_id":"nvdok-1008896","dokument_namn":"Beslut och skötselplan Kalvön 2010.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008896","dokument_sha256":"2054cbd483ca36a6c8908a710b7f83fa75aa9f313ca255f609ec884c1a5a317e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[11.65408549,58.26625148],[11.65362682,58.26623656],[11.65319027,58.26624931],[11.65301499,58.26621664],[11.65280891,58.266156],[11.65252421,58.2660389],[11.65236269,58.26596175],[11.65162833,58.26553339],[11.65149853,58.26547515],[11.65113078,58.26533732],[11.65099798,58.26530605],[11.65064561,58.26525871],[11.65064466,58.26525892],[11.65054661,58.26530039],[11.6504893,58.26535248],[11.65040891,58.26560151],[11.65026787,58.26578587],[11.65021833,58.26606275],[11.65014198,58.26613217],[11.64971471,58.2664326],[11.64971434,58.26643313],[11.64971125,58.26645952],[11.64971139,58.26645997],[11.64977077,58.26653356],[11.64982514,58.2665804],[11.65000798,58.26669422],[11.65023416,58.26680039],[11.65066778,58.26695837],[11.65156361,58.26732013],[11.65217018,58.26752859],[11.65240179,58.26759007],[11.65259638,58.26767734],[11.65289717,58.2678759],[11.