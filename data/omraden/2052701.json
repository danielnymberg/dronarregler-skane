tiga för fåglar men även en del intressant flora finns i in-\ntilliggande områden som kan sprida sig till naturreservatet. Två skogsområden in-\ngår också i naturreservatet där man finner en barrblandad lövskog med mycket död\nved och trädslagsvariation. Skogen visar tydliga tecken på att den har betats. Näs-\ntan hela Svartekulla är en del av det större Natura 2000-området Eldslyckan- Ko-\nbonäs (SE 0540309).","inledning":"Inom naturreservatet är det förbjudet att:","inledning_offset":1131,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":1687,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["större","fåglar"],"dokument_id":"nvdok-1026336","dokument_namn":"Beslut med bilagor Svartekulla 2021-12-07.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026336","dokument_sha256":"45744af2abf13944d46eb94dfc9662fbc2d0e3e8e0112e1bc330acf10464eae9","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.96691997,58.21600916],[13.96692094,58.21600907],[13.96709263,58.21596666],[13.9671988,58.21588728],[13.96726756,58.2158703],[13.96757357,58.21587446],[13.96776118,58.21586803],[13.9681058,58.21578286],[13.96815896,58.21573874],[13.96818042,58.21564922],[13.96823847,58.21550642],[13.96834799,58.2153553],[13.96840388,58.21525729],[13.96854426,58.21516946],[13.96863148,58.21512576],[13.96878572,58.21510095],[13.9689208,58.21512073],[13.9691047,58.21518607],[13.96918668,58.21524092],[13.96918762,58.21524126],[13.96918876,58.21524124],[13.97248067,58.