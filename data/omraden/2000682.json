lingar":["marken"],"dokument_id":"nvdok-1014253","dokument_namn":"2000682_inscannad.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014253","dokument_sha256":"6b7e66dbab33edbc9c305b105c869645e2887f3770989f8bb6389daab816c76b","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Föreskrifter enligt 7 kap 30 $ miljöbalken om rätten att färdas och vistas inom\nreservatet samt om ordningen i övrigt inom reservatet.\n\nUtöver vad som för övrigt gäller är det förbjudet att:\n\n1 fälla eller på annat sätt skada levande eller döda stående och omkullfallna träd och\nbuskar.\n\n2 insamla mossor, svampar, kärlväxter eller lavar med undantag för plockning av\nmatsvamp för husbehov.\n\n3 framföra motordrivet fordon, inklusive snöskoter.\n\n4 insamla eller föra bort ryggradslösa djur.\n5 genom grävning eller på annat sätt skada mark, block och vattenmiljö.\n\n6 medföra ej kopplad hund eller annat lösgående husdjur.\n7 sätta upp skylt, tavla, affisch eller göra inskrift.\n\n3av8","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1731,"inledning_sidnummer":2,"punkt":"C.","sidnummer":3,"teckenoffset_pa_sidan":1529,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1014253","dokument_namn":"2000682_inscannad.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014253","dokument_sha256":"6b7e66dbab33edbc9c305b105c869645e2887f3770989f8bb6389daab816c76b","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Prästflon är en av länets finaste orkidémyrar. Myren som till största delen består av ett\nsluttande kärr är mycket artrik med ett stort antal rikkärrsarter som tagelstarr, gräsull,\nblodnycklar, sumpnycklar och tvåblad. Typiska rikkärrsarter i bottenskiktet är\npiprensarmossa, gyllenmossa, purpurvitmossa och i de centrala delarna, käppkrokmossa.\nOmrådets karaktärsart är myrbräckan som här har sin starkaste population i länet. I augusti\nlyser hela myren i gult av alla blommande myrbräckor. Av häckande fågelarter på myren\nförekommer de vanliga myrfåglarna som till exempel grönbena, gulärla och ängspiplärka.\nDe örtrika myr- och sumpskogspartierna utnyttjas sommartid av betande älgar.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1668,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":2363,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["fågelarter","fåglarna","största"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1014253","dokument_namn":"2000682_inscannad.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014253","dokument_sha256":"6b7e66dbab33edbc9c305b105c869645e2887f3770989f8bb6389daab816c76b","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"9. utan länsstyrelsens tillstånd framföra motordrivet fordon\nFöreskrifterna utgör inte hinder för de åtgärder som behövs för\natt tillgodose ändamålet med reservatet och som är angivna i","inledning":"skall förbud gälla att","inledning_offset":99,"inledning_sidnummer":3,"punkt":"9.","sidnummer":3,"teckenoffset_pa_sidan":761,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1006971","dokument_namn":"Prästflon.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1006971","dokument_sha256":"9d45d38b5ef7ca827178699ebe3f4464280af698427c7cd4d5a73261f07acfc3","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"2. medvetet störa djur ivet","inledning