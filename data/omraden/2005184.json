dning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":577,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1045003","dokument_namn":"511-2703-11 Beslut utökning Halsnäset.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045003","dokument_sha256":"ca23d8e01e96dc0f6f734a650369dc1199d8fb451e12c61da1b4f73700c7eb7f","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Beskrivning av ärendet\nHalsnäset vid Ånnsjön är ett viktigt område för häckande fåglar, med omväxlande\nvåtmarker och skyddade småvatten. Ånnsjöns fågelstation har noterat att flyttfåglar\ntenderar att komma allt tidigare till Ånnsjön och fågelskyddsområdet på våren, i och\nmed att klimatet förändras. Det har förekommit snöskoterkörning i viken mot Ånns\nsamhälle, bland annat över partier med öppet vatten i samband med att isen smälter.\nFlyttfåglar använder dessa öppna vattenytor som viloplatser, varför skoterkörning här\ninnebär en störning för fågellivet.\nÅre kommun, berörda markägare och verksamhetsutövare i anslutning till området har\nfått tillfälle att yttra sig över föreslagna ändringar.","inledning":"Det är förbjudet att under tiden 1 april – 31 juli\n                Inom område A (enligt bifogad beslutskarta):","inledning_offset":1374,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":338,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1045003","dokument_namn":"511-2703-11 Beslut utökning Halsnäset.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045003","dokument_sha256":"ca23d8e01e96dc0f6f734a650369dc1199d8fb451e12c61da1b4f73700c7eb7f","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0"