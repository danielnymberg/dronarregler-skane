df","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042432","dokument_sha256":"91399eef8173b76969d945a3ac2c5f03980cb173a1b4a8f64543e440465fc1d8","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Utökning, breddning eller andra ombyggnader på allmänna vägar och gator\nkräver tillstånd.\nUpplag och tillverkning av asfalt, oljegrus, vägsalt eller saltinblandad sand/grus\nkräver tillstånd.\nUppställning av motordrivet fordon samt släp med innehåll av för människors\nhälsa eller miljön skadliga ämnen, är förbjudet. Från förbudet undantas\nuppställning av personbilar, lätta lastbilar, mopeder och motorcyklar. Från förbudet\nundantas även uppställning på plats där eventuellt läckage till mark och vatten förhindras.","inledning":"Förvaring av farligt avfall utöver normala hushållsmängder kräver tillstånd.\nFörvaringen ska ske utan åtkomst för obehörig, under tak och på ett sådant sätt att","inledning_offset":1261,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1677,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1042432","dokument_namn":"FS Galgbacken 2020_36.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042432","dokument_sha256":"91399eef8173b76969d945a3ac2c5f03980cb173a1b4a8f64543e440465fc1d8","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.77567926,56.15055151],[13.77545794,56.15063684],[13.77545722,56.15063744],[13.