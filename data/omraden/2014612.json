er":1,"teckenoffset_pa_sidan":1089,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1018388","dokument_namn":"Beslut ändr föreskr 2017 webb.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1018388","dokument_sha256":"004d5485b12fcd52251ff4631e6fc131b439ae3515f2985f00597033f9b2cf51","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I beslutet om att bilda naturreservatet betonas områdets stora betydelse för vår- och\nhöstrastande tranor. Antalet tranor har ökat kraftigt i området sedan naturreservatet\nbildades. Nuvarande ordningsföreskrifter ger inte tillräckligt skydd för att tranorna\nska kunna rasta och övernatta ostört. Länsstyrelsens bedömning är att det är\nnödvändigt med ett beträdnadsförbud under delar av året mot bakgrund av att\nantalet besökare i området har ökat kraftigt, särskilt vid utemuseet och fågeltornet\nvid Pulken i norr, och att störningar på fågellivet skett under senare år.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":1412,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1018388","dokument_namn":"Beslut ändr föreskr 2017 webb.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1018388","dokument_sha256":"004d5485b12fcd52251ff4631e6fc131b439ae3515f2985f00597033f9b2cf51","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Syfte\nSyftet med föreskriften är att skapa en ostörd rast- och övernattningsplats för tranor.\nDetta ligger i linje med 1§ Artskyddsförordningen som säger att det är förbjudet att\navsiktligt störa fåglarna och Europaparlamentets och rådets direktiv 2009/147/EG\nav den 30 november 2009 om bevarande av vilda fåglar.\nSyftet uppnås bland annat genom att skapa ostörda miljöer för djurarter som är i\nbehov av skydd och som det finns intresse av att bevara i livskraftiga bestånd.","inledning":"nödvändigt med ett beträdnadsförbud under delar av året mot bakgrund av att","inledning_offset":1750,"inledning_sidnummer":2,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":299,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1018388","dokument_namn":"Beslut ändr föreskr 2017 webb.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1018388","dokument_sha256":"004d5485b12fcd52251ff4631e6fc131b439ae3515f2985f00597033f9b2cf51","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Mot bakgrund av att risken för störningar som motverkar fåglarnas möjlighet till\nrast- och övernattningsframgång i området är överhängande är det nödvändigt att\ngenom beträdnadsförbud skapa ostördhet för dessa fåglar under rast- och\növernattningsperioden.","inledning":"Detta ligger i linje med 1§ Artskyddsförordningen som säger att det är förbjudet att","inledning_offset":395,"inledning_sidnummer":3,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":1963,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1018388","dokument_namn":"Beslut ändr föreskr 2017 webb.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1018388","dokument_sha256":"004d5485b12fcd52251ff4631e6fc131b439ae3515f2985f00597033f9b2cf51","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"3. avsiktligt störa djurlivet,","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att","inledning_offset":125,"inledning_sidnummer":4,"punkt":"3.","sidnummer":4,"teckenoffset_pa_sidan":422,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1010847","dokument_namn":"Pulken-Yngsjön BESLUT 2009 Webb.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010847","dokument_sha256":"ac70b3dff20381a77d9ed807def908c8b68b1948023a6a5008ff20a872480d6c","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"7. lägga upp båt eller annan farkost på land.\nVidare är det förbjudet att utan Länsstyrelsens tillstånd","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att","inledning_offset":125,"inledning_sidnummer":4,"punkt":"7.","sidnummer":4,"teckenoffset_pa_sidan":700,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1010847","dokument_namn":"Pulken-Yngsjön BESLUT 2009 Webb.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010847","dokument_sha256":"ac70b3dff20381a77d9ed807def908c8b68b1948023a6a5008ff20a872480d6c","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Sveriges Ornitologiska Förening (markägare vid tiden för remissbehandling av för-\nslaget) är positiv till att området blir reservat. Föreningen framför invändningar när\ndet gäller jakten på fåglar och föreslår i första hand att den förbjuds helt. Ett alter-\nnativ är att det etableras stora jaktfria zoner och eller inskränkningar i jakttiden. När\ndet gäller dikesrensning anser man inte att det räcker med formuleringen att detta\nskall undvikas under fåglarnas häckningstid. Föreningen menar att dikesrensning\ninte alls bör vara tillåten under häckningstid.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":965,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1010847","dokument_namn":"Pulken-Yngsjön BESLUT 2009 Webb.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010847","dokument_sha256":"ac70b3dff20381a77d9ed807def9