{"nvrid":"2000137","slug":"traskmyr-och-vastean","namn":"Träskmyr och Vasteån","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Gotland","lan":"Gotlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Gotlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"1981-03-23","senaste_gallandedatum":"1982-05-13","area_ha":288.92,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2000137","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":true,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"traskmyr-vastean-beslut.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016441","dokument_id":"nvdok-1016441","sha256":"e85a1140b44ea07227612e7c1f4c7f1f4896c89f5af4a9f453846c3162c20e25","sidor":31,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"- BESLUT 4\n\nson 1981-03-23 11.121-366-71\n\njämförlig anordning - informations- och fridlysningstavlor un-\ndantagna\n\n= jaga i Träskmyr fram till regleringsdammen under tiden 1 mars -\n31 juli. Rävjakt får dock ske 1 mars - 15 mars.\n\nVid ansökan om tillstånd att avverka skog skall även frågan om\n\njoo körning med motordrivna fordon prövas utan särskild ansökan. — -\n\nFöreskrifterna nedan under punkt C gällande allmänheten gäller\näven markägare och Innehavare av särskild rätt i den mån pågående\nmarkanvändning därigenom inte avsevärt försvåras.\n\nAN\nNa","inledning":"Utan länsstyrelsens tillstånd är det förbjudet att","inledning_offset":1241,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":0,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivna","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1016441","dokument_namn":"traskmyr-vastean-beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016441","dokument_sha256":"e85a1140b44ea07227612e7c1f4c7f1f4896c89f5af4a9f453846c3162c20e25","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Föreskrifter jämlikt 10 $ naturvårdslagen om vad allmänheten\nhar att iakttaga inom reservatet\n\nUtöver föreskrifter och förbud i andra lagar och författningar\nskall förbud gälla att\n\n1 FO = störa djurlivet\n\n> plocka blommor, insamla eller gräva upp växter\n\ntälta eller ställa upp husvagn\n\n> köra med motordrivna fordon frånsett den mindre vägen Snäckers -\nNorrvange inklusive bron över Vasteån\n\nanbringa tavla, plakat, affisch, skylt, inskrift eller därmed\njämförlig anordning.","inledning":"Utan länsstyrelsens tillstånd är det förbjudet att","inledning_offset":1241,"inledning_sidnummer":3,"punkt":"C.","sidnummer":4,"teckenoffset_pa_sidan":1190,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivna","fordon","förbud"],"handlingar":["flyga","landa","lyfta","marken"],"dokument_id":"nvdok-1016441","dokument_namn":"traskmyr-vastean-beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016441","dokument_sha256":"e85a1140b44ea07227612e7c1f4c7f1f4896c89f5af4a9f453846c3162c20e25","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.73432995,57.82962227],[18.73394902,57.82982491],[18.73394851,57.8298254],[18.73394859,57.82982596],[18.73847569,57.8362262],[18.74097602,57.83786244],[18.74097691,57.83786276],[18.74097762,57.8378628],[18.74097862,57.83786258],[18.74195194,57.