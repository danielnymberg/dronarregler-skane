borre får utföras genom\nnaturvårdsförvaltarens försorg genom att barka eventuella vindfällen eller genom\natt oskadliggöra nyligen angripna träd som yngelplats för skadegörare.","inledning":"genom förbud mot nya anläggningar och byggnader.\nDetta ska uppnås genom att:","inledning_offset":739,"inledning_sidnummer":23,"punkt":null,"sidnummer":24,"teckenoffset_pa_sidan":621,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["storskaliga","yngel"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1028713","dokument_namn":"Storangstorpet_2019-12-19_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028713","dokument_sha256":"49e1e769a57b02cbb770b0187cd1456d7291ea2dcf40db126ea5a1c5974b5cec","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.67410985,59.94013024],[18.67152857,59.94100327],[18.67152775,59.94100387],[18.67152798,59.94100459],[18.67458487,59.94218073],[18.67547246,59.94252676],[18.68621225,59.94661525],[18.68880577,59.9475918],[18.68880693,59.94759177],[18.6888076,59.94759156],[18.6904003,59.94682852],[18.69082169,59.94604448],[18.69363001,59.94490366],[18.69523282,59.94455388],[18.69523352,59.94455347],[18.69523367,59.94455293],[18.69517017,59.94432221],[18.69581628,59.94413186],[18.69581677,59.94413149],[18.69596358,59.94393987],[18.69605554,59.94372379],[18.69605929,59.94343747],[18.69599347,59.94327361],[18.69597443,59.94312947],[18.69598251,59.94290848],[18.69603008,59.94264164],[18.69618899,59.94198685],[18.6962719,