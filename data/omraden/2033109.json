 kommuns östra del på\ngränsen till Botkyrka kommun. Området avgränsas i norr och öster av kommungränsen, i väst av\nmotorvägen E4/E20 och Söderby gårds väg samt i söder av vägen mellan Granmora och Söderby\ngårds väg. Reservatet har stora kultur-, natur- och rekreationsvärden och kan enkelt nås med bil,\ncykel, buss eller till fots från Salem och Rönninge tätort. Reservatet innefattar delar av gården Nedre\nSöderbys brukningsenhet och består av betesmark, skogsmark, våtmark och åkermark som tillhört\ngården.","inledning":"fornlämningsområden skyddade enligt lag. Det är utan Länsstyrelsens tillstånd förbjudet att","inledning_offset":483,"inledning_sidnummer":13,"punkt":null,"sidnummer":13,"teckenoffset_pa_sidan":1415,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1039117","dokument_namn":"Nedre_Söderby_2010-09-30_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1039117","dokument_sha256":"491600dbb2bb1e69ad50c46148fa9cb9679af4d653a1482f1b272d115ec86eec","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.78338086,59.21755227],[17.78346396,59.21745063],[17.78358578,59.21728349],[17.78368211,59.21709328],[17.78377218,59.21691938],[17.78380462,59.21676553],[17.78379285,59.21661149],[17.7837172,59.21647693],[17.7837884,59.21623115],[17.78387859,59.21600816],[17.78390483,59.21587058],[17.7839118,59.21573953],[17.78443235,59.2158605],[17.78467406,59.21588338],[17.78507499,59.21587993],[17.78532912,59.21586672],[17.78555247,59.21581741],[17.7856865,5