":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":828,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelskyddsområden","större","förbud"],"dokument_id":"nvdok-1046922","dokument_namn":"beslut om fågelskyddsområden feb 2023 nvr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046922","dokument_sha256":"a4b10c09bb0a3e3648dd9080b06291751ca689ffe7612f6d14b393158c08a4f2","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"1. beträda mark årligen under tiden 1/4 - 15/7 inom områden som anges med gul\n              begränsningslinje på bifogade kartor;","inledning":"Inom fågelskyddsområdena är det förbjudet att:","inledning_offset":1045,"inledning_sidnummer":1,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":1104,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["beträda"],"dokument_id":"nvdok-1041971","dokument_namn":"Beslut fso skärgård dec 2012.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1041971","dokument_sha256":"562411c2a72746567b3ea9682226b3e1535fe6dfaedbd9c0eb660803a22ab67b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"2. beträda mark eller komma närmare strand än 100 meter årligen under tiden 1/4 -\n              31/7 inom områden som anges med orange begränsningslinje respektive 1/2 - 15/8\n              inom områden som anges med röd begränsningslinje på bifogade kartor;","inledning":"Inom fågelskyddsområdena är det förbjudet att:","inledning_offset":1045,"inledning_sidnummer":1,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":1249,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["beträda"],"dokument_id":"nvdok-1041971","dokument_namn":"Beslut fso skärgård dec 2012.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1041971","dokument_sha256":"562411c2a72746567b3ea9682226b3e1535fe6dfaedbd9c0eb660803a22ab67b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"fågelskyddsbestämmelserna inom dessa inte påverkar habitatens bevarandestatus\nnegativt. Några av de fågelskyddsområden som föreslås upphävas ligger även inom\nbefintliga SPA-områden, d.v.s. områden som är utpekade som särskilda\nskyddsområden för fågellivet. Länsstyrelsen anser vad gäller dessa objekt att\ntillträdesförbud inte krävs för att bevara fågellivet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":209,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"dokument_id":"nvdok-1041971","dokument_namn":"Beslut fso skärgård dec 2012.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1041971","dokument_sha256":"562411c2a72746567b3ea9682226b3e1535fe6dfaedbd9c0eb660803a22ab67b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.99148883,58.4370413],[16.99156327,58.43704537],[16.99152813,58.4371067],[16.99152814,58.43710729],[16.99152882,58.43710778],[16.99153028,58.43710795],[16.99162524,58.43709861],[16.99162121,58.43716998],[16.9915848,58.43722973],[16.99154705,58.43738339],[16.9915502,58.43751638],[16.99163789,58.43757862],[16.99164102,58.43771153],[16.99167057,58.43780715],[16.99180543,58.43804038],[16.991839