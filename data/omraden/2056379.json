{"nvrid":"2056379","slug":"djup-hortenskogarna","namn":"Djup-Hortenskogarna","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Ånge","lan":"Västernorrlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Västernorrlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2024-11-27","senaste_gallandedatum":"2025-04-03","area_ha":74.27,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2056379","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"beslut för djuphorten utan sändlista.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027575","dokument_id":"nvdok-1027575","sha256":"e721136f6b2bcf9ae4ee6454d9534dbd4bba4c471d6800037c9f96c7d0f0f132","sidor":31,"ocr":false,"beslutsstatus":"Gällande","fel":null},{"namn":"regeringsbeslut nr 8 kn2025 00195_bilaga - ånge kommun.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028005","dokument_id":"nvdok-1028005","sha256":"1790db7cf28aec357e8a9910a072a5d68ec16071337bd3d2406d6f5c7a2d033b","sidor":5,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"C. Föreskrifter enligt 7 kap. 30 § miljöbalken om rätten att färdas\noch vistas inom reservatet samt om ordningen i övrigt inom\nreservatet.\n\nUtöver vad som för övrigt gäller är det förbjudet att:\n\n   1 fälla eller på annat sätt skada levande eller döda, stående eller\n     omkullfallna träd och buskar.\n  2 plocka, gräva upp eller på annat sätt ta bort mossor, lavar eller\n    svampar, med undantag för plockning av icke fridlysta\n    marklevande mat- eller färgsvampar.\n  3 insamla eller föra bort insekter eller andra ryggradslösa djur.\n\n                                                                      4 av 20","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":133,"inledning_sidnummer":3,"punkt":"C.","sidnummer":4,"teckenoffset_pa_sidan":1701,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1027575","dokument_namn":"beslut för djuphorten utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027575","dokument_sha256":"e721136f6b2bcf9ae4ee6454d9534dbd4bba4c471d6800037c9f96c7d0f0f132","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4 genom grävning eller på annat sätt skada mark, block eller\n    vattenmiljöer.\n  5 klättra i boträd eller på annat sätt medvetet störa eller skada\n    djurlivet.\n  6 framföra motordrivet fordon. Förbudet gäller inte snöskoter\n    på snötäckt, tjälad mark eller på sjöis.\n   7 vaska efter guld eller andra ämnen.\n  8 uppföra anläggning, såsom vindskydd, koja, bänk, spång, bro,\n    stängsel, ledning, mast eller torn.\n  9 sätta upp skylt, tavla, affisch eller göra inskrift.\n 10 utan länsstyrelsens tillstånd använda området för\n    organiserade tävlingar, militära eller andra övningar,\n    lägerverksamhet eller motsvarande.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1841,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":2,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1027575","dokument_namn":"beslut för djuphorten utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027575","dokument_sha256":"e721136f6b2bcf9ae4ee6454d9534dbd4bba4c471d6800037c9f96c7d0f0f132","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskrifterna ska inte utgöra hinder för att utöva renskötsel i\nenlighet med rennäringslagen (1971:437) eller framföra motordrivet\nfordon vid renskötsel i enlighet med gällande\nterrängkörningslagstiftning.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1841,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1245,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1027575","dokument_namn":"beslut för djuphorten utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027575","dokument_sha256":"e721136f6b2bcf9ae4ee6454d9534dbd4bba4c471d6800037c9f96c7d0f0f132","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Enligt Förordningen (2007:1244) om konsekvensutredning vid\nregelgivning ska en bedömning om konsekvensutredning göras för\nordningsföreskrifterna enligt 7 kap. 30 § miljöbalken. Dessa\nförskrifter gäller rätten att färdas och vistas, och ordningen i övrigt\ni området och exemplifieras i förarbetena till miljöbalken (prop.\n1997/98:45) som förbud mot åtgärder som annars hade varit\ntillåtna enligt allemansrätten.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":19,"teckenoffset_pa_sidan":439,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1027575","dokument_namn":"beslut för djuphorten utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027575","dokument_sha256":"e721136f6b2bcf9ae4ee6454d9534dbd4bba4c471d6800037c9f96c7d0f0f132","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.86935595,62.41019992],[14.8