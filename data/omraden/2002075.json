{"nvrid":"2002075","slug":"gyllbergen","namn":"Gyllbergen","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Borlänge, Gagnef, Ludvika","lan":"Dalarnas Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Borlänge kommun","tillsynsmyndighet":null,"urspr_beslutsdatum":"1982-03-22","senaste_gallandedatum":"2008-02-12","area_ha":1705.35,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2002075","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Gyllbergen_Beslut_20071210.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024828","dokument_id":"nvdok-1024828","sha256":"6629353efec8c1200dcb67575edff29e398d2fa446cae20e76c74d148c3b1d82","sidor":13,"ocr":false,"beslutsstatus":"Gällande","fel":null},{"namn":"Gyllbergen_Beslut_19820322.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008887","dokument_id":"nvdok-1008887","sha256":"22cb05569310263f92f94bf609648b6bcbeee0f717b5cafb648138302e84a2ec","sidor":8,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"Bild_Från_Gyllbergen.jpg","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024829","orsak":"ej föreskriftsbärande dokumenttyp"}],"citat":[{"citat":"4. framföra motordrivet fordon i terrängen","inledning":"Det är förbjudet att","inledning_offset":943,"inledning_sidnummer":4,"punkt":"4.","sidnummer":4,"teckenoffset_pa_sidan":1219,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1024828","dokument_namn":"Gyllbergen_Beslut_20071210.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024828","dokument_sha256":"6629353efec8c1200dcb67575edff29e398d2fa446cae20e76c74d148c3b1d82","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"6. uppföra jakttorn\n\nUndantag\nFöreskrifterna gäller inte för\n• underhåll av befintliga vägar och master\n• åtgärder för skötsel och förvaltning av reservatet eller för att tillgodose syftet\n   med reservatet\n• punkt A.4 gäller inte för uttransport av älg med fordon som inte ger skador på\n   mark eller vegetation och inte för ägarnas transport till de två stugorna på\n   fastigheten Baggbo 5:7 och Tjärna 1:13 efter skriftlig överenskommelse med\n   markägaren, Borlänge kommun.","inledning":"Det är förbjudet att","inledning_offset":943,"inledning_sidnummer":4,"punkt":"6.","sidnummer":4,"teckenoffset_pa_sidan":1358,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1024828","dokument_namn":"Gyllbergen_Beslut_20071210.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024828","dokument_sha256":"6629353efec8c1200dcb67575edff29e398d2fa446cae20e76c74d148c3b1d82","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"3. framföra motordrivet fordon i terrängen","inledning":"Det är förbjudet att","inledning_offset":275,"inledning_sidnummer":5,"punkt":"3.","sidnummer":5,"teckenoffset_pa_sidan":389,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1024828","dokument_namn":"Gyllbergen_Beslut_20071210.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024828","dokument_sha256":"6629353efec8c1200dcb67575edff29e398d2fa446cae20e76c74d148c3b1d82","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"B. 1-3 och C. 1-3\nLänsstyrelsen har bedömt dessa intrång och ordningsföreskrifter som rimliga mot\nbakgrund av syftet med reservatet.\n\nDet är t ex inte förbjudet att tälta i reservatet och inte att elda under förutsättning att\nman tar hänsyn och inte stör häcknings- och spelplatser och inte skadar växande\neller döda träd. Vill man inte använda de vedförsedda eldplatserna går det bra att\nplocka torra kvistar från marken eller bryta torrgrenar från växande träd utan att de\nskadas. Däremot får man t ex inte elda med delar av torrakor och stubbar eller\nliggande döda träd, s k lågor. Det gamla förbudet att inte elda på hällmarker har\ntagits bort eftersom påverkan blir så begränsad.","inledning":"Förbudet A.4 mot att köra snöskoter och andra motordrivna fordon är viktigt för att","inledning_offset":1168,"inledning_sidnummer":5,"punkt":"B.","sidnummer":5,"teckenoffset_pa_sidan":1317,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["häcknings","stör","förbjudet"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1024828","dokument_namn":"Gyllbergen_Beslut_20071210.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024828","dokument_sha256":"6629353efec8c1200dcb67575edff29e398d2fa446cae20e76c74d148c3b1d82","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Förbudet C.3 mot att köra snöskoter och andra motordrivna fordon är viktigt för att\nkunna upprätthålla tystnaden och vildmarkskänslan i reservatet.","inledning":"Det är t ex inte förbjudet att tälta i reservatet och inte att elda under förutsättning att","inledning_offset":1451,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":364,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivna","fordon","Förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1024828","dokument_namn":"Gyllbergen_Beslut_20071210.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024828","dokument_sha256":"6629353efec8c1200dcb67575edff29e398d2fa446cae20e76c74d148c3b1d82","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Skötselområde 7, tjärnar och bäckar\nBeskrivning av området\nÄven om flera av tjärnarna, t ex Dragsjön och Lång-Älgsjön, är naturligt fisktomma\noch har låga pH-värden, har de naturligtvis ett värde för sländor, grodor, fåglar,\nstrandväxter och för friluftslivet. Två vatten som delvis ligger i reservatet kalkas,\nnämligen Stora Spånsan och Stora Älgsjön. I den sistnämnda lever abborre och\nöring. En studie över kiselalgerna i Stora Älgsjön, Dragsjön och Dammsjön för att\nbelysa försurningens utveckling finns publicerad. Hela detta höjdområde avrinner\nvia små bäckar, norra delen till Norån, södra delen till Grängshammarsån och västra\ndelen till Kolbäcksån.","inledning":"och anläggningar av leder mm. I det gamla reservatsbeslutet var det förbjudet att","inledning_offset":1270,"inledning_sidnummer":11,"punkt":null,"sidnummer":11,"teckenoffset_pa_sidan":1448,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["fåglar","Stora"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1024828","dokument_namn":"Gyllbergen_Beslut_20071210.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024828","dokument_sha256":"6629353efec8c1200dcb67575edff29e398d2fa446cae20e76c74d148c3b1d82","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"A. FÖRESKRIFTER JÄMLIKT 8 § NATURVÅRDSLAGEN ANGÅENDE IN-\n   SKRÄNKNINGAR I MARKÄGARES OCH ANNAN SAKÄGARES RÄTT ATT\n   FÖRFOGA ÖVER FASTIGHET INOM RESERVATET.\nUtöver föreskrifter och förbud i andra lagar och författ-\nningar skall förbud gälla att\n\n- bedriva täkt\n- skada vegetationen\n- avverka träd eller utföra skogsvårdande åtgärder utöver\n  vad som framgår av fastställd skötselplan (bifogas be-\n  slutet)\n- framföra motordrivet fordon annan än vid skötsel av natur-\n  reservat och på vägen till TV-masten, samt underhåll av\n  denna anläggning\n- inplantera för området främmande växt- eller djurarter\n- anordna upplag annan än tillfälligt i samband med skötsel\n  av reservatet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"A.","sidnummer":2,"teckenoffset_pa_sidan":236,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1008887","dokument_namn":"Gyllbergen_Beslut_19820322.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008887","dokument_sha256":"22cb05569310263f92f94bf609648b6bcbeee0f717b5cafb648138302e84a2ec","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. FÖRESKRIFTER JÄMLIKT 10 § NATURVÅRDSLAGEN OM VAD ALLMÄN-\n   HETEN HAR ATT IAKTTAGA INOM RESERVATET.\n\nUtöver föreskrifter och förbud i andra lagar och författ-\nningar skall förbud gälla att\n- göra åverkan på mark eller geologiska föremål\n- skada levande eller döda träd, buskar eller annan växtlig-\n  het\n- framföra motordrivet fordon\n- medföra ej kopplad hund\n- göra upp eld på berghällar\n- inplantera för området främmande växt- eller djurart.","inledning":"Utan länsstyrelsens tillstånd är det förbjudet att","inledning_offset":916,"inledning_sidnummer":2,"punkt":"C.","sidnummer":2,"teckenoffset_pa_sidan":1500,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1008887","dokument_namn":"Gyllbergen_Beslut_19820322.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008887","dokument_sha256":"22cb05569310263f92f94bf609648b6bcbeee0f717b5cafb648138302e84a2ec","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_ka