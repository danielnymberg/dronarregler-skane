ens":"medel","traffade_ord":["stora","stort","sälg"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1028165","dokument_namn":"storo-bocko-lokao_2022-12-21_beslut_foreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028165","dokument_sha256":"76ee372dee7c879506993bed55bf4d428df67cacb93c26ac5b93ddfeba190038","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"11 $ naturvårdslagen förbud att utan länsstyrelsens\ntillstånd inom Storö-Bockö-Lökaö m, fl. intilliggan-\nde öar i Möja socken, Djurö kommun, uppföra byggnad, .\nbrygga eller annan därmed jämförlig anordning i den\nmån den ej erfordrades för jordbrukets, skogsbrukets,\nträdgård jordbrukets, fiskets eller varvsrörelsens\nbehov, Förbudet skulle gälla i avvaktan på natur-\nreservatsfrågans slutliga avgörande, dock längst\ntill 1.4.1969. Genom beslut 17.3.1969 meddelade läns-\nstyrelsen fortsatt förbud av samma innebörd. Detta\nförbud skulle gälla längst till 1.4.1972.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":268,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["Storö","Djurö","förbud"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1009923","dokument_namn":"Storo-Bocko-Lokao_1973-04-27_1972-03-23_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1009923","dokument_sha256":"91afac6018278d62341d916ff8a3cc4193f13c91093fec87cdc9e5b4e8ea8965","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Storö-Bockö-Lökaö naturreservat bildades genom Länsstyrelsens beslut den\n23 mars 1972. Syftet med reservatet är att säkra ett för allmänhetens fri-\nluftsliv betydelsefullt skärgårdsområde samt att skydda och bibehålla områ-\ndets värdefulla växt- och djurvärld i en särpräglad skärgår