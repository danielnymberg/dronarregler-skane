t växer igen och övergår till att bli sumpskog. De öppna ytorna är till större delen\nmycket blöta och svåra att beträda eftersom bärigheten är dålig. Flaskstarr dominerar över\nstora ytor och i den östra delen finns stora områden med bladvass. På mindre blöta delar\nväxer lågvuxen tall och pors samt i några mindre områden ung glasbjörk. Andra vanliga\nväxter är vitag, rosling, tuvull och tranbär. Även det i södra Sverige sällsynta\ndvärgtranbäret (Vaccinium microcarpum) är vanligt här.","inledning":"Det är förbjudet att utan Länsstyrelsens tillstånd:","inledning_offset":186,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1376,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1020740","dokument_namn":"Beslut Marsjön 18 dec 2018.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1020740","dokument_sha256":"4f2d069993b2b3f848d152f6682ce2a49fb8a4f064703a4ce56ad9556227a608","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.67243359,58.95775953],[16.67077333,58.95761099],[16.67077188,58.95761117],[16.67001488,58.95826513],[16.66917092,58.95867738],[16.66917075,58.9586779],[16.66922408,58.95894752],[16.66922455,58.95894808],[16.66922555,58.95894838],[16.67042875,58.95909472],[16.67137313,58.95915275],[16.67215749,58.9590762],[16.67287659,58.95918589],[16.67366857,58.95920275],[16.67466288,58.95909832],[16.67492038,58.95895478],[16.67493193,58.9587351],[16.67531544,58.95854384],[16.67608488,58.95843852],[16.67729504,58.95852605],[16.