 och\nvildmarkskänsla. Uddarna i Måsjöns södra del är attraktiva besöksmål för\nnaturupplevelser.\nReservatet nås till fots eller cykel. Vägen är förbjuden för allmän motorfordons-\ntrafik. Närmast nås området från Ortala i öster, där det finns en vägbom efter de\nvästligaste husen. Den norra delen av reservatet kan nås via skogsbilvägen som\ngår från Häverö och Kåtorp ner till Pensarmyra. Vägen är där bommad vid\nKåtorp.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":26,"teckenoffset_pa_sidan":428,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motorfordons","förbjuden"],"dokument_id":"nvdok-1018211","dokument_namn":"Masjon_Borudamyren_utvidgning_2018_11_19_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1018211","dokument_sha256":"bcce62d950c3fcd9136d751c8224e2d267dc6046557225f26b021d5c03d6a212","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.70299479,59.99415689],[18.70471494,59.99541522],[18.70469139,59.99817665],[18.70402509,59.99955951],[18.7040779,60.00095046],[18.7040787,60.00095106],[18.7057428,60.00153439],[18.70574433,60.00153423],[18.70860672,60.00053212],[18.70860703,60.00053156],[18.70860685,60.00053118],[18.70808647,59.99996036],[18.70808382,59.99988948],[18.70887212,59.99983887],[18.70976651,59.99987741],[18.71033881,59.99998122],[18.71033995,59.99998125],[18.71034065,59.99998108],[18.71034133,59.99998062],[18.7103696,59.999941],[18.71045859,59.99969529],[18.711316