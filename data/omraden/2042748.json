{"nvrid":"2042748","slug":"mangmanskogens-naturreservat","namn":"Mångmanskogens naturreservat","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Sollefteå","lan":"Västernorrlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Västernorrlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2017-02-17","senaste_gallandedatum":"2017-03-17","area_ha":100.55,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2042748","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":true,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"beslut Mångmanskogen underskrivet exkl sändlista.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008763","dokument_id":"nvdok-1008763","sha256":"ccb00775f08d5c600870c3bae622140452d1e9de4367529e12d6790a80951403","sidor":15,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"10 utan länsstyrelsens tillstånd utföra fiskevårdande åtgärder (iläggning av sten,\nskapande av lekbottnar etc). Observera att tillstånd även kan krävas i enlighet med\nannat regelverk.\n\n11 utanför befintlig bilväg framföra motordrivet fordon annat än i samband med\nuttransport av fällda älgar, björnar eller annat högvilt, varvid risken för skador på\nmark och vegetation ska minimeras.\n\n12 upplåta mark för militär övningsverksamhet.\n13 uppföra jakttorn utan länsstyrelsens tillstånd.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1317,"inledning_sidnummer":2,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":0,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1008763","dokument_namn":"beslut Mångmanskogen underskrivet exkl sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008763","dokument_sha256":"ccb00775f08d5c600870c3bae622140452d1e9de4367529e12d6790a80951403","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Föreskrifter enligt 7 kap. 30 $ miljöbalken om rätten att färdas och vistas inom\nreservatet samt om ordningen i övrigt inom reservatet.\n\nUtöver vad som för övrigt gäller är det förbjudet att:\n1 fälla eller på annat sätt skada levande eller döda stående och omkullfallna träd och\nbuskar.\n\n2 plocka, gräva upp eller på annat sätt ta bort kärlväxter, mossor, lavar eller\nsvampar, med undantag för plockning av icke fridlysta matsvampar och\nmarklevande färgsvampar, samt bär.\n\n3 genom grävning eller på annat sätt skada mark eller vattenmiljöer.\n4 vaska efter guld eller andra mineraler.\n5 klättra i boträd eller på annat sätt medvetet störa eller skada djurlivet.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1317,"inledning_sidnummer":2,"punkt":"C.","sidnummer":3,"teckenoffset_pa_sidan":1207,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["djurlivet","störa","förbjudet"],"handlingar":["flyga","landa","lyfta","marken"],"dokument_id":"nvdok-1008763","dokument_namn":"beslut Mångmanskogen underskrivet exkl sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008763","dokument_sha256":"ccb00775f08d5c600870c3bae622140452d1e9de4367529e12d6790a80951403","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskrifterna ska inte utgöra hinder för drift och underhåll av den 10 kV luftledning som\nlöper genom området mellan de två allmänna bilvägarna. Detta innefattar bland annat att\ninom den 8 meter breda ledningsgatan röja buskar och träd och att framföra motordrivna\nmaskiner. Träd, även utanför ledningsgatan, som har fallit, eller hotar falla, över ledningen\nfår kapas och ska lämnas i reservatet.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1347,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":782,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivna"],"handlingar":["marken"],"dokument_id":"nvdok-1008763","dokument_namn":"beslut Mångmanskogen underskrivet exkl sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008763","dokument_sha256":"ccb00775f08d5c600870c3bae622140452d1e9de4367529e12d6790a80951403","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskrifterna ska inte hindra ägare till mark inom reservatet att röja och med mindre\nmotorfordon, såsom så kallad fyrhjuling, nyttja den äldre väg som löper intill älven i södra\ndelen av reservatet, se beslutskartan (bilaga 1). Röjning och nyttjande förutsätter även\nmedgivande från ägaren till marken där vägen löper.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1347,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1182,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motorfordon"],"handlingar":["marken"],"dokument_id":"nvdok-1008763","dokument_namn":"beslut Mångmanskogen underskrivet exkl sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008763","dokument_sha256":"ccb00775f08d5c600870c3bae622140452d1e9de4367529e12d6790a80951403","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtnin