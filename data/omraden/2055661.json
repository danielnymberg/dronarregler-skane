ad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"b) renskötsel i enlighet med rennäringslagen (1971:437), eller att\n      framföra motordrivet fordon vid renskötsel i enlighet med\n      gällande terrängkörningslagstiftning,","inledning":"Det är förbjudet att:","inledning_offset":1322,"inledning_sidnummer":6,"punkt":"b)","sidnummer":7,"teckenoffset_pa_sidan":674,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1024503","dokument_namn":"beslut om bildande av tjärnmyrans naturreservat.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024503","dokument_sha256":"370150c5525404a5b1da59cd962cb67ad9d49ba8d500e934ee5dedf9e9c6f1e3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"j)   uttransport av fälld älg, björn, hjort eller vildsvin. Fordon och\n        färdväg ska väljas med omsorg för att minimera mark- och\n        vegetationsskador,","inledning":"Det är förbjudet att:","inledning_offset":1322,"inledning_sidnummer":6,"punkt":"j)","sidnummer":7,"teckenoffset_pa_sidan":1890,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["Fordon"],"dokument_id":"nvdok-1024503","dokument_namn":"beslut om bildande av tjärnmyrans naturreservat.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024503","dokument_sha256":"370150c5525404a5b1da59cd962cb67ad9d49ba8d500e934ee5dedf9e9c6f1e3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"•   Svenska samernas riksförbund (SSR) lämnar övergripande\n       synpunkter på förslaget och hänvisar till berörd sameby för\n       områdesspecifika synpunkter. SSR anser att det är viktigt att\n       naturreservaten inte orsakar olägenhet för renskötseln i länet\n       men påtalar också att naturreservat bidrar till att bevara\n       naturmiljöer vilket gynnar betesområden för renen och\n       renskötseln. SSR begär också ett förtydligande om hur förbudet\n       att störa djurlivet påverkat inventeringar av järv.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":574,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["djurlivet","störa","förbudet"],"dokument_id":"nvdok-1024503","dokument_namn":"beslut om bildande av tjärnmyrans naturreservat.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024503","dokument_sha256":"370150c5525404a5b1da59cd962cb67ad9d49ba8d500e934ee5dedf9e9c6f1e3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Konsekvensutredning för ordningsföreskrifter enligt\n7 kap. 30 § miljöbalken\nEnligt förordningen (2007:1244) om konsekvensutredning vid\nregelgivning ska en bedömning om konsekvensutredning göras för\nordningsföreskrifterna enligt 7 kap. 30 § miljöbalken. Dessa föreskrifter\ngäller rätten att färdas och vistas, och ordningen i övrigt i området och\nexemplifieras i förarbetena till miljöbalken (prop. 1997/98:45) som\nförbud mot åtgärder som annars hade varit tillåtna enligt\nallemansrätten.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":16,"teckenoffset_pa_sidan":1470,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","förbud"],"dokument_id":"nvdok-1024503","dokument_namn":"beslut om bildande av tjärnmyrans naturreservat.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024503","dokument_sha256":"370150c5525404a5b1da59cd962cb67ad9d49ba8d500e934ee5dedf9e9c6f1e3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst"