ch strandkärr och förekommer förutom på Gotland bara i\nytterligare sex svenska landskap. Förekomsten i Millumträsk är en av de allra\nrikaste i landet - vid en inventering 1984 påträffades hela 8 300 exemplar!","inledning":"Utöver vad som i övrigt gäller är det förbjudet att:","inledning_offset":143,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":794,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["storsileshår","sällsynta"],"dokument_id":"nvdok-1018869","dokument_namn":"millumtrask-beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1018869","dokument_sha256":"3591c1d82a6cbb3aa4a9f2ca91838d50a34f34ee411e75ecd5c54e09c82efead","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.61607619,57.77395109],[18.61301944,57.77318964],[18.61301805,57.7731896],[18.61184101,57.7735607],[18.6118402,57.77356124],[18.6104824,57.77869337],[18.6104827,57.77869406],[18.61048348,57.77869441],[18.61226458,57.77911498],[18.61232899,57.77913008],[18.61233009,57.77912988],[18.61784136,57.77688522],[18.61994598,57.77603895],[18.62004114,57.77599625],[18.62012545,57.77595598],[18.62018463,57.77592184],[18.62023812,57.77588679],[18.62028365,57.77585238],[18.62032866,57.77581608],[18.620379,57.77577031],[18.62041703,57.77573487],[18.62045377,57.7756956],[18.62054916,57.77558423],[18.6209187,57.77515854],[18.62091843,57.77515799],[18.62091763,57.77515761],[18.62086226,57.775144],[18.61607619,57.77395109]]]]},"beraknad_area_ha":22.71,"arealavvikelse_proc