 med gott om döda och\ndöende träd i olika former. Inte minst lövträden håller på att självgallra i betydande\nomfattning. Några mindre ungskogar av olika ålder finns spritt i området, samt även ett\npar lövrika bestånd som nyligen har gallrats.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":456,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":969,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["stora","sälg"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1016302","dokument_namn":"Paljaskero_Beslut_110428.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016302","dokument_sha256":"96c5cd2b0ca9d92dad0ecbd2906cdfc3c47e1397a4e450d550676c009100c1e6","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[23.51823783,66.73635656],[23.51832407,66.73650653],[23.51832475,66.73650702],[23.51889074,66.73660024],[23.5220712,66.73638238],[23.52349355,66.7368303],[23.52576461,66.73720544],[23.52635222,66.73722759],[23.52635396,66.73722739],[23.52635763,66.73722582],[23.52635838,66.73723375],[23.5263591,66.7372344],[23.52636029,66.73723467],[23.53006407,66.73758501],[23.53931293,66.74281412],[23.53931376,66.74281441],[23.55003515,66.74405896],[23.55003647,66.74405887],[23.55305314,66.74349888],[23.55376766,66.74337929],[23.55376884,66.74337888],[23.55429531,66.74274235],[23.55433157,66.74115764],[23.55371957,66.74025267],[23.55345479,66.73976007],[23.55418088,66.73900608],[23.5552110