yddet är att bevara områdets helhetsvärden och att motverka\n        exploatering. Området har värdefulla egenskaper och strukturer som har\n        utvecklats genom att naturliga processer fått verka relativt ostört under lång\n        tid. För att områdets naturvärden ska bestå behöver det därför undantas från\n        skogsproduktion och annan exploatering som innebär att naturvärdena på-\n        tagligt skulle skadas.\n        Områden med naturskog blir alltmer sällsynta i länet och att skydda dessa\n        kvarvarande fragment av det ursprungliga skogslandskapet är viktigt för att\n        bevara den biologiska mångfalden.","inledning":"Det är vidare utan Länsstyrelsens tillstånd förbjudet att:","inledning_offset":885,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":364,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1020372","dokument_namn":"Hälltjärnberget_Beslut_SKP_Hela20161102_slut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1020372","dokument_sha256":"e8df661d385b8ba46bffcee246c01b7c97e49c36c4b870155113054ab54ad40c","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[19.55109796,64.24047419],[19.55296337,64.24167763],[19.55223912,64.24202749],[19.55192247,64.24224128],[19.55192211,64.24224182],[19.55192273,64.2422425],[19.55275774,64.24262743],[19.55295101,64.24302973],[19.55295214,64.24303009],[19.55501201,64.24331947],[19.55539545,64.24407803],[19.55835998,64.24524362],[19.55836173,64.24524386],[19.56219563,