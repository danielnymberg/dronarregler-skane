{"nvrid":"2042909","slug":"farberget","namn":"Fårberget","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Ånge","lan":"Västernorrlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Västernorrlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2014-12-10","senaste_gallandedatum":"2015-01-02","area_ha":109.48,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2042909","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Fårberget.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014500","dokument_id":"nvdok-1014500","sha256":"6a1846b65deff03d932fff03daa8b05813d4d7698187294b2aaab72de8ac60d1","sidor":11,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"C. Föreskrifter enligt 7 kap 30 § miljöbalken om rätten att färdas och vistas inom\nreservatet samt om ordningen i övrigt inom reservatet.\n\nUtöver vad som för övrigt gäller är det förbjudet att:\n  1 fälla eller på annat sätt skada levande eller döda stående och omkullfallna träd och\n    buskar.\n  2 insamla mossor, lavar eller svampar med undantag för plockning av matsvamp.\n  3 genom grävning eller på annat sätt skada mark och block.\n  4 insamla eller föra bort insekter eller andra ryggradslösa djur.\n  5 framföra motordrivet fordon. Förbudet gäller ej snöskoter på snötäckt mark.\n  6 uppföra anläggning, såsom vindskydd, koja, bänk, spång, stängsel, ledning, mast\n    eller torn.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":669,"inledning_sidnummer":2,"punkt":"C.","sidnummer":3,"teckenoffset_pa_sidan":100,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbjudet"],"dokument_id":"nvdok-1014500","dokument_namn":"Fårberget.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014500","dokument_sha256":"6a1846b65deff03d932fff03daa8b05813d4d7698187294b2aaab72de8ac60d1","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"De naturskogsartade skogarna på berget består huvudsakligen av brandpräglad\nbarrblandskog på frisk mark av ristyp. Området karaktäriseras av en stor inblandning av\nlövträd, framförallt av asp och björk men även en hel del sälg. Bergets sydsluttning\ndomineras av tall, med inslag av klent löv. Beståndsåldrarna ligger omkring 120 år, med\nförekomst av betydligt äldre granar och tallöverståndare.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":239,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":109,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["stor","sälg"],"dokument_id":"nvdok-1014500","dokument_namn":"Fårberget.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014500","dokument_sha256":"6a1846b65deff03d932fff03daa8b05813d4d7698187294b2aaab72de8ac60d1","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[15.48255517,62.59442768],[15.48227354,62.59463017],[15.48223519,62.59521295],[15.48223537,62.59521338],[15.48223592,62.59521373],[15.48363711,62.59577787],[15.48363854,62.59577812],[15.48487575,62.59555253],[15.48566376,62.59534878],[15.48633491,62.59543094],[15.48633645,62.59543086],[15.4863373,62.5954305],[15.48706867,62.59487093],[15.487704