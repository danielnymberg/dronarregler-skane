don"],"handlingar":["marken"],"dokument_id":"nvdok-1034171","dokument_namn":"Ålidbergets naturreservat_Beslut 20260319_US.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034171","dokument_sha256":"c62caaf49c63d15b5171198eea4882b0023ff3a138d07cb429fb0854a31faae5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"h) uttransport av fälld älg, björn, hjort eller vildsvin. Fordon och\n      färdväg ska väljas med omsorg för att minimera mark- och\n      vegetationsskador,","inledning":"Det är utan Länsstyrelsens tillstånd förbjudet att:","inledning_offset":719,"inledning_sidnummer":8,"punkt":"h)","sidnummer":9,"teckenoffset_pa_sidan":436,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["Fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1034171","dokument_namn":"Ålidbergets naturreservat_Beslut 20260319_US.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034171","dokument_sha256":"c62caaf49c63d15b5171198eea4882b0023ff3a138d07cb429fb0854a31faae5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Förbud mot jakt bedöms inte behövas för att uppnå syftet med\nreservatet och följaktligen finns inga föreskrifter som förhindrar det.\nUttransport av fälld älg, björn, hjort eller vildsvin på motordrivet fordon\ni terräng är tillåtet under förutsättning att fordon och färdväg väljs med\nomsorg för att minimera mark- och vegetationsskador. För möjligheten\natt utöva säker jakt är sikt- och skjutgator viktiga och de behöver oftast\nunderhållsröjas för att behålla sin funktion.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":14,"teckenoffset_pa_sidan":1578,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","Förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1034171","dokument_namn":"Ålidbergets naturreservat_Beslut 20260319_US.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034171","dokument_sha256":"c62caaf49c63d15b5171198eea4882b0023ff3a138d07cb429fb0854a31faae5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"•   För att få arrangera en tävling eller uppvisning med fordon på en\n       väg behöves tillstånd hos Länsstyrelsen enligt 3 kap. 84 §\n       trafikförordningen (1998:1275). Om arrangemanget får över mer\n       än ett län ska ansökan ske hos den länsstyrelse i det län där\n       tävlingen startar. Som fordon räknas, bilar, motorcyklar,\n       mopeder, cyklar, rullskidor, inlines och andra transportmedel på\n       hjul.","inledning":"(1988:950). Enligt 2 kap. 6 § kulturmiljölagen är det förbjudet att","inledning_offset":443,"inledning_sidnummer":22,"punkt":null,"sidnummer":22,"teckenoffset_pa_sidan":1098,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["fordon"],"handlingar":["landa","lyfta","marken"],"dokument_id":"nvdok-1034171","dokument_namn":"Ålidbergets naturreservat_Beslut 20260319_US.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034171","dokument_sha256":"c62caaf49c63d15b5171198eea4882b0023ff3a138d07cb429fb0854a31faae5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[19.35108569,63.56851174],[19.34998764,63.56834303],[19.349986,63.56834306],[19.3