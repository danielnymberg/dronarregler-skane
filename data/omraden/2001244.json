et":455,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":833,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["Störst","sälgar","sälg"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1011528","dokument_namn":"Långträskberget_Beslut_130211.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011528","dokument_sha256":"454c09b8496338ea59d5daa3b0de44fede98944347851074f61988797e0ceba8","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Reservatet bjuder på en miljö präglad av naturlig dynamik med olikåldriga träd samt rik\ntillgång på lågor och torrträd av olika trädslag och nedbrytningsgrad. Då omgivande\nlandskap är kraftigt påverkat av skogsbruk är området av stor betydelse för de växter\noch djur som behöver naturskogar för sin överlevnad. Skogsavverkning eller annan\nexploatering skulle innebära att områdets naturvärden förstörs.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":455,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1193,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["störs","stor","djur"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1011528","dokument_namn":"Långträskberget_Beslut_130211.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011528","dokument_sha256":"454c09b8496338ea59d5daa3b0de44fede98944347851074f61988797e0ceba8","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"1.    avverka eller utföra annan skogsbruksåtgärd\n                   2.    ta bort eller upparbeta dött träd eller vindfälle\n                   3.    anlägga väg, luft- eller markledning\n                   4.    uppföra eller ändra byggnad eller anläggning\n                   5.    upplåta byggnad eller anläggning för ändamål som ej är förenligt med reservatets\n                         syfte\n                   6.    anordna upplag\n                   7.    borra, gräva, schakta, utfylla, tippa, dika eller dämma\n                   8.    framföra motordrivet fordon i terräng på barmark med undantag för uttransport\n                         av redan fälld älg","inledning":"Utöver vad som eljest gäller är det förbjudet att:","inledning_offset":1574,"inledning_sidnummer":3,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":1640,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1009731","dokument_namn":"Beslut Långträskberget 97-01-10.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1009731","dokument_sha256":"4af516836ed164f38f023e3fbe4674fc9f38e560dd84f172bc3a8cc705f15459","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"1.    framföra motordrivet fordon i terräng på barmark\n                   2.    fälla eller på annat sätt skada levande eller döda stående och omkullfallna träd\n                   3.    störa djurlivet t ex genom att klättra i boträd\n                   4.    skada eller bortföra växter och djur\n                   5.    sätta upp tavla, plakat eller skyltar","inledning":"Utöver vad som eljest gäller är det förbjudet att:","inledning_offset":1259,"inledning_sidnummer":4,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1327,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"handlingar":["flyga","landa","lyfta","marken"],"dokument_id":"nvdok-1009731","dokument_namn":"Beslut Långträskberget 97-01-10.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1009731","dokument_sha256":"4af516836ed164f38f023e3fbe4674fc9f38e560dd84f172bc3a8cc7