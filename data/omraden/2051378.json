{"nvrid":"2051378","slug":"kvarneberget","namn":"Kvarneberget","skyddstyp":"Djur- och växtskyddsområde","lager":"djur-och-vaxtskydd","karnlager":true,"kommun":"Strömstad","lan":"Västra Götalands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Västkuststiftelsen","tillsynsmyndighet":null,"urspr_beslutsdatum":"2018-03-15","senaste_gallandedatum":"2019-02-01","area_ha":5.17,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2051378","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"15/2","tillDatum":"31/7"}],"sasongsdata":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"15/2","tillDatum":"31/7"}],"dokument":[{"namn":"Beslut_Kvarneberget.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1038123","dokument_id":"nvdok-1038123","sha256":"b5e3deac67860ef43eb7cddd8d9852bd4bdbc1e1cc0b1baa3a5b5c44eceecbbd","sidor":9,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Inga-Lill Tyft tillstyrker bildande av djur- och växtskyddsområde men vill dels ha\nen utökning av tillträdesförbudet till mellan 15 feb och 31 augusti, dels ha en utök-\nning av skyddsområdet till att omfatta en radie av 200 meter från mittpunkt.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":2978,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1038123","dokument_namn":"Beslut_Kvarneberget.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1038123","dokument_sha256":"b5e3deac67860ef43eb7cddd8d9852bd4bdbc1e1cc0b1baa3a5b5c44eceecbbd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Victoria Erixon Tyft, som bor i området och bedriver verksamhet på berörd fas-\ntighet, stödjer bildandet av ett djur- och växtskyddsområde men önskar med hänsyn\ntill djur- och växtlivet att tillträdesförbudet utökas till mellan den 15/2 och 31/8\nsamt att förbudsområdet utvidgas till en radie av 200 meter från mittpunkt vilket då\ninnefattar hela berget samt badplatsen. Hon understryker vidare att området på se-\nnare år utvecklats till ett populärt turistmål med besökare från hela världen vilket\nökar störningarna i naturen.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1525,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1038123","dokument_namn":"Beslut_Kvarneberget.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1038123","dokument_sha256":"b5e3deac67860ef43eb7cddd8d9852bd4bdbc1e1cc0b1baa3a5b5c44eceecbbd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Hanna Mogren, boende närmast Kvarnberget, stödjer bildandet av ett djur- och\nväxtskyddsområde men oroas över störningar från berget bakom häckningsplatsen\noch önskar därför att hela berget ska ingå i skyddet, samt att tillträdesförbudet ska\nutsträckas till sommarlovets slut för att minska tillströmningen av människor till\nområdet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":2115,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1038123","dokument_namn":"Beslut_Kvarneberget.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1038123","dokument_sha256":"b5e3deac67860ef43eb7cddd8d9852bd4bdbc1e1cc0b1baa3a5b5c44eceecbbd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Slutligen har även Haldens klatreklubb inkommit med yttrande. Föreningen mot-\nsätter sig inte ett djur- och växtskyddsområde i området men anser att föreslaget\nområde är för stort och att tillträdesförbudet är för omfattande. Föreningen föreslår\ndärför ett skyddsområde på 50–100 meter i diameter under perioden 1/3 – 15/7.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":2732,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1038123","dokument_namn":"Beslut_Kvarneberget.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1038123","dokument_sha256":"b5e3deac67860ef43eb7cddd8d9852bd4bdbc1e1cc0b1baa3a5b5c44eceecbbd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Då den tidigare frivilliga överenskommelsen mellan ornitologer och klättrare inte\nlängre är aktuell och det under Länsstyrelsens utredning visat sig omöjligt att få till\nstånd ett nytt frivilligt avtal, kvarstår ett skyddsbehov inom häckningsområdet.\nLänsstyrelsen anser därmed att ett tillträdesförbud krävs. Genom ett tillträdesför-\nbud under häckningsperioden skyddas den mest kritiska delen av häckningsområ-\ndet mot störningar från det rörliga friluftslivet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":640,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1038123","dokument_namn":"Beslut_Kvarneberget.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1038123","dokument_sha256":"b5e3deac67860ef43eb7cddd8d9852bd4bdbc1e1cc0b1baa3a5b5c44eceecbbd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"För djur- och växtskyddsområdet vid Kvarneberget/Tvetvattnet gäller förbud att\nklättra, färdas igenom eller uppehålla sig inom djur- och växtskyddsområdet under\ntiden 15 februari till 31 juli. Arealen på området är ca. 0,51 hektar. Detta innebär\nen mindre begränsning för det rörliga friluftslivet och då främst begränsande för\nbergsklättring. Det föreslagna djur- och växtskyddsområdet används av flera aktö-\nrer inom friluftsliv. Det närbelägna badet innefattas inte i det skyddade området.\nStörsta delen av djur- och växtskyddsområdet omfattas av strandskydd.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":2129,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1038123","dokument_namn":"Beslut_Kvarneberget.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1038123","dokument_sha256":"b5e3deac67860ef43eb7cddd8d9852bd4bdbc1e1cc0b1baa3a5b5c44eceecbbd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Förbuden är anpassade till djur- och växtskyddsområdets syften och värden. De är\nfrämst avsedda att begränsa störningar på djurliv. Vid en avvägning mellan en-\nskilda och allmänna intressen i enlighet med 7 kap. 25 § miljöbalken finner Läns-\nstyrelsen att förbuden inte går längre än vad som krävs för att syftet med skyddet\nska tillgodoses. Företrädare för markägaren är uttalat positiva till inrättandet av ett\ndjur- och växtskyddsområde. Markägaren är undantagen från gällande förbud.","inledning":"För djur- och växtskyddsområdet vid Kvarneberget/Tvetvattnet gäller förbud att","inledning_offset":2131,"inledning_sidnummer":6,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":209,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1038123","dokument_namn":"Beslut_Kvarneberget.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1038123","dokument_sha256":"b5e3deac67860ef43eb7cddd8d9852bd4bdbc1e1cc0b1baa3a5b5c44eceecbbd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Störningar från det rörliga friluftslivet, och då främst bergsklättring inom området\nunder häckningsperioden, bedömer Länsstyrelsen vara så betydande att ett skydd\nkrävs.","inledning":"För djur- och växtskyddsområdet vid Kvarneberget/Tvetvattnet gäller förbud att","inledning_offset":2131,"inledning_sidnummer":6,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":709,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1038123","dokument_namn":"Beslut_Kvarneberget.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1038123","dokument_sha256":"b5e3deac67860ef43eb7cddd8d9852bd4bdbc1e1cc0b1baa3a5b5c44eceecbbd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Med hänsyn till områdets värden för fågellivet och pågående störningar från fri-\nluftslivet bedömer Länsstyrelsen, efter en avvägning mot andra allmänna och en-\nskilda intressen, att områdets värden bäst ges ett långsiktigt skydd genom bildande\nav ett djur- och växtskyddsområde.","inledning":"För djur- och växtskyddsområdet vid Kvarneberget/Tvetvattnet gäller förbud att","inledning_offset":2131,"inledning_sidnummer":6,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":881,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1038123","dokument_namn":"Beslut_Kvarneberget.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1038123","dokument_sha256":"b5e3deac67860ef43eb7cddd8d9852bd4bdbc1e1cc0b1baa3a5b5c44eceecbbd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturva