{"nvrid":"2001297","slug":"gnien","namn":"Gnien","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Surahammar","lan":"Västmanlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Västmanlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"1985-03-20","senaste_gallandedatum":"2013-01-24","area_ha":236.68,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2001297","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":true,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Beslut Gnien 2008-06-27.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007934","dokument_id":"nvdok-1007934","sha256":"111a724a81edfe2be9597c84dbe4670fadbf2d09d9c26c461cf1a87431a4d1f3","sidor":14,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"Skötselplan Gnien 2008-06-27.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007565","orsak":"ej föreskriftsbärande dokumenttyp"}],"citat":[{"citat":"C. Föreskrifter enligt 7 kap. 30 & miljöbalken om rätten att färdas och vistas\ninom reservatet och om ordningen i övrigt inom reservatet\n\nUtöver vad som i övrigt gäller är det förbjudet att:\n\n1 — beträda det landområde som framgår av bilaga 1 under perioden fr o m 15\nmars — t o m 15 juli. Förbudet omfattar inte fågeltorn eller markerad stig.\n\n2 vistas inom det vattenområde som framgår av bilaga 1 under perioden fr om\n15 mars — t o m 15 maj.","inledning":"Utöver vad som annars gäller är det förbjudet att:","inledning_offset":259,"inledning_sidnummer":2,"punkt":"C.","sidnummer":3,"teckenoffset_pa_sidan":81,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["beträda","färdas","vistas","förbjudet"],"dokument_id":"nvdok-1007934","dokument_namn":"Beslut Gnien 2008-06-27.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007934","dokument_sha256":"111a724a81edfe2be9597c84dbe4670fadbf2d09d9c26c461cf1a87431a4d1f3","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Gnien består av en rad sjölika utvidgningar av Kolbäcksån, strax sydväst om\nRamnäs i Surahammars kommun. På båda sidor om vattnet finns betydande\nareal strandäng som till stor del nyttjas för betesdrift. Vattenståndet i Gnien\nvarierar med Kolbäcksån och svämmar varje år över intilliggande marker,\nvilket skapar mycket goda förutsättningar för våtmarksfåglar. Större delen\nav området utgörs av gamla slåttermarker som varit mer eller mindre öppna,\nmen i de sydöstra delarna är dessa numera huvudsakligen bevuxna med\nskog. Området utgör ett populärt utflyktsmål. Gnien ingår i Strömsholms\nkanal och är därmed allmän farled. Båt- och kanottrafiken i sjön kulminerar\nunder sommaren.","inledning":"Utöver vad som i övrigt gäller är det förbjudet att:","inledning_offset":219,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":926,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["Större","fåglar","stor"],"dokument_id":"nvdok-1007934","dokument_namn":"Beslut Gnien 2008-06-27.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007934","dokument_sha256":"111a724a81edfe2be9597c84dbe4670fadbf2d09d9c26c461cf1a87431a4d1f3","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.17775759,59.75058714],[16.17775786,59.75058789],[16.1777584,59.75058816],[16.1777595,59.75058833],[16