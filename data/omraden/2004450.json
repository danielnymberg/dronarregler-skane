_namn":"Beslut_Korvgrund_2010.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042162","dokument_sha256":"b7f9a50e31e59e685c077981d60cec4482bc1f2af2321f92210249b6f359f003","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Syftet med Korvgrund m.fl. djurskyddsområde är att skydda och bevara den\nvärdefulla faunan av häckande och rastande fåglar. Mer specifikt är syftet att\nskydda och bevara öarnas kolonier med häckande tordmule, tobisgrissla, silltrut\noch silvertärna samt övriga häckande fåglar som roskarl och ejder. Störningar\nfrån människor ska minimeras under den tid på året då sjöfåglar häckar på\nKorvgrund, Skottstenarna och Remmarharet genom att beträdnadsförbud då ska\ngälla.","inledning":"För området gäller följande förvaltningsföreskrifter:","inledning_offset":653,"inledning_sidnummer":2,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":204,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["djurskyddsområde","Störningar","kolonier","förbud"],"dokument_id":"nvdok-1042162","dokument_namn":"Beslut_Korvgrund_2010.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042162","dokument_sha256":"b7f9a50e31e59e685c077981d60cec4482bc1f2af2321f92210249b6f359f003","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.42498475,61.84215193],[17.42491409,61.84216968],[17.42481521,61.84219635],[17.42471148,61.84222856],[17.42461233,61.84226393],[17.42451827,61.842