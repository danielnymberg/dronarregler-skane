947","dokument_sha256":"e6454f80b85d6afad492df11cbfe8d4673d5a4ff7ac925ed9cb3807f967e9d9f","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Beskrivning av reservatet\n        Djupsjöbrännans naturreservat ligger ca 4 km nordost om Yxsjö. Reservatet\n        ligger mellan en mindre trafikerad väg och Gigån. Området utgörs av ett\n        mindre naturskogsområde med barrnaturskog. Det finns ett visst inslag av\n        äldre och grövre aspar samt enstaka sälgar. I fuktdrågen återfinns ett större\n        inslag av klenare björk. Området har höga naturvärden knutna till det\n        naturskogsartade tillståndet, med god förekomst av strukturer som gamla\n        tallar och granar på ca 200 år, torrakor av tall samt liggande död ved i olika\n        dimensioner och nedbrytningsstadier.","inledning":"Det är vidare utan Länsstyrelsens tillstånd förbjudet att:","inledning_offset":667,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1754,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["större","sälgar"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1019947","dokument_namn":"Djupsjöbrännan_beslut och skötselplan_ej_sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019947","dokument_sha256":"e6454f80b85d6afad492df11cbfe8d4673d5a4ff7ac925ed9cb3807f967e9d9f","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.53637605,64.31485482],[17.5356047,64.3