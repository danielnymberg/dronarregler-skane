dokument/1019833","dokument_sha256":"c20a8c23315100cf2795394891946063b10f98fd82d838c2e80e2e186ee46bbb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Forsakarsområdet har under lång tid haft stor betydelse för människan, vilket åter-\nspeglas i de fossila åkermarker, en stensättning och boplats som påträffats i områ-\ndet och som eventuellt sträcker sig ända tillbaka till stenåldern. Ett flertal sägner\nfinns knutna till den trolska Forsakarsravinen och ända in på 1900-talet var det\nmånga som inte vågade sig in i ravinen av rädsla för de sagoväsen som bodde där.\nUtredningsområdet tillhör två byar, Degeberga och Borråkra. Kartor från\n1700-och 1800-talen visar att Borråkras marker, norr om ravinen, i huvudsak nytt-\njades för åker- och slåtterbruk. Degebergas marker utgjordes i huvudsak av sam-\nfällda utmarker.","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att","inledning_offset":377,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":460,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["boplats","stor"],"dokument_id":"nvdok-1019833","dokument_namn":"Forsakar med Lillaforsskogen BESLUT 2006.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019833","dokument_sha256":"c20a8c23315100cf2795394891946063b10f98fd82d838c2e80e2e186ee46bbb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"2. framföra motordrivet fordon, rida eller cykla, annat än på allmän väg,","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att","inledning_offset":126,"inledning_sidnummer":4,"punkt":"2.","sidnummer":4,"teckenoffset_pa_sidan":229,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1010824","d