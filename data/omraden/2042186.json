{"nvrid":"2042186","slug":"tossebergsklatten","namn":"Tossebergsklätten","skyddstyp":"Djur- och växtskyddsområde","lager":"djur-och-vaxtskydd","karnlager":true,"kommun":"Sunne","lan":"Värmlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Värmlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2014-03-17","senaste_gallandedatum":"2014-03-17","area_ha":0.44,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2042186","svarslage":"reglerat-las-beslutet","luftfartslage":"luftfart","ocr":true,"foreskriftsomraden":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"15/7"}],"sasongsdata":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"15/7"}],"dokument":[{"namn":"Tossebergskätten DSO beslutsorigina 140317l.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1039304","dokument_id":"nvdok-1039304","sha256":"9e5bafdc1fd14440f1f863a4298465cb87faac425cf2a7907374af12eeee905d","sidor":6,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Tillträdesförbudet gäller även om det överklagas.","inledning":"det förbjudet att:","inledning_offset":529,"inledning_sidnummer":1,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":972,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["Tillträdesförbudet","förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1039304","dokument_namn":"Tossebergskätten DSO beslutsorigina 140317l.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1039304","dokument_sha256":"9e5bafdc1fd14440f1f863a4298465cb87faac425cf2a7907374af12eeee905d","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"LÄNSSTYRELSENS MOTIVERING\nEnligt EU:s fågeldirektiv (2009/147/EG) ska Sverige vidta åtgärder för att\nsäkerställa fortplantningen hos de arter som listas i direktivets bilaga 1. En\nav de arter som listas i bilagan häckar inom det aktuella området på\nTossebergsklätten, mycket nära startrampen. Inom området bedrivs också\nbåde skärmflygning och hängflygning (drakflygning) under den tid på året\ndå området också hyser häckning av de störningskänsliga fåglarna.\nAktiviteterna vid flygningarnas startplats innebär så stor störning på\nfåglarna att häckningen löper stor risk att misslyckas, vilket bl a var fallet\n2011.\nLänsstyrelsen har vid två tillfällen kontrollerat störningskänsligheten i fält.","inledning":"det förbjudet att:","inledning_offset":529,"inledning_sidnummer":1,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":1023,"klassificering":"start-landningsförbud","konfidens":"medel","traffade_ord":["flygningarnas","startrampen","startplats"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1039304","dokument_namn":"Tossebergskätten DSO beslutsorigina 140317l.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1039304","dokument_sha256":"9e5bafdc1fd14440f1f863a4298465cb87faac425cf2a7907374af12eeee905d","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"beslutade Länsstyrelsen att bilda ett fågelskyddsområde runt\nhäckningsplatsen. Beslutet överklagades dock av de berörda föreningarna.\nMark- och miljödomstolen upphävde Länsstyrelsens beslut 13-06-28 och\nåterförvisade ärendet till Länsstyrelsen för förnyad handläggning med\nmotivering rörande brister i den del av handläggningen som rör\nsakägarskapet och rätten att överklaga beslutet. Domstolen berörde alltså\ninte sakfrågan, dvs om skälen till införande av tillträdesförbud.","inledning":"det förbjudet att:","inledning_offset":529,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":80,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1039304","dokument_namn":"Tossebergskätten DSO beslutsorigina 140317l.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1039304","dokument_sha256":"9e5bafdc1fd14440f1f863a4298465cb87faac425cf2a7907374af12eeee905d","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Skärmflygklubben Solskärmarna har avstyrkt förslaget med bl a hänvisning\ntill att tillträdesförbudet är en kraftig begränsning av deras idrottsutövande.\nÄven Sunne hängflygklubb motsätter sig införande av ett tillträdesförbud\noch önskar mer av samarbete, t ex med utplacering av bolådor som\nalternativ till den aktuella boplatsen","inledning":"det förbjudet att:","inledning_offset":529,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":939,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","tillträdesförbud","förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1039304","dokument_namn":"Tossebergskätten DSO beslutsorigina 140317l.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1039304","dokument_sha256":"9e5bafdc1fd14440f1f863a4298465cb87faac425cf2a7907374af12eeee905d","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Verksamhet som stör den aktuella fågelarten, särskilt under häckningstiden,\när förbjuden. Det finns redan idag en alternativ boplats där häckningen har\nlyckats tidigare. Det finns därför inget behov av att skapa nya konstgjorda\nboplatser just nu. Sådana åtgärder kan bli aktuella i ett senare skede men det\nkräver markägarens tillstånd.","inledning":"det förbjudet att:","inledning_offset":529,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":1318,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["häckningstiden","fågelarten","häckningen","förbjuden"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1039304","dokument_namn":"Tossebergskätten DSO beslutsorigina 140317l.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1039304","dokument_sha256":"9e5bafdc1fd14440f1f863a4298465cb87faac425cf2a7907374af12eeee905d","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Om nämnda fågelpar väljer att häcka på annan plats i närheten, som det\ngjorde tidigare, kan Länsstyrelsen komma att upphäva tillträdesförbudet\nmed kort varsel.","inledning":"det förbjudet att:","inledning_offset":529,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":1972,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1039304","dokument_namn":"Tossebergskätten DSO beslutsorigina 140317l.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1039304","dokument_sha256":"9e5bafdc1fd14440f1f863a4298465cb87faac425cf2a7907374af12eeee905d","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.08714737,59.97922633],[13.08770316,59.97928174],[13.08770435,59.97928167],[13.08770524,59.97928128],[13.08816078,59.97863162],[13.08800297,59.97836469],[13.08800193,59.97836408],[13.08743525,59.97835579],[13.08743441,59.97835587],[1