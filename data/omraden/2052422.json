{"nvrid":"2052422","slug":"vattholmsskaren","namn":"Vattholmsskären","skyddstyp":"Naturreservat","lager":"naturreservat-kommunalt","karnlager":true,"kommun":"Leksand","lan":"Dalarnas Län","beslutsstatus":"Gällande","beslutsmyndighet":"Kommun","forvaltare":"Leksands kommun","tillsynsmyndighet":null,"urspr_beslutsdatum":"2017-05-08","senaste_gallandedatum":"2018-03-07","area_ha":58.0,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2052422","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Vattholmsskären_Beslut_20170508.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025017","dokument_id":"nvdok-1025017","sha256":"2c9978f65e5286f67d0a008118005e99c8becfbf7b3ab64912cfcb30470f2f03","sidor":19,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"Vattholmsskären.jpg","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025423","orsak":"ej föreskriftsbärande dokumenttyp"}],"citat":[{"citat":"Avvägning mellan allmänna och enskilda intressen\nFöreskrifterna är anpassade till naturreservatets syften och värden. De är främst\navsedda att begränsa skador på mark samt växt- och djurliv. Vid en avvägning mellan\nenskilda och allmänna intressen i enlighet med 7 kap 25 § miljöbalken finner\nLeksands kommun att föreskrifterna inte går längre än vad som krävs för att syftet\nmed skyddet ska tillgodoses.\nDet är främst tillträdesförbudet under häckningssäsong som kan kännas begränsande\nför allmänheten, men bedöms som ringa eftersom det som regel inte sker någon\nlandstigning på skären.\nBeslutet är förenligt med hushållningsbestämmelserna för mark och vattenområden.\n(enligt 3 kap. Miljöbalken).","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":0,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","förbudet"],"dokument_id":"nvdok-1025017","dokument_namn":"Vattholmsskären_Beslut_20170508.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025017","dokument_sha256":"2c9978f65e5286f67d0a008118005e99c8becfbf7b3ab64912cfcb30470f2f03","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"5. Framföra motordrivet fordon i terrängen, gäller både barmark och snötäckt mark,\nmed följande undantag:","inledning":"I naturreservatet är det förbjudet att:","inledning_offset":1338,"inledning_sidnummer":4,"punkt":"5.","sidnummer":4,"teckenoffset_pa_sidan":1861,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1025017","dokument_namn":"Vattholmsskären_Beslut_20170508.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025017","dokument_sha256":"2c9978f65e5286f67d0a008118005e99c8becfbf7b3ab64912cfcb30470f2f03","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Plandel\n2 Avvägningar mellan bevarandevärden\n\n2.1 Syfte med naturreservatet\nVattholmsskärens fågelliv är unikt för länet och skyddas för den biologiska\nmångfaldens skull.\nBildandet av naturreservatet innebär ett områdesskydd som är gynnsamt främst för\nungfågelreproduktionen.\nGrundet som omger skären är en mycket värdefullt moränbotten som attraherar\nfiskreproduktion. Genom ett skydd förstärks en biotop, avsedd också för sportfiske.\nFör friluftslivet, främst det båtburna, är Vattholmsskären också en attraktion.\nFågellivet på skären är unikt och kan skådas från båt under tid för tillträdesförbud.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":14,"teckenoffset_pa_sidan":0,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"dokument_id":"nvdok-1025017","dokument_namn":"Vattholmsskären_Beslut_20170508.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025017","dokument_sha256":"2c9978f65e5286f67d0a008118005e99c8becfbf7b3ab64912cfcb30470f2f03","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.85945806,60.85445248],[14.87463899,60.85296901],[14.87463974,60.85296855],[14.87463983,60.85296797],[14.87463949,60.85296761],[14.86642753,60.84743032],[14.86642651,60.84742996],[14.86642525,60.84742997],[14.85023365,60.8500815],[14.85023293,60.8500817],[14.85023232,60.85008222],[14.85023242,60.85008281],[14.85023288,60.85008315],[14.85945703,60.85445222],[14.85945806,60.85445248]]]]},"beraknad_area_ha":57.68,"arealavvikelse_procent":-0.55,"bbox":[14.850232,60.84743,14.87464,60.854452]}