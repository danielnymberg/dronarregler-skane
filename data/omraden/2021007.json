jälvgallra\nvilket producerar ännu mer död ved. Fläckvis finns partier med örtrik vegetation i\nristypen.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":1906,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1795,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1011130","dokument_namn":"Tallberget_beslut_100608_inkl alla bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011130","dokument_sha256":"f0ed58f95629be5e8d26d7e8cddd84cb71b740a4c528d898faaf3229a4f0c784","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[22.16775903,66.42881144],[22.16614291,66.42857654],[22.16614144,66.42857651],[22.16144764,66.42950498],[22.16144661,66.42950536],[22.16144627,66.4295059],[22.16430081,66.4342428],[22.16497021,66.4353379],[22.1654331,66.43598194],[22.16627369,66.43686476],[22.16735266,66.43784885],[22.17039068,66.44062009],[22.17039197,66.4406206],[22.17039333,66.44062067],[22.17039489,66.4406203],[22.17363527,66.43894765],[22.1736355,66.43894722],[22.17361888,66.43831281],[22.17400874,66.43776631],[22.17397633,66.43756763],[22.17469649,66.43744756],[22.17554077,66.43725706],[22.17609819,66.43742412],[22.1761,66.4374243],[22.17642745,66.43737926],[22.17777023,66.43718912],[22.17871519,66.4390725],[22.1774296,66.43950922],[22.17719862,66.4401165],[22.17719891,66.4401169],[22.1771996,66.44011722],[22.17844684,66.44049348],[22.17844856,66.44049367],[22.17916732,66.44034917],[22.180