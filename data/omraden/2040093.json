grafisk utglesning av\n         viktiga livsmiljöer. Flera av de sällsynta arter som finns i området är också\n         beroende av en hög och jämn luftfuktighet. Avverkningar eller utglesningar\n         leder ofelbart till ökad uttorkningsrisk varvid dessa känsliga arter riskeras.","inledning":"Utöver vad som annars gäller i lagar och författningar är det i naturreservatet\n         förbjudet att:","inledning_offset":551,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":2577,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1014806","dokument_namn":"Myrbråten beslut m bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014806","dokument_sha256":"357b42d20a20b8a2fdeeda1fb50242168982ab42f3f97772c560fec5776aecbe","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[11.94008939,59.53737781],[11.93999558,59.53742446],[11.93991294,59.5375297],[11.93991343,59.53753037],[11.93996203,59.53755811],[11.939963,59.53755841],[11.940183,59.53756495],[11.94024833,59.53761176],[11.94026401,59.53770655],[11.94012936,59.53787781],[11.9401326,59.53800372],[11.94006001,59.53810009],[11.9400602,59.53810047],[11.94006098,59.53810091],[11.94017944,59.5381355],[11.94024071,59.53821812],[11.94023663,59.53825393],[11.94018898,59.53828409],[11.94018691,59.53830194],[11.94019537,59.53831614],[11.94019629,59.53831672],[11.94396382,59.53855501],[11.94481026,59.53889655],[11.94502206,59.5389763],[11.9453016,59.53908099],[11.94546451,59.53914602],[11.94614