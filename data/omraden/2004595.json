6,"inledning_sidnummer":4,"punkt":"C.","sidnummer":5,"teckenoffset_pa_sidan":1451,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1007792","dokument_namn":"Beslut Ettak strömmar .pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007792","dokument_sha256":"dd5995b0e00c22b1b97bcfee5aedb634b904b3fe5534c9a2b9d3aab43f26fef3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"3. Färdas med kanot eller annan farkost mellan Ågårdsbron och Ettaks-\n    bron. Transport skall ske på särskild anvisad transportled.","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":1595,"inledning_sidnummer":5,"punkt":"3.","sidnummer":5,"teckenoffset_pa_sidan":1789,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1007792","dokument_namn":"Beslut Ettak strömmar .pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007792","dokument_sha256":"dd5995b0e00c22b1b97bcfee5aedb634b904b3fe5534c9a2b9d3aab43f26fef3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"5. Ställa upp motordrivet fordon, husvagn eller släpvagn annat än på sär-\n    skilt anvisade platser","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":1595,"inledning_sidnummer":5,"punkt":"5.","sidnummer":5,"teckenoffset_pa_sidan":1977,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1007792","dokument_namn":"Beslut Ettak strömmar .pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007792","dokument_sha256":"dd5995b0e00c22b1b97bcfee5aedb634b904b3fe5534c9a2b9d3aab43f26fef3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"6. Framföra motordrivet fordon annat än på befintliga vägar","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":1595,"inledning_sidnummer":5,"punkt":"6.","sidnummer":5,"teckenoffset_pa_sidan":2078,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1007792","dokument_namn":"Beslut Ettak strömmar .pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007792","dokument_sha256":"dd5995b0e00c22b1b97bcfee5aedb634b904b3fe5534c9a2b9d3aab43f26fef3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Strandpartierna närmast ån domineras av klibbal. Speciellt bör framhållas en\ngrovvuxen sumpskog av klibbal (ca 7 ha) som sträcker sig från Ettaksbron\noch ungefär 800 m uppströms på ömse sidor om ån. Förutom klibbal växer\ninom reservatet hägg, lönn, rönn, asp, brakved, ask, tall och gran. Vissa ex-\nemplar av barrträden har nått ansenlig storlek. Bland den mera särpräglade\nfloran bör framför allt omnämnas den sällsynta ormbunken, safsa, som här\nväxer på en av sina nordligaste lokaler. På en fuktäng nedströms Ettaksbron\nväxer ett fint bestånd av klockgentiana.","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":1595,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":879,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1007792","dokument_namn":"Beslut Ettak strömmar .pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007792","dokument_sha256":"dd5995b0e00c22b1b97bcfee5aedb634b904b3fe5534c9a2b9d3aab43f26fef3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Ettaks strömmar är en viktig lokal för fåglar knutna till strömmande vatten.\nStrömstare, forsärla och kungsfiskare ses regelbundet vid vattendraget.\nBland sjöfåglar kan nämnas gräsand, storskrake, knipa och vid enstaka till-\nfällen småskrake. Vidare har man sett eller hört mer sällsynta fåglar som\nkornknarr, flodsångare och gräshoppsångare. De låglänta madmarkerna mel-\nlan Ettaksbron och Lillån utgör vid översvämning på våren en omtyckt rast-\nlokal för gäss, tranor och vadarfåglar.","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":1595,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":1764,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1007792","dokument_namn":"Beslut Ettak strömmar .pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007792","dokument_sha256":"dd5995b0e00c22b1b97bcfee5aedb634b904b3fe5534c9a2b9d3aab43f26fef3","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.89559511,58.09135034],[13.89640503,58.09280026],[13.89758823,58.09449068],[13.89748033,58.09528131],[13.89654708,58.09508877],[13.89654601,58.09508873],[13.89654536,58.09508888],[13.89654468,58.09508931],[13.89654457,58.09508988],[13.89674655,58.09535699],[13.89681548,58.09558833],[13.89694761,58.09588057],[13.89695478,58.0961045],[13.89694521,58.09641462],[13.89696741,58.09663194],[13.89698562,58.09675418],[13.89715758,58.0969959],[13.89739802,58.09713558],[13.89761234,58.09742411],[13.89780247,58.09773468],[13.89791224,58.09783621],[13.89791278,58.09783653],[13.89791352,58.09783669],[13.89811724,58.09785655],[13.89815944,58.09803364],[13.89819043,58.09826303],[13.8981942,58.09859439],[13.89819488,58.09859483],[13.89819627,58.09859498],[13.89845149,58.0