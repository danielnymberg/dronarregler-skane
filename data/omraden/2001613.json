7","dokument_namn":"Altarliden_Beslut_och_Skötselplan_US_20251217.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047387","dokument_sha256":"ec7ecc9716019205bb06fe1893be7d8c4bc8ca1fe5fbb507bdda2ca657c9c7b8","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"b) renskötsel i enlighet med rennäringslagen (1971:437) samt\n      framförande av motordrivet fordon vid renskötsel i enlighet med\n      gällande terrängkörningslagstiftning,","inledning":"Det är förbjudet att:","inledning_offset":2084,"inledning_sidnummer":7,"punkt":"b)","sidnummer":8,"teckenoffset_pa_sidan":1321,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1047387","dokument_namn":"Altarliden_Beslut_och_Skötselplan_US_20251217.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047387","dokument_sha256":"ec7ecc9716019205bb06fe1893be7d8c4bc8ca1fe5fbb507bdda2ca657c9c7b8","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsen bedömer att det i detta reservat inte finns skäl att\n       upphäva det tidigare beslutets förbud mot motordrivet fordon i\n       terrängen. Länsstyrelsen delar uppfattningen att det är inom\n       ramen för bevarandet av naturmiljöer som naturreservatet ska\n       tillgodose behovet av områden för friluftslivet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":11,"teckenoffset_pa_sidan":2274,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1047387","dokument_namn":"Altarliden_Beslut_och_Skötselplan_US_20251217.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047387","dokument_sha256":"ec7ecc9716019205bb06fe1893be7d8c4bc8ca1fe5fbb507bdda2ca657c9c7b8","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Förbud mot jakt bedöms inte behövas för att uppnå syftet med\nreservatet och följaktligen finns inga föreskrifter som förhindrar det.\nUttransport av fälld älg, björn eller hjort på motordrivet fordon i\nterräng är tillåtet under förutsättning att fordon och färdväg väljs med\nomsorg för att minimera mark- och vegetationsskador. För möjligheten\natt utöva säker jakt är sikt- och skjutgator viktiga och de behöver oftast\nunderhållsröjas för att behålla sin funktion. Där sikt- och skjutgator\nredan är etablerade bedöms ett upprätthållande att dessa genom\nröjning eller kvistning av sly inte skada naturmiljön annat än marginellt\noch påverkar därför inte det huvudsakliga syftet med reservatet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":15,"teckenoffset_pa_sidan":395,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","Förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1047387","dokument_namn":"Altarliden_Beslut_och_Skötselplan_US_20251217.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1047387","dokument_sha256":"ec7ecc9716019205bb06fe1893be7d8c4bc8ca1fe5fbb507bdda2ca657c9c7b8","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.80083449,64.78195617],[18.80396994,64.78189944],[18.80561341,