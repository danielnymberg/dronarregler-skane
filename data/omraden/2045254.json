ar/rest/dokument/1019899","dokument_sha256":"195b11ab8d8e6241bd4e945589cb4e7ce305cc4902b2cfbe9085544e64b3a427","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Översiktlig beskrivning av reservatet\n        Klippfäbodarna ligger ca 2 mil nordväst om Dorotea på mellan 530 och 600\n        m ö h. Större delen av området täcks av skiktad naturskogsartad granskog\n        med inslag av björk, rönn och sälg. Skogen på nordsluttningen av\n        Kallkällklippen är mycket lövrik. Beståndsåldern på skogen är omkring 150\n        år, med inslag av en del äldre granar på uppemot 300 år. Större delen av\n        området är myrmosaikartat, varav en del myrar utgörs av artrika rikkärr. En\n        skogsbilväg gränsar till området i öster och i de södra delarna av området\n        ligger en gammal fäboplats.","inledning":"Det är förbjudet att:","inledning_offset":439,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":289,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["boplats","Större","sälg"],"dokument_id":"nvdok-1019899","dokument_namn":"Klippfäbodarna_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019899","dokument_sha256":"195b11ab8d8e6241bd4e945589cb4e7ce305cc4902b2cfbe9085544e64b3a427","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.18351196,64.44771963],[16.17915156,64.44825388],[16.17915078,64.44825405],[16.17915002,64.4482545],[16.17847138,64.450249