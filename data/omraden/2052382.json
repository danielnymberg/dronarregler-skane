{"nvrid":"2052382","slug":"kjugekull","namn":"Kjugekull","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Kristianstad","lan":"Skåne Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Skåne län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2019-11-15","senaste_gallandedatum":"2024-09-26","area_ha":65.1,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2052382","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Beslut.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1013477","dokument_id":"nvdok-1013477","sha256":"1072fc4ffa123c5bb8e390815c295f8e26c34712703e612ea9b68e2fbcd49513","sidor":70,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"C. Ordningsföreskrifter med stöd av 7 kap. 30 § miljöbalken om rätten\natt färdas och vistas samt ordningen i övrigt inom naturreservatet\n\nUtöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att:","inledning_offset":532,"inledning_sidnummer":4,"punkt":"C.","sidnummer":5,"teckenoffset_pa_sidan":868,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1013477","dokument_namn":"Beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1013477","dokument_sha256":"1072fc4ffa123c5bb8e390815c295f8e26c34712703e612ea9b68e2fbcd49513","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Undantag från föreskrifter\nOvanstående föreskrifter under A och C utgör inte hinder för:\n   •   förvaltaren, eller den som Länsstyrelsen utser, att utföra de åtgärder som behövs\n       för reservatets vård och skötsel och som framgår av föreskrifter B1-10.\n   • tillsyn i samband med förvaltarens skötsel av området,\n   • driftåtgärder av vid tidpunkten för detta beslut befintliga vägar för\n     motorfordon, vägkanter, vägdiken eller enskilda brukningsvägar. Exempel\n     på driftåtgärder som ovan åsyftas är: lagning av mindre beläggningsskador\n     och potthål, röjning och slåtter av vägslänter eller rensning av vägtrummor.","inledning":"Vidare är det förbjudet att utan länsstyrelsens tillstånd:","inledning_offset":1984,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":516,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1013477","dokument_namn":"Beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1013477","dokument_sha256":"1072fc4ffa123c5bb8e390815c295f8e26c34712703e612ea9b68e2fbcd49513","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskriften C8 ska tolkas som att större tävlingsarrangemang är förbjudna utan\nförvaltarens tillstånd året runt. Det som står om perioden 21 april – 10 juli finns\nunder ett avsnitt i beslutet som heter upplysningar och vars syfte är att lite närmre\nbeskriva varför föreskriften finns. Datumspannet ovan beskriver, som ett exempel,\nnär fågelfaunan är extra känslig för störningar. Träningsorientering under ovan\nnämnda tidsperiod går att genomföra efter skriftligt tillstånd av reservatförvaltaren\n(se första stycket).\nLänsstyrelsen välkomnar en dialog om känsliga områden.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":65,"teckenoffset_pa_sidan":377,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1013477","dokument_namn":"Beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1013477","dokument_sha256":"1072fc4ffa123c5bb8e390815c295f8e26c34712703e612ea9b68e2fbcd49513","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Kristianstads kommun\nKommunen är positiv till bildandet av naturreservatet Kjugekull men vill framföra\nnågra frågeställningar:\n   • Anser att det är av vikt att reservatsföreskrifterna inte påverkar\n        utbyggnaden av kommunalt VA. Kommunen vill att undantag från\n        reservatsföreskrifterna görs så att de inte enbart gäller befintliga ledningar\n        utan även omfattar framtida utbyggnad av VA-nätet.\n   • Skötselplanen kan kompletteras så att det går att sätta sopkärl och bygga\n        toalett vid parkeringsplatsen.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":65,"teckenoffset_pa_sidan":952,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1013477","dokument_namn":"Beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1013477","dokument_sha256":"1072fc4ffa123c5bb8e390815c295f8e26c34712703e612ea9b68e2fbcd49513","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.36003328,56.07855517],[14.35951719,56.07870068],[14.3587892,56.07893483],[14.35878851,56.07893524],[14.35877244,56.07903483],[14.35881259,56.07913751],[14.35887151,56.07925985],[14.35890439,56.07942439],[14.35882627,56.07975292],[14.3588431,56.07983233],[14.35886511,56.07987908],[14.35898936,56.08005188],[14.35928482,56.08041968],[14.36000755,56.0808446],[14.36050847,56.08106735],[14.36100099,56.08120618],[14.36269909,56.08345091],[14.36274411,56.08350549