rängmatchning efter dokumenterad normalisering"},{"citat":"Trafik med terrängfordon\nKörning i terräng med motordrivet fordon regleras av terrängkörningslagen med tillhörande förordningar, SFS\n1975:1313. Här anges bland annat att körning i terräng med motordrivet fordon för annat ändamål än jordbruk\neller skogsbruk alltid är förbjuden på barmark och att den är förbjuden på snötäckt skogsmark med plant- eller\nungskog samt på snötäckt jordbruks-mark, om det inte är uppenbart att körningen kan ske utan risk för skada på\nmarken.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":10,"teckenoffset_pa_sidan":2213,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["terrängfordon","motordrivet","fordon","förbjuden"],"dokument_id":"nvdok-1042676","dokument_namn":"Handöl Föreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042676","dokument_sha256":"ecc5959692f7e2c6e3d332c303d9c3ff616bce2494a2ff08b5188211ef9e8d56","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[12.22305813,63.18245464],[12.22404314,63.18284764],[12.22431687,63.18368985],[12.2251842,63.18423265],[12.22518538,63.1842328],[12.22653677,63.18423095],[12.22880633,63.18404568],[12.23071307,63.18438113],[12.23146583,63.18520836],[12.23189762,63.18590191],[12.23442093,63.18704332],[12.23567867,63.18764972],[12.23641464,63.18764129],[12.23641573,63.18764114],[12.23769199,63.18712563],[12.24143668,63.18529749],[12.24435046,63.18488572],[12.24578829,63.