nde:","inledning_offset":360,"inledning_sidnummer":2,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":2443,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["störningar","djurliv"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1026831","dokument_namn":"2023_beslut om ändrade ordningsföreskrifter med bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026831","dokument_sha256":"25e415da909641276a3ccda1111fba24814cc965b62079c805f1551c6f46b880","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskrift 6. Länsstyrelsen bedömer att den tidigare regleringen av upplag samt\n            förtöjning av båtar och andra farkoster går längre än vad som krävs för att syftet\n            ska uppnås. Det föreslås således ett tillägg med tidshänvisning under tiden mellan\n            den 15 maj – 31 augusti för när föreskriften ska gälla. Denna tidsangivelse har\n            fungerat bra i andra likande reservat där besökstrycket är högt. Genom\n            tidsangivelsen förhindrar vi att båtar läggs upp och blockerar stränderna under\n            perioden för högsäsong då det är flest besökare i området.","inledning":"Föreskrift 3. Eldning har tidigare varit förbjudet. Länsstyrelsen anser dock att","inledning_offset":1264,"inledning_sidnummer":3,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":2662,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["farkoster"],"handlingar":["marken"],"dokument_id":"nvdok-1026831","dokument_namn":"2023_beslut om ändrade ordningsföreskrifter med bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026831","dokument_sha256":"25e415da909641276a3ccda1111fba24814cc965b62079c805f1551c6f46b880","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Det tidigare förbudet i ordningsföreskrifterna att; Framföra motordrivet fordon\n            eller arbetsfordon annat än till och från parkeringsplatsen markerad i bilaga 1E,\n            plockas bort med hänvisning till att vägarna inom naturreservatet är enskilda och\n            skyltade med vägmärke om privat väg. I naturvårdsverkets vägledning kring\n            allemansrätten på enskild väg står det att markägare eller vägens ägare som vill\n            minska risken för slitage på vägen från utomstående trafik, själva kan bestämma\n            om trafik med motorfordon ska förbjudas. Förbudet ska då tydligt skyltas med\n            vägmärke och/eller bom.","inledning":"utan markägarens tillstånd och att åtgärden regleras i A-föreskrifterna. Genom att","inledning_offset":327,"inledning_sidnummer":4,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1699,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","motorfordon","fordon","förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1026831","dokument_namn":"2023_beslut om ändrade ordningsföreskrifter med bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026831","dokument_sha256":"25e415da909641276a3ccda1111fba24814cc965b62079c805f1551c6f46b880","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Vidare skriver Kustbevakningen i sitt yttrande att det är rimligt att förbudet om att\n            tomgångsköra motor och använda motordrivet laddningsaggregat istället för att\n            vara absolut ges en tidsgräns på exempelvis en minut, eftersom det av\n            säkerhetsskäl för att undvika landstötning kan vara nödvändigt att ha en båt på\n            tomgång exempelvis i samband med losskastning och förtöjning.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1610,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","motor","förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1026831","dokument_namn":"2023_beslut om ändrade ordningsföreskrifter med bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026831","dokument_sha256":"25e415da909641276a3ccda1111fba24814cc965b62079c805f1551c6f46b880","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Diarienummer      Sida\n                                             2015-10-07              511-13656-2013   4(14)\n\n\n\nSyftet ska tryggas genom att\n• nytillkommande verksamhet som tar mark eller vatten i anspråk och som\n   innebär skador på mark, vegetation eller i den marina miljön och som\n   förändrar landskapets orörda karaktär inte tillåts\n• besöksnäringen bedrivs och utvecklas på ett sätt som är anpassat till om-\n   rådets höga natur- och kulturmiljövärden\n• friluftslivet kanaliseras för att undvika störningar på känsligt djurliv och\n   slitage på känslig vegetation samtidigt som behovet av goda naturupple-\n   velser som stillhet, avskildhet och tystnad erbjuds.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":69,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["störningar","djurliv","är inte tillåts"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1025350","dokument_namn":"Beslut Västra Rossö 2015.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025350","dokument_sha256":"428d2f255e96333550657d027fb04b9d61faf7c929897ef0f354c81b581455b2","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Ordningsföreskrifter om rätten att färdas och vistas inom naturreserva-\n   tet samt om ordningen i övrigt inom naturreservatet (7 kap 30 §)\nDet