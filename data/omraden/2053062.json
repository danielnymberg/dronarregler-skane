 exploatering\nsom skulle innebär att områdets naturvärden påtagligt kan komma att skadas. Vidare\nbehövs skötselinsatser för att naturvärdena ska bestå och stärkas. Länsstyrelsen bedömer\ndärför att området bör skyddas som naturreservat.","inledning":"Utöver föreskrifter och förbud i lagar och andra författningar är det förbjudet att:","inledning_offset":662,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1083,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurarter","stor"],"dokument_id":"nvdok-1020130","dokument_namn":"Bångmossen Beslut- Skötselplan 2020-09-21.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1020130","dokument_sha256":"7ead4b4739977b670dcd2b9d3e97c2941b67a3c6a98c24dd13c81548200055e4","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.25745997,60.02461192],[17.25959228,60.0258578],[17.26077414,60.02639424],[17.26077531,60.02639438],[17.26077641,60.02639414],[17.26131319,60.02616529],[17.26201275,60.02582674],[17.2622893,60.0253015],[17.26228913,60.02517651],[17.26226481,60.02429854],[17.2622632,60.02416181],[17.26212256,60.02402247],[17.26133799,60.02326353],[17.26127063,60.02319999],[17.26064965,60.02260856],[17.25997573,60.02169957],[17.26047512,60.01985152],[17.2606958,60.01819284],[17.26069494,60.01819228],[17.25942868,60.01780887],[17.25814892,60.01765423],[17.25547062,60.01646855],[17.25546977,60.01646832],[17.25530316,60.01644859],[17.25530187,60.01644898],[17.25455765,60.01695436],[17.25133166,60.01