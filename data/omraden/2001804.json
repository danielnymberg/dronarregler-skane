ser för civil luftfart, t ex:","inledning_offset":1892,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":590,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["vistas"],"dokument_id":"nvdok-1028621","dokument_namn":"beslut ordningsföreskrifter flommen 2022 gdpr inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028621","dokument_sha256":"792ef38728ab5761f268952373c7d677ff55de98bd44436db4897e478edbddd5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Förbudet att avsiktligt störa djurlivet omformuleras för att tydligare koppla\nföreskriften till syftet med reservatet.","inledning":"är viktigt, liksom att se över gällande beträdnadsförbud och att reglera fisket för att","inledning_offset":1531,"inledning_sidnummer":7,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":658,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["djurlivet","störa","Förbudet"],"dokument_id":"nvdok-1028621","dokument_namn":"beslut ordningsföreskrifter flommen 2022 gdpr inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028621","dokument_sha256":"792ef38728ab5761f268952373c7d677ff55de98bd44436db4897e478edbddd5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Förbuden mot att framföra och parkera motordrivna fordon utanför väg respektive\nparkeringsplats avser fordon på land och denna föreskrift omformuleras endast\nnågot.","inledning":"är viktigt, liksom att se över gällande beträdnadsförbud och att reglera fisket för att","inledning_offset":1531,"inledning_sidnummer":7,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":1297,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivna","fordon","Förbuden"],"dokument_id":"nvdok-1028621","dokument_namn":"beslut ordningsföreskrifter flommen 2022 gdpr inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028621","dokument_sha256":"792ef38728ab5761f268952373c7d677ff55de98bd44436db4897e478edbddd5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Koppeltvång för hundar kvarstår och gäller från 1 mars till och med 31 oktober.\nDäremot överlåts tidpunkterna när hundar får vistas på badstränderna att beslutas av\nVellinge kommun i den lokala ordningsstadgan.","inledning":"är viktigt, liksom att se över gällande beträdnadsförbud och att reglera fisket för att","inledning_offset":1531,"inledning_sidnummer":7,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":1463,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["vistas"],"dokument_id":"nvdok-1028621","dokument_namn":"beslut ordningsföreskrifter flommen 2022 gdpr inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028621","dokument_sha256":"792ef38728ab5761f268952373c7d677ff55de98bd44436db4897e478edbddd5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Förbud mot vattenfarkoster (t.ex. stand up paddle board (SUP), vind- eller\nkitesurfare) inne i vattensamlingarna (flommarna) i naturreservatet införs på\nförekommen anledning, då kitesurfare har skrämt fåglarna inne i vattensamlingarna.\nFågellivet i naturreservatet är känsligt för störningar året runt, då det även finns\növervintrande arter, och förbjud införs mot att framföra olika former av\nvattenfarkoster i de grunda inlandslagunerna och vattensamlingarna.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":2065,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["störningar","Fågellivet","fåglarna","Förbud"],"dokument_id":"nvdok-1028621","dokument_namn":"beslut ordningsföreskrifter flommen 2022 gdpr inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028621","dokument_sha256":"792ef38728ab5761f268952373c7d677ff55de98bd44436db4897e478edbddd5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Ett förbud införs mot att starta eller landa med bemannade eller obemannade\nluftfartyg, eller flyga drake. Syftet med förbudet är att inte störa betesdjuren eller\ndet känsliga djurlivet framför allt fåglar och säl.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":2528,"klassificering":"start-landningsförbud","konfidens":"hög","traffade_ord":["obemannade\nluftfartyg","starta","landa","förbud"],"dokument_id":"nvdok-1028621","dokument_namn":"beslut ordningsföreskrifter flommen 2022 gdpr inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028621","dokument_sha256":"792ef38728ab5761f268952373c7d677ff55de98bd44436db4897e478edbddd5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Förbudet att lägga upp båt eller annan farkost annat än tillfälligt då man vistas på\nstranden är nytt. Det har blivit populärt att ha uppläggningsplats på stranden för\nmindre båtar och katamaraner, men farkosterna riskerar att uppta ganska stora ytor\nmer eller mindre permanent, vilket påverkar vegetation och naturtyper. Sådana\nfarkoster som man själv tar med sig över dagen till stranden när man själv är på plats","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":2744,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["farkosterna","farkoster","farkost","Förbudet"],"dokument_id":"nvdok-1028621","dokument_namn":"beslut ordningsföreskrifter flommen 2022 gdpr inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028621","dokument_sha256":"792ef38728ab5761f268952373c7d677ff55de98bd44436db4897e478edbddd5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Lars Persson, Skyddsjägare Vellinge kommun (2022-06-27)\nEn synpunkt på förslag till beslut avseende naturreservatet Flommen.\nI ordningsföreskrifterna C1, angående beträdande förbud inom område markerat med A,\nbör få samma undantag som det finns för C2 område B att föreskriften ej","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":14,"teckenoffset_pa_sidan":2305,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["beträdande","förbud"],"dokument_id":"nvdok-1028621","dokument_namn":"beslut ordningsföreskrifter flommen 2022 gdpr inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028621","dokument_sha256":"792ef38728ab5761f268952373c7d677ff55de98bd44436db4897e478edbddd5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Som ni beskriver situationen så har både besökande ökat samt antalet jaktkort. Inga kända\nstudier i området har visat att jakten i området påverkar faunan negativt. Antalet jaktkort i\nområdet minskas för närvarande ner av Vellinge kommun. Länsstyrelsen anser att det finns\nandra hot mot störningskänsligt fågelliv som joggare, hundägare och annat rörligt friluftsliv.\nLänsstyrelsen anser att det kan finnas skäl att bibehålla jakt i naturreservatet, då det\nframöver kan t.ex. bli problem med vildsvin eller andra arter.","inledning":"som riktar sig till markägare och sakägare. I nuvarande föreskrifter är det förbjudet att","inledning_offset":920,"inledning_sidnummer":18,"punkt":null,"sidnummer":18,"teckenoffset_pa_sidan":1061,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["störningskänsligt","fågelliv"],"dokument_id":"nvdok-1028621","dokument_namn":"beslut ordningsföreskrifter flommen 2022 gdpr inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028621","dokument_sha256":"792ef38728ab5761f268952373c7d677ff55de98bd44436db4897e478edbddd5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"gemensamma bedömningen är att under den senaste 10-årsperioden har antalet varit\nnågorlunda konstant.\nDet bör också påpekas att katamaransegling var mer populärt då reservatet upprättades\n1981 och att författarna till reservatsbeslutet inte då fann det nödvändigt att särskilt\nomnämna farkoster på stränderna som en riskfaktor för naturen. Båtarnas naturpåverkan\nLänsstyrelsen uttrycker en oro för att de båtar som ligger inom reservatets område kan ha\nen negativ påverkan på arter och naturtyper. Denna formulering är vag och slentrianmässig.","inledning":"som riktar sig till markägare och sakägare. I nuvarande föreskrifter är det förbjudet att","inledning_offset":920,"inledning_sidnummer":18,"punkt":null,"sidnummer":19,"teckenoffset_pa_sidan":323,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["farkoster"],"dokument_id":"nvdok-1028621","dokument_namn":"beslut ordningsföreskrifter flommen 2022 gdpr inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028621","dokument_sha256":"792ef38728ab5761f268952373c7d677ff55de98bd44436db4897e478edbddd5","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Beträdnadsförbud under tiden 1 april - 15 juli på N Reveln och\nvattenområdena däromkring innebär en årlig tidsbegränsad inskränk-\nning i möjligheterna att fritt utnyttja hela reservatet. Detta be-\nträdnadsförbud har enbart tillkommit för att säkerställa ostörda\nhäckningsplatser för bl a de sällsynta fågelarterna svartbent\nstrandpipare och småtärna. Skulle inventeringar visa att häckning\nej förekommer inom området må länsstyrelsen besluta att förbudet\nupphävs temporärt.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":26,"teckenoffset_pa_sidan":754,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["häckningsplatser","fågelarterna","sällsynta","förbud"],"dokument_id":"nvdok-1011198","dokument_namn":"Flommen BESLUT och SKÖTSELPLAN 1981 Webb.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011198","dokument_sha256":"3bcfc4a99a3942b628c45b1aa5ae0d7a516714c510811d6ba87f880f96def414","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Naturistföreningen yrkar att tillträdesförbudet under\ntiden den 1 april - den 15 juli undanröjs. De framhåller\nbl.a. att detta område sedan många år tillbaka är liv-\nligt frekventerat som badstrand och rekreationsområde","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":47,"teckenoffset_pa_sidan":2061,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","förbudet"],"dokument_id":"nvdok-1011198","dokument_namn":"Flommen BESLUT och SKÖTSELPLAN 1981 Webb.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011198","dokument_sha256":"3bcfc4a99a3942b628c45b1aa5ae0d7a516714c510811d6ba87f880f96def414","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-