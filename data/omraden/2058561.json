ord":["fordon","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1045480","dokument_namn":"17fs2022_8.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045480","dokument_sha256":"f5504f02217c4a037bb28cc8d0f4260acf85ddddf7d7513bde2f5b2347790707","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Trafik med bensin- eller dieseldrivet fordon på isbelagd sjö är förbjuden.\n Undantag gäller för körning som sker i syfte att anlägga isbana eller skidspår, körning som\n avser transporter inom jord- och skogsbruk och i samband med biotopvård som inte kan ske\n på fastmark eller under tid då sjö inte är isbelagd samt körning med räddningstjänstens\n fordon.\n Förvaring av bensin eller diesel ombord på båt eller annat fordon är förbjuden.\n Undantag gäller för bränsle till båt med max 75 liter som förvaras i trycktank eller i fast\n monterad tank i båt.\n Tankning av båtar och andra fordon är förbjuden.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":124,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1045480","dokument_namn":"17fs2022_8.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045480","dokument_sha256":"f5504f02217c4a037bb28cc8d0f4260acf85ddddf7d7513bde2f5b2347790707","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Användning av båt eller annat fordon med dieselmotor utan direktinsprutning eller\n tvåtaktsmotorer som inte är försedda med direktinsprutning är förbjudet fem år efter dagen\n för detta beslut.\n Trafik med bensin- eller dieseldrivet fordon på isbelagd sjö är förbjuden.\n Undantag gäller för körning som sker i syfte att anlägga isbana eller skidspår, körning som\n avser transporter inom jord- och skogsbruk och i samband med biotopvård som inte kan ske\n på fastmark eller under tid då sjö inte är isbelagd samt körning med räddningstjänstens\n fordon.\n Förvaring av bensin eller diesel ombord på båt eller annat fordon är förbjuden.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":897,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1045480","dokument_namn":"17fs2022_8.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045480","dokument_sha256":"f5504f02217c4a037bb28cc8d0f4260acf85ddddf7d7513bde2f5b2347790707","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Hantering av petroleumprodukter i större mängd än 75 liter är förbjudet.\n Undantag gäller för transport av petroleumprodukter, framdrivande av motordrivet fordon\n och uppvärmning av befintliga bostads- och jordbruksfastigheter.\n Hantering av petroleumprodukter för uppvärmning av befintliga bostads- och\n jordbruksfastigheter kräver tillstånd.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1889,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1045480","dokument_namn":"17fs2022_8.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045480","dokument_sha256":"f5504f02217c4a037bb28cc8d0f4260acf85ddddf7d7513bde2f5b2347790707","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Uppställning i 24 timmar eller längre av arbetsfordon, arbetsmaskiner, tunga fordon och\n stationära förbränningsmotorer är förbjuden.\n Undantag gäller för mindre arbetsmaskiner med tankvolym på max 10 liter eller\n uppställning av fordon och motorer som sker på en uppställningsplats som är utformad så\n att hela den hanterade volymen bränsle vid läckage säkert förhindras nå omgivningen.\n Transformatorolja som saknar anordning för att förhindra spridning vid läckage av\n transformatorolja är förbjudna.\n Transformatorstationer med oljor innehållande PCB är förbjudna.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":499,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1045480","dokument_namn":"17fs2022_8.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045480","dokument_sha256":"f5504f02217c4a037bb28cc8d0f4260acf85ddddf7d7513bde2f5b2347790707","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.24020228,59.83604352],[13.24050407,59.83791725],[13.24083489,59.83941448],[13.24058285,59.84037043],[13.23977768,59.84155806],[13.23986037,59.84303216],[13.23986058,59.84303257],[13.24103474,59.84377383],[13.24333661,59.84447421],[13.24538602,59.84428066],[13.24851165,59.84331771],[13.25069032,59.84306371],[13.25189765,59.84360794],[13.25171358,59.84531063],[13.25184412,59.84710021],[13.25286725,59.84818874],[13.25478564,59.84924071],[13.25509054,59.85015357],[13.25459764,59.85076365],[13.25475985,59.85190711],[13.25476011,59.85190753],[13.25564625,59.85268785],[13.25764344,