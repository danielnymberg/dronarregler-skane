{"nvrid":"2043146","slug":"storesjon","namn":"Storesjön","skyddstyp":"Vattenskyddsområde","lager":"vattenskyddsomrade","karnlager":false,"kommun":"Nässjö","lan":"Jönköpings Län","beslutsstatus":"Gällande","beslutsmyndighet":"Kommun","forvaltare":null,"tillsynsmyndighet":"Kommun","urspr_beslutsdatum":"2014-05-22","senaste_gallandedatum":"2019-10-31","area_ha":3143.19,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2043146","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Storesjön vattenskyddsföreskrifter.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042636","dokument_id":"nvdok-1042636","sha256":"ecff1025f5760510d252519d6af4a34d073b4f75de1e314f8847d310711270fd","sidor":17,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"§ 7 Djurhållning\n\nPrimär skyddszon:\nUppläggning av ensilage direkt på mark är förbjuden, med undantag för ensilagebalar.\nObrukbara/kasserade ensilagebalar får endast komposteras på tät platta utan avrinning.\n\nNyanläggande av anläggningar för förvaring av ensilage är förbjuden.\n\nBefintliga anläggningar för lagring av ensilage ska vara täta, inspekteras regelbundet och vid\nbehov byggas om eller renoveras. Läckage ska omhändertas direkt.\n\nVattning av djur direkt i Storesjöns vattenområde är förbjuden. I resterande del av zonen ska\nbetande djur alltid erbjudas ett alternativt vattenställe.\n\nSekundär skyddszon:\nUppläggning av ensilage direkt på mark är förbjuden, med undantag för ensilagebalar.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§ 7","sidnummer":5,"teckenoffset_pa_sidan":576,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1042636","dokument_namn":"Storesjön vattenskyddsföreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042636","dokument_sha256":"ecff1025f5760510d252519d6af4a34d073b4f75de1e314f8847d310711270fd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"8(17)\n\nSekundär skyddszon:\nUppställning av fordon och maskiner, med mer än 120 liter drivmedelstank, är förbjuden\n(avser parkering mer än 24 timmar utan egen tillsyn).\n\nUppställning av fordon och maskiner, med 120 liter eller mindre drivmedelstank, är\nförbjuden (avser parkering mer än 72 timmar utan egen tillsyn).\n\nFordon som är uppställda på egen mark betraktas som egen tillsyn om de placeras på sådant\nsätt att ett läckage till mark och ytvatten förhindras. På platser anpassade för långvarig\nuppställning ska det finnas absorbtionsmateriel för att akut kunna hantera ett eventuellt\nläckage.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":94,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1042636","dokument_namn":"Storesjön vattenskyddsföreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042636","dokument_sha256":"ecff1025f5760510d252519d6af4a34d073b4f75de1e314f8847d310711270fd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§ 14 Fordonstrafik\n\nPrimär och sekundär skyddszon:\nMotorfordonstrafik på sjöar och vattendrag inom den primära och sekundära skyddszonen\när förbjuden.\n\nUndantag gäller för båt med fyrtaktsmotor som drivs med alkylatbensin och en maximal\nmotorstyrka på upp till 8 hk (6 kW). Enbart miljöanpassade oljor får användas.\n\nPåfyllning av drivmedel inom den primära och sekundära skyddszonen är förbjuden. Den\nmaximala volymen drivmedel som får hanteras på sjöar och vattendrag är 20 liter.\n\nDrivmedelstankar måste alltid vara utrustade eller placerade så att den lagrade volymen vid\nläckage säkert kan förhindras nå ytvattnet.\n\nDrivmedelstankar får ej förvaras inom skyddszonen utan egen tillsyn.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§ 14","sidnummer":9,"teckenoffset_pa_sidan":101,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1042636","dokument_namn":"Storesjön vattenskyddsföreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042636","dokument_sha256":"ecff1025f5760510d252519d6af4a34d073b4f75de1e314f8847d310711270fd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Generella bestämmelser\nTerrängkörningslagen (SFS 1975:1313) reglerar körning med motordrivet fordon i terräng.\nKörning i terräng med motordrivet fordon för annat ändamål än jordbruk eller skogsbruk är\nalltid förbjuden i hela landet på barmark. På snötäckt skogsmark med plant- eller ungskog är\nterrängkörning förbjuden om det inte är uppenbart att körningen kan ske utan risk för skada\npå skogen, samt på snötäckt jordbruksmark, om det inte är uppenbart att körningen kan ske\nutan risk för skada på marken.","inledning":"och förordningen (1998:899) om miljöfarlig verksamhet och hälsoskydd, krävs tillstånd att","inledning_offset":1384,"inledning_sidnummer":17,"punkt":null,"sidnummer":17,"teckenoffset_pa_sidan":2711,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1042636","dokument_namn":"Storesjön vattenskyddsföreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042636","dokument_sha256":"ecff1025f5760510d252519d6af4a34d073b4f75de1e314f8847d310711270fd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sh