t.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":756,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträde","förbud"],"dokument_id":"nvdok-1027587","dokument_namn":"fallamosse östra beslut inkl. karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027587","dokument_sha256":"beca7fdf96284db2cf8be34ab68d34f6d246074ea145169aef40a90f5b68408d","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.52999768,57.52904143],[14.52994716,57.5290858],[14.52995743,57.52915766],[14.52998343,57.52919963],[14.53000509,57.52926697],[14.53004454,57.52929029],[14.53004597,57.52929046],[14.5300981,57.52928506],[14.53017607,57.52929674],[14.53024445,57.52933835],[14.53030342,57.52938484],[14.53029856,57.52938986],[14.53029858,57.52939045],[14.53029922,57.52939093],[14.5331472,57.53054263],[14.53900822,57.53525616],[14.53998116,57.53606949],[14.54626307,57.54072173],[14.54914367,57.54350725],[14.54914463,57.54350746],[14.54914565,57.54350737],[14.5491462,57.54350714],[14.54914665,57.54350663],[14.54934722,57.54281946],[14.54946565,57.54258158],[14.54977087,57.54206771],[14.55032347,57.54143996],[14.55050659,57.54118875],[14.5509277,57.54110026],[14.55114045,57.54111114],[14.55126202,57.54115843],[14.55159434,57.5413989],[14.55233261,57.54153399],[14.55233367,57.54153374],[14.55345893,57.54097462],[14.55381369,57.54091945],[14.5545218,57.54051129],[14.55525638,57.54026158],[14.55602302,57.54041321],[14.5566