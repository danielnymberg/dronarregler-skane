set_pa_sidan":195,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1008829","dokument_namn":"beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008829","dokument_sha256":"b8bf7c717315070b3d4de22cacb4a38bcc8fa0b26b5541667b83189003942e46","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"1. framföra motordrivet fordon i terrängen med undantag för uttransport av\n   älg med hjälp av terrängfordon;","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":338,"inledning_sidnummer":5,"punkt":"1.","sidnummer":5,"teckenoffset_pa_sidan":381,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["terrängfordon","motordrivet","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1008829","dokument_namn":"beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008829","dokument_sha256":"b8bf7c717315070b3d4de22cacb4a38bcc8fa0b26b5541667b83189003942e46","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Bland de många rödlistade kärlväxterna märks bland andra ärtvicker. Den\när en av våra mest sällsynta ädellövskogsväxter, som idag endast finns på ett\n20-tal lokaler i Sverige. Idegranen som är spridd i stora delar av reservatet\nhar sannolikt den rikaste förekomsten i Sveriges inland här. Ett stort antal\nrödlistade lavar och mossor är också noterade från de kalkrika skogarna och\nbranterna i området. Här finns bland annat den starkt hotade jättelaven .","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":338,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":454,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sällsynta","stora","stort"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1008829","dokument_namn":"beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008829","dokument_sha256":"b8bf7c717315070b3d4de22cacb4a38bcc8fa0b26b5541667b83189003942e46","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I de lövrika branterna mot kanalsystemet finns det gott om grova lövträd,\ndöda träd och lågor. Dessa områden är av stor betydelse för flera sällsynta\nlavar och för många rödlistade fågelarter. Bland fågelfaunan märks mindre\nhackspett, bivråk och nötkråka. Den vitryggiga hackspetten har tidigare\nhäckat i området. Samtliga dessa arter gynnas av en rik lövträdsförekomst\neller är beroende av en rik tillgång på död ved och döda träd. Bland dägg-\ndjuren märks lo som uppträder regelbundet i området. Branterna längs ka-\nnalsystemet utgör lämpliga vistelsemiljöer för arten.","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":338,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":910,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["fågelfaunan","fågelarter","sällsynta"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1008829","dokument_namn":"beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1008829","dokument_sha256":"b8bf7c717315070b3d4de22cacb4a38bcc8fa0b26b5541667b83189003942e46","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygo