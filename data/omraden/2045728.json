ag-\nstiftning och med de övriga begränsningar som följer av reservatsföreskrifterna.\nInom reservatet finns inga jakttorn eller siktgator. Några nya jakttorn eller\nsiktgator får heller inte upprättas. Ett befintligt jakttorn står dock strax utanför\nreservatet vid skogsbilvägen öster om reservatet.\nVid uttransport av fällt högvilt får inte tyngre fordon än terrängskoter (lag\n2001:559 om vägtrafikdefinitioner), till exempel så kallad fyrhjuling, användas.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":22,"teckenoffset_pa_sidan":1004,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1026415","dokument_namn":"Larudan_2016-12-19_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026415","dokument_sha256":"80e937be5ba73c7031c7962d9943e016e0f014d64f66a86ffb7b145db3040e04","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.37517435,59.85787592],[18.37517329,59.85787642],[18.37517321,59.85787716],[18.37596784,59.85904883],[18.37596853,59.8590493],[18.37596962,59.8590495],[18.37597106,59.85904923],[18.37738546,59.85836839],[18.37747859,59.85873565],[18.37747913,59.85873621],[18.37747983,59.85873644],[18.37846827,59.85892838],[18.3784694,59.85892817],[18.3791415,59.85865728],[18.37985157,59.85837046],[18.3810058,59.85824861],[18.38100665,59.85824841],[18.38279477,59.85750323],[18.38376471,59.85691173],[18.38415455,59.85631855],[