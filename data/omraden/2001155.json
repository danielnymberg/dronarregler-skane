andlingar":["marken"],"dokument_id":"nvdok-1021524","dokument_namn":"Angarnssjoangen_1999-11-29_andring_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021524","dokument_sha256":"fd4ab568cd880707a9f0f450d298efebb819ce0d9a7d256ca4733ce6091ca711","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsen finner vid en vägning mellan enskilda och allmänna intressen i\nenlighet med 7 kap. 25 $ miljöbalken att det för att skydda och bevara\novanstående naturvärden finns skäl att besluta om föreskrifter för att skydda\nområdet samt att fastställa en skötselplan. För att uppnå det starka skydd som\nbehövs för områdets naturvärden bör föreskrifterna bland annat omfatta\ntillträdesförbud till sjöängen under delar av året. En modernisering av\nföreskrifter och skötselplan anses nödvändig för att naturvärdena i området\nskall bevaras.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1557,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1021524","dokument_namn":"Angarnssjoangen_1999-11-29_andring_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021524","dokument_sha256":"fd4ab568cd880707a9f0f450d298efebb819ce0d9a7d256ca4733ce6091ca711","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Skador till följd av skogsbruksåtgärder undviks eller begränsas i och invid\nhänsynskrävande biotoper och värdefulla kulturmiljöer i skogen, samt för\nväxt- och djurarter som är rödlistade eller ovanliga i regionen. Däggdjur och\nfåglar som är rödlistade får inte utsättas för allvarliga störningar under sin\nfortplantningstid. Skogsbruksåtgärder bör därför inte ske under perioden 1\napril till 20 augusti. Skyddszoner med träd och buskar lämnas kvar mot\nskogliga impediment, vattendrag och öppen jordbruksmark, samt vid\nbebyggelse i sådan utsträckning som behövs av hänsyn till växt- och\ndjurlivet, kulturmiljön och landskapsbilden.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":21,"teckenoffset_pa_sidan":1139,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["störningar","djurarter","djurlivet","får inte"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1021524","dokument_namn":"Angarnssjoangen_1999-11-29_andring_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021524","dokument_sha256":"fd4ab568cd880707a9f0f450d298efebb819ce0d9a7d256ca4733ce6091ca711","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Reservatet nås av besökande allmänhet med cykel, bil eller buss.\nTillträdesförbud råder 1/4 - 30/9 inom fågelskyddsområdet (karta III). Reservatet\ni övrigt, förutom bland annat hemfridszoner och åkermark med växande gröda är\ntillgängligt enligt allemansrätten. Tältning är endast tillåtet på en plats (karta IT)\noch där endast i två dygn i följd. Tillgängligheten för handikappade bör utredas i\nen särskild studie.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":24,"teckenoffset_pa_sidan":919,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["Tillträdesförbud","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1021524","dokument_namn":"Angarnssjoangen_1999-11-29_andring_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021524","dokument_sha256":"fd4ab568cd880707a9f0f450d298efebb819ce0d9a7d256ca4733ce6091ca711","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"18\n\n2.2.5 Renhållning\n\nTorrdass öppna för allmänheten finns vid Örsta och Olhamra. Antalet torrdass\nbedöms inte vara tillräckligt. Ytterligare torrdass behövs framför allt vid Örsta.\nStädning av frekventerade platser bör utföras efter behov.\n\n2.2.6 Störningskänslighet och slitage\n\nVissa delar av naturreservatet är känsliga för en hög besöksfrekvens. Detta gäller\nsärskilt sjöängen, som dock skyddas genom tillträdesförbud under perioden 1/4 —\n30/9. Risken bedöms därför för närvarande vara låg för att besökarna skall vara\nett hot mot områdets naturvärden. Uppstår slitage bör kanalisering genom till\nexempel omdragning av stigar övervägas.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":25,"teckenoffset_pa_sidan":0,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1021524","dokument_namn":"Angarnssjoangen_1999-11-29_andring_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021524","dokument_sha256":"fd4ab568cd880707a9f0f450d298efebb819ce0d9a7d256ca4733ce6091ca711","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.124393,59.53993709],[18.12424522,59.53997974],[18.12424468,59.53997997],[18.12424426,59.53998046],[18.12421949,59.5400682],[18.12417749,59.54022158],[18.12415186,59.54035663],[18.12421521,59.54049934],[18.12445762,59.54091692],[18.12479614,59.54144048],[18.12514975,59.54192788],[18.12643252,59.54352