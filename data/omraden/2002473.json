"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"Bild_Från_Österåberget.jpg","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016444","orsak":"ej föreskriftsbärande dokumenttyp"}],"citat":[{"citat":"Länsstyrelsen Dalarnas län                          Beslut                                  4 (12)\n\n                                                    2026-04-13                         14868-2024\n\n\n\n              3. avverka eller utföra annan skogsvårdande åtgärd\n\n              4. upparbeta dött träd eller vindfälle\n\n              5. anlägga mark- eller luftledning\n\n              6. framföra motordrivet fordon i terrängen\n\n              7. på delen väster om vägen jaga annat än älg, rådjur, räv och hare\n\n              8. gräva upp eller plocka örter, mossor, svampar och lavar\n\n         Undantag\n         Föreskrifterna gäller inte för:","inledning":"Det är förbjudet att","inledning_offset":1936,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":0,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1033928","dokument_namn":"Österåberget tilläggsbeslut 20270413 dnr 14868-2024_TA.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1033928","dokument_sha256":"f63886b97abf45145491e61c3cfe9486f48c8dac26201638740d15702758b7da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Ordningsföreskrifter\n         Det är förbjudet att\n\n              1.   framföra motordrivet fordon i terrängen\n\n              2. gräva upp eller plocka örter, mossor, lavar eller vedlevande svampar\n\n              3. fånga eller insamla djur\n\n              4. göra åverkan på torra träd eller vindfällen\n\n\n         Förtydligande av föreskrifter\n         I föreskrift B4 förpliktigas markägare och innehavare av särskild rätt att tåla\n         skötselåtgärder såsom restaureringsåtgärder i våtmarker. I begreppet\n         innefattas även förberedande åtgärder såsom röjning och/eller nedtagande\n         av träd för att maskiner ska ta sig fram till restaureringsytan.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"C.","sidnummer":5,"teckenoffset_pa_sidan":207,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1033928","dokument_namn":"Österåberget tilläggsbeslut 20270413 dnr 14868-2024_TA.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1033928","dokument_sha256":"f63886b97abf45145491e61c3cfe9486f48c8dac26201638740d15702758b7da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Befintliga naturreservatsbeslut samt behov av tillägg till beslut\n         Österåbergets naturreservat i Orsa kommun bildades 18 december 1989 med\n         syfte att bevara områdets urskogsprägel med förutsättningar för dess djur\n         och växtliv att utvecklas naturligt och ostört. Naturreservatet bestod av en\n         yta på 144 ha och omfattade berget Österåberget (dnr 2311-4968-89). Ett\n         beslut om rättelse togs den 9 juli 1991 med anledning av att reservatsgränsen\n         var felaktig på beslutskartan från 1989 (dnr 231-7221-91).","inledning":"Det är förbjudet att","inledning_offset":240,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":1909,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1033928","dokument_namn":"Österåberget tilläggsbeslut 20270413 dnr 14868-2024_TA.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1033928","dokument_sha256":"f63886b97abf45145491e61c3cfe9486f48c8dac26201638740d15702758b7da","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"6. framföra motordrivet fordon i terrängen