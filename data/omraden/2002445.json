ndning, åldersfördelning och\ndimensioner. Det finns även mycket död ved i olika dimensioner\noch nedbrytningsstadier. Sammantaget ger detta goda förutsätt-\nningar för stor artrikedom både bland växter och djur. Skyddet\nav skogen i Lillådalen är därför ett led i bevarandet av biolo-\ngisk mångfald.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att","inledning_offset":1721,"inledning_sidnummer":2,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":31,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["stor","djur"],"dokument_id":"nvdok-1028331","dokument_namn":"Lillådalen_Beslut_20020624.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028331","dokument_sha256":"ce9b4a6d98086ad9f326a48198b8ee00f08bc43e48dd84311fb9a83a64bbb81b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[12.46991869,61.63043008],[12.46998342,61.63070977],[12.47023561,61.63095714],[12.47089744,61.63147085],[12.4712239,61.63171936],[12.47170814,61.63213723],[12.47195728,61.63255136],[12.47200648,61.63261724],[12.47240505,61.63315456],[12.4725872,61.63362371],[12.4727743,61.63394289],[12.47297456,61.63430051],[12.47303628,61.63463412],[12.47304016,61.63496543],[12.47304729,61.63516224],[12.47345424,61.63568233],[12.47374431,61.63605512],[12.47393778,61.6362377],[12.47447904,61.63658269],[12.47491204,61.63698789],[12.47510552,61.63727256],[12.47514605,61.6375468],[12.4752211,61.63789103],[12.47533741,61.63808666],[12.47533711,61.63808741],[12.47612875,61.63895568],[12.4763