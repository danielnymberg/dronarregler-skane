 tidigare föreskrift C4 motsvaras av föreskrift nr 11. Ändringen\ninnebär ingen skillnad i rättsverkan. Efter ändringen har numreringen av\nföreskrifterna gjorts om och uppdelningen i A, B och C-föreskrifter har tagits bort.","inledning":"som naturreservatet är till för att skydda. Förbudet mot stödutfodring behövs för att","inledning_offset":681,"inledning_sidnummer":10,"punkt":null,"sidnummer":10,"teckenoffset_pa_sidan":2269,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","Förbud"],"dokument_id":"nvdok-1012325","dokument_namn":"Beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1012325","dokument_sha256":"2fe2679e6e750565e1c43d0736c5c13c84f40430258ca830e29859441598cf60","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.54511233,56.96659479],[13.5439751,56.96623975],[13.543974,56.96623988],[13.54308178,56.9665269],[13.54308102,56.96652738],[13.54235695,56.96752163],[13.54235682,56.96752202],[13.54235716,56.96752257],[13.54333581,56.96784993],[13.54462666,56.96803307],[13.54530973,56.96817784],[13.54666881,56.96962684],[13.54666934,56.96962718],[13.54752749,56.9698357],[13.55150277,56.97076695],[13.5706845,56.97147312],[13.57408244,56.97185115],[13.57477343,56.97193284],[13.57477488,56.97193283],[13.57477545,56.97193263],[13.57477596,56.97193215],[13.57483979,56.97128607],[13.57483968,56.97128568],[13.57483904,56.97128522],[13.5662455,56.96789964],[13.56547029,56.96706068],[13.56300406,56.96537336],[13.56296566,56.96471231