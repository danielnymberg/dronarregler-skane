a kvistar, fälla eller på annat sätt skada levande eller döda träd och buskar.\nFånga eller samla in ryggradslösa djur.\n\nUtplantera växt- eller djurart.\n\nRida och cykla på sådant sätt att naturvärden eller vandringsleder och stigar\nskadas.","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":283,"inledning_sidnummer":5,"punkt":"C.","sidnummer":5,"teckenoffset_pa_sidan":1751,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbjudet"],"handlingar":["flyga","landa","lyfta","marken"],"dokument_id":"nvdok-1011540","dokument_namn":"Beslut Gröna mads naturreservat 2012 samlade handlingar.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011540","dokument_sha256":"e3ecc116579be0dcbb2380ba21382854cff7001fb18375d0ef83492b93f9ba0a","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.50952382,58.18351508],[13.50932416,58.18367069],[13.50928562,58.18386184],[13.50937397,58.18394232],[13.50959415,58.18400165],[13.50977855,58.18407289],[13.50982793,58.18432196],[13.50985441,58.18444895],[13.51012118,58.18460772],[13.51401708,58.18795152],[13.51401754,58.18795179],[13.5140185,58.18795198],[13.51435308,58.18796828],[13.51472995,58.18794455],[13.51473071,58.18794441],[13.51473129,58.18794411],[13.51526084,58.18751882],[13.51809016,58.18970973],[13.51809106,58.1897101],[13.51809255,58.18971005],[13.51885888,58.18950402],[13.51885943,58.18950379],[13.51885988,58.18950329],[13.51885975,58.18950274],[13.51833123,58.188858