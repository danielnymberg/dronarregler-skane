0eb660803a22ab67b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"fågelskyddsbestämmelserna inom dessa inte påverkar habitatens bevarandestatus\nnegativt. Några av de fågelskyddsområden som föreslås upphävas ligger även inom\nbefintliga SPA-områden, d.v.s. områden som är utpekade som särskilda\nskyddsområden för fågellivet. Länsstyrelsen anser vad gäller dessa objekt att\ntillträdesförbud inte krävs för att bevara fågellivet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":209,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1040528","dokument_namn":"Beslut fso skärgård dec 2012.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040528","dokument_sha256":"562411c2a72746567b3ea9682226b3e1535fe6dfaedbd9c0eb660803a22ab67b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.81977952,58.4281778],[16.81977894,58.42817826],[16.81977891,58.42817881],[16.81979052,58.42820149],[16.81984481,58.4282212],[16.81994172,58.42823468],[16.81998446,58.42823321],[16.82007087,58.42824805],[16.82012744,58.4282683],[16.82030393,58.42834393],[16.82040202,58.42840099],[16.82049688,58.42844813],[16.82061083,58.42849361],[16.8206838,58.42850245],[16.82068491,58.42850241],[16.82068554,58.42850219],[16.82076697,58.42846],[16.8208264,58.42840075],[16.82091427,58.42841942],[16.82096849,58.42841867],[16.82099066,58.42848044],[16.82099157,58.4284