r dikningspåverkad.","inledning":"Utan länsstyrelsen tillstånd är det också förbjudet att","inledning_offset":1033,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":387,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["fågelfauna","stort","stor"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1023783","dokument_namn":"0_Beslut Päggonätto_inkl_bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023783","dokument_sha256":"f07fb0b4fe1f4ec16b9c81fcb76e3f38f5f23c8b8751de0bdb36665df51c69aa","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Päggonätto utgör ett från naturvårdssynpunkt mycket värdefullt våtmarks-\n         och naturskogsområde som hyser en stor mångfald av växt- och djurarter\n         som är knutna till dessa miljöer. För att områdets värden ska bestå, behöver\n         området undantas från skogsproduktion och annan exploatering som innebär\n         att dess naturvärden skulle skadas.","inledning":"Utan länsstyrelsen tillstånd är det också förbjudet att","inledning_offset":1033,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1728,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurarter","stor"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1023783","dokument_namn":"0_Beslut Päggonätto_inkl_bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023783","dokument_sha256":"f07fb0b4fe1f4ec16b9c81fcb76e3f38f5f23c8b8751de0bdb36665df51c69aa","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1a