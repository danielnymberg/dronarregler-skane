_pa_sidan":555,"klassificering":"start-landningsförbud","konfidens":"medel","traffade_ord":["luftfarkost","landa"],"dokument_id":"nvdok-1026499","dokument_namn":"Stora Karlsö beslut 1990 utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026499","dokument_sha256":"7157aba702b0f37723c4d34f35d08b2fce450816b93f9694705a3eedbfd272c4","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I samband med att tillstånd givits för ordinarie turbåt\natt angöra bryggan i Suderhamn, får även motordrivet\nfordon, utan hinder av förbud A 10, föras på vägen ned\ntill Suderhamn.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":256,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbud"],"dokument_id":"nvdok-1026499","dokument_namn":"Stora Karlsö beslut 1990 utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026499","dokument_sha256":"7157aba702b0f37723c4d34f35d08b2fce450816b93f9694705a3eedbfd272c4","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"2 Reservatet liksom områden med särskilt tillträdes-\nförbud till skydd för fågellivet skall utmärkas en-\nligt svensk standard (SIS 03 15 22) och SNV:s anvis-\nningar.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":758,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdes","förbud"],"dokument_id":"nvdok-1026499","dokument_namn":"Stora Karlsö beslut 1990 utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026499","dokument_sha256":"7157aba702b0f37723c4d34f35d08b2fce450816b93f9694705a3eedbfd272c4","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Med stöd av 1 $ Kungl Maj:ts kungörelse den 26 mars 1965\nom lokala bestämmelser till skydd av djurlivet förordna-\nde länsstyrelsen 1966-12-uv1 om förbud mot all jakt på\nsjöfågel på allmänt vattenområde runt Stora Karlsö in-\ntill 3 000 m från stranden från och med den 1 januari\n1967.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":1120,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["djurlivet","Stora","förbud"],"dokument_id":"nvdok-1026499","dokument_namn":"Stora Karlsö beslut 1990 utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026499","dokument_sha256":"7157aba702b0f37723c4d34f35d08b2fce450816b93f9694705a3eedbfd272c4","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Enligt beslutade föreskrifter är det inte tillåtet att\nframföra motordrivet fordon utanför den väg som går\nmellan Norderhamn och Fyren samt till militärens anlägg-\nningar på ön. I samband med att ordinarie turbåt ges\ntillstånd att anlöpa bryggan i Suderhamn, kan av läns-\nstyrelsen utsedd tillsynsman för ön även lämna tillstånd\ntill att motordrivet fordon får föras på vägen ned till\nSuderhamn för att hämta varor m m.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":28,"teckenoffset_pa_sidan":1498,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","inte tillåtet"],"dokument_id":"nvdok-1026499","dokument_namn":"Stora Karlsö beslut 1990 utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026499","dokument_sha256":"7157aba702b0f37723c4d34f35d08b2fce450816b93f9694705a3eedbfd272c4","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Enligt de reservatsföreskrifter som tidigare gällt för\nallmänheten har året runt rått förbud att stiga iland\noch vistas på Stora Karlsö utan förvaltarens tillstånd.\nNågra betydande naturvårdsskäl att bibehålla detta året-\nruntförbud har dock knappast förelegat. Det är därför\nmöjligt att bereda allmänheten fritt tillträde till ön\nunder hösten och vintern utan att öns naturvärden därvid\nskadas. Från såväl naturvårds- som sjösäkerhetssynpunkt\när det dock önskvärt att alla som besöker ön under hös-\nten och vintern fyller i en anmälningsblankett omedel-\nbart efter inlandstigningen i Norderhamn. Efter att\nblanketten har fyllts i, läggs den i en låst \"brevlåda\".","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":29,"teckenoffset_pa_sidan":717,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträde","vistas","förbud"],"dokument_id":"nvdok-1026499","dokument_namn":"Stora Karlsö beslut 1990 utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026499","dokument_sha256":"7157aba702b0f37723c4d34f35d08b2fce450816b93f9694705a3eedbfd272c4","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"De besökare som övernattar på ön ges större rörelsefri-\nhet än dagsbesökarna och får i dag i princip röra sig\nfritt på ön med undantag för att de under våren och som-\nmaren ej får beträda de strandområden där särskilt till-\nträdesförbud till skydd för fågellivet gäller.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":30,"teckenoffset_pa_sidan":1351,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågellivet","större","förbud"],"dokument_id":"nvdok-1026499","dokument_namn":"Stora Karlsö beslut 1990 utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/res