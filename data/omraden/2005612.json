ng_offset":1741,"inledning_sidnummer":5,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1828,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurlivet","störa"],"dokument_id":"nvdok-1025806","dokument_namn":"hässningberget beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025806","dokument_sha256":"5fa5b2377ac5a4a700aa81c27037338b4262a39500ef98c6ca03fcbd7f737660","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"b) renskötsel i enlighet med rennäringslagen (1971:437) eller\n                      framföra motordrivet fordon vid renskötsel i enlighet med\n                      gällande terrängkörningslagstiftning,","inledning":"Det är utan Länsstyrelsens tillstånd förbjudet att:","inledning_offset":2416,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":756,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1025806","dokument_namn":"hässningberget beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025806","dokument_sha256":"5fa5b2377ac5a4a700aa81c27037338b4262a39500ef98c6ca03fcbd7f737660","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Det nya beslutet får även kompletteringar och förtydliganden av A-\n                föreskrifterna enligt 7 kap. 5 § miljöbalken om inskränkningar i rätten\n                att använda mark- och vattenområden vad gäller uppförandet av\n                byggnad eller annan anläggning, ombyggnad eller ändring av befintlig\n                byggnad eller anläggning, i förbudet att framföra motordrivet fordon\n                samt i förbudet att släppa ut vådliga ämnen. En ny föreskrift har lagts\n                till, vad gäller förbud mot att bygga om eller ändra befintlig byggnad\n                eller anläggning.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":2862,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbudet"],"dokument_id":"nvdok-1025806","dokument_namn":"hässningberget beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025806","dokument_sha256":"5fa5b2377ac5a4a700aa81c27037338b4262a39500ef98c6ca03fcbd7f737660","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I C föreskrifterna enligt 7 kap. 30 § miljöbalken, om rätten att färdas\n                och vistas samt ordningen i övrigt inom naturreservatet, har lättnader i\n                förbuden inrättats vad gäller att plocka icke-fridlysta blommor, samt att\n                sätta upp skyltar och liknande anordningar med Länsstyrelsens tillstånd.\n                Det nya beslutet får också ett förstärkt skydd genom tillägg i C-\n                föreskrifterna, med att det nu förbjuds att elda på annat än angivna\n                platser, något som vill skona terrängen från skador som följer med ett\n                ökat besökstryck i området.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":10,"teckenoffset_pa_sidan":333,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","förbuden"],"dokument_id":"nvdok-1025806","dokument_namn":"hässningberget beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025806","dokument_sha256":"5fa5b2377ac5a4a700aa81c27037338b4262a39500ef98c6ca03fcbd7f737660","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Konsekvensutredning\n                Enligt förordningen (2007:1244) om konsekvensutredning vid\n                regelgivning ska en bedömning om konsekvensutredning göras för\n                ordningsföreskrifterna enligt 7 kap. 30 § miljöbalken. Dessa föreskrifter\n                gäller rätten att färdas och vistas, och ordningen i övrigt i området och\n                exemplifieras i förarbetena till miljöbalken (prop. 1997/98:45) som\n                förbud mot åtgärder som annars hade varit tillåtna enligt allemansrätten.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":13,"teckenoffset_pa_sidan":2053,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","förbud"],"dokument_id":"nvdok-1025806","dokument_namn":"hässningberget beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025806","dokument_sha256":"5fa5b2377ac5a4a700aa81c27037338b4262a39500ef98c6ca03fcbd7f737660","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"6. framföra motordrivet fordon med undantag för uttransport av fälld älg,","inledning":"Utöver vad som eljest gäller är det förbjudet att","inledning_offset":1919,"inledning_sidnummer":6,"punkt":"6.","sidnummer":6,"teckenoffset_pa_sidan":2626,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1006779","dokument_namn":"Hässningsbergetbeslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1006779","dokument_sha256":"c316aebc1ab1f008f86da0c899bb2945da12812f1786c7cfea028ef8332e37fe","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"1. framföra motordrivet fordon,","inledning":"Utöver vad som eljest gäller är det förbjudet att","inledning_offset":12