r":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Området består av ett flertal nyckelbiotoper samt mindre delar av yngre skog som\nbinder ihop området och är viktiga för helheten och för att behålla en hög och jämn\nluftfuktighet inom reservatet. Skogen har ett stort inslag av gamla tallar och granar.\nBland annat finns det gott om tallar som är runt 200 år. Det finns även relativt gott\nom död ved, både stående och liggande. Ett 20-tal sällsynta arter (varav fem\nrödlistade) är funna i området. Förutom gamla träd är de knutna till en lång skoglig\nkontinuitet och en lång kontinuitet av död ved. Flera av dem kräver en jämn och hög\nluftfuktighet medan andra gynnas av solexponering.","inledning":"Dessutom är det förbjudet att utan Länsstyrelsens tillstånd:","inledning_offset":1614,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":927,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1010395","dokument_namn":"beslut_Loreberg_underskrivet inskannat_170217.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010395","dokument_sha256":"ac166a34bfb690cc9dfc9a5f6c6fcc0dc2c462db12c7751076b7ea32c35250b3","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[15.78698403,58.7475882],[15.78638964,58.74826368],[15.78644279,58.74890617],[15.78644297,58.74890655],[15.78644372,58.74890698],[15.78746357,58.74898297],[15.78908662,58.74896999],[15.78990014,58.74867961],[15.79049478,58.74