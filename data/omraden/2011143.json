ok-1040550","dokument_namn":"Beslut fso skärgård dec 2012.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040550","dokument_sha256":"562411c2a72746567b3ea9682226b3e1535fe6dfaedbd9c0eb660803a22ab67b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"fågelskyddsbestämmelserna inom dessa inte påverkar habitatens bevarandestatus\nnegativt. Några av de fågelskyddsområden som föreslås upphävas ligger även inom\nbefintliga SPA-områden, d.v.s. områden som är utpekade som särskilda\nskyddsområden för fågellivet. Länsstyrelsen anser vad gäller dessa objekt att\ntillträdesförbud inte krävs för att bevara fågellivet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":209,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1040550","dokument_namn":"Beslut fso skärgård dec 2012.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040550","dokument_sha256":"562411c2a72746567b3ea9682226b3e1535fe6dfaedbd9c0eb660803a22ab67b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.00296746,58.36122585],[17.00294298,58.36127279],[17.00292519,58.36132056],[17.0029142,58.36136885],[17.00289589,58.3614588],[17.00288927,58.36150053],[17.00288695,58.36158102],[17.00289838,58.36166138],[17.0029235,58.36174097],[17.00296202,58.36181888],[17.00301371,58.3