rbjudet att:","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"C.","sidnummer":4,"teckenoffset_pa_sidan":423,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","förbjudet"],"dokument_id":"nvdok-1020817","dokument_namn":"Rönnåsliden_beslut och skötselplan_underskrift_ej_sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1020817","dokument_sha256":"3427496e0bdbdae0c4e7bbfb41488f7943a815eda9307bb4b336d5e09031b146","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"3. störa djurlivet, till exempel genom att klättra i boträd eller medvetet\n           uppehålla sig nära rovfågelbo, lya eller gryt,","inledning":"Det är förbjudet att:","inledning_offset":569,"inledning_sidnummer":4,"punkt":"3.","sidnummer":4,"teckenoffset_pa_sidan":865,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurlivet","störa"],"dokument_id":"nvdok-1020817","dokument_namn":"Rönnåsliden_beslut och skötselplan_underskrift_ej_sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1020817","dokument_sha256":"3427496e0bdbdae0c4e7bbfb41488f7943a815eda9307bb4b336d5e09031b146","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4. framföra motordrivet fordon annat än på befintliga skogsbilvägar, med\n           undantag för snöskoterkörning vintertid på snötäckt, väl tjälad mark eller\n           på is,","inledning":"Det är förbjudet att:","inledning_offset":569,"inledning_sidnummer":4,"punkt":"4.","sidnummer":4,"teckenoffset_pa_sidan":1007,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1020817","dokument_namn":"Rönnåsliden_beslut och skötselplan_underskrift_ej_sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1020817","dokument_sha256":"3427496e0bdbdae0c4e7bbfb41488f7943a815eda9307bb4b336d5e09031b146","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Beskrivning av reservatet\n        Rönnåslidens naturreservat ligger ca 31 km sydväst om Lycksele. Området\n        utgörs av ett stort sammanhängande naturskogsområde med grandominerad\n        naturskog. Det finns även ett stort inslag av våtmarker, tjärnar, bäckar och\n        sjöar. Området har mycket höga naturvärden knutna till det naturskogsartade\n        skogstillståndet, med god förekomst av gamla träd samt stående och\n        liggande död ved. Reservatet hyser flera sällsynta och rödlistade arter som\n        är beroende av gamla naturskogar.","inledning":"Det är förbjudet att:","inledning_offset":569,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1143,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sällsynta","stort"],"dokument_id":"nvdok-1020817","dokument_namn":"Rönnåsliden_beslut och skötselplan_underskrift_ej_sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1020817","dokument_sha256":"3427496e0bdbdae0c4e7bbfb41488f7943a815eda9307bb4b336d5e09031b146","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsens motivering\n        Motiv för skyddet är att bevara områdets naturvärden och att motverka\n        exploatering. Områdets värdefulla strukturer har utvecklats genom att\n        naturliga processer fått verka relativt ostört under lång tid. För att områdets\n        naturvärden ska bevaras och utvecklas behöver det undantas från skogsbruk\n        och annan exploatering, verksamhet eller påverkan som innebär att områdets\n        naturvärden skadas.\n        Områden med naturskog blir allt mer sällsynta i länet och att skydda dessa\n        kvarvarande fragment av det ursprungliga skogslandskapet är avgörande för\n        att bevara den biologiska mångfalden.","inledning":"Det är förbjudet att:","inledning_offset":569,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1869,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sällsynta","stört"],"dokument_id":"nvdok-1020817","dokument_namn":"Rönnåsliden_beslut och skötselplan_underskrift_ej_sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1020817","dokument_sha256":"3427496e0bdbdae0c4e7bbfb41488f7943a815eda9307bb4b336d5e09031b146","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.14595931,64.42051744],[18.14542887,64.41976242],[18.14527776,64.41900211],[18.14527692,64.4190017],[18.14527571,64.41900156],[18.14425682,64.41900118],[18.14425579,64.41900156],[18.14425546,64.41900193],[18.14399806,64.41965567],[18.14306556,64.42272884],[18.14248112,64.42452984],[18.1424813,64.42453038],[18.14248214,64.4245308],[18.14517798,64.42528373],[18.14969092,64.42555212],[18.15036937,64.42903351],[18.14950557,64.42918243],[18.14950453,64.42918279],[18.1488854,64.42981438],[18.14888598,64.42981506],[18.15025666,64.43047689],[18.15027126,64.43130076],[18.15027223,64.43130121],[18.15352968,64.43208586],[18.15353092,64.43208599],[18.15353212,64.43208581],[18.15353291,64.43208538],[18.15422331,64.43135969],[18.15525879,64.43131382],[18.15574272,64.43258056],[18.15574329,64.43258084],[18.15574449,64.43258104]