{"nvrid":"2047540","slug":"predikstolen","namn":"Predikstolen","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Gagnef, Ludvika","lan":"Dalarnas Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Dalarnas län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2018-12-14","senaste_gallandedatum":"2019-01-10","area_ha":33.62,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2047540","svarslage":"reglerat-las-beslutet","luftfartslage":"luftfart","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Predikstolen_Beslut_20181214.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024384","dokument_id":"nvdok-1024384","sha256":"d8d97132b9a69d54708ec6b3d88abc6403ff9d8262003d45d5d884900e630d10","sidor":35,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"Bild_Från_Predikstolen.jpg","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024383","orsak":"ej föreskriftsbärande dokumenttyp"}],"citat":[{"citat":"6. framföra motordrivet fordon, gäller både barmark och snötäckt mark, med\n   följande undantag:\n         fälld älg, björn, hjort eller vildsvin får uttransporteras. Färdvägar ska\n           väljas med omsorg så att mark- och vegetationsskador minimeras,\n         för tjänstemän i sjukvårds-, polis- eller räddningsärende. Insatsen ska\n           anmälas omgående till Länsstyrelsen,","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att:","inledning_offset":2035,"inledning_sidnummer":2,"punkt":"6.","sidnummer":3,"teckenoffset_pa_sidan":188,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1024384","dokument_namn":"Predikstolen_Beslut_20181214.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024384","dokument_sha256":"d8d97132b9a69d54708ec6b3d88abc6403ff9d8262003d45d5d884900e630d10","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"2. framföra motordrivet fordon i terrängen, gäller både barmark och snötäckt\n   mark,","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att:","inledning_offset":1436,"inledning_sidnummer":3,"punkt":"2.","sidnummer":3,"teckenoffset_pa_sidan":1610,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1024384","dokument_namn":"Predikstolen_Beslut_20181214.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024384","dokument_sha256":"d8d97132b9a69d54708ec6b3d88abc6403ff9d8262003d45d5d884900e630d10","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"8. klättra i boträd eller medvetet störa djur i fågelbo, lya eller gryt.","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att:","inledning_offset":1436,"inledning_sidnummer":3,"punkt":"8.","sidnummer":3,"teckenoffset_pa_sidan":2316,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["fågelbo","störa","djur"],"dokument_id":"nvdok-1024384","dokument_namn":"Predikstolen_Beslut_20181214.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024384","dokument_sha256":"d8d97132b9a69d54708ec6b3d88abc6403ff9d8262003d45d5d884900e630d10","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"9. starta eller landa drönare, där undantag medges för tjänstemän i sjukvårds-,\n   polis- eller räddningsärende. Insatsen ska omgående anmälas till\n   Länsstyrelsen.","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att:","inledning_offset":1436,"inledning_sidnummer":3,"punkt":"9.","sidnummer":3,"teckenoffset_pa_sidan":2389,"klassificering":"start-landningsförbud","konfidens":"medel","traffade_ord":["drönare","starta","landa"],"dokument_id":"nvdok-1024384","dokument_namn":"Predikstolen_Beslut_20181214.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024384","dokument_sha256":"d8d97132b9a69d54708ec6b3d88abc6403ff9d8262003d45d5d884900e630d10","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Dalarnas Ornitologiska Förening såg positivt till att området skyddas. I sitt yttrande\nframför de att fågeljakt ej bör vara tillåtet inom området, samt att klättring bör vara\nförbjudet under häckningsperioden för att harmonisera föreskrifterna med det\nangränsande kommunala reservatet Tansvägga. De framför även att användandet av\ndrönare bör förbjudas inom reservatet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":183,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"hög","traffade_ord":["drönare","förbjudet"],"dokument_id":"nvdok-1024384","dokument_namn":"Predikstolen_Beslut_20181214.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024384","dokument_sha256":"d8d97132b9a69d54708ec6b3d88abc6403ff9d8262003d45d5d884900e630d10","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsen bedömer att ett permanent tillträdesförbud vid klipporna under\nhäckningstid för rovfåglar inte är befogat då en sådan inskränkning i friluftslivet är för\nlångtgående jämfört med den naturvårdsnytta det skulle innebära. Tillfälliga\nbeträdnadsförbud bedöms uppnå syftet att skydda häckningar.\nRörande inventering av klippväggar för att övervaka vilka naturvärden som finns och\nfölja dessa över tid bedömer Länsstyrelsen att eventuella skador på arter antagligen\nredan har skett, då klättring har pågått inom området under så lång tid.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":309,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"dokument_id":"nvdok-1024384","dokument_namn":"Predikstolen_Beslut_20181214.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024384","dokument_sha256":"d8d97132b9a69d54708ec6b3d88abc6403ff9d8262003d45d5d884900e630d10","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Vad gäller användande av drönare delar Länsstyrelsen synen om att flygandet av drönare\nvid klippan riskerar att störa häckande fåglar, och inför därmed en ny föreskrift om\nförbud mot start och landning av drönare i reservatet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":1863,"klassificering":"start-landningsförbud","konfidens":"hög","traffade_ord":["landning","drönare","start","förbud"],"dokument_id":"nvdok-1024384","dokument_namn":"Predikstolen_Beslut_20181214.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024384","dokument_sha256":"d8d97132b9a69d54708ec6b3d88abc6403ff9d8262003d45d5d884900e630d10","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskrift C4 förbjuder eldning annat än på anvisad plats. Skälet till detta är risken för\nskada på berg och störning av djurlivet.\nI föreskrift C6 och C7 förbjuds att skada block och berg genom att borra, hacka eller\nmejsla samt att klättra i bergsbranterna. I området finns branter som är intressanta ur\nbiologisk synvinkel, bl.a. för häckande fåglar. Undantag från förbudet gäller dock under\nvissa villkor inom avgränsade områden. Risken för störning av fågellivet regleras genom\natt avlysning sker i samråd med Dalarnas Klätterklubb.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":442,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågellivet","djurlivet","störning","förbjuder"],"dokument_id":"nvdok-1024384","dokument_namn":"Predikstolen_Beslut_20181214.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024384","dokument_sha256":"d8d97132b9a69d54708ec6b3d88abc6403ff9d8262003d45d5d884900e630d10","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[15.00256765,60.36267203],[15.00172621,60.36375301],[15.00172623,60.36375374],[15.00172726,60.36375427],[15.00172873,60.3637543],[15.00230556,60.3636549],[15.00398873,60.36337334],[15.01184691,60.36185877],[15.0157355,60.36439952],[15.01828681,60.36604299],[15.01828818,60.36604337],[15.01828968,60.36604314],[15.01829038,60.36604244],[15.01835631,60.36546289],[15.01766702,60.36388082],[15.02065583,60.36360061],[15.02065685,60.36360034],[15.02065745,60.36359964],[15.02065687,60.36359894],[15.01877527,60.36265699],[15.01816563,60.3619327],[15.01841917,60.3613285],[15.01841918,60.36132813],[15.01841868,60.36132763],[15.01294341,60.36003764],[15.01166501,60.35994121],[15.01122952,60.35935718],[15.01122883,60.35935673],[15.01122776,60.35935654],[15.00912932,60.35971511],[15.0091287,60.35971541],[15.0087546,60.36000006],[15.00785621,60.35956418],[15.00785509,60.35956391],[15.00692832,60.35959869],[15.00683993,60.35960264],[