8,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":894,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbud"],"dokument_id":"nvdok-1007458","dokument_namn":"Gammalsby_sjömarkerBeslutSkötselplan - GDPR.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007458","dokument_sha256":"6ea5181d743f217f9d845b8a02b08a800cd0367d2f66d8de1a418c03444af97b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Ölands Ornitologiska förening (Ö0F) är positiva till reservatsbildningen i sin\n  helhet och det tidsbegränsande beträdnadsförbudet som berör en stor del av\n  reservatet. Dock önskar ÖOF att strövstigen i norra delen av reservatet kunde\n  flyttas något närmre stranden. Anledningen är att ler- och sandbankarna inom\n  norra delen är mest intressanta för fågelskådning. ÖOF anser att den föreslagna\n  sträckningen på strövstig i just det området kan innebära vissa vinster för\n  fågellivet, men att de flesta vadararterna har sina bon längre upp på stranden i\n  vanligtvis mindre hårt betade marker.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":10,"teckenoffset_pa_sidan":381,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelskådning","fågellivet","stor","förbudet"],"dokument_id":"nvdok-1007458","dokument_namn":"Gammalsby_sjömarkerBeslutSkötselplan - GDPR.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007458","dokument_sha256":"6ea5181d743f217f9d845b8a02b08a800cd0367d2f66d8de1a418c03444af97b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Inom en stor del av reservatet kommer det att vara ett tidsbegränsat beträdnads-\nförbud under tiden 1 april-31 juli, för att minimera störningar på häckande fågel.\nAllmänheten kommer dock att ges möjlighet att vandra längs med en markerad\nströvstig mellan Seby badplats och Gräsgårds hamn. En fågelskådningsplattform\nkommer att placeras ut längs med strövstigen för att göra området mer\nlättöverskådligt (se skötselplanekarta bilaga 3.1). Ytterligare en fågelskådnings-\nplattform planeras straxt utanför reservatsgränsen i sydöstra delen vid Gräsgårds\nhamn.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":23,"teckenoffset_pa_sidan":2150,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelskådningsplattform","fågelskådnings","störningar","förbud"],"dokument_id":"nvdok-1007458","dokument_namn":"Gammalsby_sjömarkerBeslutSkötselplan - GDPR.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007458","dokument_sha256":"6ea5181d743f217f9d845b8a02b08a800cd0367d2f66d8de1a418c03444af97b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.52619529,56.32376292],[16.52699186,56.32452692],[16.52699265,56.32452732],[16.52699406,56.32452734],[16.52707273,56.32451002],[16.52716993,56.32457312],[16.52729652,56.32466281],[16.52757094,56.32488785],[16.52765277,56.32497781],[16.52774739,56.32511627],[16.52795175,56.32542827],[16.52770417,56.32546991],[16.52770309,56.32547041],[16.52770302,56.32547119],[16.52832623,56.32640854],[16.52832685,56.32640877],[16.52832794,56.32640881],[16.52987161,56.32619095],[16.52993256,56.32638844],[16.53001756,56.32656439],[16.53008388,56.32675019],[16.53045703,56.32742717],[16.53005019,56.