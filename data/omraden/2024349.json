":4,"teckenoffset_pa_sidan":880,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurlivet","fågelbo","störa"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1016084","dokument_namn":"Hattbäcken_Beslut_121024.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016084","dokument_sha256":"4a6f79260e5c14926f5206f2a82fcc100466d4826167cad3abe9b54681040b62","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"8. Framföra motordrivna fordon utanför befintlig väg.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":604,"inledning_sidnummer":4,"punkt":"8.","sidnummer":4,"teckenoffset_pa_sidan":1308,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivna","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1016084","dokument_namn":"Hattbäcken_Beslut_121024.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016084","dokument_sha256":"4a6f79260e5c14926f5206f2a82fcc100466d4826167cad3abe9b54681040b62","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Skogen i reservatet har genomgående låg påverkansgrad och spår av skogsbruk är\nsällsynta. I de gamla sumpskogarna är luftfuktighet ofta mycket hög, vilket är en viktig\nförutsättning för många uttorkningskänsliga naturskogsarter. Här trivs bland annat\nhänglavar och i delar av området är de gamla granarna ofta helt draperade med garnlav.\nDen mycket sällsynta och krävande arten trådbrosklav förekommer också på ett par\nplatser inom reservatet. Tillgången på död ved varierar mycket inom området och det är\nframför allt i de mer produktiva bestånden i norra delen av reservatet som man finner\nstörre mängder lågor och torrakor.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":604,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1302,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sällsynta","större"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1016084","dokument_namn":"Hattbäcken_Beslut_121024.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016084","dokument_sha256":"4a6f79260e5c14926f5206f2a82fcc100466d4826167cad3abe9b54681040b62","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Bland andra intressanta arter som hittats i reservatet kan förekomst av lavskrika, tretåig\nhackspett och gråspett vara värda att nämna. Den sällsynta skalbaggen bronshjon har\nockså hittats i reservatet. Insekten förekommer i stort sett bara i mycket gamla,\nsenvuxna och hänglavsrika granbestånd.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":604,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":2321,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sällsynta","stort"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1016084","dokument_namn":"Hattbäcken_Beslut_121024.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016084","dokument_sha256":"4a6f79260e5c14926f5206f2a82fcc100466d4826167cad3abe9b54681040b62","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[2