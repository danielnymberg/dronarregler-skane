la och den högvuxna\noch sällsynta ormbunken safsa (kungsbräken). Utefter ån förekommer sumpskog som\ndomineras av al. Forsarna i Holjeån har tidigare använts för vattenkraftproduktion. Utvinning\nav vattenkraft upphörde för mer än ca 30 år sedan, men anläggningar och dammar finns kvar i\nområdet.","inledning":"Utöver föreskrifter och förbud i andra lagar är det inom naturreservatet förbjudet att","inledning_offset":181,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":80,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sällsynta","stor","djur"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1013363","dokument_namn":"Ljungryda-Östarfors BESLUT ändr föreskr 2001 Webb.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1013363","dokument_sha256":"e175fd0ed12c177e4e28bbdda72c3e98c647e1cec31e1895c03e8d2414c371c4","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.51320717,56.21470003],[14.51172296,56.21528776],[14.51172251,56.21528825],[14.51172259,56.2152888],[14.51186113,56.21548943],[14.51208589,56.2155891],[14.51255252,56.21576542],[14.51319594,56.21609957],[14.51372533,56.21625239],[14.51407427,56.21629774],[14.51462142,56.21634929],[14.51524884,56.21638491],[14.51536588,56.21648894],[14.51536669,56.21648932],[14.5153674,56.2164894],[14.51536868,56.21648908],[14.51536915,56.21648835],[14.51528991,56.21584758],[14.51597284,56.21590074],[14.51597386,56.21590065],[14.51597441,56.21590042],[14.51610262,56.21569151],[14.5162