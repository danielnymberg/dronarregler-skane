{"nvrid":"2025525","slug":"skottarn","namn":"Skottarn","skyddstyp":"Djur- och växtskyddsområde","lager":"djur-och-vaxtskydd","karnlager":true,"kommun":"Mariestad","lan":"Västra Götalands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Västra Götalands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2010-03-23","senaste_gallandedatum":"2010-03-23","area_ha":5.37,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2025525","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"31/7"}],"sasongsdata":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"31/7"}],"dokument":[{"namn":"brommo_bil_2_1.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040371","dokument_id":"nvdok-1040371","sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","sidor":10,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Beslut\n               Till skydd för fågellivet meddelar Länsstyrelsen med stöd av 7 kap 12 §\n               miljöbalken (1998:808) att det är förbjudet att färdas eller uppehålla sig på\n               följande öar och skär med omgivande vattenområden:","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":564,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1040371","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040371","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Thomas Landgren har på uppdrag av Länsstyrelsen i Västra Götalands län,\ngjort en översyn av fågelskyddet i Brommö-Kalvö skärgårdar, se\nLänsstyrelsens rapport 2007:17 1 . I rapporten föreslås:\n    - att skyddet i 4 befintliga fågelskyddsområden förblir oförändrat,\n    - att gränser och tillträdesförbud revideras för 5 befintliga\n        fågelskyddsområden,\n    - att 7 nya fågelskyddsområden inrättas och\n    - att fågelskyddsområdena Trollö och Laxhallarna upphävs.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":610,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1040371","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040371","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Sedan början av 1970-talet har Länsstyrelsen beslutat om ett flertal\nfågelskyddsområden i Brommö-Kalvö skärgårdar. Flera av dessa beslut har\ndärefter delvis upphävts. I beslutet för naturvårdsområdet Kalvö skärgård, i\nbeslutet för naturvårdsområde Västra Brommö, och i beslutet för\nnaturreservatet Brommö skärgård har också områden med tillträdesförbud\nangetts.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1079,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1040371","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040371","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"För att tydliggöra vilka områden som omfattas av tillträdesförbud i\nBrommö-Kalvö skärgårdar upphävs genom detta beslut samtliga tidigare\nbeslut om tillträdesförbud i Brommö-Kalvö skärgårdar.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1442,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1040371","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040371","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"De områden som fortfarande hyser ett värdefullt och störningskänsligt\nfågelliv ingår i detta beslut. Detta nya beslut omfattar då samtliga områden\nmed tillträdesförbud inom Brommö-Kalvö skärgårdar i Mariestads\nkommun.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1634,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1040371","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040371","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Thomas Landgren: för lokal 3 och 5 bör tillträdesförbudet vara 1 februari\ntill 15 augusti.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":180,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1040371","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040371","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsen har justerat tiden för tillträdesförbudet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":272,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1040371","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040371","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsens beslut är ett tidsbegränsat tillträdesförbud. Sjöfartsverkets\nmarkerade farleder omfattas inte av förbudet. Länsstyrelsen har vidare i sitt\nbeslut meddelat att tillträdesförbud inte gäller Sjöfartsverket.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":627,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1040371","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040371","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.64957171,58.85361094],[13.64968133,58.8535957],[13.64978864,58.85357678],[13.64989325,58.85355431],[13.64999488,58.85352829],[13.6