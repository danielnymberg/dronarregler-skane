":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Danderyds kommun har hemställt att Länsstyrelsen skyddar ön Råholmen som\nfågelskyddsområde. Senare har Danderyds kommun bildat naturreservatet Öarna i\nStora Värtan, där kommunens del av Råholmen ingår. Delen av Råholmen inom\nreservatet är också fågelskyddsområde med tillträdesförbud peroiden 1 april – 31\njuli enligt reservatsföreskrifterna. Fågelskyddet inom reservatet innefattar också\nöarna Västerskär och Svalnäsholmen.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1587,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelskyddsområde","Fågelskyddet","Stora","förbud"],"dokument_id":"nvdok-1035688","dokument_namn":"Raholmen_beslut_2005-01-24.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1035688","dokument_sha256":"552dcea01b716dc8df39c72e49e5b0b6fa419a52775a7c3c0a0442bea8cf16a9","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.12177558,59.41218389],[18.11899708,59.41251887],[18.11899585,59.41251934],[18.11899566,59.41252011],[18.11899631,59.4125206],[18.12006332,59.41295619],[18.12138553,59.41310573],[18.12138675,59.41310567],[18.12247808,59.41285441],[18.12247895,59.41285401],[18.12332679,59.41212692],[18.12332706,59.41212639],[18.12303094,59.41140754],[18.12249526,59.40998813],[18.12249472,59.40998762],[18.12249371,59.40998735],[18.12249225,59.40998751],[18.12249145,59.40998816],[18.12177558,59.412