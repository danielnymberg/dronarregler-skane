eringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. ORDNINGSFÖRESKRIFTER ENLIGT 7 KAP. 30 § MB OM\n   RÄTTEN ATT FÄRDAS OCH VISTAS INOM\n   NATURRESERVATET SAMT OM ORDNINGEN I ÖVRIGT\n   INOM NATURRESERVATET\n\nInom naturreservatet är det förbjudet att:","inledning":"Inom reservatet är det utan Länsstyrelsens tillstånd förbjudet att:","inledning_offset":1225,"inledning_sidnummer":2,"punkt":"C.","sidnummer":3,"teckenoffset_pa_sidan":565,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["FÄRDAS","VISTAS","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1014352","dokument_namn":"Uvaberget Tenhult beslut och skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014352","dokument_sha256":"2a5e512ee6a596ec23ef7fdc70e703b9933c0452beada55c6368ada7491c718a","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"5. ställa upp husvagn, släpvagn, husbil eller motorfordon","inledning":"Inom naturreservatet är det förbjudet att:","inledning_offset":722,"inledning_sidnummer":3,"punkt":"5.","sidnummer":3,"teckenoffset_pa_sidan":1216,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motorfordon"],"handlingar":["marken"],"dokument_id":"nvdok-1014352","dokument_namn":"Uvaberget Tenhult beslut och skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014352","dokument_sha256":"2a5e512ee6a596ec23ef7fdc70e703b9933c0452beada55c6368ada7491c718a","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Naturskyddsföreningen anser att udden och kärret öster om\nreservatsgränsen borde inkluderas i reservatet. Naturskyddsföreningen\nframhåller vidare att bergsklättring ska förbjudas under hela året för att inte\nriskera att pilgrimsfalk eller berguv störs vid häckningsplatserna.\nNaturskyddsföreningen påpekar även att det eventuellt behövs\nbeträdnadsförbud även i anslutning till klippbranten.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1922,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["häckningsplatserna","störs","förbjudas"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1014352","dokument_namn":"Uvaberget Tenhult beslut och skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014352","dokument_sha256":"2a5e512ee6a596ec23ef7fdc70e703b9933c0452beada55c6368ada7491c718a","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Uvaberget utgör en lämplig häckningsmiljö för både berguv och\npilgrimsfalk. Dessa arter är med på listan över hotade arter i Sverige\n(Rödlistade arter i Sverige 2010) samt i EU:s fågeldirektiv (Bilaga 1 till rådets\ndirektiv 79/409/EEG om bevarande av vilda fåglar). Vidare är dessa arter\nmed på den lista över arter som det enligt artskyddsförordningen bör ges\nspeciell uppmärksamhet vid tillämpningen av förbudet mot att störa fåglar\n(Bilaga 3 till Artskyddsförordningen (2007:845)).","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":623,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["häckningsmiljö","fågeldirektiv","fåglar","förbudet"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1014352","dokument_namn":"Uvaberget Tenhult beslut och skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014352","dokument_sha256":"2a5e512ee6a596ec23ef7fdc70e703b9933c0452beada55c6368ada7491c718a","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskrifterna är anpassade till naturreservatets syften och värden. De är\nfrämst avsedda att bevara den biologiska mångfalden knuten till brantmiljö,\nnaturskog och naturliga skyddszoner mot vatten. Pilgrimsfalk och berguv är\nkänsliga för störningar under sin häckningsperiod. Det är därför motiverat\natt det inom brantområdet är förbjudet med bergsklättring och för\nmänniskor att uppehålla sig där under perioden 1 februari – 15 augusti.\nTillstånd från Länsstyrelsen krävs innan större lägerverksamheter anordnas.\nLänsstyrelsen gör bedömningen att det i nuläget inte är motiverat med\nytterligare begränsningar för friluftslivet då det varit lyckade häckningar av\npilgrimsfalk under senare år.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":2348,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["häckningsperiod","störningar","häckningar","förbjudet"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1014352","dokument_namn":"Uvaberget Tenhult beslut och skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1014352","dokument_sha256":"2a5e512ee6a596ec23ef7fdc70e703b9933c0452beada55c6368ada7491c718a","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.32542751,57.68112243],[14.32542649,57.68112247],[14.3254259,57.68112266],[14.32542549,57.68112296],[14.32542531,57.6811235],[14.32549475,57.68145868],[14.32557544,57.68173412],[14.32567075,57.68207755],[14.32576511,57.68242364],[14.32583976,57.68267767],[14.32592334,57.68