sidnummer":4,"teckenoffset_pa_sidan":734,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurlivet","fågelbo","störa"],"dokument_id":"nvdok-1016548","dokument_namn":"120514 Beslut Vallegielas inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016548","dokument_sha256":"6f493925cf9b8fec5861747e8edd3d470be57b0cbeeb221d3dda26fadfe5328c","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"8. Framföra motordrivna fordon utanför befintlig väg.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":458,"inledning_sidnummer":4,"punkt":"8.","sidnummer":4,"teckenoffset_pa_sidan":1296,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivna","fordon"],"dokument_id":"nvdok-1016548","dokument_namn":"120514 Beslut Vallegielas inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016548","dokument_sha256":"6f493925cf9b8fec5861747e8edd3d470be57b0cbeeb221d3dda26fadfe5328c","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I de grandominerade delarna är de uråldriga träden ofta rikt draperade med hänglavar,\nframförallt garnlav. Skogen har mycket lång kontinuitet och det finns stora mängder av\ndöd ved i alla dimensioner och nedbrytningsstadier. På gammelgranarna förekommer\nnaturskogsarter som t ex knottrig blåslav och gammelgransskål på i stort sett varje träd\noch på de allra äldsta träden kan man även finna mer krävande arter som t ex liten\nsotlav. På lågorna förekommer en rik flora av arter som är knutna till urskogsartade\nskogar, som t ex rosenticka, gräddticka, kristallticka, rynkskinn, ostticka, harticka och\nlappticka. På de gamla sälgarna finner man arter som skrovellav, lunglav och doftticka.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":458,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1434,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sälgarna","stora","stort"],"dokument_id":"nvdok-1016548","dokument_namn":"120514 Beslut Vallegielas inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016548","dokument_sha256":"6f493925cf9b8fec5861747e8edd3d470be57b0cbeeb221d3dda26fadfe5328c","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"För besökaren har Vallegielas naturreservat mycket att erbjuda. De gamla, trolska\nurskogarna inbjuder till vandringar och tar man sig upp till någon av bergstopperna,\nväntar en storslagen utsikt över det omkringliggande landskapet. För den som inte vill\nvandra lika långt finns vackra vyer, urskogar och fina fikaplatser även i låglandet, t ex\nvid någon av sjöarna. Den som har tur kan även få besök vid fikaplatsen av Norrbottens\nlandskapsdjur, den sällskapliga lavskrikan.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":458,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":2818,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sällskapliga","storslagen"],"dokument_id":"nvdok-1016548","dokument_namn":"120514 Beslut Vallegielas inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016548","dokument_sha256":"6f493925cf9b8fec5861747e8edd3d470be57b0cbeeb221d3dda26fadfe5328c","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"De urgamla skogarna i Vallegielas har mycket höga naturvärden och hyser även en stor\nmångfald av växter och djur knutna till naturskogsmiljöer. Skogsavverkning eller annan\nexploatering skulle innebära att områdets naturvärden förstörs. Med anledning av detta\nhar frågan om bildande av ett naturreservat aktualiserats.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":458,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":3320,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["störs","stor","djur"],"dokument_id":"nvdok-1016548","dokument_namn":"120514 Beslut Vallegielas inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016548","dokument_sha256":"6f493925cf9b8fec5861747e8edd3d470be57b0cbeeb221d3dda26fadfe5328c","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[18.3038808,65.85252999],[18.30388065,65.85253051],[18.30396635,65.85276976],[18.30404648,65.85299966],[18.30418275,65.85309341],[18.30434431,65.85327432],[18.30433531,65.85338233],[18.30475625,65.85434969],[18.30475718,65.8543503],[18.30475844,65.8543505],[18.30475975,65.85435038],[18.31237458,65.8526996],[18.31645261,65.85577404],[18.31004712,65.85716654],[18.31004594,65.85716713],[18.31004615,65.85716789],[18.31188011,65.8585039],[18.31188091,65.85850414],[18.31188238,65.85850422],[18.31264045,65.85844373],[18.3128997,65.85937469],[18.31580841,65.86069196],[18.32022997,65.8626926],[18.32549326,65.86507233],[18.33052156,65.86734642],[18.32892339,65.86976727],[18.32892333,65.86976767],[18.32892396,65.86976821],[18.32892523,65.8697685],[18.33126597,65.86996673],[18.33523703,65.86936017],[18.33523798,65.8693597],[18.33