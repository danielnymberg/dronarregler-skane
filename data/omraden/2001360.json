a, ta bort, gräva ut, täcka över eller genom bebyggel-\nse, plantring eller på annat sätt ändra eller skada en fornlämning. Schaktning, körning, upp-\nläggning av massor samt uppställning av fordon och arbetsmaterial får inte ske i närheten.\nVid avverkning får fornlämningarna inte skadas.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":15,"teckenoffset_pa_sidan":2226,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1033220","dokument_namn":"Beslut inkl SP_Stengardet.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1033220","dokument_sha256":"45c01e33e6658ff6e11c167dceec7e1ecc1a1d1e85f83f22607ac9c5a73fa4ca","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.10216775,59.36384742],[16.10216762,59.36384799],[16.10216842,59.36384863],[16.10216948,59.3638488],[16.10217256,59.36384884],[16.10559051,59.36388903],[16.10573205,59.36477896],[16.10573278,59.36477965],[16.10573387,59.36477986],[16.10806067,59.36485006],[16.10805518,59.36487122],[16.10802422,59.365014],[16.10802819,59.36506054],[16.10802803,59.36508355],[16.10800833,59.36515638],[16.10796391,59.36527588],[16.1079528,59.36535424],[16.10794652,59.36551018],[16.10793378,59.36560173],[16.10792912,59.36567417],[16.1079445,59.36574642],[16.10800401,59.36585519],[16.10805509,59.3659529],[16.10806258,59.36602181],[16.10803795,59.36614871],[16.10796635,59.36634457],[16.10795117,59.36638231],[16.10787829,59.3666027],[16.10782431,59.36682447],[16.10780096,59.