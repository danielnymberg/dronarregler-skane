{"nvrid":"2013471","slug":"sillmansasen","namn":"Sillmansåsen","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Sundsvall","lan":"Västernorrlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Västernorrlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2007-12-12","senaste_gallandedatum":"2007-12-17","area_ha":146.39,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2013471","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":true,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"2013471_inscannad.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011918","dokument_id":"nvdok-1011918","sha256":"a2fa2f47f66bf63becea22ca2dfb34ce4033dc1ea0bf0d0a06750d9c2dda0e76","sidor":15,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"B. Föreskrifter om förpliktelser för ägare och innehavare av särskild rätt att tåla intrång\nenligt 7 kap 6 $ miljöbalken.\n\nMarkägare och innehavare av särskild rätt förpliktigas tåla att följande åtgärder vidtas\nför att tillgodose ändamålet med reservatet:\n\n1 upphuggning och markering av reservatsgränsen.\n\n2 uppsättning av informationstavlor.\n\n3 anläggning och underhåll av stigar.\n\n4 kontrollerade bränningar i naturvårdande syfte, samt eventuella därtill hörande\nstängslingar, avverkningar och nyttjande av motorfordon.\n\n5 undersökningar av mark, vatten, vegetation och djurliv.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1164,"inledning_sidnummer":2,"punkt":"B.","sidnummer":3,"teckenoffset_pa_sidan":0,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motorfordon"],"handlingar":["marken"],"dokument_id":"nvdok-1011918","dokument_namn":"2013471_inscannad.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011918","dokument_sha256":"a2fa2f47f66bf63becea22ca2dfb34ce4033dc1ea0bf0d0a06750d9c2dda0e76","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Föreskrifter enligt 7 kap 30 $ miljöbalken om rätten att färdas och vistas inom\nreservatet samt om ordningen i övrigt inom reservatet.\n\nUtöver vad som för övrigt gäller är det förbjudet att:\n\n1 fälla eller på annat sätt skada levande eller döda stående och omkullfallna träd och\nbuskar.\n\n2 insamla mossor, svampar eller lavar med undantag för plockning av matsvamp för\nhusbehov.\n\n3 genom grävning eller på annat sätt skada mark och block.\n\n4 insamla eller föra bort ryggradslösa djur.\n\n5 klättra i boträd eller på annat sätt medvetet störa eller skada djurlivet.\n\n6 framföra motordrivet fordon annat än på befintlig väg.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1164,"inledning_sidnummer":2,"punkt":"C.","sidnummer":3,"teckenoffset_pa_sidan":584,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbjudet"],"handlingar":["flyga","landa","lyfta","marken"],"dokument_id":"nvdok-1011918","dokument_namn":"2013471_inscannad.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011918","dokument_sha256":"a2fa2f47f66bf63becea22ca2dfb34ce4033dc1ea0bf0d0a06750d9c2dda0e76","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.51682944,62.31341124],[16.51681777,62.31348322],[16.51678218,62.313568],[16.51663139,6