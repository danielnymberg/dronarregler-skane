öjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1035772","dokument_namn":"sånfjället_231-3933-89.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1035772","dokument_sha256":"29573109372ecbaa10b33f1538ee869c169a1ae929d1a25c4210157b9b1cd65d","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"tider av året. Enligt uppgift från samebyn nyttjas Sånfjället\ndels som återsamlingsplats för renarna under en vecka kring\n15 april inför flyttningen tillbaka till fjälls, dels som\nreservbete under vinterhalvåret. Området har dock enligt\nordföranden i samebyn (muntligt 1989-03-06) hittills inte\nbehövt nyttjas som reservbete. Helikopter används i ren-\nskötseln bl a vid hopsamlingen av renarna på Sånfjället inför\nflyttningen. Skoter används under flyttningen.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":16,"teckenoffset_pa_sidan":435,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","dokument_id":"nvdok-1035772","dokument_namn":"sånfjället_231-3933-89.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1035772","dokument_sha256":"29573109372ecbaa10b33f1538ee869c169a1ae929d1a25c4210157b9b1cd65d","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.48803352,62.28678915],[13.45551975,62.3050991],[13.45551928,62.30509985],[13.4555198,62.30510039],[13.47178713,62.31078108],[13.49008671,62.32192305],[13.49645323,62.32580361],[13.5