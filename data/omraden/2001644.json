geodata.naturvardsverket.se/handlingar/rest/dokument/1033367","dokument_id":"nvdok-1033367","sha256":"030adc5002e784c77115833538c4850ac46b94e96b6ae514f048eed74d53b137","sidor":13,"ocr":false,"beslutsstatus":"Gällande","fel":null},{"namn":"Galo_2006-01-26_beslut.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026793","dokument_id":"nvdok-1026793","sha256":"cc85c69d2455b4f2e4ac89a718cc8c72012937e7327ede2e459bbac7f4aa5c2e","sidor":14,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"Marin_skötselplan_Gålö.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1033223","orsak":"ej föreskriftsbärande dokumenttyp"},{"namn":"Galo_2006-01-26_skotselplan.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026792","orsak":"ej föreskriftsbärande dokumenttyp"}],"citat":[{"citat":"•    Föreskrifter för båtliv (exempelvis hastighetsbegränsningar,\n                               förbud mot motordriven farkost och ankringsförbud) beslutas\n                               med stöd av sjötrafikförordningen (1986:300). Mer\n                               information finns i Transportstyrelsens föreskrifter och\n                               allmänna råd om sjövägsregler och Stockholms läns\n                               författningssamling.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1725,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordriven","farkost","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1033224","dokument_namn":"Marint_tilläggsbeslut_Gålö.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1033224","dokument_sha256":"f0dd8b377ec551907cc51184cff2c70547d800a197057a75b1148c37f34b62b9","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskriften A9, om tillträdesförbud för vissa delar av Gålö naturreservat, ska inte\n                utgöra hinder för att bedriva verksamhet som behövs för totalförsvarets räkning.\n                Undantaget gäller inom den zon av mark och vatten vilken är markerad på karta,\n                bilaga 1.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":27,"teckenoffset_pa_sidan":1926,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1033224","dokument_namn":"Marint_tilläggsbeslut_Gålö.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1033224","dokument_sha256":"f0dd8b377ec551907cc51184cff2c70547d800a197057a75b1148c37f34b62b9","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Bakgrund\n                Fortifikationsverket har ansökt om ett undantag från tillträdesförbudet som gäller\n                för Fjäderholmama inom Gålö naturreservat i Haninge kommun. Ansökan gäller\n                ett område på södra delen av Västra Fjäderholmen, i anslutning till de byggnader\n                som Fortifikationsverket äger. Byggnaderna används för närvarande av\n                totalförsvaret. Till anläggningen hör även en brygga.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":27,"teckenoffset_pa_sidan":2340,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","undantag från"],"handlingar":["marken"],"dokument_id":"nvdok-1033224","dokument_namn":"Marint_tilläggsbeslut_Gålö.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1033224","dokument_sha256":"f0dd8b377ec551907cc51184cff2c70547d800a197057a75b1148c37f34b62b9","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"För att kunna nyttja byggnaderna på södra delen av Västra Fjäderholmen behöver\npersonal från Fortifikationsverket eller annan myndighet inom totalförsvaret som\nFortifikationsverket upplåter byggnaderna till, kunna ha tillträde dit året om, utan\natt hindras av tillträdesförbudet","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":28,"teckenoffset_pa_sidan":400,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","tillträde","förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1033224","dokument_namn":"Marint_tilläggsbeslut_Gålö.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1033224","dokument_sha256":"f0dd8b377ec551907cc51184cff2c70547d800a197057a75b1148c37f34b62b9","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Fjäderholmarna ägdes från 1940-talet till 1998 av Stockholms stad, men överläts\ndärefter till Skärgårdsstiftelsen. Försvaret har arrenderat södra delen av Västra\nFjäderholmen sedan 1930. Fjäderholmarna skyddades tör tagellivets skull redan\n1950, då Länsstyrelsen med stöd av dåvarande bestämmelser om\nnaturminnesmärkens fredande belade öarna med tillträdesförbud under känsliga\ndelar av vår och sommar. Året efter tillkom ett undantag för personal tillhörande\nkungliga flottan att vid nödvändiga tjänsteförrättningar beträda de fridlysta\nområdena. Det skyddade området utvidgades med flera öar 1982, och 1984\nbelades även vattenområdet närmast öarna med vistelseförbud.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":28,"teckenoffset_pa_sidan":680,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","beträda","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1033224","dokument_namn":"Marint_tilläggsbeslut_Gålö.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/