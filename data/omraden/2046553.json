{"nvrid":"2046553","slug":"feron","namn":"Ferön","skyddstyp":"Djur- och växtskyddsområde","lager":"djur-och-vaxtskydd","karnlager":true,"kommun":"Olofström","lan":"Blekinge Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Blekinge län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2017-03-23","senaste_gallandedatum":"2017-04-19","area_ha":1.66,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2046553","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":true,"foreskriftsomraden":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"15/7"}],"sasongsdata":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"15/7"}],"dokument":[{"namn":"FSO Ferön, med karta.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1043571","dokument_id":"nvdok-1043571","sha256":"105dc283f6f8f49679b2b82fe670242c4c9c321d6992e98014c8bc29725f765f","sidor":3,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Inom området är det förbjudet att:\ne färdas eller uppehålla sig årligen under tidsperioden 1 april — 15 juli.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":307,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1043571","dokument_namn":"FSO Ferön, med karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1043571","dokument_sha256":"105dc283f6f8f49679b2b82fe670242c4c9c321d6992e98014c8bc29725f765f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Ferön utgör häckningsplats för fiskgjuse. Fiskgjuse är mycket känslig för störningar vid\nboplatsen. Fåglarna återvänder ogärna till boet så länge störningen finns kvar, vilket kan\nleda till misslyckad häckning. Länsstyrelsen anser därför att ett tillträdesförbud under\nhäckningstiden är angeläget för att den skyddsvärda arten ska kunna reproducera sig.","inledning":"Inom området är det förbjudet att:","inledning_offset":307,"inledning_sidnummer":1,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":1126,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1043571","dokument_namn":"FSO Ferön, med karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1043571","dokument_sha256":"105dc283f6f8f49679b2b82fe670242c4c9c321d6992e98014c8bc29725f765f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Naturskyddsföreningen i Olofström har begärt att länsstyrelsen beslutar om djurskydds-\nområde för Ferön, i syfte att skydda häckande fiskgjuse från mänskliga störningar. Ar-\nten har, enligt vad som uppgivits, efter många års frånvaro återvänt och häckar nu","inledning":"Inom området är det förbjudet att:","inledning_offset":307,"inledning_sidnummer":1,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":1506,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1043571","dokument_namn":"FSO Ferön, med karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1043571","dokument_sha256":"105dc283f6f8f49679b2b82fe670242c4c9c321d6992e98014c8bc29725f765f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"202)\n\nåterigen på ön. Halen är en välfrekventerad båt- och kanotsjö, och just Ferön är enligt\nuppgift populär att angöra för att rasta och grilla, något som innebär en stor störnings-\nrisk under häckningstid.\n\nEtt förslag till bildande av djurskyddsområde (fågelskyddsområde) har skickats till fas-\ntighetsägaren för yttrande, liksom till Olofströms kommun, Miljöförbundet Blekinge\nVäst och Västblekinges Ornitologiska Förening. Miljöförbundet och Olofströms kom-\nmun har tillstyrkt förslaget.\n\nÖverklagande\n\nDetta beslut kan överklagas hos Mark- och miljödomstolen vid Växjö tingsrätt, inom tre\nveckor från den dag kungörelse om beslutet varit införd i ortstidning.","inledning":"Inom området är det förbjudet att:","inledning_offset":307,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":0,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1043571","dokument_namn":"FSO Ferön, med karta.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1043571","dokument_sha256":"105dc283f6f8f49679b2b82fe670242c4c9c321d6992e98014c8bc29725f765f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.47446427,56.26455293],[14.47444631,56.26454565],[14.47444561,56.26454548],[14.47444449,56.26454555],[14.4729885,56.26493442],[14.47298761,56.26493496],[14.47297675,56.26495122],[14.472961,56.26497934],[14.47294861,56.26500793],[14.47293963,56.26503683],[14.47293405,56.26506607],[14.47293191,56.26509551],[14.47293324,56.2651249],[14.47293564,56.26514219],[14.47294641,56.26520421],[14.47293757,56.26527536],[14.47293569,56.26530182],[14.47293378,56.26540752],[14.47293509,56.26543797],[14.47293986,56.26546725],[14.47294807,56.26549629],[14.47295967,56.26552498],[14.47297461,56.26555318],[14.47299287,56.26558082],[14.4730415,56.26564544],[14.47306196,56.26568801],[1