a256":"814dd9ee9f6bbd508d900be0fa8d9646c3dd5e9b456755f69694f1711264962e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"2. framföra motordrivet fordon i terrängen, gäller både barmark och snötäckt\n   mark.","inledning":"är det förbjudet att:","inledning_offset":1941,"inledning_sidnummer":3,"punkt":"2.","sidnummer":3,"teckenoffset_pa_sidan":2169,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1023075","dokument_namn":"Åsberg-Åsklitt-beslut-skotsel-ejsänd.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023075","dokument_sha256":"814dd9ee9f6bbd508d900be0fa8d9646c3dd5e9b456755f69694f1711264962e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"reservatens gamla skogar har mycket stor betydelse för fågellivet. Föreningen anser också\natt jakt med fälla ska förbjudas. Slutligen vill föreningen påtala att förbud att använda\ndrönare bör övervägas, då detta stör både djurliv och besökare. Länsstyrelsen mottog\nsynpunkter från DOF efter remisstidens utgång, men besvarar dem ändå nedan.\nEnergimyndigheten avstyrker inrättandet av naturreservatet med de föreslagna gränser\nsom överskrider etablerade riksintresseområden för vindbruk.\nFriluftsfrämjandet Mora-Orsa är positiva till att reservatet bildas och önskar hänvisning\ntill reservatet från väg E45.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":175,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"hög","traffade_ord":["drönare","förbjudas"],"dokument_id":"nvdok-1023075","dokument_namn":"Åsberg-Åsklitt-beslut-skotsel-ejsänd.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023075","dokument_sha256":"814dd9ee9f6bbd508d900be0fa8d9646c3dd5e9b456755f69694f1711264962e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"samt fällors utformning i annan lagstiftning, som hanteras nationellt. Gällande drönare\nså bedömer länsstyrelsen att det i dagsläget inte föreligger skäl att införa föreskrifter som\nreglerar användning av drönare i området. Om en negativ påverkan uppkommer för\nfriluftsliv och fauna kan det finnas skäl att överväga ändringar av föreskrifterna.\nLänsstyrelsen bedömer att yttranden från kommunerna Mora och Malung-Sälen är\ntongivande för reservatets bildande, då en etablering av vindkraft inom utpekat område\nför riksintresse vindbruk kräver kommunernas tillstyrkan.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":168,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","traffade_ord":["drönare"],"dokument_id":"nvdok-1023075","dokument_namn":"Åsberg-Åsklitt-beslut-skotsel-ejsänd.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023075","dokument_sha256":"814dd9ee9f6bbd508d900be0fa8d9646c3dd5e9b456755f69694f1711264962e","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.85081145,60.87566901],[13.85072509,60.87569498],[13.85067939,60.87571105],[13.85062682,60.87573202],[13.85062617,60.87573248],[13.85038248,60.87610669],[13.8502661,60.87645071],[13.85016095,60.87685686],[13.85008728,60.8773285],[13.85012629,60.87753991],[13.84996479,60.87815716],[13.84922849,60.8814