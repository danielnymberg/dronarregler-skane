916af2e893addc6100bd353e97abcd8","sidor":4,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"Färskesjon i NO, Robert Ekholm.jpg","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1022142","orsak":"ej föreskriftsbärande dokumenttyp"},{"namn":"Färskesjön bokskog, Robert Ekholm.jpg","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1022144","orsak":"ej föreskriftsbärande dokumenttyp"},{"namn":"Färskesjön_Slättamossen_THVE.jpg","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1022145","orsak":"ej föreskriftsbärande dokumenttyp"},{"namn":"Färskesjöns sydspets. Robert Ekholm.jpg","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1022143","orsak":"ej föreskriftsbärande dokumenttyp"}],"citat":[{"citat":"C. Föreskriften enligt 7 kap. 30 § miljöbalken, om rätten att färdas och vistas och om ord-\n              ningen i övrigt i reservatet med förbud att:\n                  - nyttja området för övningar som verkar störande på naturen eller på allmänhetens\n                      friluftsliv, upphävs och ersätts med följande föreskrift:","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":924,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1028023","dokument_namn":"färskesjön 2025 ändring av föreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028023","dokument_sha256":"99f3ab81371eabf11b606e145c299c90dc0b8718e7223b8d6b611c33ec2a6404","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I skötselplanen från utvidgad del år 2017 (kap 3.5 Friluftsliv och turism) beskrivs att Färske-\n    sjöområdet är ett populärt rekreations- och friluftsområde och i bevarandemålet står att\n    ”Områdets natur ska kunna upplevas utan att reservatets naturvärden påverkas negativt.\n    Målet för friluftslivet inom utvidgningen av Färskesjöns naturreservat är att göra området\n    välbesökt och lättillgängligt. Besökare ska dels få möjlighet att lära sig mer om områdets\n    naturvärden, dels kunna erbjudas möjlighet till rekreation genom att vistas i ett naturskönt\n    landskap.”","inledning":"Enligt nuvarande föreskrifter i naturreservatet Färskesjön är det förbjudet att inom natur-\n              reservatet:","inledning_offset":2213,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":1062,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["vistas"],"handlingar":["marken"],"dokument_id":"nvdok-1028023","dokument_namn":"färskesjön 2025 ändring av föreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028023","dokument_sha256":"99f3ab81371eabf11b606e145c299c90dc0b8718e7223b8d6b611c33ec2a6404","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Motivering\n    Enligt 7 kap 30 § miljöbalken och 22 § förordningen (1998:1252) om områdesskydd enligt\n    miljöbalken m.m. får länsstyrelsen meddela föreskrifter om rätten att färdas och vistas, och\n    om ordningen i övrigt, inom ett område som skyddas som naturreservat om det behövs för\n    att tillgodose syftet med skyddet. Samtidigt som föreskrifterna bör utformas så att skyddet\n    blir ändamålsenligt får en inskränkning i den enskildes rätt att använda mark eller vatten\n    inte gå längre än vad som krävs för att syftet med skyddet ska tillgodoses enligt 7 kap. 25 §\n    miljöbalken.","inledning":"Enligt nuvarande föreskrifter i naturreservatet Färskesjön är det förbjudet att inom natur-\n              reservatet:","inledning_offset":2213,"inledning_sidnummer":1,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":1649,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["färdas","vistas"],"handlingar":["marken"],"dokument_id":"nvdok-1028023","dokument_namn":"färskesjön 2025 ändring av föreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028023","dokument_sha256":"99f3ab81371eabf11b606e145c299c90dc0b8718e7223b8d6b611c33ec2a6404","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskrifter enligt 7 kap. 30 § miljöbalken, om rätten att färdas och vistas och om\n                ordningen i övrigt i reservatet.","inledning":"Utöver vad som annars gäller är det förbjudet att","inledning_offset":2302,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":825,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["färdas","vistas"],"handlingar":["marken"],"dokument_id":"nvdok-1027578","dokument_namn":"färskesjön 2002 beslut o skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027578","dokument_sha256":"1dd4658f484b3bf881edd0e9166916422558401d56d2c5268f8624f3878e8dc6","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Ovanstående föreskrifter enligt 7 kap. miljöbalken skall inte utgöra hinder för natur-\n                vårdsförvaltare att sköta området enligt den till beslutet hörande skötselplanen, ej heller\n                för rättighetsinnehavare att använda och underhålla anläggningar på fastigheten Stora\n                Rom 3:9 eller att bedriva övningar i anslutning till dessa anläggningar. Västra delen av\n                Stora Rom 3:9 har begränsat tillträde för allmänheten för att tillgodose säkerhetskrav\n                vid anläggningarna.","inledning":"Utan länsstyrelsens tillstånd är det förbjudet att","inledning_offset":2062,"inledning_sidnummer":4,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":2260,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["tillträde"],"handlingar":["marken"],"dokument_id":"nvdok-1027578","dokument_namn":"färskesjön 2002 beslut o skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027578","dokument_sha256":"1dd4658f484b3bf881edd0e9166916422558401d56d2c5268f8624f3878e8dc6","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"1.27.2             Restriktioner\n                För att skydda störningskänsliga naturvärden kan det bli aktuellt att under viss period av\n                året belägga delar av naturskogarna med beträdnadsförbud. Markerade leder bör dock\n                hållas öppna. Västra delen av Stora Rom 3:9 har begränsat tillträde för allmänheten för\n                att tillgodose säkerhetskrav vid anläggningarna.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":15,"teckenoffset_pa_sidan":2948,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträde","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1027578","dokument_namn":"färskesjön 2002 beslut o skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1027578","dokument_sha256":"1dd4658f484b3bf881edd0e9166916422558401d56d2c5268f8624f3878e8dc6","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[15.82834629,56.15013528],[15.82823805,56.14976324],[15.82823741,56.14976262],[15.82823618,56.14976241],[15.82812381,56.14976663],[15.828