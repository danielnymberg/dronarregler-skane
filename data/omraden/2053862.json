{"nvrid":"2053862","slug":"kroktjarnet","namn":"Kroktjärnet","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Bengtsfors","lan":"Västra Götalands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Västkuststiftelsen","tillsynsmyndighet":null,"urspr_beslutsdatum":"2022-11-14","senaste_gallandedatum":"2022-12-07","area_ha":3.42,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2053862","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"kroktjärnets naturreservat beslut och skötselplan.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1009477","dokument_id":"nvdok-1009477","sha256":"df53de9862a08c98a5f5752caa2cbf59cf40363edd19297d8843d696f38dc046","sidor":30,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"C. Ordningsföreskrifter om rätten att färdas och vistas inom\n            naturreservatet samt om ordningen i övrigt inom naturreservatet (7 kap.\n            30 § miljöbalken och 22 § förordningen [1998:1252] om områdesskydd\n            enligt miljöbalken m.m.)\n            Inom naturreservatet är det förbjudet att göra följande:\n\n                      1. Framföra motordrivet fordon. Förbudet gäller inte i samband med\n                         uttransport av fällt vilt med så kallad älgdragare, fyrhjuling eller\n                         motsvarande.\n\n                      2.","inledning":"Det är också förbjudet att utan Länsstyrelsens tillstånd göra följande:","inledning_offset":364,"inledning_sidnummer":5,"punkt":"C.","sidnummer":6,"teckenoffset_pa_sidan":234,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbjudet"],"dokument_id":"nvdok-1009477","dokument_namn":"kroktjärnets naturreservat beslut och skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1009477","dokument_sha256":"df53de9862a08c98a5f5752caa2cbf59cf40363edd19297d8843d696f38dc046","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Beskrivning av naturreservatet\n            I Kroktjärnets naturreservat finns naturvärden i form av agkärr, sumpskog och\n            skogbevuxen myr. Agkärren finns fläckvis längs strandkanten vid Kroktjärnets\n            avsnörning. Förekomsten är tydligt kopplad till kalkhaltig berggrund som finns i\n            områdets västra del. Arten ag, Cladium mariscus, förekommer sällsynt i södra och\n            mellersta Sverige och bedöms generellt vara skyddsvärd. Arten är troligtvis en\n            kvarleva från en varmare tidsperiod. Vid Kroktjärnet finns sannolikt ett av de\n            största agbestånden i Västra Götalands län.","inledning":"Inom naturreservatet är det förbjudet att göra följande:","inledning_offset":507,"inledning_sidnummer":6,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":284,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sällsynt","största"],"dokument_id":"nvdok-1009477","dokument_namn":"kroktjärnets naturreservat beslut och skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1009477","dokument_sha256":"df53de9862a08c98a5f5752caa2cbf59cf40363edd19297d8843d696f38dc046","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[12.40668486,58.87580095],[12.40684645,58.87560454],[12.40705494,58.87551