{"nvrid":"2001456","slug":"svartamynningen","namn":"Svartåmynningen","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Linköping","lan":"Östergötlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Östergötlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"1975-04-25","senaste_gallandedatum":"2026-06-15","area_ha":350.82,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2001456","svarslage":"reglerat-las-beslutet","luftfartslage":"luftfart","ocr":false,"foreskriftsomraden":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Fågel","foreskriftstypKod":"2","foreskriftssubtypKod":"2","franDatum":"1/4","tillDatum":"30/6"}],"sasongsdata":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Fågel","foreskriftstypKod":"2","foreskriftssubtypKod":"2","franDatum":"1/4","tillDatum":"30/6"}],"dokument":[{"namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_id":"nvdok-1034384","sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","sidor":85,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"Svartåmynningen 19750425.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1005761","orsak":"namnet matchar inget föreskriftsmönster"},{"namn":"Svartåmynningen 19960319.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1005762","orsak":"namnet matchar inget föreskriftsmönster"},{"namn":"kartasvartamynningen.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1017961","orsak":"ej föreskriftsbärande dokumenttyp"},{"namn":"svartamynningenskpl.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023114","orsak":"namnet matchar inget föreskriftsmönster"}],"citat":[{"citat":"C. Länsstyrelsen beslutar att utöver vad som annars gäller ska\n               följande föreskrifter om rätten att färdas och vistas inom reservatet\n               gälla. Inom reservatet är det inte tillåtet att:","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":1175,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","inte tillåtet"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4. starta och landa med luftfartyg;","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":2150,"klassificering":"start-landningsförbud","konfidens":"låg","traffade_ord":["luftfartyg","starta","landa"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskrifterna ska inte heller utgöra hinder för uttransport av fällt\n               vilt med stöd av terrängkörningsförordningen. Fordon och färdväg\n               ska väljas med omsorg för att minimera mark- och\n               vegetationsskador. Föreskrifterna ska heller inte hindra att hund kan\n               nyttjas vid jakt i enlighet med bestämmelser i jaktförordningen.","inledning":"Dessutom är det förbjudet att utan Länsstyrelsens tillstånd:","inledning_offset":304,"inledning_sidnummer":7,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":1284,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["Fordon"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskriften C4 ska inte heller gälla för förvaltaren,\n               ambulanstransporter och luftfartyg när de används i\n               räddningsinsatser enligt bestämmelserna i lagen (2003:778) om\n               skydd mot olyckor","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":286,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","traffade_ord":["luftfartyg"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Ändringar i C-föreskrifter\n               Sedan tidigare har det varit förbjudet för allmänheten att under\n               tiden 1 april – 30 juni vistas inom reservatets land- och vassområden\n               med undantag av vissa särskilt markerade områden som\n               besöksområde, fågeltorn, vandringsled och väg. Det har även varit\n               förbjudet att kitesurfa eller vindsurfa inom vattenområden i\n               reservatet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":13,"teckenoffset_pa_sidan":1271,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["vistas","förbjudet"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I övrigt bedömer Länsstyrelsen att det blir tydligare och rättssäkrare\n               att märka ut de områden som omfattas av tillträdesförbud på\n               särskild karta snarare än att ange förutsättningarna för dessa\n               föreskrifter enbart i text.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":13,"teckenoffset_pa_sidan":2572,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Bilagor\n                   1.   Beslutskarta\n                   2.   Karta över tillträdesförbud\n                   3.   Karta över område med undantag från föreskrift C1\n                   4.   Sändlista\n                   5.   Bemötande av inkomna remissvar\n                   6.   Hur man överklagar\n                   7.   Skötselplan","inledning":"Om verksamheten eller åtgärden kräver en tillståndsprövning ska en\n               specifik miljöbedömning göras. Detta innebär att","inledning_offset":430,"inledning_sidnummer":17,"punkt":null,"sidnummer":18,"teckenoffset_pa_sidan":166,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Linköpings kommun framför att reservatsbeslutet är välformulerat\n               och ger goda förutsättningar för att kunna genomföra viktiga\n               restaureringar och årliga skötselinsatser för att gynna områdets\n               flora och fauna. Särskilt de nya möjligheterna att återställa\n               strandängarnas hydrologi bör lyftas fram. Kommunen ser också\n               positivt på att tillträdesförbudet utökas till 1 november exklusive det\n               gamla tornområdet på Röudden och vägen dit från Nybrobaden, för\n               att bättre skydda rastande fåglar på strandängarna.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":27,"teckenoffset_pa_sidan":1533,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","förbudet"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Fågelklubben ser inte att ett tillträdesförbud utanför\n               besöksområdena är motiverat ur naturvårdssynpunkt utanför\n               häckningstid då störningarna från besökare får anses som små.\n               Dessutom har liknande strandängsområden i Sverige sällan\n               tillträdesförbud som sträcker sig över så stor del av året. Ett tredje\n               argument är att det leder till en inskränkning i stadsnära\n               friluftsaktiviteter. Fågelklubben förordar perioden 1 mars - 15 juli\n               vilket också är den dominerande uppfattningen bland fågelskådare\n               som besöker området.","inledning":"aktuella åtgärden kan kräva tillstånd för vattenverksamhet samt att","inledning_offset":2875,"inledning_sidnummer":29,"punkt":null,"sidnummer":30,"teckenoffset_pa_sidan":699,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["störningarna","Fågelklubben","häckningstid","förbud"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Fågelklubben noterar att det så kallade Stora tornet planeras att tas\n               bort och vill i det sammanhanget påtala behovet av utveckling av ett\n               lämpligt besöksområde vid Röudden. Alternativt om\n               tillträdesförbudet sätts till 1 november behöver plattformen vid\n               Nybro höjas för att erbjuda bättre överblick.","inledning":"aktuella åtgärden kan kräva tillstånd för vattenverksamhet samt att","inledning_offset":2875,"inledning_sidnummer":29,"punkt":null,"sidnummer":30,"teckenoffset_pa_sidan":2404,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","förbudet"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreningen anser att den förlängda perioden med tillträdesförbud\n               ger ett bra, utökat skydd för tidiga och sena häckare samt för\n               rastande fåglar långt in på hösten. Det innebär samtidigt en rejält","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":31,"teckenoffset_pa_sidan":2840,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"utökad begränsning för fågelstudier, framför allt av rastande fåglar\n               under eftersommar-höst. Den utpekade zonen mellan Nybrobaden\n               och Röudden som ett undantag från tillträdesförbudet och möjlig att\n               besöka under tiden 15/7–1/11 blir därför extra betydelsefull för\n               framför allt fågelskådare men också för botaniskt intresserade och\n               andra. Viktigt att tydligt informera om och skylta den.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":32,"teckenoffset_pa_sidan":182,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","undantag från"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Nybro samfällighetsförening framför i sitt yttrande ett\n               ifrågasättande av förbudet mot motorfordon i reservatet vilket de\n               uppfattar omfattar även båtar. Ett förbud innebär att boende längs\n               Svartån och inom Alguvi 1:7 inte kan ta sig med motorbåt till Roxen\n               eftersom enda vägen är genom reservatet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":38,"teckenoffset_pa_sidan":854,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motorfordon","förbudet"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Intressen för friluftslivet\nReservatet är beläget i ett natur- och kulturhistoriskt rikt område i ett spännande landskap som\ninbjuder till och har ett värde för rekreation. Svartåmynningens öppna strandängar och rika\nfågelliv lockar ett stort antal besökare, under alla tider på året. Reservatet är även relativt\nstadsnära, dit besökare kan ta sig med bil, buss, cykel eller till fots. Längs reservatets sydvästra\nkant går Bergsvägen (väg 1136 mellan Linköpings stadskärna och Berg) utmed vilken det löper\nen upplyst cykelväg som gör reservatet mycket tillgängligt. För att förhindra störningar råder\ntillträdesförbud för större delen av området under perioden 1 mars - 1 november.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":63,"teckenoffset_pa_sidan":391,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["störningar","storiskt","fågelliv","förbud"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Strandängarna lockar både besökare som är mer allmänt natur- eller friluftsintresserade och\npersoner som är botaniskt intresserade. Fågellivet på öppna strandängar är känsliga för\nstörningar, speciellt under häckningsperioden. Av denna anledning råder det idag\ntillträdesförbud inom större delen av reservatet under perioden 1 mars-1 november.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":78,"teckenoffset_pa_sidan":256,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["häckningsperioden","störningar","Fågellivet","förbud"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Mål\nInformationen om naturreservatet, dess föreskrifter och olika värden är lättillgänglig, bidrar till\noch förhöjer upplevelsen av besöket. Områdets friluftslivsanläggningar och leder är i gott skick\noch underlättar för besökare att uppleva tillgängliga delar av reservatet. Friluftsanordningar,\ndass, stigar och leder är så långt det är möjligt tillgänglighetsanpassade. Inom reservatet finns\nparkeringsplatser för rörelsehindrade med närhet till besöksplatser. Reservatets gränser och\nleder samt områden med tillträdesförbud är tydligt markerade.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":78,"teckenoffset_pa_sidan":601,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Åtgärder\n •    Underhåll (och byt ut vid behov) reservatsområdets gräns, leder, anläggningar som\n      exempelvis fågeltorn, dass, bänkbord, informationsskyltar samt markeringar för\n      tillträdesförbud. Anläggningar bör även vara tillgänglighetsanpassade.\n •    Vid behov, se över och uppdatera information om reservatet.\n •    Vid behov, underhåll och grusa parkeringar. Eventuell utökning av parkeringsyta får\n      genomföras i den mån det anses lämpligt.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":78,"teckenoffset_pa_sidan":1152,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"dokument_id":"nvdok-1034384","dokument_namn":"Svartåmynningen beslut och skötselplan_utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1034384","dokument_sha256":"2d7050dfb742245b172cc49061418ec250ee7fcd83fb4a1d7c97bc5f3b676798","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Tillsyn\nLänsstyrelsen är ansvarig för tillsyn av reservatet. Tillsyn av tillträdesförbudet är prioriterat.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":80,"teckenoffset_pa_sidan":521,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","förbudet