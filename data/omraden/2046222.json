{"nvrid":"2046222","slug":"kolasen-vattenskyddsomrade","namn":"Kolåsen Vattenskyddsområde","skyddstyp":"Vattenskyddsområde","lager":"vattenskyddsomrade","karnlager":false,"kommun":"Åre","lan":"Jämtlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":null,"tillsynsmyndighet":"Länsstyrelse","urspr_beslutsdatum":"2016-10-31","senaste_gallandedatum":"2016-10-31","area_ha":2315.49,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2046222","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Kolåsen Föreskrifter.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042701","dokument_id":"nvdok-1042701","sha256":"2c6abdf26108026c5afd99172b29562cc1acba1d7312ad7256c1857323f9fce9","sidor":11,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"§1 Vattentäktszon\nI vattentäktszonen är varje annan verksamhet än vattentäkts-verksamhet förbjuden.\nVattentäktszonen ska vara inhägnad eller brunnen vara så utformad att obehöriga inte har\ntillträde.\nVattentäktszonen får endast disponeras av huvudmannen för dricksvattenförsörjningen.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§1","sidnummer":1,"teckenoffset_pa_sidan":1338,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1042701","dokument_namn":"Kolåsen Föreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042701","dokument_sha256":"2c6abdf26108026c5afd99172b29562cc1acba1d7312ad7256c1857323f9fce9","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Jämtlands läns\nförfattningssamling\n\nPetroleumprodukter för uppvärmning av befintliga bostads- och jordbruksfastigheter får inte\nförvaras, transporteras eller användas utan tillstånd av den kommunala nämnden för\nmiljöfrågor.\nAll övrig hantering av petroleumprodukter och andra brandfarliga vätskor i större mängd än\nsammanlagt 50 liter är förbjuden, med undantag för transport av petroleumprodukter och\nandra brandfarliga vätskor, drift av den kommunala vattenförsörjningen samt drivmedel i\nfordon, transportmedel och arbetsmaskiner.\nFordonstvätt med avfettningsmedel eller liknande produkt på andra platser än som speciellt\nanordnats för detta ändamål är förbjuden.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":0,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1042701","dokument_namn":"Kolåsen Föreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042701","dokument_sha256":"2c6abdf26108026c5afd99172b29562cc1acba1d7312ad7256c1857323f9fce9","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[12.91031308,63.76405804],[12.91017458,63.76410555],[12.91001061,63.76415225],[12.90987812,63.76420153],[12.90982002,63.76424665],[12.90975352,63.76431759],[12.90970249,63.76461016],[12.90942713,63.76531139],[12.90937296,63.76548051],[12.90931613,63.76566674],[12.90923729,63.76585177],[12.90909713,63.76607829],[12.90889501,63.76637721],[12.90876407,63.76659904],[12.90871089,63.76670842],[12.90868795,63.76681837],[12.90865466,63.76709704],[12.90861109,63.76722252],[12.90854199,63.7673322],[12.90843213,63.76746919],[12.90827916,63.76758861],[12.90808561,63.76771177],[12.90773801,63.76785729],[12.90709986,