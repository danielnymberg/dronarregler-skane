{"nvrid":"2041530","slug":"kobbungen","namn":"Kobbungen","skyddstyp":"Naturreservat","lager":"naturreservat-kommunalt","karnlager":true,"kommun":"Strömstad","lan":"Västra Götalands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Kommun","forvaltare":"Strömstads kommun","tillsynsmyndighet":null,"urspr_beslutsdatum":"2014-06-12","senaste_gallandedatum":"2014-07-20","area_ha":28.3,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2041530","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Beslut Kobbungen med skötselplan.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026199","dokument_id":"nvdok-1026199","sha256":"0886f0cfe029c9a6785b2c4d83becd60160b6784782c0d298b06654a6898a264","sidor":59,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Syftet ska tryggas genom att:\n• verksamheter som tar mark eller vatten i anspråk och som\n    innebär skador på mark, vegetation eller den marina miljön\n    och som förändrar landskapets orörda karaktär inte tillåts\n• friluftsliv kanaliseras för att undvika störningar på känsligt\n    djurliv och slitage på känslig vegetation samtidigt som be-\n    hovet av goda naturupplevelser som stillhet, avskildhet och\n    tystnad erbjuds\n• naturinformation och naturvägledning byggs ut","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1304,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["störningar","djurliv","är inte tillåts"],"dokument_id":"nvdok-1026199","dokument_namn":"Beslut Kobbungen med skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026199","dokument_sha256":"0886f0cfe029c9a6785b2c4d83becd60160b6784782c0d298b06654a6898a264","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"3. störa djurlivet eller skada vegetationen t ex genom att gräva upp\n    växter. Det är dock tillåtet att plocka blommor, svamp och bär för\n    husbehov.","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":4083,"inledning_sidnummer":7,"punkt":"3.","sidnummer":7,"teckenoffset_pa_sidan":4236,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurlivet","störa"],"dokument_id":"nvdok-1026199","dokument_namn":"Beslut Kobbungen med skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026199","dokument_sha256":"0886f0cfe029c9a6785b2c4d83becd60160b6784782c0d298b06654a6898a264","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"De trädlösa hällmarksområdena bildar en mosaik tillsammans med\n    insprängda hällmarkstallskog med vindpinade äldre tallar och stående\n    och liggande döda träd. Denna naturtyp täcker all bergbunden mark av\n    naturreservatet, och endast i de mer låglänta delarna växer mer högväxt\n    skog, mestadels lövdominerad blandskog. Stora delar av reservatet har\n    troligen utgjort gamla utmarker där de lokala gårdarna betat sina djur\n    medan de låglänta delarna har utnyttjats som åker- och ängsmarker.","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":4083,"inledning_sidnummer":7,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":608,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["Stora","djur"],"dokument_id":"nvdok-1026199","dokument_namn":"Beslut Kobbungen med skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026199","dokument_sha256":"0886f0cfe029c9a6785b2c4d83becd60160b6784782c0d298b06654a6898a264","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Inom reservatsområdet omges Kobbungsbäcken av en brant bäckra-\n    vin, som är bevuxen med en relativt orörd blandskog med främst gran\n    och klibbal, men även björk, tall, asp, sälg och hägg. De södra delarna\n    av blandskogen domineras av gran, medan de norra delarna av bäckra-\n    vinen består av en lövdominerad blandskog. Hela bäckravinen har ett\n    stort inslag av torrträd, lågor och högstubbar. Bäcken och den omgi-\n    vande vegetationen bildar en fuktig och relativt skyddad miljö där det\n    växer en intressant kärlväxtflora.","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":4083,"inledning_sidnummer":7,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":1494,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["stort","sälg"],"dokument_id":"nvdok-1026199","dokument_namn":"Beslut Kobbungen med skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026199","dokument_sha256":"0886f0cfe029c9a6785b2c4d83becd60160b6784782c0d298b06654a6898a264","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Bäckravinen är även intressant från kryptogamsynpunkt på grund av\n    sitt fuktiga mikroklimat, delvis lite kalkrikare marklager och fuktiga\n    klippor. Här växer bl a mossor som rävsvansmossa Thamnobryum ale-\n    opecurum, skogssidenmossa Plagiothecium denticulatum och kranshakmossa\n    Rhytidiadelphus triquetrus. Vidare noterades en del sällsynta lavar i ravi-\n    nen, t ex kvistskivlav Fellhanera bouteillei, stor rostfläck Arthonia spadicea\n    och kattfotslav A. leucopellaea. I ravinmiljön finns även gott om död ved","inledning":"Det är förbjudet att inom naturreservatet:","inledning_offset":4083,"inledning_sidnummer":7,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":2388,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sällsynta","stor"],"dokument_id":"nvdok-1026199","dokument_namn":"Beslut Kobbungen med skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026199","dokument_sha256":"0886f0cfe029c9a6785b2c4d83becd60160b6784782c0d298b06654a6898a264","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Delar av området är relativt svårforcerat t ex på de brantare delarna\n    ute på Nordbytången. Fiske får inte förekomma i Kobbungen eller i\n    Kobbungsbäcken, men en del havsfiske förekommer på västsidan av\n    Nordbytången. Området ger dock stora möjligheter till naturupplevel-\n    ser av skärgårdslandskapet. Vidare finns i området ett intressant fågel-\n    liv att studera för den fågelintresserade.\n    ã               ä           ó           ä                   ô                       î               ç           è   õ               ö                   ñ           ö       ÷       õ       õ       ñ       é       í       ñ   ø   ù   ú   û   ò   é   ï   õ   õ   ò   è   ò   õ   û   ç","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":37,"teckenoffset_pa_sidan":1014,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelintresserade","stora","fågel","får inte"],"dokument_id":"nvdok-1026199","dokument_namn":"Beslut Kobbungen med skötselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026199","dokument_sha256":"0886f0cfe029c9a6785b2c4d83becd60160b6784782c0d298b06654a6898a264","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"typ