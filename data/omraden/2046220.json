{"nvrid":"2046220","slug":"trangsviken-vattenskyddsomrade","namn":"Trångsviken Vattenskyddsområde","skyddstyp":"Vattenskyddsområde","lager":"vattenskyddsomrade","karnlager":false,"kommun":"Krokom","lan":"Jämtlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":null,"tillsynsmyndighet":"Länsstyrelse","urspr_beslutsdatum":"2013-06-03","senaste_gallandedatum":"2013-07-08","area_ha":41.66,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2046220","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Trångsviken Föreskrifter.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042721","dokument_id":"nvdok-1042721","sha256":"3e0fe8c1e22ff4616b7a894cb3a1195c750bdfac052700cf009f1597f13e5c43","sidor":16,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"§ 3 Övriga skyddszoner\n\nHANTERING AV PETROLEUMPRODUKTER M.M.\n\nPrimär skyddszon\n\nAnnan hantering än transport av mer än 250 liter petroleumprodukter får ej ske utan\ntillstånd från kommunens nämnd för miljö och hälsoskydd.\n\nFöreskrifterna gäller ej drivmedel som finns i fordon, lok, arbetsmaskiner och liknande.\nVid användning av arbetsmaskiner, tunga fordon, arbetsfordon inklusive lätta fordon för\nyrkesmässig användning skall dock detta ske med beaktande av att risk för förorening av\ngrundvatten inte uppkommer.\n\nFordonstvätt etc. med avfettningsmedel eller därmed liknande produkter är förbjuden.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§ 3","sidnummer":2,"teckenoffset_pa_sidan":0,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","får ej"],"dokument_id":"nvdok-1042721","dokument_namn":"Trångsviken Föreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042721","dokument_sha256":"3e0fe8c1e22ff4616b7a894cb3a1195c750bdfac052700cf009f1597f13e5c43","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Körning i terräng med motordrivet fordon regleras av terrängkörningslagen med\ntillhörande förordningar, SFS 1975:1313. Här anges bland annat att körning i terräng\nmed motordrivet fordon för annat ändamål än jordbruk eller skogsbruk alltid är\nförbjuden på barmark och att den är förbjuden på snötäckt skogsmark med plant- eller\nungskog samt på snötäckt jordbruks-mark, om det inte är uppenbart att körningen kan\nske utan risk för skada på marken.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":14,"teckenoffset_pa_sidan":26,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbjuden"],"dokument_id":"nvdok-1042721","dokument_namn":"Trångsviken Föreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042721","dokument_sha256":"3e0fe8c1e22ff4616b7a894cb3a1195c750bdfac052700cf009f1597f13e5c43","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.02408021,63.32929799],[14.02418961,63.32948016],[14.02419007,63.32948055],[14.0254003,63.33011144],[14.03061953,63.33171571],[14.03062067,63.33171588],[14.03062217,63.33171566],[14.0378378,63.3290347],[14.03783828,63.32903418],[14.0378382,63.3290338],[14.03684344,63.32751851],[14.03313742,63.32488242],[14.03268246,63.32442449],[14.03268123,63.32442424],[14.03267991,63.32442436],[14.03