{"nvrid":"2048778","slug":"storhogna","namn":"Storhogna","skyddstyp":"Vattenskyddsområde","lager":"vattenskyddsomrade","karnlager":false,"kommun":"Berg","lan":"Jämtlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":null,"tillsynsmyndighet":"Länsstyrelse","urspr_beslutsdatum":"2016-05-23","senaste_gallandedatum":"2016-05-23","area_ha":299.68,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2048778","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Storhogna Föreskrifter.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044509","dokument_id":"nvdok-1044509","sha256":"b767171118b6f425b36804e39b7842153cd1aaf918a8d3aecb0387299f1edc65","sidor":8,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Jämtlands läns\nförfattningssamling\n\nSpridning av vägsalt kräver tillstånd. Saltinblandad sand (max 2 % salt) undantas från kravet på tillstånd.\n\nTäktverksamhet, borrnings-, schakt- och markarbeten\n\nPrimär och sekundär skyddszon\nNyetablering av täktverksamhet samt uttag av jordmaterial för husbehov är förbjudet.\nStörre schaktnings- eller grävningsarbeten, sprängning, pålning och borrningar eller undersökningsarbeten\nkräver tillstånd.\nÅterfyllning med massor som medför risk för förorening av grund- eller ytvatten får ej utföras.\n\nSkogsbruk\n\nPrimär och sekundär skyddszon\nUpplag överstigande en avverkningssäsong av bark, flis, spån, timmer och liknande kräver tillstånd.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":0,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["Saltinblandad","Större","salt","förbjudet"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1044509","dokument_namn":"Storhogna Föreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044509","dokument_sha256":"b767171118b6f425b36804e39b7842153cd1aaf918a8d3aecb0387299f1edc65","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Trafik med terrängfordon\nKörning i terräng med motordrivet fordon regleras av terrängkörningslagen med tillhörande förordningar, SFS\n1975:1313. Här anges bland annat att körning i terräng med motordrivet fordon för annat ändamål än jordbruk\neller skogsbruk alltid är förbjuden på barmark och att den är förbjuden på snötäckt skogsmark med plant- eller\nungskog samt på snötäckt jordbruks-mark, om det inte är uppenbart att körningen kan ske utan risk för skada på\nmarken.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":2777,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["terrängfordon","motordrivet","fordon","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1044509","dokument_namn":"Storhogna Föreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044509","dokument_sha256":"b767171118b6f425b36804e39b7842153cd1aaf918a8d3aecb0387299f1edc65","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.10313429,62.49890757],[14.10166851,62.49857165],[14.10166739,62.49857155],[14.10166631,62.49857173],[14.07584972,62.50721984],[14.07584896,62.50722031],[14.07584884,62.5072207],[14.07584928,62.50722125],[14.08764231,62.51424507],[14.104647