se,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Thomas Landgren har på uppdrag av Länsstyrelsen i Västra Götalands län,\ngjort en översyn av fågelskyddet i Brommö-Kalvö skärgårdar, se\nLänsstyrelsens rapport 2007:17 1 . I rapporten föreslås:\n    - att skyddet i 4 befintliga fågelskyddsområden förblir oförändrat,\n    - att gränser och tillträdesförbud revideras för 5 befintliga\n        fågelskyddsområden,\n    - att 7 nya fågelskyddsområden inrättas och\n    - att fågelskyddsområdena Trollö och Laxhallarna upphävs.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":610,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1041855","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1041855","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Sedan början av 1970-talet har Länsstyrelsen beslutat om ett flertal\nfågelskyddsområden i Brommö-Kalvö skärgårdar. Flera av dessa beslut har\ndärefter delvis upphävts. I beslutet för naturvårdsområdet Kalvö skärgård, i\nbeslutet för naturvårdsområde Västra Brommö, och i beslutet för\nnaturreservatet Brommö skärgård har också områden med tillträdesförbud\nangetts.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1079,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1041855","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1041855","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"För att tydliggöra vilka områden som omfattas av tillträdesförbud i\nBrommö-Kalvö skärgårdar upphävs genom detta beslut samtliga tidigare\nbeslut om tillträdesförbud i Brommö-Kalvö skärgårdar.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1442,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1041855","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1041855","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"De områden som fortfarande hyser ett värdefullt och störningskänsligt\nfågelliv ingår i detta beslut. Detta nya beslut omfattar då samtliga områden\nmed tillträdesförbud inom Brommö-Kalvö skärgårdar i Mariestads\nkommun.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1634,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1041855","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1041855","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Thomas Landgren: för lokal 3 och 5 bör tillträdesförbudet vara 1 februari\ntill 15 augusti.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":180,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1041855","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1041855","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsen har justerat tiden för tillträdesförbudet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":272,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1041855","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1041855","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsens beslut är ett tidsbegränsat tillträdesförbud. Sjöfartsverkets\nmarkerade farleder omfattas inte av förbudet. Länsstyrelsen har vidare i sitt\nbeslut meddelat att tillträdesförbud inte gäller Sjöfartsverket.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":627,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1041855","dokument_namn":"brommo_bil_2_1.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1041855","dokument_sha256":"cd4272afc114a47045fd783d3bfbf03f7341f8ffbfc56bed42f3f35cf9209afb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.65471259,58.85601665],[13.65474136,58.85603878],[13.65477342,58.85607979],[13.6549859