akarsjön och Södra Skomakarsjön är förbjudet.\n\n13 § ALLMÄNNA BESTÄMMELSER","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":87,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivna","FORDON","fordon","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1046603","dokument_namn":"18fs 2025 2.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046603","dokument_sha256":"24cbbde0a0af7eb775bde3e5d33d422c4a849756a0850391267a8dd379fd5721","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.46396432,59.66185111],[14.46305995,59.66239158],[14.4630595,59.66239212],[14.4619657,59.66803103],[14.46196592,59.66803158],[14.4619667,59.66803199],[14.46810309,59.66904241],[14.46810413,59.66904244],[14.47505323,59.66824613],[14.47505424,59.6682456],[14.47540841,59.66780971],[14.47562872,59.66762346],[14.47626726,59.66718114],[14.47664404,59.66707719],[14.47686258,59.66693579],[14.47691552,59.66693632],[14.47691238,59.66701692],[14.47696364,59.66705313],[14.47696448,59.66705347],[14.47696519,59.66705354],[14.47703459,59.66705425],[14.4770356,59.66705412],[14.47717967,59.66699279],[14.47720253,59.6668674],[14.4777377,59.66679206],[14.47784339,59.66681108],[14.47794751,59.66683847],[14.47794858,59.66683858],[14.47794961,59.66683837],[14.47814717,59.66676028],[14.47896515,59.6667147],[14.4809707,59.66670805],[14.48135973,59.66673891],[14.48141087,59.66677488],[14.48141225,59.66677528],[14.4815