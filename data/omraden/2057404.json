{"nvrid":"2057404","slug":"vuollerim-vattenskyddsomrade","namn":"Vuollerim vattenskyddsområde","skyddstyp":"Vattenskyddsområde","lager":"vattenskyddsomrade","karnlager":false,"kommun":"Jokkmokk","lan":"Norrbottens Län","beslutsstatus":"Gällande","beslutsmyndighet":"Kommun","forvaltare":null,"tillsynsmyndighet":"Kommun","urspr_beslutsdatum":"2020-02-24","senaste_gallandedatum":"2020-02-24","area_ha":265.3,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2057404","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Skyddsföreskrifter Vuollerim.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046305","dokument_id":"nvdok-1046305","sha256":"bff730e90cbf95a5996d13fd25fa1262a8afa44b7ba6bb0ff66d60998248aeab","sidor":13,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"§5 HANTERING AV PETROLEUMPRODUKTER OCH ANDRA BRANDFARLIGA VÄTSKOR\n\nHantering av petroleumprodukter och andra brandfarliga vätskor i större volym än 40\nliter (samtidig hantering) är förbjuden. Förbudet gäller dock inte för transporter av\npetroleumprodukter och andra brandfarliga vätskor eller för drivmedel i fordon,\narbetsmaskiner och liknande och liknande som är i bruk (dvs. ej skrotfordon).\nBrandfarliga vätskor som hanteras på täta ytor inom verksamhet som är befintlig när\nskyddsområdet fastställs undantas från förbudet, under förutsättning att särskilt\nvidtagna brandskyddsåtgärder finns.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§5","sidnummer":7,"teckenoffset_pa_sidan":28,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1046305","dokument_namn":"Skyddsföreskrifter Vuollerim.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046305","dokument_sha256":"bff730e90cbf95a5996d13fd25fa1262a8afa44b7ba6bb0ff66d60998248aeab","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§13 UPPSTÄLLNING OCH SKÖTSEL AV FORDON OCH MASKINER\n\nFör motordrivna arbetsfordon och arbetsmaskiner gäller att tankning eller uppställning\nmed varaktighet längre än 8 timmar är förbjuden, om åtgärder inte vidtas för att\nhindra eventuellt läckage av olja eller andra kemikalier att tränga ner i underliggande\nmark eller vatten. Sådana åtgärder är till exempel att placera täta dukar med\ninvallningar under uppställda maskiner.\n\nTvätt av motordrivna fordon är förbjuden.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§13","sidnummer":8,"teckenoffset_pa_sidan":900,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivna","FORDON","fordon","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1046305","dokument_namn":"Skyddsföreskrifter Vuollerim.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046305","dokument_sha256":"bff730e90cbf95a5996d13fd25fa1262a8afa44b7ba6bb0ff66d60998248aeab","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§20 ANVÄNDNING AV SLÄCKVATTEN\n\nVid brand av bebyggelse och fordon är användning av släckvatten förbjuden om det\nföreligger risk för förorening av grundvattnet.\n\n2.6        Sekundär skyddszon","inledning":"med varaktighet längre än 8 timmar är förbjuden, om åtgärder inte vidtas för att","inledning_offset":1040,"inledning_sidnummer":8,"punkt":"§20","sidnummer":9,"teckenoffset_pa_sidan":100,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1046305","dokument_namn":"Skyddsföreskrifter Vuollerim.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046305","dok