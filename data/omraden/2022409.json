{"nvrid":"2022409","slug":"rosjoskogen","namn":"Rösjöskogen","skyddstyp":"Naturreservat","lager":"naturreservat-kommunalt","karnlager":true,"kommun":"Sollentuna","lan":"Stockholms Län","beslutsstatus":"Gällande","beslutsmyndighet":"Kommun","forvaltare":"Sollentuna kommun","tillsynsmyndighet":null,"urspr_beslutsdatum":"2010-06-09","senaste_gallandedatum":"2010-07-27","area_ha":206.31,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2022409","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Rosjoskogen_2010-06-09_beslut_skotselplan.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019107","dokument_id":"nvdok-1019107","sha256":"483aa9b0d34da4cec43ddcdc5b4485489da75146fff4eb787d6fe34b5d50a810","sidor":41,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"8. uppföra stängsel annat än runt tomtmark, betesdjur, kolonilotter eller lövplanteringar.\n          Gärdesgård får sättas upp för att återskapa kulturmiljöer. Stängsling får inte hindra\n          allmänhetens tillträde","inledning":"Inom naturreservatet är det förbjudet att:","inledning_offset":2498,"inledning_sidnummer":5,"punkt":"8.","sidnummer":6,"teckenoffset_pa_sidan":109,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträde","får inte"],"dokument_id":"nvdok-1019107","dokument_namn":"Rosjoskogen_2010-06-09_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019107","dokument_sha256":"483aa9b0d34da4cec43ddcdc5b4485489da75146fff4eb787d6fe34b5d50a810","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"3. störa djurlivet, tex genom att klättra i boträd, fånga eller döda däggdjur, fåglar, kräldjur\n       eller groddjur (fiske är tillåtet med giltigt fiskekort)","inledning":"För allmänheten är det förbjudet att:","inledning_offset":1728,"inledning_sidnummer":6,"punkt":"3.","sidnummer":6,"teckenoffset_pa_sidan":2020,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurlivet","fåglar","störa"],"dokument_id":"nvdok-1019107","dokument_namn":"Rosjoskogen_2010-06-09_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019107","dokument_sha256":"483aa9b0d34da4cec43ddcdc5b4485489da75146fff4eb787d6fe34b5d50a810","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"6. framföra motordrivna fordon annat än på anvisade vägar","inledning":"För allmänheten är det förbjudet att:","inledning_offset":1728,"inledning_sidnummer":6,"punkt":"6.","sidnummer":6,"teckenoffset_pa_sidan":2477,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivna","fordon"],"dokument_id":"nvdok-1019107","dokument_namn":"Rosjoskogen_2010-06-09_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019107","dokument_sha256":"483aa9b0d34da4cec43ddcdc5b4485489da75146fff4eb787d6fe34b5d50a810","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Rösjöskogens naturreservat har ett läge som ger området ett högt värde. Området fungerar som\nen grön kil in till tätorten. Då Rösjöskogens naturreservat är en del av ett större grönstråk, den så\nkallade Rösjökilen, möjliggörs långa vandringar i naturen. Grönstråket möjliggör även arters\nspridning. Därmed bidrar Rösjöskogens naturreservat till en ökad biologisk mångfald i staden\nvilket också har ett stort naturpedagogiskt värde. Området används idag regelbundet av förskolor\noch skolor. Människan mår bra av att vistas i naturen och Rösjöskogens naturreservat är\nlättillgänglig för stor del av kommuns och angränsande kommuners invånare.","inledning":"Utan kommunens* tillstånd är det förbjudet att:","inledning_offset":2763,"inledning_sidnummer":6,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":2234,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["vistas"],"dokument_id":"nvdok-1019107","dokument_namn":"Rosjoskogen_2010-06-09_beslut_skotselplan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019107","dokument_sha256":"483aa9b0d34da4cec43ddcdc5b4485489da75146fff4eb787d6fe34b5d50a810","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.97971937,59.44791232],[17.97965872,59.44797702],[17.97958898,59.44801558],[17.97949802,59.4480835],[17.97947073,59.44815124],[17.9794856,59.44829612],[17.97945227,59.44835156],[17.97930071,59.44845783],[17.97890487,59.44872524],[17.97881241,59.44887971],[17.97868778,59.44900662],[17.97869244,59.44907017],[17.97862521,59.44919715],[17.97853414,59.44929228],[17.97837032,59.44939113],[17.97812327,59.44946511],[17.97812236,59.44946575],[17.97812266,59.44946652],[17.9786631,59.44986134],[17.97872068,59.44993951],[17.97872542,59.44999074],[17.97823707,59.45057027],[17.97830293,59.45081852],[17.97844139,59.45108454],[17.97869991,59.45127527],[17.9787626,59.4515187],[17.97876304,59.45151921],[17.97876395,59.45151952],[17.97924719,59.45159511],[17.97951562,59.45165862],[17.97978892,59.45183445],[17.9800382,59.4520152],[17.98019667,59.45214473],[17.98036425,59.45221064],[17.98060969,59.45224929],[17.98078974,59.4522911],[17.98092399,59.45231122],[17.98126323,59.4523153],[17.98159474,59.45237973],[17