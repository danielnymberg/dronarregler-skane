{"nvrid":"2004831","slug":"hagerkoloni-pa-lindo-i-sjon-salen","namn":"Hägerkoloni på Lindö i sjön Salen","skyddstyp":"Djur- och växtskyddsområde","lager":"djur-och-vaxtskydd","karnlager":true,"kommun":"Alvesta","lan":"Kronobergs Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Kronobergs län","tillsynsmyndighet":null,"urspr_beslutsdatum":"1986-04-25","senaste_gallandedatum":"1986-05-08","area_ha":6.04,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2004831","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":true,"foreskriftsomraden":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"15/7"}],"sasongsdata":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"15/7"}],"dokument":[{"namn":"beslut om fågelskyddsområde hägerkoloni lindö i salen.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046586","dokument_id":"nvdok-1046586","sha256":"88a642c3655cd767ff5c41c6351650e8fa980bf70c1514bcbedef16455e5d730","sidor":3,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Statens naturvårdsverk motsätter sig inte att Lindö av-\nsätts som fågelskyddsområde och framför att ett sådant\nskydd bör utformas enligt samma principer som tidigare\nvad gäller förbudstid och befaringsförbud. Skogsvårdssty-\nrelsen skriver i sitt yttrande att tillträdesförbudet bör\ngälla såväl ön Lindö som vattenområdet intill 100 m från\nöns strand. Detta gäller för den hägerkoloni som är skyd-\ndad i sjön Åsnens centrala del. Kommunstyrelsen i Alvesta\nkommun tillstyrker förslaget. Salens Båt & Sjösällskap\nframför i sitt yttrande att ett landstigningsförbud på\nLindö vore både felaktigt, onödigt och verkningslöst.","inledning":null,"inlednin