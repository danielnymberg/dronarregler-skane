smetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"1. framföra motordrivet fordon, t.ex. snöskoter,","inledning":"Utöver vad som för övrigt gäller är det förbjudet att","inledning_offset":1001,"inledning_sidnummer":4,"punkt":"1.","sidnummer":4,"teckenoffset_pa_sidan":1056,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1024558","dokument_namn":"Korpimäki_Beslut_19990525.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024558","dokument_sha256":"ba71bc38bb3ac06f2c17a01e199790830e5630c7c0b55f9b2a71bae8a5a11189","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Korpimäki är ett utpräglat granberg och med sina 732 m det\nhögsta berget i Orsa kommun. Därifrån är utsikten storslagen.\nBerget ligger som en kilometerbred och 4 km lång limpa i nord-\nsydlig riktning. När man färdas längs skogsvägen på östra\nsidan öppnar sig över myrarna en unik vy mot bergets långa,\nbranta och helt ohuggna, svarta gransluttning.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att","inledning_offset":1001,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":24,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["färdas"],"handlingar":["marken"],"dokument_id":"nvdok-1024558","dokument_namn":"Korpimäki_Beslut_19990525.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024558","dokument_sha256":"ba71bc38bb3ac06f2c17a01e199790830e5630c7c0b55f9b2a71bae8a5a11189","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"En hel rad hotade och sällsynta arter har påträffats vid Korpi-\nmäki, främst lavar och vedsvampar t.ex. långskägg, stiftgelé-\nlav, lunglav, skrovellav, ostticka, rynkskinn och rosenticka.\nOmrådet fyller också kraven för \"storskogsfaunan\" med ugglor,\nrovfåglar, hackspettar, lavskrika, tallbit och björn.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att","inledning_offset":1001,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1290,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["storskogsfaunan","sällsynta","fåglar"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1024558","dokument_namn":"Korpimäki_Beslut_19990525.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024558","dokument_sha256":"ba71bc38bb3ac06f2c17a01e199790830e5630c7c0b55f9b2a71bae8a5a11189","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.61898298,61.42725647],[14.61898178,61.42725643],[14.61898104,61.42725659],[14.61898049,61.42725687],[14.61898018,61.42725743],[14.61904161,61.42801323],[14.61936497,61.43090416],[14.61952207,61.43206253],[14.62005861,61.43480965],[14.62102622,61.44390144],[14.62106008,61.44443331],[14.62109818,61.44479822],[14.62112375,61.44514213],[14.62163218,61.44998338],[14.62217457,61.45527683],[14.62266058,61.4597022],[14.62257334,61.46195482],[14.62257433,61.46195548],[14.63535702,61.46552581],[14.63703898,61.46652244],[14.63816937,61.4668931],[14.6388668,61.46723209],[14.63889093,61.46861311],[14.63889128,61.46861365],[14.63889186,61.46861392],[14.6388934,61.46861407],[14.64042569,61.46846408],[14.64089658,61.46846851],[14.64513429,61.46800303],[14.64513501,61.46800288],[14.64513574,61.468