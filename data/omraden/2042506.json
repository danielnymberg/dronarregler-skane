jade.","inledning":"Det förbjudet inom naturreservatet att:","inledning_offset":158,"inledning_sidnummer":6,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":0,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["stort","sälja"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1028381","dokument_namn":"Sanders_beslut_20141106.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028381","dokument_sha256":"7847a92c80a37c89cdf9c08e4d9710060abbe5fdf97bb069b6627f7bf5ff0eef","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[15.57772618,60.56650493],[15.57772628,60.56650569],[15.577943,60.56671984],[15.57817937,60.56687807],[15.57877311,60.56727877],[15.57918091,60.5675522],[15.57939526,60.56769652],[15.58053696,60.56830279],[15.5824508,60.56967565],[15.5829393,60.57005921],[15.58448745,60.57106883],[15.58505834,60.57137192],[15.58517951,60.57147204],[15.5851804,60.57147243],[15.58518119,60.57147252],[15.58518235,60.57147235],[15.5856542,60.57131664],[15.58634225,60.57113441],[15.58666798,60.57103373],[15.5874814,60.57071881],[15.588085,60.57052218],[15.5883585,60.57045148],[15.58861049,60.57040986],[15.58901329,60.57037302],[15.58966313,60.57032684],[15.59036941,60.57037891],[15.59144095,60.57049792],[15.59214928,60.57061789],[15.59282039,60.57072433],[15.59381384,60.57084494],[15.59449486,60.57093773],[15.5948786,60.57096012],[15.59487946,60.57095998],[15.5949595,60.57093509],[15.59496024,60.57093467],[15.59496815,60.57086966],[15.59496785,60.57086908],[15