yga","landa","lyfta"],"dokument_id":"nvdok-1019362","dokument_namn":"Storröjningsmorans NR sammanslagen 20180208 utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019362","dokument_sha256":"b30002c021c306bdf73dcfc05599e11bdacd11a4cfd21c4558c0df8fab03c7a9","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Storröjningsmoran är en sedan länge känd växtplats för flera sällsynta och\nhotade arter. Områdets lövkärr och sumpskogar uppmärksammades redan 1906\ni den botaniska litteraturen. Områdets betydelse som värdefull floralokal\nuppmärksammandes ytterligare 1979 genom fyndet av sötgräs och flera andra\nintressanta växter. Från 1980-talet och framåt har diskussioner förts mellan den\nideella naturvården, länsstyrelsen, skogsvårdsstyrelsen och den dåvarande\nmarkägaren Stora, om restaurerings- och skötselåtgärder i området, samt även\nom behovet av långsiktigt skydd. Under denna tid har även floran inventerats\nnärmare, främst av ideella intressen.","inledning":"Utöver vad som gäller enligt andra författningar är det förbjudet att","inledning_offset":473,"inledning_sidnummer":6,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":573,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["Storröjningsmoran","sällsynta","Stora"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1019362","dokument_namn":"Storröjningsmorans NR sammanslagen 20180208 utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019362","dokument_sha256":"b30002c021c306bdf73dcfc05599e11bdacd11a4cfd21c4558c0df8fab03c7a9","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","sv