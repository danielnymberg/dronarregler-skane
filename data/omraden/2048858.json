erifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Kallkärret utgör ett från naturvårdssynpunkt mycket värdefullt skogsområde\n         med stort inslag av myr och hyser en stor mångfald av växt- och djurarter\n         knutna till dessa miljöer. Skogen i reservatet har till allra största delen fått\n         utvecklas fritt under lång tid. Smärre partier med yngre skogar uppkomna\n         efter avverkning finns i östra och västra delen av området. Området\n         genomkorsas av flera myrar och i östra delen av området ligger myren som\n         gett reservatet dess namn, Kallkärret, med den djupa bäcken Stöen.\n         Spritt i bestånden finns gammaltallar med så kallad pansarbark och\n         spärrgreniga kronor.","inledning":"Utan länsstyrelsen tillstånd är det också förbjudet att","inledning_offset":1112,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":975,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1021281","dokument_namn":"sammanslaget beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021281","dokument_sha256":"84da4c45e797bc1d6d951a183cc82c06240c70a5b86616b048d9c869174c8316","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.2121296,60.35463447],[13.20331519,60.35169958],[13.20031995,60.35070272],[13.19762637,60.3498049],[13.19762485,60.34980475],[13.19762357,60.34980519],[13.19762332,60.34980595],[13.19778629,60.3501439],[13.19901197,60.35262188],[13.19901283,60