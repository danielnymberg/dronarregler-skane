{"nvrid":"2027513","slug":"slattbranna-stormyran","namn":"Slättbränna-Stormyran","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Sollefteå","lan":"Västernorrlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Västernorrlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2022-02-15","senaste_gallandedatum":"2022-03-10","area_ha":758.84,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2027513","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"hela beslutet m underskrift utan sändlista.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010950","dokument_id":"nvdok-1010950","sha256":"0235e4516947522fefafd17279bd8f0678c9237bcb25137a4b87859fde42138c","sidor":18,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"C. Föreskrifter enligt 7 kap. 30 § miljöbalken om rätten att färdas och vistas\ninom reservatet samt om ordningen i övrigt inom reservatet.\n\nUtöver vad som för övrigt gäller är det förbjudet att:\n  1 fälla eller på annat sätt skada levande eller döda stående och omkullfallna träd och\n    buskar.\n  2 plocka, gräva upp eller på annat sätt ta bort mossor, lavar eller svampar, med\n    undantag för plockning av icke fridlysta matsvampar och icke fridlysta\n    marklevande färgsvampar.\n  3 framföra motordrivet fordon annat än på befintlig väg. Förbudet gäller inte\n    snöskoter på snötäckt, tjälad mark.\n  4 klättra i boträd eller på annat sätt medvetet störa eller skada djurlivet.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":947,"inledning_sidnummer":3,"punkt":"C.","sidnummer":4,"teckenoffset_pa_sidan":988,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbjudet"],"dokument_id":"nvdok-1010950","dokument_namn":"hela beslutet m underskrift utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010950","dokument_sha256":"0235e4516947522fefafd17279bd8f0678c9237bcb25137a4b87859fde42138c","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskrifterna ska inte utgöra hinder för att utöva renskötsel i enlighet med rennäringslagen\n(1971:437) eller framföra motordrivet fordon vid renskötsel i enlighet med gällande\nterrängkörningslagstiftning.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1128,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":746,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1010950","dokument_namn":"hela beslutet m underskrift utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010950","dokument_sha256":"0235e4516947522fefafd17279bd8f0678c9237bcb25137a4b87859fde42138c","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Gällande Jägareförbundets synpunkter kring jakt i området samt uttransport av fällt vilt så\när all jakt i reservatet förbjuden under perioden 15/3-15/8. Ett av huvudsyftena med\nreservatet är att värna ett för fågellivet värdefullt rast- och häckningsområde. Länsstyrelsen\nbedömer att ett förbud mot jakt under denna för fåglar så känsliga period för störning är väl\nmotiverat. Jakttider för de flesta viltarter som jagas är också belägen utanför denna tid\nvarför intrånget i jakträtten får anses vara mycket liten.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":950,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["häckningsområde","fågellivet","störning","förbjuden"],"dokument_id":"nvdok-1010950","dokument_namn":"hela beslutet m underskrift utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010950","dokument_sha256":"0235e4516947522fefafd17279bd8f0678c9237bcb25137a4b87859fde42138c","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Vid uttransport av högvilt ska fordon och färdväg väljas med omsorg för att minimera mark-\noch vegetationsskador(se beslutet § A9). Inom område A (se beslutskarta) är emellertid all\nmotorfordonstrafik på barmark förbjuden, inklusive uttransport av vilt. Dessa delar av\nreservatet utgörs av blötare myrmarker där riskerna är för höga att terrängfordon kan orsaka\nmarkskada.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":14,"teckenoffset_pa_sidan":754,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motorfordonstrafik","terrängfordon","fordon","förbjuden"],"dokument_id":"nvdok-1010950","dokument_namn":"hela beslutet m underskrift utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1010950","dokument_sha256":"0235e4516947522fefafd17279bd8f0678c9237bcb25137a4b87859fde42138c","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.82798869,63.91756467],[16.82824568,63.91774153],[16.82824675,63.91774192],[16.82824813,63.91774195],[16.82877652,63.91768111],[16.82923278,63.91744054],[16.83282395,63.91712412],[16.83394227,63.