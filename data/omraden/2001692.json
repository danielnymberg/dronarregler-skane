{"nvrid":"2001692","slug":"morkahalkarret","namn":"Mörkahålkärret","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Ödeshög","lan":"Östergötlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Östergötlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"1998-05-29","senaste_gallandedatum":"2023-05-04","area_ha":11.32,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2001692","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"beslut och skötselplan mörkahålkärret naturreservat.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025071","dokument_id":"nvdok-1025071","sha256":"a86d1ac39d57b4306cb25e93e5cfd4c2f39422e21bcb6539e9edb70eae7b06ad","sidor":33,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"Mörkahålkärrets domänreservat.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1006435","orsak":"namnet matchar inget föreskriftsmönster"},{"namn":"morkahalskarretplankartor.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1028245","orsak":"namnet matchar inget föreskriftsmönster"}],"citat":[{"citat":"C. Länsstyrelsen beslutar att utöver vad som annars gäller ska följande föreskrifter\n        om rätten att färdas och vistas inom reservatet gälla. Inom reservatet är det inte\n        tillåtet att:","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"C.","sidnummer":4,"teckenoffset_pa_sidan":847,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","inte\n        tillåtet"],"handlingar":["marken"],"dokument_id":"nvdok-1025071","dokument_namn":"beslut och skötselplan mörkahålkärret naturreservat.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025071","dokument_sha256":"a86d1ac39d57b4306cb25e93e5cf