 av gamla boplatser och\nfångstgropar. Skogsbruket har varit omfattande och lämningar efter flera sågar finns i\nområdet, bl.a. Sundvattssågen i nordost. Moderna skogsbruksåtgärder har på senare tid\npåverkat skogen då kalhyggen och gallringar genomförts i vissa bestånd. På 1960-talet\ngenomfördes en gallring men stor del av gammelskogen är fortfarande opåverkad av sentida\nskogsbruksåtgärder. Nyare hyggen finns i områdets centrala delar.","inledning":"Utöver vad som annars gäller i lagar och författningar är det förbjudet att:","inledning_offset":928,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":950,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["boplatser","storia","stor"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1005932","dokument_namn":"Brännan.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1005932","dokument_sha256":"fe5ccf1ba1b07ae56fe4f137695d3313e2564ad84cee4e4a04d5f2a19d3a6594","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[11.9582885,59.59509937],[11.95829018,59.59516242],[11.9583684,59.59525472],[11.95860747,59.5954099],[11.95873326,59.595472],[11.95868329,59.59549864],[11.95866917,59.59554569],[11.95868726,59.59557444],[11.95873192,59.59559086],[11.9587815,59.59560312],[11.95878018,59.59560381],[11.95872018,59.59566482],[11.9587214,59.59573219],[11.95872201,59.59573261],[11.95886627,59.59579003],[11.95886769,59.59579024],[11.95886898,59.59578988],[11.95887474,59.59578438],[11.9589154,59.5958