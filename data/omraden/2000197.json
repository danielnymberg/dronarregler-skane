05 fick Hällefors kommun ett erbjudande av dåvarande markägar-\nen Bergvik Skog att köpa Björskogsnäs naturreservat. Kommunfullmäktige\nbeslöt den 11 oktober 2005 att genomföra köpet, som även inbegrep an-\ngränsande mark söder om reservatet. Motiv till köpet var kommunens vilja\natt säkra allmänhetens tillträde till området, samt möjligheten att nyttja\nbesöksmålet Björskogsnäs för att locka natur- och kulturintresserade turister\ntill kommunen. Hällefors kommun beviljades ett bidrag på halva köpesum-\nman av Naturvårdsverket och köpet genomfördes 17 november 2005. Kom-\nmunen fick tillträde till fastigheten 1 januari 2006.","inledning":"Enligt brottsbalken (1962:700) 8 kap 11 § och 12 kap 2 § är det förbjudet att","inledning_offset":464,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":928,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["tillträde"],"dokument_id":"nvdok-1020772","dokument_namn":"Beslut_Björskogsnäs utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1020772","dokument_sha256":"a3d71d0f52ec37d65af59de34eca4b516c94d1a0c2bfc0fade3fbd5a24a3aa1f","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.48753126,59.69127088],[14.48763755,59.69125124],[14.48770716,59.69124708],[14.4878788,59.69129599],[14.48794877,59.69142144],[14.48799155,59.6914943],[14.48807491,59.69151379],[14.48819202,59.69151983],[14.48826657,59.69152822],[14.4884049,59.69156127],[14.48851037,59.69159073],[14.48856154,59.69161363],[14.48860422,