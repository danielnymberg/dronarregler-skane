73a73542d505563caaa3f4e603be91b0ac1ae1aaf6219a4d707b9e3e81132","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I det förslag till beslut som skickades på remiss till sakägare och andra berörda\nden 18 juli 2007 föreskrevs förbud mot fågeljakt i hela naturreservatet.\nMarkägarna och en jaktarrendator begärde i remissyttranden att få fortsätta\nbedriva fågeljakt inom reservatet. Även Jägareförbundet Västmanland invände\nmot förbudet mot fågeljakt. Mot detta intresse står det allmänna intresse som\nutgör skäl för bildande av reservatet. Myrkomplexet Stora Flyten-Stormossen är\nen viktig häcknings- och rastlokal för fågel. Inom området förekommer tre\njaktbara fågelarter (järpe, orre och tjäder) som ingår i bilaga 1 i EU:s\nfågeldirektiv, vilket innebär att särskilda skyddsområden ska utpekas för dessa.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":645,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1009116","dokument_namn":"Beslut Stora Flyten.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1009116","dokument_sha256":"6f073a73542d505563caaa3f4e603be91b0ac1ae1aaf6219a4d707b9e3e81132","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[15.93789316,59.83560099],[15.936231,59.83590705],[15.93623035,59.83590768],[15.9361534,59.8362674],[15.93615389,59.83626816],[15.93615493,59.83626847],[15.9420402,59.83691921],[15.942