{"nvrid":"2027769","slug":"rojtjarnsmyran-och-spangmyran","namn":"Röjtjärnsmyran och Spångmyran","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Ånge","lan":"Västernorrlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Västernorrlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2023-03-27","senaste_gallandedatum":"2023-04-21","area_ha":818.74,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2027769","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"röjtjärnsmyran hela beslutet utan sändlista 230327.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023186","dokument_id":"nvdok-1023186","sha256":"4b7043df2dda61c14faf453d365705498063977efc13cd804240fa487fceff30","sidor":21,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"C. Föreskrifter enligt 7 kap. 30 § miljöbalken om rätten att färdas och vistas\ninom reservatet samt om ordningen i övrigt inom reservatet.\n\nUtöver vad som för övrigt gäller är det förbjudet att:\n  1 fälla eller på annat sätt skada levande eller döda stående eller omkullfallna träd\n    och buskar.\n  2 plocka, gräva upp eller på annat sätt ta bort mossor, lavar eller svampar, med\n    undantag för plockning av icke fridlysta matsvampar och icke fridlysta\n    marklevande färgsvampar.\n  3 genom grävning eller på annat sätt skada mark, block och vattenmiljöer.\n  4 insamla eller föra bort insekter eller andra ryggradslösa djur.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":133,"inledning_sidnummer":3,"punkt":"C.","sidnummer":4,"teckenoffset_pa_sidan":744,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1023186","dokument_namn":"röjtjärnsmyran hela beslutet utan sändlista 230327.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023186","dokument_sha256":"4b7043df2dda61c14faf453d365705498063977efc13cd804240fa487fceff30","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Reservatsföreskrifterna ska heller inte utgöra hinder för ledningsrättshavare att utöva de till\nbefintliga anläggningar hörande rättigheter såsom drift och underhåll av anläggningar och\nledningar. Till exempel underhåll av befintligt ledningsnät, motormanuella åtgärder såsom\nröjning av buskar och fällning av farliga kantträd intill ledningsgatan eller terrängkörning\nmed mindre terrängfordon längs ledningsgata. Innan underhåll av ledningsgatan vidtas ska\nkontakt tas med länsstyrelsen.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":884,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":191,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["terrängfordon"],"handlingar":["marken"],"dokument_id":"nvdok-1023186","dokument_namn":"röjtjärnsmyran hela beslutet utan sändlista 230327.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023186","dokument_sha256":"4b7043df2dda61c14faf453d365705498063977efc13cd804240fa487fceff30","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskrifterna ska inte utgöra hinder för att utöva renskötsel i enlighet med rennäringslagen\n(1971:437) eller framföra motordrivet fordon vid renskötsel i enlighet med gällande\nterrängkörningslagstiftning.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":884,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1046,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1023186","dokument_namn":"röjtjärnsmyran hela beslutet utan sändlista 230327.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023186","dokument_sha256":"4b7043df2dda61c14faf453d365705498063977efc13cd804240fa487fceff30","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Mot bakgrund av att området är ett av länets största (drygt 800 hektar) och mest värdefulla\nfågelmyrar, antaget som Natura 2000-område och skyddsområde enligt fågeldirektivet\nanser länsstyrelsen att jakt ska förbjudas under perioden 15 mars - 15 augusti för att\nminimera störningar på fågellivet. Eftersom syftet med reservatet är bland annat att skydda\nen ornitologiskt värdefull skogsmyrmosaik och betydelsefull fågellokal är jakt under den\nperiod som fåglarna uppehåller sig på myren inte förenligt med syftet. Med ett jaktförbud\ninom området kan reservatet fungera som en ostörd våtmark vid häckning för fåglar som\ndärigenom har möjlighet att bibehålla eller förstärka populationen.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":11,"teckenoffset_pa_sidan":2621,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågeldirektivet","störningar","fågelmyrar","förbjudas"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1023186","dokument_namn":"röjtjärnsmyran hela beslutet utan sändlista 230327.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023186","dokument_sha256":"4b7043df2dda61c14faf453d365705498063977efc13cd804240fa487fceff30","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Servitut och samfälligheter mm\nSamfälligheterna Torps-Oxsjön S:14 och S:15 rör Röjtjärnen respektive äldre vägar över\nmyrkomplexet. Då nödiga vägar finns till respektive fastighet utanför reservatet bedöms dessa\nsamfällda vägar inte behöva nyttjas. Rättigheten påverkas således inte negativt av att\nreservatsföreskrifterna förbjuder anläggning och underhåll av vägar i reservatet samt\nframförande av motorfordon, undantaget snöskoter på snötäckt, tjälad mark längs skoterled samt\npå sjöis.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":15,"teckenoffset_pa_sidan":1169,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motorfordon","förbjuder"],"handlingar":["marken"],"dokument_id":"nvdok-1023186","dokument_namn":"röjtjärnsmyran hela beslutet utan sändlista 230327.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023186","dokument_sha256":"4b7043df2dda61c14faf453d365705498063977efc13cd804240fa487fceff30","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.06138507,62.32247329],[16.06118906,62.32259072],[16.06114343,62.32320046],[16.06133359,62.32368566],[16.06124922,62.32433318],[16.06124967,62.32433352],[16.06125077,62.32433381],[16.06269486,62.32448051],[16.06347644,62.32470248],[16.06436858,62.32557334],[16.06450218,62.32663993],[16.0646067,62.32757939],[16.06327712,62.32811571],[16.0632769,62.32811627],[16.06339841,62.32861929],[16.06339871,62.3286197],[16.06339935,62.32862001],[16.06465495,62.32900224],[16.06614039,62.32926298],[16.06717204,62.32948729],[16.06775906,62.32985087],[16.06945697,62.33029557],[16.07040996,62.33081977],[16.07041124,62.33081986],[16.0711318,62.33076658],[16.07