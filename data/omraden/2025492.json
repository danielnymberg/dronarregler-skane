{"nvrid":"2025492","slug":"mellskar-och-graens-sydo","namn":"Mellskär och Gråens sydö","skyddstyp":"Djur- och växtskyddsområde","lager":"djur-och-vaxtskydd","karnlager":true,"kommun":"Lidköping","lan":"Västra Götalands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Västra Götalands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2007-03-09","senaste_gallandedatum":"2007-03-09","area_ha":11.0,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2025492","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"31/7"}],"sasongsdata":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"31/7"}],"dokument":[{"namn":"mellanskar_graen.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040338","dokument_id":"nvdok-1040338","sha256":"7659e0ffa220bea5de3a8ab6bfe771e869c308b022100b285f3ff3ee5c9ddd2a","sidor":8,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Beslut\n               Länsstyrelsen meddelar med stöd av 7 kap 12 § miljöbalken (1998:808)\n               förbud mot att, under tiden 1 april – 31 juli, färdas eller uppehålla sig på\n               följande öar och skär med omgivande vattenområden;","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":548,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","förbud"],"dokument_id":"nvdok-1040338","dokument_namn":"mellanskar_graen.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040338","dokument_sha256":"7659e0ffa220bea5de3a8ab6bfe771e869c308b022100b285f3ff3ee5c9ddd2a","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Sedan början av 1970-talet har Länsstyrelsen beslutat om ett flertal fågel-\nskyddsområden på Kålland. Flera av dessa beslut har därefter delvis upp-\nhävts. I beslutet för naturvårdsområdet Kålland har också ett område med\ntillträdesförbud angetts. För att tydliggöra vilka områden som omfattas av\ntillträdesförbud på Kålland upphävs i detta beslut samtliga tidigare beslut\nom tillträdesförbud i Kållands skärgårdar. De områden som fortfarande hy-\nser ett värdefullt och störningskänsligt fågelliv ingår i detta beslut. Detta nya\nbeslut omfattar då samtliga områden med tillträdesförbud inom Ekens, Tra-\nnebergs och Rackeby skärgårdar på Kålland i Lidköpings kommun.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":579,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["störningskänsligt","fågelliv","fågel","förbud"],"dokument_id":"nvdok-1040338","dokument_namn":"mellanskar_graen.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040338","dokument_sha256":"7659e0ffa220bea5de3a8ab6bfe771e869c308b022100b285f3ff3ee5c9ddd2a","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Följande övriga synpunkter har kommit in:\nSjöfartsverket pekar på att Sjöfartsverket och Kustbevakningen skall undan-\ntas från tillträdesförbudet istället för Vänerns seglationsstyrelse och tullver-\nket. Vidare anser verket att förbudet ej skall omfatta farleder och att sjökor-\ntet bör användas som kartunderlag i beslutet.\nLänsstyrelsens kommentar: Synpunkter beaktas med följande justeringar:\nTullverket kommer att undantas från förbudet och farleder som berörs\nkommer att nämnas i beslutet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":1969,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","förbudet"],"dokument_id":"nvdok-1040338","dokument_namn":"mellanskar_graen.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040338","dokument_sha256":"7659e0ffa220bea5de3a8ab6bfe771e869c308b022100b285f3ff3ee5c9ddd2a","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Lidköpings båtsällskap/Segelsällskapet Westgötarne anser att passage bör\ntillåtas in till Sandviken genom Tjursholmarna alternativt bör utprickningen\nändras så att man kan passera norr om ögruppen. Föreningarna saknar en\nredovisning av befintliga fågelskyddsområden.\nLänsstyrelsens kommentar: Tjursholmarna består av flera mindre öar/skär.\nÖgruppen är en av Vänerns viktigaste häckningsplatser för sjöfågel med\nbland annat Vänerns största fiskmåskoloni. Enligt sjökortet är det lämpligast\natt med båt passera norr om ögruppen. Detta är fullt möjligt utan att gränsen\nför tillträdesförbudet ändras. Föreningarna saknar också en överblick av","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":2465,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelskyddsområden","häckningsplatser","största","förbudet"],"dokument_id":"nvdok-1040338","dokument_namn":"mellanskar_graen.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040338","dokument_sha256":"7659e0ffa220bea5de3a8ab6bfe771e869c308b022100b285f3ff3ee5c9ddd2a","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Genom tillträdesförbudet under häckningstid skyddas en stor andel av mås-\nfåglarna med följearter på Kållands ö.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1384,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["häckningstid","fåglarna","stor","förbudet"],"dokument_id":"nvdok-1040338","dokument_namn":"mellanskar_graen.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040338","dokument_sha256":"7659e0ffa220bea5de3a8ab6bfe771e869c308b022100b285f3ff3ee5c9ddd2a","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Konsekvenser för friluftslivet\nFör samtliga fågelskyddsområden i Kållands skärgård gäller förbud att un-\nder tiden 1 april-31 juli färdas eller uppehålla sig inom området. Detta inne-\nbär en begränsning för det rörliga friluftslivet. De föreslagna nya fågel-\nskyddsområdena är dock i allmänhet mindre attraktiva för friluftslivet. Ett\nrikt fågelliv höjer också skärgårdens kvaliteter som rekreations- och upple-\nvelseområde. För fyra öar med fågelskydd föreslås att bestämmelsen om\ntillträdesförbud upphävs. Tre av dessa öar bedöms ha intresse för friluftsli-\nvet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":1670,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","färdas","förbud"],"dokument_id":"nvdok-1040338","dokument_namn":"mellanskar_graen.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1040338","dokument_sha256":"7659e0ffa220bea5de3a8ab6bfe771e869c308b022100b285f3ff3ee5c9ddd2a","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Tillträdesförbud 1 apri l- 31 juli\n          Kälkegrund\n                                                                                                Gräns för fågelskyddsområde                                                                                                                                          