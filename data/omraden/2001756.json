bl a många rödlistade arter av insekter, lavar\noch vedsvampar. Området bör särskilt skyddas på grund av dessa höga biologiska värden,\nNärvaron av så många hotade organismer inom ett så begränsat område gör att Norrkrog har\nett fåtal motsvarigheter i Östergötlands skogsbygder. Det klimatiskt gynnsamma läget vid\nSlätbaken och den varma miljön som uppstår i sydbranter ger speciella förhållanden för djur\noch växtliv. Värdena är till stor del knutna till den rikliga förekomsten av gamla ihåliga ekar\noch död ved, såväl stående som liggande.","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att","inledning_offset":503,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":404,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["stor","djur"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1011264","dokument_namn":"Norrkrog NR beslut och skötselplan inkl bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1011264","dokument_sha256":"8f615fefe37bedca79c70b11094f5b4b3a0ba2de15f7c06cd065c27b01d427d4","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.59830439,58.44824081],[16.59830298,58.44824109],[16.59830242,58.44824182],[16.59840442,58.45002955],[16.59877366,58.45029277],[16.59877438,58.45029308],[16.59930226,58.4504233],[16.5999354,58.45042865],[16.60054722,58.45029694],[16.60054805,58.45029659],[16.60098171,58.44978674],[16.60116401,58.44947788],[16.6016574,58.44938392],[16.60493