:"b5647b0a340cbdd4567baa580d6bceb9a36da57f8c7a54727a7c5d9da542aab6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Föreskrifter jämlikt. 10 $ naturvårdslagen om vad all-\nmänheten har att iakttaga inom reservatet\n\nUtöver föreskrifter och förbud i andra lagar och författ-\nningar skall förbud gälla\n\natt gräva eller på annat sätt skada fast naturföremål eller\n\"> ytbilaning | |\n\natt gräva upp växter\natt skada levande eller döda träd eller buskar\n\natt otillbörligt störa djurlivet, t ex genom närgången\nfotografering\n\natt medföra okopplad hund\n\natt framföra motoråärivet fordon annat än på härför upp-\nlåtna vägar |\n\natt tälta eller uppställa husvagn","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"C.","sidnummer":3,"teckenoffset_pa_sidan":1026,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1016914","dokument_namn":"Beslut Store mosse.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016914","dokument_sha256":"cf5adcd961e6cdc0fb747494e62085b26c45f7b37d4dd119cd6e2bbb03d3d1e9","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I skrivelse till länsstyrelsen har Ni i egenskap av naturvårdsför-\nvaltare av naturreservatet Store mosse hemställt att gränsen för det\ni länsstyrelsens beslut 1981-03-06 om bildande av naturreservatet\nStore mosse (dnr 11.1211-162-80) angivna området med beträdnadsförbud,\nfågelskyddsområde, ändras så att en värdefull häckningslokal i reser-\nvatet kan få ett nödvändigt skydd. Skäl för bibehållande av nuvarande\nfågelskyddsområde i reservatet föreligger inte då dess betydelse som\nhäckningslokal minskat.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":240,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokum