{"nvrid":"2013555","slug":"harrans-naturreservat","namn":"Harråns naturreservat","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Ånge","lan":"Västernorrlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Västernorrlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2021-12-21","senaste_gallandedatum":"2022-01-21","area_ha":174.91,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2013555","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"hela beslutet med bilagor.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024833","dokument_id":"nvdok-1024833","sha256":"e543c477cd22563d956e7524ed99707f153be44436521328f8d4966a40a0e542","sidor":20,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"9 framföra motordrivet fordon annat än på befintlig väg eller i samband med\n    uttransport av skjutna älgar, björnar eller annat högvilt, varvid risk för skador på\n    mark, vatten och vegetation ska minimeras. Förbudet gäller ej snöskoterkörning\n    på snötäckt mark.\n 10 anlägga fiskodling eller annan odling av växter eller djur.\n 11 utföra fiskevårdande åtgärd såsom iläggning av sten eller grus, borttagning av\n    vandringshinder och liknande utan länsstyrelsens tillstånd.\n 12 riva bäverdammar. Föreskrifterna ska inte utgöra hinder för rivning av\n    bäverdamm som påverkar väg eller område utanför reservatet.\n 13 uppföra jakttorn och röja siktgator utan länsstyrelsens tillstånd.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1421,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":2,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1024833","dokument_namn":"hela beslutet med bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024833","dokument_sha256":"e543c477cd22563d956e7524ed99707f153be44436521328f8d4966a40a0e542","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Föreskrifter enligt 7 kap. 30 § miljöbalken om rätten att färdas och vistas inom\nreservatet samt om ordningen i övrigt inom reservatet.\n\nUtöver vad som för övrigt gäller är det förbjudet att:\n  1 fälla eller på annat sätt skada levande eller döda, stående eller omkullfallna, träd\n    och buskar.\n  2 plocka, gräva upp eller på annat sätt ta bort mossor, lavar eller svampar, med\n    undantag för plockning av icke fridlysta matsvampar och icke fridlysta\n    marklevande färgsvampar, samt bär.\n  3 genom grävning eller på annat sätt skada mark- eller vattenmiljöer.\n  4 vaska efter guld eller andra ämnen.\n  5 framföra motordrivet fordon annat än på befintlig väg.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"C.","sidnummer":5,"teckenoffset_pa_sidan":334,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1024833","dokument_namn":"hela beslutet med bilagor.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024833","dokument_sha256":"e543c477cd22563d956e7524ed99707f153be44436521328f8d4966a40a0e542","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[15.6353182,62.62932342],[15.63603124,62.62912512],[15.636032,62.62912475],[15.63674382,62.62854134],[15.6370889,62.62801329],