{"nvrid":"2011718","slug":"tikaskruv-1-1-munkamala-1-1","namn":"Tikaskruv 1:1, Munkamåla 1:1","skyddstyp":"Vattenskyddsområde","lager":"vattenskyddsomrade","karnlager":false,"kommun":"Nybro","lan":"Kalmar Län","beslutsstatus":"Gällande","beslutsmyndighet":"Kommun","forvaltare":null,"tillsynsmyndighet":"Kommun","urspr_beslutsdatum":"1967-03-17","senaste_gallandedatum":"2010-04-08","area_ha":672.97,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2011718","svarslage":"reglerat-las-beslutet","luftfartslage":"luftfart","ocr":true,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Tikaskruv_2009_Nybro_Författning.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042870","dokument_id":"nvdok-1042870","sha256":"dc27c0d32e0586e55cdf461d9b62e1a65cb709527355a8cce7b07aad01603c9f","sidor":9,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Primär och sekundär skyddszon: För hantering, med undantag\nför transporter, av diesel eller eldningsolja krävs tillstånd från\nkommunens nämnd för miljöfrågor. Användning av diesel,\nhydraul- och smörjolja i traktorer, m.fl. fordon eller redskap\nundantas. Uppställning av traktorer, m.fl. motorfordon eller\nmotorredskap kräver tillstånd från kommunens nämnd för\nmiljöfrågor. Uppställning av personbilar, motorcyklar och\nmopeder undantas.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":459,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motorfordon","fordon","krävs tillstånd"],"dokument_id":"nvdok-1042870","dokument_namn":"Tikaskruv_2009_Nybro_Författning.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042870","dokument_sha256":"dc27c0d32e0586e55cdf461d9b62e1a65cb709527355a8cce7b07aad01603c9f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Primär och sekundär skyddszon: Genomgående transporter av\nfarligt gods på andra vägar än rekommenderad väg (väg 31),\nsamt på väg 1017, får inte ske utan tillstånd av kommunens\nnämnd för miljöfrågor. Väg 31, med anslutningar, skall vara\nförsedd med skäliga anordningar till skydd mot avkörning och\nvattenförorening från vägen. Tillsynsmyndigheten skall\ngodkänna anordningarna och medge den tid som krävs för att\nutföra sådana anordningar. Det är förbjudet att parkera fordon\nsom är lastade med farligt gods, vilket ska framgå av skyltning\npå lämpliga platser.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":926,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","får inte"],"dokument_id":"nvdok-1042870","dokument_namn":"Tikaskruv_2009_Nybro_Författning.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042870","dokument_sha256":"dc27c0d32e0586e55cdf461d9b62e1a65cb709527355a8cce7b07aad01603c9f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Primär och sekundär skyddszon: Motorbåttrafik är förbjuden\nmed undantag för eldriven motor.","inledning":"godkänna anordningarna och medge den tid som krävs för att","inledning_offset":1278,"inledning_sidnummer":5,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":77,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motor","förbjuden"],"dokument_id":"nvdok-1042870","dokument_namn":"Tikaskruv_2009_Nybro_Författning.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1042870","dokument_sha256":"dc27c0d32e0586e55cdf461d9b62e1a65cb709527355a8cce7b07aad01603c9f","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Landning med förbränningsmotordriven flygfarkost på sjöar\noch vattendrag