{"nvrid":"2014072","slug":"rennstadsnipan","namn":"Rennstadsnipan","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Kil","lan":"Värmlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Värmlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2008-07-30","senaste_gallandedatum":"2008-09-22","area_ha":61.99,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2014072","svarslage":"reglerat-las-beslutet","luftfartslage":"luftfart","ocr":true,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Rennstadsnipan-beslut.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007527","dokument_id":"nvdok-1007527","sha256":"c7c5316c72e43ea1244e8900b2524151db257748b3c9b4f7ec95fcd678c65611","sidor":40,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"C. Ordningsföreskrifter enligt 7 kap. 30 & miljöbalken om rätten att färdas och vistas i,\nsamt om ordningen i reservatet i övrigt (gäller även markägare och innehavare av\nsärskild rätt).\n\nUtöver vad som annars gäller i lagar och författningar är det i naturreservatet förbjudet att:\n\nsamla in ryggradslösa djur, t ex skalbaggar, snäckor och fjärilar\n\nsamla in mossor, lavar och vedsvampar\n\nskada eller ta bort död ved såsom lågor, torrträd och torra grenar\n\nrida\n\nframföra fordon\n\nelda annat än på anvisad plats\n\nmedföra ej kopplad hund\n\nNN NM OP RN","inledning":"Utöver vad som annars gäller i lagar och författningar är det i naturreservatet förbjudet att:","inledning_offset":804,"inledning_sidnummer":2,"punkt":"C.","sidnummer":2,"teckenoffset_pa_sidan":1883,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1007527","dokument_namn":"Rennstadsnipan-beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007527","dokument_sha256":"c7c5316c72e43ea1244e8900b2524151db257748b3c9b4f7ec95fcd678c65611","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskriften C3 utgör inte hinder för röjning av befintliga pass under förutsättning att inte\nnaturvärden påverkas negativt och att åtgärden sker i samråd med reservatsförvaltaren.\nFöreskriften CS utgör inte hinder för hämtning av fällt vilt enligt terrängkörningsförordningen\n(1975:594 18) under förutsättning att fordon med lågt marktryck används så att spårbildning inte\nsker. Föreskriften CS utgör inte heller hinder för transport till och från friluftsanläggningen i\nsamband med skötsel och underhåll. Föreskriften CS utgör inte heller hinder för transport med\nfyrhjuligt fordon av rörelsehindrade inom reservatet.","inledning":"Utöver vad som annars gäller i lagar och författningar är det i naturreservatet förbjudet att:","inledning_offset":2071,"inledning_sidnummer":2,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":66,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1007527","dokument_namn":"Rennstadsnipan-beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007527","dokument_sha256":"c7c5316c72e43ea1244e8900b2524151db257748b3c9b4f7ec95fcd678c65611","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Tjärnarna runt Rennstadsnipan, dvs Nordsjötjärnet, Rennstadtjärnet, Skitjärnet och\nSmåtjärnarna, ingår i Vitsandsälvens avrinningsområde. Vattnen var tidigare starkt försurade och\nkalkas sedan ett antal år via helikopter. Kalkningsprojektet har gett god utdelning och numera\nfinns flodkräfta och lekande harr i vattnen (harren troligen inplanterad). I Rennstadtjärnet, som\nhar fina vassområden i vikar i både norr och söder, är det varje vår ett fantastiskt grodspel då\noerhörda mängder med åkergroda och vanlig groda spelar. Också paddor deltar.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":13,"teckenoffset_pa_sidan":990,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","traffade_ord":["helikopter"],"handlingar":["flyga"],"dokument_id":"nvdok-1007527","dokument_namn":"Rennstadsnipan-beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1007527","dokument_sha256":"c7c5316c72e43ea1244e8900b2524151db257748b3c9b4f7ec95fcd678c65611","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.08212357,59.61402911],[13.07865164,59.61601885],[13.07865159,59.61601941],[13.07984043,59.61844664],[13.08116964,59.61976567],[13.09195774,59.62309855],[13.09195916,59.62309868],[13.09196012,59.62309842],[13.0919607,59.62309775],[13.09203796,59.62210149],[13.09233039,59.61839587],[13.09572272,59.61840544],[13.09572358,59.61840511],[13.09572396,59.61840459],[13.0958412,59.61759801],[13.09588677,59.61754115],[13.09588612,59.61754044],[13.09588544,59.61754024],[13.09588426,59.61754023],[13.095687,59.61757028],[13.09531605,59.61755365],[13.09506542,59.61758437],[13.09492679,59.6175456],[13.0948672,59.6175129],[13.09469249,59.61748234],[13.09452071,59.61741596],[13.09439342,59.61734599],[13.09429513,59.6172451],[13.09415246,59.61703559],[13.09386609,59.61685003],[13.09388323,59.61674724],[13.09386217,59.61667943],[13.09374764,59.61656017],[13.0937414,59.61641624],[13.09359236,59.61628748],[13.09353892,59.61607082],[13.093441