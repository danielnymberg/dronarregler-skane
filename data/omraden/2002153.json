räns ändras\nmen framför samtidigt en oro över att besökare ska få en mer begränsad tillgänglighet till\nområden som tidigare tillhört naturreservatet. Vigselplatsen och Drömmarnas sjö är exempel på\npopulära platser för besökande och kommunen hoppas på fortsatt fritt tillträde till dessa i samråd","inledning":"Utöver vad som annars gäller i lagar och författningar är det i naturreservatet förbjudet att:","inledning_offset":514,"inledning_sidnummer":3,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":2699,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["tillträde"],"dokument_id":"nvdok-1016110","dokument_namn":"Beslut-Ravinerna vid Apertin.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1016110","dokument_sha256":"a537bad76c64305077f1b6b5cb6502a0c279fee235bda10ce9583c711e382ddb","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[13.36603769,59.51881368],[13.3660379,59.51881424],[13.36603903,59.51881472],[13.36777439,59.51909421],[13.36777549,59.51909396],[13.36777596,59.51909362],[13.3680967,59.51871714],[13.3688648,59.51875624],[13.36886588,59.518756],[13.36886635,59.51875568],[13.36898034,59.51863452],[13.37066136,59.51885969],[13.37108856,59.51895508],[13.37145373,59.51907071],[13.37145482,59.51907085],[13.37145589,59.51907067],[13.37207225,59.51884588],[13.37235644,59.51862769],[13.37265477,59.51833976],[13.37357704,59.51821139],[13.37483377,59.51834745],[13.375652,59.51827916],[13.37621729,59.51844288],[13.37621833,59.51844301],[13.37621963,59.51844273],[