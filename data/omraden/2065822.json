rtsättningsvis möjliggör\nundantag från föreskrifterna för siktröjning. Det möjliggör även att\nfortsättningsvis röjning av klapperstensfältet på Hamnskär som historiskt har\nhållits öppet från igenväxning. I områden på Hamnskär, Gräsharen och\nTupparna som är markerade för möjlig siktröjning får ved från siktröjningen\nnyttjas av hamnföreningen eller fastighetsägarna på öarna förutsatt att\nmarkägaren givit godkännande.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":30,"teckenoffset_pa_sidan":344,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1023977","dokument_namn":"beslut tupparna-kalvhararnas utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023977","dokument_sha256":"f92d7418c841818a87db26472375e5b78215e29fff62f5b9e275f2cdc50d8d49","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.3436039,61.11658998],[17.34360512,61.11658956],[17.34360543,61.11658886],[17.33577816,61.09392348],[17.33577768,61.09392299],[17.31866922,61.08958898],[17.29202807,61.08299794],[17.25667442,61.07573835],[17.25667287,61.0757385],[17.25667212,61.07573895],[17.25052597,61.08324786],[17.24900113,61.08476313],[17.22075071,61.10335805],[17.22075077,61.10335862],[17.22075183,61.10335918],[17.30199413,61.12150544],[17.30199503,61.12150543],[17.3436039,61.11658998]],[[17.26929519,61.09852519],[17.26960819,61.09820737],[17.27188491,61.09745681],[17.2728565,61.09698804],[17.27406744,61.09714995],[17.27494922,61.09731