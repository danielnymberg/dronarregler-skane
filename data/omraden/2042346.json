{"nvrid":"2042346","slug":"vikskvarn","namn":"Vikskvarn","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Nässjö","lan":"Jönköpings Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Jönköpings län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2014-05-15","senaste_gallandedatum":"2015-02-26","area_ha":72.32,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2042346","svarslage":"reglerat-las-beslutet","luftfartslage":"luftfart","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Vikskvarn beslut och skötselplan 2014-05-15.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1015194","dokument_id":"nvdok-1015194","sha256":"4b34ed262604f897c318029d86d510e7f8e98981c22396a36a7a617fbcb71ac2","sidor":36,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"OMRÅDESBESKRIVNING\nOmrådet utgörs av barrblandskog med gamla tallar främst uppe på åsryggen\noch ett ökat inslag av gran på de lägre partierna, där det även finns gammal\ngrov gran. Det finns spår av tidigare skogsbete och en tidigare glesare\nbondeskog. Död ved finns bland annat i form av vindfällen och\nbarkborreangripna granar. Höglandsleden sträcker sig genom reservatet och\ngår uppe på en mäktig åsrygg med barrblandskog. Skogen närmast\nledningsgatan är delvis toppbeskuren med helikopter i samband med\nträdsäkring av ledningsgatan.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":24,"teckenoffset_pa_sidan":213,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","traffade_ord":["helikopter"],"handlingar":["flyga"],"dokument_id":"nvdok-1015194","dokument_namn":"Vikskvarn beslut och skötselplan 2014-05-15.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1015194","dokument_sha256":"4b34ed262604f897c318029d86d510e7f8e98981c22396a36a7a617fbcb71ac2","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"OMRÅDESBESKRIVNING\nNaturreservatet genomkorsas av en bred ledningsgata. Den norra delen är\nbevuxen med mycket enbuskar och fältskiktet utgörs av risvegetation med\nblåbär och ljung. I ledningsgatans södra del växer hävdgynnade arter som\njungfru marie nycklar, nattviol och slåttergubbe. Markförhållandena är bitvis\nmycket fuktiga. För att minimera risken för framtida stormfällningar med\nefterföljande insektsangrepp bör ledningsgatans stabila skogskant mot\nkringliggande skog bevaras. I samband med en ansökan om en breddning av\nledningsgatan 2006-2007 gjordes kompromissen att inom det blivande\nreservatet toppbeskära träden med helikopter istället för att avverka.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":27,"teckenoffset_pa_sidan":1898,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","traffade_ord":["helikopter"],"handlingar":["flyga"],"dokument_id":"nvdok-1015194","dokument_namn":"Vikskvarn beslut och skötselplan 2014-05-15.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1015194","dokument_sha256":"4b34ed262604f897c318029d86d510e7f8e98981c22396a36a7a617fbcb71ac2","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.60294248,57.53757983],[14.60267701,57.53780133],[14.60267672,57.53780194],[14.60274734,57.53792882],[14.60283158,57.53812721],[14.60293889,57.53836292],[14.60293924,57.5383633],[14.60293986