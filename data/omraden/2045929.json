 på uppdrag\nav regeringen och redovisades i Naturvårdsverkets rapporter 5339, 5344, 5345 och\n5473. För Norrbottens län redovisades totalt 432 områden som skyddsvärda. Detta\nursprungliga område ägdes då av Statens Fastighetsverk men har sedan dess övergått till\nNaturvårdsverkets ägo.\nLänsstyrelsen inventerade det kringliggande området år 2012 till fots och med\nhelikopter, och konstaterade att höga naturvärden finns.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":1423,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","traffade_ord":["helikopter"],"handlingar":["flyga"],"dokument_id":"nvdok-1023835","dokument_namn":"beslut om bildande av veddekbäckens naturreservat i arjeplogs kommun(24437436) (0)_tmp.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023835","dokument_sha256":"4fe1cf781094b70ddefa1464ba4ac303828382e3d42260d6692ef48fb5df1dbe","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.25919093,66.0196247],[17.24049199,66.02550627],[17.24049107,66.02550693],[17.24049157,66.02550767],[17.2535129,66.03218169],[17.25351455,66.03218206],[17.25351634,66.03218184],[17.27445125,66.02519462],[17.28858287,66.02008547],[17.29796245,66.02279901],[17.29796383,66.02279919],[17.29796523,66.02279902],[17.31131153,66.01421913],[17.33194525,66.01936149],[17.33194664,66.01936142],[17.3319477,66.01936104],[17.3382339,66.01524216],[17.34070569,66.02086972],[17.34070731,66.02087015],[17.34851172,66.02139627]