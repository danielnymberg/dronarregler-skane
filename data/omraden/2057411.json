{"nvrid":"2057411","slug":"kvikkjokk-vattenskyddsomrade","namn":"Kvikkjokk vattenskyddsområde","skyddstyp":"Vattenskyddsområde","lager":"vattenskyddsomrade","karnlager":false,"kommun":"Jokkmokk","lan":"Norrbottens Län","beslutsstatus":"Gällande","beslutsmyndighet":"Kommun","forvaltare":null,"tillsynsmyndighet":"Kommun","urspr_beslutsdatum":"2020-02-24","senaste_gallandedatum":"2020-02-24","area_ha":242.17,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2057411","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Skyddsföreskrifter Kvikkjokk.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046318","dokument_id":"nvdok-1046318","sha256":"9c5c86246545be324d663ddf7b45d11a20659b082d28d4c80eaf28107f1ef7ca","sidor":13,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"§5 HANTERING AV PETROLEUMPRODUKTER OCH ANDRA BRANDFARLIGA VÄTSKOR\n\nHantering av petroleumprodukter och andra brandfarliga vätskor i större volym än 40\nliter (samtidig hantering) är förbjuden. Förbudet gäller dock inte för transporter av\npetroleumprodukter och andra brandfarliga vätskor eller för drivmedel i fordon,\narbetsmaskiner och liknande och liknande som är i bruk (dvs. ej skrotfordon).\n\nFörvaringstankar, stationära förbränningsmotorer etc är förbjudna.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§5","sidnummer":7,"teckenoffset_pa_sidan":28,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1046318","dokument_namn":"Skyddsföreskrifter Kvikkjokk.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046318","dokument_sha256":"9c5c86246545be324d663ddf7b45d11a20659b082d28d4c80eaf28107f1ef7ca","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§13 UPPSTÄLLNING OCH SKÖTSEL AV FORDON OCH MASKINER\n\nFör motordrivna arbetsfordon och arbetsmaskiner gäller att tankning eller uppställning\nmed varaktighet längre än 8 timmar är förbjuden, om åtgärder inte vidtas för att\nhindra eventuellt läckage av olja eller andra kemikalier att tränga ner i underliggande\nmark eller vatten. Sådana åtgärder är till exempel att placera täta dukar med\ninvallningar under uppställda maskiner.\n\nTvätt av motordrivna fordon är förbjuden.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§13","sidnummer":8,"teckenoffset_pa_sidan":367,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivna","FORDON","fordon","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1046318","dokument_namn":"Skyddsföreskrifter Kvikkjokk.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046318","dokument_sha256":"9c5c86246545be324d663ddf7b45d11a20659b082d28d4c80eaf28107f1ef7ca","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§20 ANVÄNDNING AV SLÄCKVATTEN\n\nVid brand av bebyggelse och fordon är användning av släckvatten förbjuden om det\nföreligger risk för förorening av grundvattnet.\n\n\n\n\n                                                                                    Sida 8 (13)","inledning":"med varaktighet längre än 8 timmar är förbjuden, om åtgärder inte vidtas för att","inledning_offset":507,"inledning_sidnummer":8,"punkt":"§20","sidnummer":8,"teckenoffset_pa_sidan":1904,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1046318","dokument_namn":"Skyddsföreskrifter Kvikkjokk.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046318","dokument_sha256":"9c5c86246545be324d663ddf7b45d11a20659b082d28d4c80eaf28107f1ef7ca","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§21 HANTERING AV PETROLEUMPRODUKTER OCH ANDRA BRANDFARLIGA VÄTSKOR\n\nHantering av petroleumprodukter och andra brandfarliga vätskor i större volym än 250\nliter (samtidig hantering) får inte ske utan tillstånd från miljönämnden. Tillstånd krävs\ndock inte för transporter av petroleumprodukter och andra brandfarliga vätskor eller\nför drivmedel i fordon, arbetsmaskiner och liknande som är i bruk (dvs. ej\nskrotfordon).","inledning":"med varaktighet längre än 8 timmar är förbjuden, om åtgärder inte vidtas för att","inledning_offset":507,"inledning_sidnummer":8,"punkt":"§21","sidnummer":9,"teckenoffset_pa_sidan":31,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","får inte"],"handlingar":["marken"],"dokument_id":"nvdok-1046318","dokument_namn":"Skyddsföreskrifter Kvikkjokk.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046318","dokument_sha256":"9c5c86246545be324d663ddf7b45d11a20659b082d28d4c80eaf28107f1ef7ca","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"gods i länet.\nOm transporter av farligt gods sker skall det fordon som används uppfylla MSBs krav\nenligt ADR/ADR-S.","inledning":"Inom vattentäktzon, primär skyddszon och sekundär skyddszon är det förbjudet att","inledning_offset":2457,"inledning_sidnummer":12,"punkt":null,"sidnummer":13,"teckenoffset_pa_sidan":0,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1046318","dokument_namn":"Skyddsföreskrifter Kvikkjokk.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046318","dokument_sha256":"9c5c86246545be324d663ddf7b45d11a20659b082d28d4c80eaf28107f1ef7ca","ocr":false,"verifierad":true,"verifieringsmetod