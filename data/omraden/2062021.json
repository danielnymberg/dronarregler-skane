0 § miljöbalken\nEnligt förordningen (2007:1244) om konsekvensutredning vid\nregelgivning ska en bedömning om konsekvensutredning göras för\nordningsföreskrifterna enligt 7 kap. 30 § miljöbalken. Dessa föreskrifter\ngäller rätten att färdas och vistas, och ordningen i övrigt i området och\nexemplifieras i förarbetena till miljöbalken (prop. 1997/98:45) som\nförbud mot åtgärder som annars hade varit tillåtna enligt\nallemansrätten.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":21,"teckenoffset_pa_sidan":1154,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","förbud"],"dokument_id":"nvdok-1023526","dokument_namn":"beslut och skötselplan för vitknösens naturreservat utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023526","dokument_sha256":"25ce9ac3ca48e7e7f505d88bc4849808c583af5c7d5827af97b30fb11cd563fd","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.29154036,65.62702512],[17.29039193,65.62838003],[17.29039207,65.62838082],[17.29146248,65.62873089],[17.29447441,65.62911571],[17.29447573,65.62911561],[17.29447691,65.62911507],[17.29581529,65.62761036],[17.29895251,65.62833074],[17.29895392,65.62833061],[17.3016924,65.62769811],[17.30571654,65.62767534],[17.306501,65.62883726],[17.30989017,65.63002704],[17.30625406,65.63071347],[17.30364596,65.63032564],[17.30364464,65.63032561],[17.30364383,65.63032575],[17.30269507,65.63088568],[17.30269463,65.63088627],[17.30372245,65.63178316],[