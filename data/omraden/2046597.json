{"nvrid":"2046597","slug":"hunn","namn":"Hunn","skyddstyp":"Vattenskyddsområde","lager":"vattenskyddsomrade","karnlager":false,"kommun":"Finspång, Norrköping","lan":"Östergötlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Kommun","forvaltare":null,"tillsynsmyndighet":"Kommun","urspr_beslutsdatum":"2016-10-17","senaste_gallandedatum":"2016-11-07","area_ha":5385.43,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2046597","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"hunn_foreskrifter.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044009","dokument_id":"nvdok-1044009","sha256":"2eaa616550dd49bf9306e64014e8941e294b02c8dad4c4d0f04a6f84aaae6eea","sidor":10,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"§4     Hantering av brandfarliga vätskor\n\nHantering av mer än 250 liter brandfarlig vätska får ej ske utan tillstånd från\nBygg- och miljönämnden.\n\nUndantag från tillståndskravet gäller för drivmedel i fordon eller\narbetsmaskiner.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§4","sidnummer":1,"teckenoffset_pa_sidan":884,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1044009","dokument_namn":"hunn_foreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044009","dokument_sha256":"2eaa616550dd49bf9306e64014e8941e294b02c8dad4c4d0f04a6f84aaae6eea","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"God beredskap ska finnas för att hantera eventuella tillbud med läckage av\ndrivmedel eller andra kemikalier vid arbete inom vattenskyddsområdet.\n\nInom primär zon gäller dessutom\nHantering av brandfarlig vätska får inte ske utan tillstånd från Bygg- och\nmiljönämnden.\n\nUndantag från tillståndskravet gäller för upp till 25 liter om hanteringen sker\npå ett för vattenskyddet betryggande sätt. Undantag från tillståndskravet\ngäller även för drivmedel som finns i fordon eller arbetsmaskiner.\n\nFörbud mot anläggning av underjordiska cisterner.\n\nPåfyllning av båtbränsle ska alltid ske med största försiktighet och med\nhjälp av utrustning som förhindrar spill till vattnet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":2,"teckenoffset_pa_sidan":0,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1044009","dokument_namn":"hunn_foreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044009","dokument_sha256":"2eaa616550dd49bf9306e64014e8941e294b02c8dad4c4d0f04a6f84aaae6eea","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§8      Motorfordon; framförande, tvätt och uppställning\n\nNya permanenta uppställningsplatser för motorfordon av större omfattning\nän behovet för enstaka hushåll får inte anläggas utan tillstånd från Bygg-\noch miljönämnden.\n\nFordonstvätt med avfettningsmedel får endast ske på spolplatta ansluten till\nav kommunen godkänd rening.\n\nVid uppställning av arbetsfordon ska relevanta försiktighetsmått vidtas som\nförhindrar läckage av drivmedel eller andra kemikalier till omgivande mark\noch vatten.\n\nInom primär zon gäller dessutom\nFörbud mot framförande av motorfordon på isbelagd sjö.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§8","sidnummer":3,"teckenoffset_pa_sidan":740,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1044009","dokument_namn":"hunn_foreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044009","dokument_sha256":"2eaa616550dd49bf9306e64014e8941e294b02c8dad4c4d0f04a6f84aaae6eea","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Förbud mot nya permanenta uppställningsplatser på land för motorfordon\nutöver vad som behövs för enstaka hushåll.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":0,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","dokument_id":"nvdok-1044009","dokument_namn":"hunn_foreskrifter.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1044009","dokument_sha256":"2eaa616550dd49bf9306e64014e8941e294b02c8dad4c4d0f04a6f84aaae6eea","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[15.89681867,58.82602669],[15.8962634,58.82507713],[15.89626246,58.82507655],[15.89626101,58.82507647],[15.89626009,58.8250768],[15.89593512,58.8252859],[15.89569056,58.82548226],[15.89543765,58.82569488],[15.89518073,58.82590427],[15.89508906,58.82601583],[15.8950441,58.8261013],[15.89504186,58.8261567],[15.89504869,58.82624789],[15.89507088,58.82632586],[15.89511811,58.82642006],[15.89519024,58.8265572],[15.89534014,58.82676727],[15.8957892,58.82736217],[15.89607481,58.82771721],[15.89629763,58.82803466],[15.89637244,58.82816001],[15.89643324,58.8282695],[15.89646695,58.82836717],[15.89648358,58.82852757],[15.89648197,58.82870206],[15.89644456,58.8288087],[15.89635105,58.829086],[15.89605276,58.82977179],[15.89573374,58.8305574],[15.89560467,58.83080137],[15.89556029,58.83091429],[15.89554531,58.83100224],[15.89554982,58.83114505],[15.89555782,58.83121062],[15