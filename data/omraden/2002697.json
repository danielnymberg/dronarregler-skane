se/handlingar/rest/dokument/1026952","dokument_id":"nvdok-1026952","sha256":"740c9d12838ab94e763c2dc6250061b4475d2722208c412dc7b4f944e88e6e50","sidor":28,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Genom beslut 1978-01-27 avsatte Länsstyrelsen delar av det nu aktuella området\nsom sälskyddsområde enligt 14$ naturvårdslagen. Grunden för beslutet var att\ntillgodose sälarnas behov av ostördhet och därigenom gynna uppkomsten av en\nfast sälstam. Området utökades åt nordväst genom ett tilläggsbeslut 1987-06-25\nsedan det blivit känt att ett viktigt uppehållsområde för sälarna låg utanför\nskyddsområdet. För området gäller tillträdesförbud under tiden 1 januari till 15\noktober, förbud att döda, skada eller fånga säl samt att inom delar av området be-\ndriva jakt.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":8,"teckenoffset_pa_sidan":1938,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"handlingar":["flyga","landa","lyfta","marken"],"dokument_id":"nvdok-1032904","dokument_namn":"Rättelse_Värnanäs_skärgårdBeslut_gdpr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1032904","dokument_sha256":"8fbb10d564f1b4a9a3b6d77dd5819a9b938b03db9a7cf11a2070d9a0faff9fd6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I remissyttrandena har bland annat följande synpunkter framförts. Flera av re-\nmissinstanserna, bland annat Kalmar kommun, Ekenäs båtklubb, Kalmar kanot-\nklubb, Karlsnäs stugförening m fl, motsätter sig den föreslagna avgränsningen av\ntillträdesförbudsområdet (zon I). De menar att ett område närmast kusten skall un-\ndantas från zon I så att det finns möjlighet för mindre båtar som kanoter och flat-\nbottnade roddbåtar att passera förbi området längs stranden.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":10,"teckenoffset_pa_sidan":237,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudsområdet","förbudsområdet"],"handlingar":["marken"],"dokument_id":"nvdok-1032904","dokument_namn":"Rättelse_Värnanäs_skärgårdBeslut_gdpr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1032904","dokument_sha256":"8fbb10d564f1b4a9a3b6d77dd5819a9b938b03db9a7cf11a2070d9a0faff9fd6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Kalmar kommun anser att tiden för tillträdesförbudet bör börja tidigast I mars.\nTillträdesförbudet vintertid har tidigare motiverats med behovet av skydd för grå-\nsäl, men kommunen anser att det inte är ett tillräckligt starkt motiv eftersom syftet\nmed reservatet är att skydda knubbsäl och gråsälen numera inte är en hotad art.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":10,"teckenoffset_pa_sidan":701,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","Tillträdesförbudet","förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1032904","dokument_namn":"Rättelse_Värnanäs_skärgårdBeslut_gdpr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1032904","dokument_sha256":"8fbb10d564f1b4a9a3b6d77dd5819a9b938b03db9a7cf11a2070d9a0faff9fd6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsen har vid den slutliga utformningen av beslutet gjort en prövning av\nde synpunkter som förts fram i remissvaren. Synpunkterna om tillträdesförbudets\navgränsning, förbudstiden och övervakningsprogram för uppföljning av faunan\noch floran har beaktats i beslutet. Beträffande övriga framförda synpunkter har\nLänsstyrelsen inte funnit skäl att revidera beslutsförslaget.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":10,"teckenoffset_pa_sidan":1645,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudets","förbudets"],"handlingar":["marken"],"dokument_id":"nvdok-1032904","dokument_namn":"Rättelse_Värnanäs_skärgårdBeslut_gdpr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1032904","dokument_sha256":"8fbb10d564f1b4a9a3b6d77dd5819a9b938b03db9a7cf11a2070d9a0faff9fd6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"När det gäller tillträdesförbudets geografiska avgränsning och utsträckning i tiden\nhar en vägning skett mellan naturvårdsintresset och friluftslivsintresset. Länssty-\nrelsens bedömning är att naturvårdsintresset måste ges hög prioritet med hänsyn\ntill områdets status som riksintresse för den vetenskapliga naturvården och dess\nsärställning som reproduktionslokal och livsmiljö för knubbsäl. Området har\nemellertid även stor betydelse för det rörliga friluftslivet. Länsstyrelsen har därför\nfunnit att friluftslivsintresset bör tillgodoses genom att det finns tillträdesmöjlig-\nhet till ett vattenområde mellan zon I och fastlandet där mindre båtar och kanoter\nkan passera genom reservatet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":10,"teckenoffset_pa_sidan":2025,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudets","tillträdesmöjlig","förbudets"],"handlingar":["marken"],"dokument_id":"nvdok-1032904","dokument_namn":"Rättelse_Värnanäs_skärgårdBeslut_gdpr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1032904","dokument_sha256":"8fbb10d564f1b4a9a3b6d77dd5819a9b938b03db9a7cf11a2070d9a0faff9fd6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"budstiden till 1 april-15 september. Det nu gällande tillträdesförbudet under janu-\nari till mars är främst motiverat med hänsyn till gråsälen. Då området numera inte\nanses ha samma betydelse som uppehållsområde för gråsäl bedöms det inte vara\nrelevant att bibehålla förbudet under vintertid.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":11,"teckenoffset_pa_sidan":59,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbudet","förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1032904","dokument_namn":"Rättelse_Värnanäs_skärgårdBeslut_gdpr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1032904","dokument_sha256":"8fbb10d564f1b4a9a3b6d77dd5819a9b938b03db9a7cf11a2070d9a0faff9fd6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"1. Under tiden 1 april till 15 september färdas eller uppehålla sig inom zon I\nenligt markering på bifogad karta, bilaga 1 eller att där landa med båt eller\nannan farkost","inledning":"Utöver föreskrifter och förbud i annan lagstiftning är det förbjudet att","inledning_offset":904,"inledning_sidnummer":14,"punkt":"1.","sidnummer":14,"teckenoffset_pa_sidan":978,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["farkost"],"handlingar":["landa","lyfta","marken"],"dokument_id":"nvdok-1032904","dokument_namn":"Rättelse_Värnanäs_skärgårdBeslut_gdpr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1032904","dokument_sha256":"8fbb10d564f1b4a9a3b6d77dd5819a9b938b03db9a7cf11a2070d9a0faff9fd6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"2. Under tiden 1 april till 31 juli färdas eller uppehålla sig på Svartö eller Norra\nSandholmen eller komma närmare stranden av dessa öar än 100 m. Områdena\när markerade med raster på bifogad karta, bilaga 1","inledning":"Utöver föreskrifter och förbud i annan lagstiftning är det förbjudet att","inledning_offset":904,"inledning_sidnummer":14,"punkt":"2.","sidnummer":14,"teckenoffset_pa_sidan":1150,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["färdas"],"handlingar":["marken"],"dokument_id":"nvdok-1032904","dokument_namn":"Rättelse_Värnanäs_skärgårdBeslut_gdpr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1032904","dokument_sha256":"8fbb10d564f1b4a9a3b6d77dd5819a9b938b03db9a7cf11a2070d9a0faff9fd6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"3. På fastmarken framföra alla slag av fordon eller farkoster","inledning":"Utöver föreskrifter och förbud i annan lagstiftning är det förbjudet att","inledning_offset":904,"inledning_sidnummer":14,"punkt":"3.","sidnummer":14,"teckenoffset_pa_sidan":1359,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["farkoster","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1032904","dokument_namn":"Rättelse_Värnanäs_skärgårdBeslut_gdpr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1032904","dokument_sha256":"8fbb10d564f1b4a9a3b6d77dd5819a9b938b03db9a7cf11a2070d9a0faff9fd6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4. Framföra svävare, hydrokopter, vattenskoter eller liknande farkost eller åka\nvattenskidor","inledning":"Utöver föreskrifter och förbud i annan lagstiftning är det förbjudet att","inledning_offset":904,"inledning_sidnummer":14,"punkt":"4.","sidnummer":14,"teckenoffset_pa_sidan":1422,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["farkost"],"handlingar":["marken"],"dokument_id":"nvdok-1032904","dokument_namn":"Rättelse_Värnanäs_skärgårdBeslut_gdpr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/