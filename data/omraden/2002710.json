{"nvrid":"2002710","slug":"lilla-alvgangen","namn":"Lilla Älvgången","skyddstyp":"Naturvårdsområde","lager":"naturvardsomrade","karnlager":true,"kommun":"Hedemora","lan":"Dalarnas Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Dalarnas län","tillsynsmyndighet":null,"urspr_beslutsdatum":"1998-01-13","senaste_gallandedatum":"1998-06-17","area_ha":62.86,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2002710","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":true,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"LillaÄlvgången_Beslut_19980113.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045497","dokument_id":"nvdok-1045497","sha256":"98665cf94b63aaa261f98e0cea423dea89d0627dfeffc7be81f445d3c26494a1","sidor":20,"ocr":true,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"Bild_Från_LillaÄlvgången.jpg","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045498","orsak":"ej föreskriftsbärande dokumenttyp"}],"citat":[{"citat":"Naturvårdsverket har tillstyrkt reservatsbildningen men föreslår att en\nsamordning av jaktutövningen bör eftersträvas på frivillig basis för att minska\nstörningen på fågellivet.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att","inledning_offset":764,"inledning_sidnummer":2,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":952,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["störningen","fågellivet"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1045497","dokument_namn":"LillaÄlvgången_Beslut_19980113.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045497","dokument_sha256":"98665cf94b63aaa261f98e0cea423dea89d0627dfeffc7be81f445d3c26494a1","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Jaktvårdsområdesföreningen har goda kontakter med ornitologiska föreningen.\nEnligt Hedemora ornitologiska förening kan jakten inte anses vara av sådan\nbetydelse att den har någon väsentlig påverkan på fågelfaunan. Markägarna i\nområdet gör stora insatser för att främja fågelfaunan och därmed förbättra\njakten. Enligt Brunna-Nibble jaktvårdsområdesförening bedrivs fågeljakt endast\nnär allmänheten inte befinner sig i området.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att","inledning_offset":764,"inledning_sidnummer":2,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":1131,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["fågelfaunan","fågeljakt","stora"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1045497","dokument_namn":"LillaÄlvgången_Beslut_19980113.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045497","dokument_sha256":"98665cf94b63aaa261f98e0cea423dea89d0627dfeffc7be81f445d3c26494a1","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Lilla Älvgången är ett värdefullt våtmarksområde med slåttermark och betade\nstrandängar. Området ingår som del i Hovranområdet som är länets förnämsta\nfågellokal. Sjön Hovran med dess strandängar är av stor betydels som rastlokal\nför sträckande fåglar. Även för häckande slättsjöarter är området viktigt.\nOmrådet hyser dessutom flera rödlistade växtarter.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att","inledning_offset":764,"inledning_sidnummer":2,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":1837,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["fågellokal","fåglar","stor"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1045497","dokument_namn":"LillaÄlvgången_Beslut_19980113.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045497","dokument_sha256":"98665cf94b63aaa261f98e0cea423dea89d0627dfeffc7be81f445d3c26494a1","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Sverige är anslutet till konventionen om våtmarker (Convention on Wetlands),\näven kallad Ramsarkonventionen. Konventionens syfte är att bromsa förstörelsen\nav våtmarker samt att särskilt slå vakt om och främja bevarandet av de värden\nsom är knutna till områden på den så kallade Ramsarlistan, bland annat genom\natt bilda naturreservat och naturvårdsområden. Ramsarlistan omfattar områden\nav internationell betydelse i synnerhet som livsmiljö för våtmarksfåglar.\nHovranområdet är ett av de utpekade 30 svenska våtmarksområden som uppförts\npå Ramsarlistan. Området har dessutom klassats som riksintresse för naturvård","inledning":"Utöver vad som för övrigt gäller är det förbjudet att","inledning_offset":764,"inledning_sidnummer":2,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":2194,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["störelsen","fåglar"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1045497","dokument_namn":"LillaÄlvgången_Beslut_19980113.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045497","dokument_sha256":"98665cf94b63aaa261f98e0cea423dea89d0627dfeffc7be81f445d3c26494a1","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.01648689,60.27092661],[16.01648759,60.27092699],[16.01657082,60.27095344],[16.0167156,60.27097082],[16.01704136,60.27098927],[16.01751896,60.27102505]