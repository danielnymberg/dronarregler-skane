fieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Naturskyddsföreningen i Gagnef efterfrågar ett förbud mot drönare. Vad\ngäller drönare så omfattas de av regler enligt luftfartslagstiftningen.\nLuftrummet vid Harpickön omfattas inte av några restriktioner idag vilket\ninnebär att en vanlig drönare får flygas upp till 120 meters höjd och endast\ninom synhåll från den person som styr drönaren (fjärrpiloten). Länsstyrelsen\nbedömer att de befintliga regler som gäller för drönare är tillräckliga i sin\nomfattning för att drönarflygning inte ska motverka syftet med reservatet.\nOm problem med drönare uppkommer finns möjligheter att införa ytterligare\nföreskrifter i naturreservatet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":10,"teckenoffset_pa_sidan":1386,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"hög","dokument_id":"nvdok-1026151","dokument_namn":"harpickön beslut 20220923.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026151","dokument_sha256":"bd4b62e037b0eab6ad8a4d4a46b139587f2db4f8b56eb689f81663066b5bfff1","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.83889786,60.54174909],[14.83866017,60.54172928],[14.83846754,60.54168155],[14.83846607,60.54168149],[14.83846541,60.54168166],[14.83846475,60.5416821],[14.83852892,60.54261517],[14.83850378,60.54264559],[14.83831483,60.5428705],[14.83832627,60.54303543],[14.83832653,60.54303589],[14.83844201,60.54313505],[14.8387736,60.543