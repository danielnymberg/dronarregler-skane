:null,"sidnummer":7,"teckenoffset_pa_sidan":648,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelliv","stor","förbuden"],"dokument_id":"nvdok-1023794","dokument_namn":"Kopplingskrav för hund infört i 22 reservat 2019.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023794","dokument_sha256":"a60493468238de8f32a0092df50e189178bf83280b6d0f8e3728ea80c2222741","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"i       Det ar förbjudet\n                        att framföra motordrivet fordon inom reservatet annan an p%\n                            anvisade vägar och parkeringsplats, dock att agana till\n                            fastigheterna Villsharad 2: 56 och 2: 144 f%r Sraroföra\n                            fordon p& befintlig utfartsväg från fastigheterna\n                        att parkera p5 annat än därför iordningställda platser.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":525,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbjudet"],"dokument_id":"nvdok-1030008","dokument_namn":"Vilshärad 1302048-6.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1030008","dokument_sha256":"66e27d839d703136f153e67836aaf03fc3c6ab96f4e56e65d6f0130652cd1771","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsen bedömer att särskilda skäl föreligger då\n                  byggnaden är avsedd at uppföras inom tomtplats som\n                  genom befintlig bebyggelse är undandragen allmänhetens\n                  rätt till fritt tillträde. Parkeringsplatsen anordnas\n                  i anslutning till befintlig privat väg.\n                  Lansstyrelsen beviljar därför undantag fran gällande\n                  nybyggnadsförbud enligt 16 5 naturvardslagen för\n                  nybyggnad av receptionsbyggnad samt anordna parke-\n                  ringsplats enligt de ritningar som bifogats ansökan.\n                  Som tomt far nyttjas för byggnaden nödig mark.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":9,"teckenoffset_pa_sidan":1154,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträde","undantag fran"],"dokument_id":"nvdok-1030008","dokument_namn":"Vilshärad 1302048-6.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1030008","dokument_sha256":"66e27d839d703136f153e67836aaf03fc3c6ab96f4e56e65d6f0130652cd1771","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[12.67890909,56.69184658],[12.6789479,56.69188052],[12.67902125,56.6919605],[12.67905683,56.69206292],[12.67906908,56.69212727],[12.67907659,56.69218337],[12.67916994,56.69240221],[12.67927003,56.69260943],[12.67937392,56.69273161],[12.67949821,56.69285261],[12.67959082,56.69295848],[12.67969375,56.69304879],[12.67978423,56.69313141],[12.67983525,56.69316913],[12.67986195,56.6931947],[12.67993938,56.6932325],[12.67997617,56.69327445],[12.67997788,56.6933277],[12.67995942,56.69337268],[12.67999978,56.69341592],[12.68007183,56.69344763],[12.68012106,56.69350793],[12.68019059,56.69354352],[12.68027872,56.69363229],[12.68037476,56.69367303],[12.68054415,56.69370821],[12.68060392,56.69373784],[12.68061647,56.69378695],[12.68062247,56.6938759],[1