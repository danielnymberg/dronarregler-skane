ar verksamhet\nsom inbegrips i den särskilda rätten.\n\nFöreskrifterna skall inte utgöra hinder att för jordbruks-\ndriften eller för reservatets skötsel framföra fordon.","inledning":"Utöver vad som eljest gäller är det förbjudet att","inledning_offset":1249,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":0,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["fordon"],"dokument_id":"nvdok-1015630","dokument_namn":"0602045Bondberget_beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1015630","dokument_sha256":"2dd131ba09e45729af326ab313bb1b45dbd244069eda77ca2d58c11d554b06a8","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.2329516,57.76453447],[14.23300173,57.7653795],[14.23323013,57.76706259],[14.2327532,57.76718194],[14.23170563,57.76735471],[14.23170473,57.76735503],[14.2317044,57.76735538],[14.23168559,57.76739041],[14.23179725,57.76757497],[14.23235256,57.7679366],[14.23261167,57.76830095],[14.23284533,57.76892414],[14.23303963,57.76946599],[14.23345058,57.77053533],[14.23345165,57.77053587],[14.23345311,57.77053582],[14.23364404,57.770484],[14.2339371,57.77034178],[14.23400914,57.77039944],[14.23413312,57.77061355],[14.23420847,57.77083663],[14.23448247,57.77129791],[14.23465886,57.7719267],[14.23457037,57.77193446],[14.23347835,57.77205211],[14.23320851,57.77208233],[14.23182447,57.77220753],[14.23182354,57.77220777],[14.23182312,57.77220807],[14.23182301,57.77220879],[14.23252695,57.77267382],[14.23546228,57.774