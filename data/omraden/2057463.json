{"nvrid":"2057463","slug":"tvaran-vattenskyddsomrade","namn":"Tvärån vattenskyddsområde","skyddstyp":"Vattenskyddsområde","lager":"vattenskyddsomrade","karnlager":false,"kommun":"Älvsbyn","lan":"Norrbottens Län","beslutsstatus":"Gällande","beslutsmyndighet":"Kommun","forvaltare":null,"tillsynsmyndighet":"Kommun","urspr_beslutsdatum":"2021-08-16","senaste_gallandedatum":"2021-08-16","area_ha":33.44,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2057463","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Tvärån skyddsföreskrift.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046146","dokument_id":"nvdok-1046146","sha256":"a517670b8392ea0f21e61cc5ac9562ee32b5045070cab1bea928ff5a94a2d624","sidor":12,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"§2 PETROLEUMPRODUKTER\n\nHantering av sammanlagt mer än 100 liter petroleumprodukter kräver tillstånd av den\nkommunala nämnden för miljöfrågor. Undantag från tillståndskravet gäller för transporter\nav petroleumprodukter samt för drivmedel i fordon, arbetsmaskiner och liknande som är i\nbruk (d.v.s. ej skrotfordon).\n\nAtt i ny eller befintlig verksamhet påbörja lagring av sammanlagt mer än 1 m3 petroleum-\nprodukter är förbjudet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§2","sidnummer":4,"teckenoffset_pa_sidan":2675,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","Undantag från"],"handlingar":["marken"],"dokument_id":"nvdok-1046146","dokument_namn":"Tvärån skyddsföreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046146","dokument_sha256":"a517670b8392ea0f21e61cc5ac9562ee32b5045070cab1bea928ff5a94a2d624","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§11 UPPSTÄLLNING OCH SKÖTSEL AV FORDON OCH MASKINER\n\nTankning eller uppställning, med varaktighet längre än åtta timmar, av arbetsfordon,\narbetsmaskin, tankbil, tankbilssläp eller lös behållare, som innehåller petroleumprodukter,\nannat farligt gods eller annan hälso- eller miljöfarlig produkt är förbjuden. Undantag från\nförbudet gäller om platsen är utrustad med sekundärt skydd.\n\nTvätt av motorfordon med rengöringsmedel är förbjuden, med undantag för tvätt i särskilda\nanläggningar för ändamålet. Avspolning av lera, damm och liknande med vatten är tillåtet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§11","sidnummer":6,"teckenoffset_pa_sidan":762,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motorfordon","FORDON","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1046146","dokument_namn":"Tvärån skyddsföreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046146","dokument_sha256":"a517670b8392ea0f21e61cc5ac9562ee32b5045070cab1bea928ff5a94a2d624","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§16 FRILUFTSAKTIVITETER\n\nTävling med motorfordon är förbjudet.\n\n\n2.6       Sekundär skyddszon","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§16","sidnummer":7,"teckenoffset_pa_sidan":109,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motorfordon","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1046146","dokument_namn":"Tvärån skyddsföreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046146","dokument_sha256":"a517670b8392ea0f21e61cc5ac9562ee32b5045070cab1bea928ff5a94a2d624","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§17 PETROLEUMPRODUKTER\n\nHantering av sammanlagt mer än 250 liter petroleumprodukter kräver tillstånd av den\nkommunala nämnden för miljöfrågor. Undantag från tillståndskravet gäller för transporter\nav petroleumprodukter samt för drivmedel i fordon, arbetsmaskiner och liknande som är i\nbruk (d.v.s. ej skrotfordon).\n\nAtt i ny eller befintlig verksamhet påbörja lagring av sammanlagt mer än 3 m3 petroleum-\nprodukter är förbjudet.\n\nUppställning av förvaringstankar, stationära förbränningsmotorer eller liknande\ninnehållande petroleumprodukter är förbjudet. Undantag från förbudet gäller om sekundärt\nskydd finns eller på hårdgjord yta i ett utrymme inomhus som är under uppsikt och saknar\ngolvbrunn.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§17","sidnummer":7,"teckenoffset_pa_sidan":203,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["fordon","Undantag från"],"handlingar":["marken"],"dokument_id":"nvdok-1046146","dokument_namn":"Tvärån skyddsföreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046146","dokument_sha256":"a517670b8392ea0f21e61cc5ac9562ee32b5045070cab1bea928ff5a94a2d624","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"§24 UPPSTÄLLNING OCH SKÖTSEL AV FORDON OCH MASKINER\n\nTvätt av motorfordon med rengöringsmedel är förbjuden, med undantag för tvätt i särskilda\nanläggningar för ändamålet. Avspolning av lera, damm och liknande med vatten är tillåtet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"§24","sidnummer":8,"teckenoffset_pa_sidan":538,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motorfordon","FORDON","förbjuden"],"handlingar":["marken"],"dokument_id":"nvdok-1046146","dokument_namn":"Tvärån skyddsföreskrift.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046146","dokument_sha256":"a517670b8392ea0f21e61cc5ac9562ee32b5045070cab1