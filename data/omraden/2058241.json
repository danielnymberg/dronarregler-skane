{"nvrid":"2058241","slug":"mjalladalens-naturreservat","namn":"Mjällådalens naturreservat","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Härnösand, Timrå","lan":"Västernorrlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Västernorrlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2022-07-12","senaste_gallandedatum":"2023-05-21","area_ha":413.37,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2058241","svarslage":"reglerat-las-beslutet","luftfartslage":"last-annat","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"beslut mjällådalens utvidgning 2023.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023673","dokument_id":"nvdok-1023673","sha256":"4802873abf93534be68f6381b3722ddc0aef678aae1ed036f2613a137b94f5b6","sidor":13,"ocr":false,"beslutsstatus":"Gällande","fel":null},{"namn":"beslut och skötselplan mjällådalen.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025606","dokument_id":"nvdok-1025606","sha256":"862dbc506f6c0eaf3db280bae5974a11188ee825d1dc1f557da3f980acef00f7","sidor":21,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"9. framföra motordrivet fordon annat än på väg/traktorväg. Förbudet\n                                  gäller inte snöskoter på snötäckt mark på skoterled (se karta). Inte\n                                  heller gäller det uttransport av fällt högvilt med fyrhjuling eller\n                                  motsvarande. I dagsläget gäller dock terrängkörningsförordningen\n                                  (1978:594) i reservatet vilket innebär att endast högvilt i form av älg,\n                                  björn, kronhjort, dovhjort och vildsvin kan föras ut.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":2485,"inledning_sidnummer":2,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":1086,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","Förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1023673","dokument_namn":"beslut mjällådalens utvidgning 2023.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023673","dokument_sha256":"4802873abf93534be68f6381b3722ddc0aef678aae1ed036f2613a137b94f5b6","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"5. framföra cykel och häst annat än på befintlig väg.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1880,"inledning_sidnummer":4,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":2649,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["framföra"],"handlingar":["marken"],"dokument_id":"nvdok-1023673","dokument_namn":"beslut mjällådalens utvidgning 2023.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023673","dokument_sha256":"4802873abf93534be68f6381b3722ddc0aef678aae1ed036f2613a137b94f5b6","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"12. framföra motordrivet fordon annat än på väg/traktorväg. Förbudet\n                                   gäller inte snöskoter på snötäckt mark på skoterled (se karta).","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1880,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":602,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","Förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1023673","dokument_namn":"beslut mjällådalens utvidgning 2023.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023673","dokument_sha256":"4802873abf93534be68f6381b3722ddc0aef678aae1ed036f2613a137b94f5b6","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"C. Föreskrifter enligt 7 kap. 30 § miljöbalken om rätten att färdas och vistas\ninom reservatet samt om ordningen i övrigt inom reservatet.\n\nUtöver vad som för övrigt gäller är det förbjudet att:\n  1 fälla eller på annat sätt skada levande eller döda, stående eller omkullfallna, träd\n    och buskar.\n  2 uppföra anläggning, såsom vindskydd, koja, bänk, spång, bro, stängsel, ledning,\n    mast eller torn.\n  3 genom grävning eller på annat sätt skada mark eller vattenmiljöer.\n  4 plocka, gräva upp eller på annat sätt ta bort mossor, lavar eller svampar, med\n    undantag för plockning av marklevande mat- och färgsvampar och bär.\n  5 framföra cykel och häst annat än på befintlig väg.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":320,"inledning_sidnummer":3,"punkt":"C.","sidnummer":4,"teckenoffset_pa_sidan":1207,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["framföra","färdas","vistas","förbjudet"],"handlingar":["marken"],"dokument_id":"nvdok-1025606","dokument_namn":"beslut och skötselplan mjällådalen.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025606","dokument_sha256":"862dbc506f6c0eaf3db280bae5974a11188ee825d1dc1f557da3f980acef00f7","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Föreskrifterna ska inte utgöra hinder för fastighetsägaren av Tuna 1:4 att ta ut 10 granar per\når inom utritat område (karta Tuna 1:4) till och med 2043 samt att ta ut bäverfällda träd\ninom hela fastigheten till och med 2048. Motordrivet fordon får användas för uttaget av\nträd. Fordon och färdväg ska väljas med omsorg för att minimera mark- och\nvegetationsskador.","inledning":"Utöver vad som för övrigt gäller är det förbjudet att:","inledning_offset":1347,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":2276,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["Motordrivet","fordon","Fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1025606","dokument_namn":"beslut och skötselplan mjällådalen.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1025606","dokument_sha256":"862dbc506f6c0eaf3db280bae5974a11188ee825d1dc1f557da3f980acef00f7","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.39215154,62.67689821],[17.39002112,62.67701755],[17.39002,62.67701777],[17.39001949,62.67701806],[17.38946134,62.67924584],[17.38946156,62.6792462],[17.3894624,62.67924661],[17.389464,62.67924672],[17.39243037,62.678913],[17.39247862,62.67951036],[17.39314428,62.68045516],[17.39315591,62.68059848],[17.39342662,62.68137458],[17.39349468,62.68178767],[17.3928883,62.68243539],[17.39251524,62.68296776],[17.39280002,62.68348873],[17.39326049,62.68403858],[17.39339657,62.68486459],[17.39339684,62.684865],[17.39399005,62.68534826],[17.3939913,62.68534872],[17.39496552,62.6853958],[17.39604115,62.68540929],[17.39689551,62.68527888],[17.39761649,62.68527657],[17.39806864,62.68537322],[17.39824673,62.68601455],[17.39859032,62.68691131],[17.39968181,62.68787849],[17.39968264,62.68787889],[17.39968421,62.687879],[17.40129503,62.68770375],[17.40253399,62.68746731],[17.40372755,62.68739708],[17.40464345,62.68757262],[17.40550307,62.68786979],[17.40487774,62.68851649],[17.40432276,62.68906595],[17.40407571,62.69063804],[17.4055