 jakt och friluftsliv i\nområdet. Naturreservatet är viktigt för rekreation och rörligt friluftsliv, vilket\nredan i tidigare beslut är en del av syftet med reservatet. Länsstyrelsen bedömer","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":10,"teckenoffset_pa_sidan":1978,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivna","fordon","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1015726","dokument_namn":"BESLUT_inscannat.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1015726","dokument_sha256":"9cea80bd09f4b9b98c379be601a3429f897a10de9995d8949440196fa1150b36","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.62997617,61.67523343],[14.62997587,61.67523414],[14.63079589,61.67736904],[14.63079679,61.67736968],[14.63632144,61.67909655],[14.63632235,61.67909661],[14.63880494,61.67899718],[14.63971224,61.67926707],[14.64134562,61.67946742],[14.64134686,61.67946739],[14.64134784,61.67946703],[14.6423603,61.67878632],[14.64380515,61.67884992],[14.64380629,61.67884982],[14.65081393,61.67625935],[14.6530501,61.67459223],[14.65626672,61.67386524],[14.658559,61.67294798],[14.65855945,61.67294747],[14.65855939,61.6729471],[14.65855878,61.67294663],[14.65855811,61.67294643],[14.65760381,61.67277769],[14.6569986,61.67175568],[14.65946778,61.6715457],[14.66133071,61.67175972],[14.66240694,61.67213062],[14.66240817,61.6721308],[14.66240902,61.67213071],[14.66534593,61.67149208],[14.66683428,61.67114119],[