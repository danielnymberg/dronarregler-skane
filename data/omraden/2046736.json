{"nvrid":"2046736","slug":"agnmyren","namn":"Agnmyren","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Mora","lan":"Dalarnas Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Dalarnas län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2018-10-23","senaste_gallandedatum":"2018-11-26","area_ha":3.29,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2046736","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Agnmyren_Beslut_20181023.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1015031","dokument_id":"nvdok-1015031","sha256":"934506b6fb0264fe0526941fd8abc9dafd99934c3fb86441c250f73292097a14","sidor":25,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"Bild_Från_Agnmyren.jpg","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1024169","orsak":"ej föreskriftsbärande dokumenttyp"}],"citat":[{"citat":"6. framföra motordrivet fordon i terrängen, gäller både barmark och snötäckt\n   mark, med följande undantag:\n         fälld älg, björn, hjort eller vildsvin får transporteras ut. Körvägar ska\n            väljas med omsorg för att minimera mark- och vegetationsskador,\n         tjänstemän i sjukvårds-, polis- eller räddningsärende. Insatsen ska\n            omgående anmälas till Länsstyrelsen,","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att:","inledning_offset":2101,"inledning_sidnummer":2,"punkt":"6.","sidnummer":3,"teckenoffset_pa_sidan":185,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1015031","dokument_namn":"Agnmyren_Beslut_20181023.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1015031","dokument_sha256":"934506b6fb0264fe0526941fd8abc9dafd99934c3fb86441c250f73292097a14","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4. framföra motordrivet fordon i terrängen, gäller både barmark och snötäckt\n   mark,","inledning":"Utöver föreskrifter och förbud i andra lagar och författningar är det förbjudet att:","inledning_offset":1743,"inledning_sidnummer":3,"punkt":"4.","sidnummer":3,"teckenoffset_pa_sidan":1980,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1015031","dokument_namn":"Agnmyren_Beslut_20181023.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1015031","dokument_sha256":"934506b6fb0264fe0526941fd8abc9dafd99934c3fb86441c250f73292097a14","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Terrängkörning på barmark regleras i huvudsak i terrängkörningslagen och utvecklas i\nföreskrift A6 och C4. Föreskriften syftar till att minimera skador på mark och vegetation.\nDetta innebär att det är ytterst sällan som terrängkörning på barmark är möjlig i\nvåtmarksmiljöer. I detta fall utgörs stora delar av naturreservatets naturvärden av\nområden med vatten och förkastningsbrant vilket innebär att skoterkörning därför är\nförbjudet även på snötäckt mark inom reservatsområdet. Avvägningen bedöms tillgodose\njaktintresset, friluftslivets intressen och behovet av skydd för mark och vegetation.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":2862,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1015031","dokument_namn":"Agnmyren_Beslut_20181023.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1015031","dokument_sha256":"934506b6fb0264fe0526941fd8abc9dafd99934c3fb86441c250f73292097a14","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla"