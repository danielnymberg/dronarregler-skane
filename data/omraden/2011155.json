ing_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":828,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelskyddsområden","större","förbud"],"dokument_id":"nvdok-1046099","dokument_namn":"beslut om fågelskyddsområden feb 2023 nvr.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046099","dokument_sha256":"a4b10c09bb0a3e3648dd9080b06291751ca689ffe7612f6d14b393158c08a4f2","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"1. beträda mark årligen under tiden 1/4 - 15/7 inom områden som anges med gul\n              begränsningslinje på bifogade kartor;","inledning":"Inom fågelskyddsområdena är det förbjudet att:","inledning_offset":1045,"inledning_sidnummer":1,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":1104,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["beträda"],"dokument_id":"nvdok-1039366","dokument_namn":"Beslut fso skärgård dec 2012.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1039366","dokument_sha256":"562411c2a72746567b3ea9682226b3e1535fe6dfaedbd9c0eb660803a22ab67b","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"2. beträda mark eller komma närmare strand än 100 meter årligen under tiden 1/4 -\n              31/7 inom områden som anges med orange begränsningslinje respektive 1/2 - 15/8\n              inom områden som anges med röd begränsningslinje på bifogade kartor;","inledning":"Inom fågelskyddsområdena är det förbjudet att:","inledning_offset":1045,"inledning_sidnummer":1,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":1249,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["beträda"],"dokument_id":"nvdok-1039366","dokument_namn":"Beslut fso skärgård dec 2012.pdf","dokument_url":"https://geodata.naturvardsverket.