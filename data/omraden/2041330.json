{"nvrid":"2041330","slug":"hornafjarden","namn":"Hornafjärden","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Gnesta, Nyköping","lan":"Södermanlands Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Södermanlands län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2014-03-24","senaste_gallandedatum":"2014-05-06","area_ha":254.84,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2041330","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Horna_tot_webversion.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026533","dokument_id":"nvdok-1026533","sha256":"4870d7cfae1a6033319f1a3d0eed1a0e84e2eedb78d88a70de3ab40d8f4159ed","sidor":24,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"8. framföra motordrivet fordon annat än i samband med uttransport av fällt\n       vilt med s.k. älgdragare eller motsvarande.","inledning":"författningar är det förbjudet att:","inledning_offset":1722,"inledning_sidnummer":2,"punkt":"8.","sidnummer":2,"teckenoffset_pa_sidan":2041,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivet","fordon"],"dokument_id":"nvdok-1026533","dokument_namn":"Horna_tot_webversion.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026533","dokument_sha256":"4870d7cfae1a6033319f1a3d0eed1a0e84e2eedb78d88a70de3ab40d8f4159ed","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4.    fånga och insamla ryggradslösa djur på sådant sätt att deras biotoper eller\n       reproduktionsmiljöer skadas eller förstörs.","inledning":"det förbjudet att:","inledning_offset":930,"inledning_sidnummer":3,"punkt":"4.","sidnummer":3,"teckenoffset_pa_sidan":1279,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["störs","djur"],"dokument_id":"nvdok-1026533","dokument_namn":"Horna_tot_webversion.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026533","dokument_sha256":"4870d7cfae1a6033319f1a3d0eed1a0e84e2eedb78d88a70de3ab40d8f4159ed","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsen kommer inte i detta läge att förbjuda de uppräknade aktiviteterna som\n    ger störningar för fågellivet. År 2011 gjordes en översyn och ändringar av\n    fågelskyddsområdena i Båven för att anpassa skyddet till det aktuella behovet.\n    Syftet med dessa områden är att skydda bland annat fiskgjuse och storlom från\n    störningar av det rörliga friluftslivet under häckningstid. Länsstyrelsen ser ett behov\n    av att ta ett samlat tag för hela Båven när det gäller störningar i förhållande till\n    naturvärdena. Ett eventuellt förbud av olika aktiviteter måste dock föregås av en\n    närmare utredning för att avgöra vad som behövs för att bevara ett rikt fågelliv.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":6,"teckenoffset_pa_sidan":1545,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelskyddsområdena","häckningstid","störningar","förbjuda"],"dokument_id":"nvdok-1026533","dokument_namn":"Horna_tot_webversion.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026533","dokument_sha256":"4870d7cfae1a6033319f1a3d0eed1a0e84e2eedb78d88a70de3ab40d8f4159ed","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Slitage och störningskänslighet\nOmrådet påverkas under sommarhalvåret av viss störning från friluftslivet. Dels gäller det\nbuller från motorbåtar och vattenskotrar, dels båttrafiken i sig, vilket kan innebära störning av\nvissa fågelarters häckning. Då några öar är försedda med tillträdesförbud har risken för störning\nav särskilt känsliga fåglar minimerats. På öar med strandpartier där det finns badmöjligheter\nsamt på klippor med känslig lavflora och goda förankringsmöjligheter för båtar är slitaget något\nstörre. Inne på öarna är det orört, bitvis ganska svårframkomligt och fritt från skador på mark\noch vegetation.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":17,"teckenoffset_pa_sidan":1530,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["störningskänslighet","fågelarters","störning","förbud"],"dokument_id":"nvdok-1026533","dokument_namn":"Horna_tot_webversion.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026533","dokument_sha256":"4870d7cfae1a6033319f1a3d0eed1a0e84e2eedb78d88a70de3ab40d8f4159ed","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Loviseskär är en flack holme med tät lövskog. Ön är tillsammans med det närliggande skäret\nPersbyx fågelskyddad och får ej beträdas mellan 1 april – 31 juli.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":19,"teckenoffset_pa_sidan":1332,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["beträdas","får ej"],"dokument_id":"nvdok-1026533","dokument_namn":"Horna_tot_webversion.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026533","dokument_sha256":"4870d7cfae1a6033319f1a3d0eed1a0e84e2eedb78d88a70de3ab40d8f4159ed","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Häradsholmen är en liten gränsholme, där tre kommuner, fyra församlingar och fem markägare\nmöts. Större delen av holmen ingår i reservatet, endast en kil i väster ligger utanför. Ön består\nav hällmark med låg och gles tallskog. Ön med närliggande vattenområde är fågelskyddad och\nfår ej beträdas mellan 1 april – 31 juli.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":20,"teckenoffset_pa_sidan":1553,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelskyddad","Större","får ej"],"dokument_id":"nvdok-1026533","dokument_namn":"Horna_tot_webversion.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1026533","dokument_sha256":"4870d7cfae1a6033319f1a3d0eed1a0e84e2eedb78d88a70de3ab40d8f4159ed","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.04061146,59.01810596],[17.03934764,59.02367235],[17.03931074,59.02722007],[17.03931105,59.0272206],[17.03931186,59.02722097],[17.03931294,59.02722105],[17.05039503,59.02638154],[17.0503958,59.02638138],[17.05039638,59.02638108],[17.05676352,59.02105606],[17.05707634,59.02055322],[17.05849246,59.01775522],[17.05849236,59.01775484],[17.05849172,59.01775438],[17.05849106,59.01775421],[17.05848995,59.01775422],[17.05808304,59.01782214],[17.05012635,59.01406597],[17.0530437,59.01283819],[17.06020174,59.00982887],[17.06020244,59.00982819],[17.060202,59.00982746],[17.06020068,59.00982712],[17.04712055,59.00929697],[17.04570171,59.00663764],[17.04574798,59.00537769],[17.04574766,59.00537713],[17.04574642,59.0053767],[17.04158299,59.00496316],[17.04158191,59.00496334],[17.04158138,59.00496363],[17.03457498,59.01078195],[17.0264924,59.01460806],[17.02649179,59.01460869],[17.02752817,59.02083382],[17.02752855,59.02083433],[17.02752939,59.020