,"inledning_offset":2185,"inledning_sidnummer":4,"punkt":"C.","sidnummer":5,"teckenoffset_pa_sidan":1656,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1019356","dokument_namn":"Sölvesborgsviken beslut uppdaterat 171220, undertecknat.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019356","dokument_sha256":"c650323a4b21ec2bd50deb1d45607bddd1f20999df50e5d57833f858720f6bd6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Redan på 1930-talet uppmärksammande Kungliga Svenska Vetenskapsakademien\nSölvesborgsvikens rika fågelliv och gjorde framställan om skydd av området till\nlänsstyrelsen. Länsstyrelsen förklarade den 2 maj 1939, med stöd av då gällande lag\nangående naturminnesmärkens fredande, att fågellivet inom ett större område runt viken\nskulle utgöra ”fridlyst naturminnesmärke”. Enligt övergångsbestämmelserna till\nnaturvårdslagen (SFS 1964:822) omvandlades området till naturreservat. Samma syfte\noch föreskrift som gällde för naturminnesmärket kom att gälla för naturreservatet. Sedan\nlänge har det funnits behov av att förnya bestämmelserna för området.","inledning":"Vidare är det förbjudet att utan länsstyrelsens tillstånd:","inledning_offset":7,"inledning_sidnummer":6,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":779,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1019356","dokument_namn":"Sölvesborgsviken beslut uppdaterat 171220, undertecknat.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019356","dokument_sha256":"c650323a4b21ec2bd50deb1d45607bddd1f20999df50e5d57833f858720f6bd6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Sedan länsstyrelsen 2003-08-28 begärt yttrande över förslag att införliva\nSölvesborgsviken i nätverket Natura 2000 enligt EU:s fågeldirektiv inkom Sölvesborgs\nkommun 2003-10-20 med ett förslag till avgränsning av området. Avsikten var att\ngränsen för Natura 2000 och naturreservatet skulle sammanfalla. Den föreslagna\nreservatsgränsen omfattade dock ett något större område än Natura 2000-området. 2004\nfattade regeringen beslut om att Sölvesborgsviken skulle ingå i Natura 2000 enligt\nfågeldirektivet (SE0410259 Sölvesborgsviken).","inledning":"Vidare är det förbjudet att utan länsstyrelsens tillstånd:","inledning_offset":7,"inledning_sidnummer":6,"punkt":null,"sidnummer":7,"teckenoffset_pa_sidan":1999,"klassificering":"störningsförbud-djurliv","konfidens":"medel","dokument_id":"nvdok-1019356","dokument_namn":"Sölvesborgsviken beslut uppdaterat 171220, undertecknat.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019356","dokument_sha256":"c650323a4b21ec2bd50deb1d45607bddd1f20999df50e5d57833f858720f6bd6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[14.59264992,56.04318508],[14.59341502,56.04298294],[14.59358739,56.0429842],[14.59430781,56.04294449],[14.59501067,56.04268075],[14.59578654,56.04254456],[14.59703393,56.04229927],[14.59794248,56.04199321],[14.59903173,56.04152487],[14.60020012,56.04086529],[14.60105586,56.04012114],[14.60124653,56.03961103],[14.60172413,56.03891861],[14.60181642,56.03859988],[14.60188195,56.03860683],[14.60202945,56.03856687],[14.60231708,56.03860651],[14.60249405,56.03860921],[14.6026603,56.03858668],[14.60289772,56.0386183],[14.60322738,56.03865116],[14.60322866,56.03865101],[14.6032293,56.0386506