arit mest Önskvärt. För att uppnå ett till-\nräckligt hårt betestryck och en lämpligare beteseffekt på\nsjälva strandängen skulle man kunna resa ett provisoriskt\nelstängsel väster om stigen och låta nöt, eventuellt tillsam-\nmans med får, beta på strandängen under den tid då beträd-\nnadsförbud gäller och allmänheten ändå inte har tillträde\ntill området.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":14,"teckenoffset_pa_sidan":0,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträde","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1021288","dokument_namn":"brucebo-beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021288","dokument_sha256":"17074ad96624d699e5ea06cd1d2b7580f93b0b429daeaffc5612403a1ad9a6a6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Ett skyltställ med informationsskyltar samt en enklare skylt\nmed information om området med tillträdesförbud skall sättas\nupp på de platser som angivits på kartan, bilaga 4.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":15,"teckenoffset_pa_sidan":1545,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["tillträdesförbud","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1021288","dokument_namn":"brucebo-beslut.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1021288","dokument_sha256":"17074ad96624d699e5ea06cd1d2b7580f93b0b429daeaffc5612403a1ad9a6a6","ocr":true,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4. Skansudden jämte inre delen av Skansuddsviken får ej beträdas under\ntiden 15 aprtil-15 juli till skydd för fågellivet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"4.","sidnummer":28,"teckenoffset_pa_sidan":2303,"klass