dning_offset":955,"inledning_sidnummer":9,"punkt":"7.","sidnummer":9,"teckenoffset_pa_sidan":1481,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurlivet","störa"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1022383","dokument_namn":"Beslut Emsfors-Karlshammar med bilagor - GDPR.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1022383","dokument_sha256":"ab790677771f294d5c0f1b8c9d0dabfcb3d25c2196656dec3cafa8fadbc0e22d","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Havs- och vattenmyndigheten tycker förslaget är väl genomarbetat och tillstyrker bildan-\ndet av naturreservatet. Myndigheten påtalar att området har mycket höga akvatiska vär-\nden, är nationellt utpekat som särskilt värdefullt och att det är angeläget att området\nskyddas. Myndigheten föreslår att Länsstyrelsen reglerar alla typer av farkoster i vatten\ngenom hastighetsbegränsning i enlighet med Sjötrafikförordningen istället för att före-\nskriva förbud mot vissa vattenfarkoster. Länsstyrelsens kommentar: Länsstyrelsen delar\nHavs- och vattenmyndighetens uppfattning gällande föreskrift för farkoster i vattenområ-\ndet och justerar berörd föreskrift.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":13,"teckenoffset_pa_sidan":1266,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["farkoster","förbud"],"handlingar":["marken"],"dokument_id":"nvdok-1022383","dokument_namn":"Beslut Emsfors-Karlshammar med bilagor - GDPR.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1022383","dokument_sha256":"ab790677771f294d5c0f1b8c9d0dabfcb3d25c2196656dec3cafa8fadbc0e22d","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Forsnackar i höjd med Villan har tidigare biotopvårdats, men mängden lekgrus bedöms\ndock som sparsam. Som åtgärd bör tillförsel av lekgrus göras från land med maskin, al-\nternativt med helikopter. Lekgrus om 10-15 kubikmeter placeras uppe på nackarna i båda\nfårorna. För att lekgrus ska ligga kvar kan större sten och block även behöva läggas ut.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":42,"teckenoffset_pa_sidan":3104,"klassificering":"uttryckligt-luftfartygsförbud","konfidens":"låg","traffade_ord":["helikopter"],"handlingar":["flyga"],"dokument_id":"nvdok-1022383","dokument_namn":"Beslut Emsfors-Karlshammar med bilagor - GDPR.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1022383","dokument_sha256":"ab790677771f294d5c0f1b8c9d0dabfcb3d25c2196656dec3cafa8fadbc0e22d","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.37780547,57.16380124],[16.37704506,57.16395347],[16.37704452,57.16395394],[16.37704453,57.16395449],[16.37704485,57.16395482],[16.3787635,57.16513402],[16.37876441,57.16513436],[16.37876514,57.16513439],[16.38009825,57.16471545],[16.38200069,57.163244],[16.38413934,57.16347255],[16.38414006,57.16347255],[16.38414101,57.16347226],[16.38414149,57.16347174],[16.38451227,57.16217929],[16.38464216,57.16087987],[16.38469985,57.15967411],[16.38869298,57.15971008],[16.39300125,57.15942417],[16.39306365,57.15962557],[16.39306771,57.15988167],[16.39304094,57.16011321],[16.39296753,57.16027881],[16.39265437,57.16066862],[16.3924749,57.1608595],[16.39128386,57.16151788],[16.39086217,57.16178431