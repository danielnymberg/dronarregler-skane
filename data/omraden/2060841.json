rifter enligt\n7 kap. 30 § miljöbalken\nEnligt förordningen (2007:1244) om konsekvensutredning vid\nregelgivning ska en bedömning om konsekvensutredning göras för\nordningsföreskrifterna enligt 7 kap. 30 § miljöbalken. Dessa föreskrifter\ngäller rätten att färdas och vistas, och ordningen i övrigt i området och\nexemplifieras i förarbetena till miljöbalken (prop. 1997/98:45) som\nförbud mot åtgärder som annars hade varit tillåtna enligt\nallemansrätten.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":20,"teckenoffset_pa_sidan":1513,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","vistas","förbud"],"dokument_id":"nvdok-1023518","dokument_namn":"beslut och skötselplan för gájbienåjvvie naturreservat utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1023518","dokument_sha256":"cc58e151fa468d03b5fd62022afa3ab680e1ec7ce27db1782a29a2f062601164","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[17.32470197,65.5848837],[17.32364026,65.58636614],[17.32173833,65.58743556],[17.32202564,65.58872771],[17.32202596,65.58872812],[17.32399686,65.58959541],[17.32399843,65.58959572],[17.33028441,65.58928699],[17.33616281,65.59202131],[17.33616406,65.59202161],[17.33616552,65.59202156],[17.3564317,65.58621195],[17.35643238,65.58621127],[17.35643175,65.58621059],[17.35347708,65.58488508],[17.36180546,65.58211731],[17.36450704,65.5807133],[17.36660371,65.57950122],[17.37078941,65.57985631],[17.37272243,65.58041833],[