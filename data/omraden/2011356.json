{"nvrid":"2011356","slug":"bussan-skorvan-och-intlig-oar-zon-1","namn":"Bussan, Skorvan och intlig öar Zon 1","skyddstyp":"Djur- och växtskyddsområde","lager":"djur-och-vaxtskydd","karnlager":true,"kommun":"Västervik","lan":"Kalmar Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Kalmar län","tillsynsmyndighet":null,"urspr_beslutsdatum":"1973-03-30","senaste_gallandedatum":"2023-01-12","area_ha":34.39,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2011356","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"10/7"}],"sasongsdata":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Övrigt","foreskriftstypKod":"2","foreskriftssubtypKod":"4","franDatum":"1/4","tillDatum":"10/7"}],"dokument":[{"namn":"beslut_bussan skorvan intilliggande öar.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046421","dokument_id":"nvdok-1046421","sha256":"436c865e27fa3ed49cee37b180ab65e703c21979436911dba502723dedb31f89","sidor":6,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[{"namn":"11.131-588-71 Skärgårdsområden i Västerviks och Oskarshamns kommuner -GDPR.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045749","orsak":"namnet matchar inget föreskriftsmönster"}],"citat":[{"citat":"Bildande av djur- och växtskyddsområde till skydd för\n         fågellivet vid Bussan, Skorvan och intilliggande öar,\n         Västerviks kommun, Kalmar län\n         Beslutet innebär en ändring av det befintliga fågelskyddsområdet, där tillträdesförbudsperioden\n         förlängs för Skorvan.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":305,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1046421","dokument_namn":"beslut_bussan skorvan intilliggande öar.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046421","dokument_sha256":"436c865e27fa3ed49cee37b180ab65e703c21979436911dba502723dedb31f89","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Länsstyrelsen har rätt att utföra förvaltning som röjning och skyltning om tillträdesförbudet\n         enligt § 10 i Förordning (1998:1252) om områdesskydd, miljöbalken.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":1,"teckenoffset_pa_sidan":921,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1046421","dokument_namn":"beslut_bussan skorvan intilliggande öar.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046421","dokument_sha256":"436c865e27fa3ed49cee37b180ab65e703c21979436911dba502723dedb31f89","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Redogörelse för ärendet\nÖarna skyddades som fågelskyddsområden 1973 med ett tillträdesförbud mellan 1 april och 10\njuli. Detta ansågs vid tidpunkten vara tillräckligt med hänsyn till häckande fågel i området.\nUnder åren har skräntärnornas häckningar löpande dokumenterats inom området. Sentida\ninventeringar och dokumentationer visar att skräntärnornas häckning fortfarande pågår i stor\nomfattning flera veckor efter den 10 juli och att störningar inverkar negativt i alla\nhäckningsstadier. Misslyckas första häckningen hos skräntärnan så börjas en ny och därför\nförekommer häckning och ungar sent under sommaren.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":1833,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1046421","dokument_namn":"beslut_bussan skorvan intilliggande öar.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046421","dokument_sha256":"436c865e27fa3ed49cee37b180ab65e703c21979436911dba502723dedb31f89","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"2021 inkom en begäran om förlängning av tillträdesförbudet från Projekt Skräntärnans\nVästerviksgrupp som på uppdrag av länsstyrelsen genomfört fågelinventering under sommaren.\nI begäran nämns att vid den 10 juli, efter att skyddstiden upphört, förekom häckning i stor\nomfattning i alla stadier. Intrång av besökare har även konstaterats på ön Bussan under\nmidsommarhelgen vilket faller inom tidsintervallet för nuvarande tillträdesförbud.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":2448,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1046421","dokument_namn":"beslut_bussan skorvan intilliggande öar.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046421","dokument_sha256":"436c865e27fa3ed49cee37b180ab65e703c21979436911dba502723dedb31f89","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"I samtal med styrelsen för bysamfälligheten framkom önskemål om att inte ändra tidsperioden\nför tillträdesförbudet på Bussan men att de inte ser några som helst hinder att förlänga\ntidsperioden för Skorvan och alla intilliggande öar. Detta för att Bussan har ett stort värde för\nmånga av personerna i samfälligheten som nyttjar Bussan efter att tillträdesförbudet har upphört\nunder sommaren. Länsstyrelsen såg inga hinder med att dela upp området i två zoner med olika\nlånga tillträdesförbud då häckningen av skräntärna förekommer på Skorvan och de fågelarter\nsom återfinns på Bussan är färdiga med sin häckning 10 juli.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":3,"teckenoffset_pa_sidan":3097,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1046421","dokument_namn":"beslut_bussan skorvan intilliggande öar.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046421","dokument_sha256":"436c865e27fa3ed49cee37b180ab65e703c21979436911dba502723dedb31f89","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"BESLUT                                           4 (6)\n\n                                                            2022-12-09                             511-5088-2022\n\n\n\n\n2 fram till den 15 augusti. Zon 1 behåller nuvarande avgränsning i tid för tillträdesförbudet\nmellan 1 april och 10 juli.\n\nFörslaget till beslut har remitterats till Händelöp samfällighetsförening, Västerviks kommun,\nNaturvårdsverket, Havs-och vattenmyndigheten, Försvarsmakten, Mellersta Götalands\njordägarförbund, Naturskyddsföreningen i Kalmar län, Jägareförbundet Kalmar Län, Projekt\nSkräntärnans, Tjust Fågelklubb, Östra Smålands Ornitologiska förening.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":60,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1046421","dokument_namn":"beslut_bussan skorvan intilliggande öar.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046421","dokument_sha256":"436c865e27fa3ed49cee37b180ab65e703c21979436911dba502723dedb31f89","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Beslutskarta\nZon 1 markeras i rött på karta 1 och tillträdesförbudet gäller 1 april till 10 juli årligen.\nZon 2 markeras i gult på karta 1 och tillträdesförbudet gäller 1 april till 15 augusti årligen.\nGeografisk lokalisering av området markeras med röd fyrkant i karta 2.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":234,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1046421","dokument_namn":"beslut_bussan skorvan intilliggande öar.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046421","dokument_sha256":"436c865e27fa3ed49cee37b180ab65e703c21979436911dba502723dedb31f89","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Tillträdesförbud årligen\n                                                              Zon 1: 1/4–10/7\n                                                              Zon 2: 1/4–15/8\n                                                              Geografisk lokalisering","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":570,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1046421","dokument_namn":"beslut_bussan skorvan intilliggande öar.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1046421","dokument_sha256":"436c865e27fa3ed49cee37b180ab65e703c21979436911dba502723dedb31f89","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[16.76632126,57.66142695],[16.76661666,57.66135286],[16.766918,57.66135057],[16.76843999,57.66157243],[16.76880879,57.66156964],[16.76959159,57.66138401],[16.77003023,57.66118309],[16.7703