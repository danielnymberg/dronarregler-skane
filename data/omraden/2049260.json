ffset":573,"inledning_sidnummer":2,"punkt":"1.","sidnummer":2,"teckenoffset_pa_sidan":648,"klassificering":"annat-läs-beslutet","konfidens":"medel","traffade_ord":["färdas"],"handlingar":["marken"],"dokument_id":"nvdok-1045000","dokument_namn":"Komplett Beslut Skåarnja fågelskyddsområde utan sändlista 2021-04-19.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045000","dokument_sha256":"627753a0546effd3938340c4592580bdcf5f2334ad8eadb9843826d43069aa60","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"d) markerad led från Vildmarksvägen till sjön övre Raavrejaevrie markerad i\n      karta, bilaga 1. Innehavare av giltigt fiskekort får nyttja leden i samband\n      med fiske under upplåtelsetid som sammanfaller med\n      beträdnadsförbudet. Vidare gäller att innehavare av fiskekort får beträda\n      isen samt vid isfritt vatten beträda stranden men inte avvika mer än 100\n      meter från vattenlinjen.\nFöreskrifterna ska inte utgöra något hinder för att bedriva renskötsel i enlighet\nmed rennäringslagen (1971:437), framföra motordrivet fordon vid renskötsel\nenligt undantag i terrängkörningsförordningen (1978:594) eller vid skyddsjakt på\nrovdjur enligt jaktförordningen (1987:905).","inledning":"Inom området råder förbud att under perioden 10 juni till och med 10 juli:","inledning_offset":573,"inledning_sidnummer":2,"punkt":"d)","sidnummer":2,"teckenoffset_pa_sidan":1008,"klassificering":"motorfordon-möjligen-relevant","konfidens":"hög","traffade_ord":["motordrivet","fordon","förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1045000","dokument_namn":"Komplett Beslut Skåarnja fågelskyddsområde utan sändlista 2021-04-19.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045000","dokument_sha256":"627753a0546effd3938340c4592580bdcf5f2334ad8eadb9843826d43069aa60","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Motivering till beslutet\nLänsstyrelsens bedömning är att fågellivet i området har ett högt skyddsvärde\noch att ett beslut om ett fågelskyddsområde behövs för att värna olika fågelarter\noch skydda deras häckning inom ett lättillgängligt fjällområde. Länsstyrelsen\nbedömer att ett beträdnadsförbud från 10 juni till 10 juli är nödvändigt för att en\nallmänhet inte ska störa häckande fåglar, för att området inte ska vara\ntillgängligt för ägg- och boplundrare, samt för att möjliggöra effektiv tillsyn av\nfågelskyddsområdet.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":276,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelskyddsområdet","fågelskyddsområde","fågellivet","förbud"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1045000","dokument_namn":"Komplett Beslut Skåarnja fågelskyddsområde utan sändlista 2021-04-19.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045000","dokument_sha256":"627753a0546effd3938340c4592580bdcf5f2334ad8eadb9843826d43069aa60","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Fågelskyddsområdets föreskrifter tillåter inte att området utanför vägbanan\nbeträds, med undantag för väghållaren i samband med underhåll av vägen.\nOmrådet närmast vägbanan blir tidigt snöfritt och där har många fåglar sin\nhäckning. Förutom att färdas på Vildmarksvägen är det tillåtet att stanna till på\nparkerings- och informationsplatser invid vägen. Undantaget från\nbeträdnadsförbudet är också en vandringsled från Vildmarksvägen till\nBørgefjells Nationalpark på den norska sidan och en vandringsled från\nVildmarksvägen till Skårnja.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":799,"klassificering":"annat-läs-beslutet","konfidens":"hög","traffade_ord":["färdas","förbudet"],"handlingar":["marken"],"dokument_id":"nvdok-1045000","dokument_namn":"Komplett Beslut Skåarnja fågelskyddsområde utan sändlista 2021-04-19.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045000","dokument_sha256":"627753a0546effd3938340c4592580bdcf5f2334ad8eadb9843826d43069aa60","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Naturvårdsverket tillstyrker förslaget om nytt fågelskyddsområde men erinrar\nom att ett tillträdesförbud av denna storlek utgör en avsevärd inskränkning på\nallemansrätten vilket gör det viktigt att löpande följa upp att syftet med\nrestriktionerna uppnås. Alternativa övervakningsmetoder bör också övervägas.\nLänsstyrelsen kommer att ta hänsyn till Naturvårdsverkets synpunkter i det\nfortsatta arbetet i området.","inledning":"Företag och organisationer kan dessutom söka Länsstyrelsens tillstånd för att\nutföra färdledarledda friluftsaktiviteter inom området, under förutsättning att","inledning_offset":1537,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":577,"klassificering":"störningsförbud-djurliv","konfidens":"hög","traffade_ord":["fågelskyddsområde","storlek","förbud"],"handlingar":["flyga","landa","lyfta","marken"],"dokument_id":"nvdok-1045000","dokument_namn":"Komplett Beslut Skåarnja fågelskyddsområde utan sändlista 2021-04-19.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1045000","dokument_sha256":"627753a0546effd3938340c4592580bdcf5f2334ad8eadb9843826d43069aa60","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f