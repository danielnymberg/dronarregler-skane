ingsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Beskrivning av naturreservatet\nNatur- och kulturhistoriska värden\nDet största värdet med Borgelemossen och angränsande mossar är kombina-\ntionen av hydrologiskt opåverkad myrmark, den sammanlagt stora våt-\nmarksarealen, äldre orörda barrnaturskogar på skogsholmar och det rika\nfågellivet. Detta är mycket ovanligt i landet och området har därför stort\nskyddsvärde. Storleken tillsammans med orördheten ger en påtaglig känsla\nav vildmark som är tydlig i hela området. I synnerhet Borgelemossen, Sla-\ndalsmossarna och Hallemossen utmärker sig. De många fastmarksholmarna\noch angränsande mark kring dessa delobjekt är i många fall obrukade eller\ninte brukade på mycket lång tid.","inledning":"Utöver föreskrifter och förbud i andra lagar är det inte tillåtet att:","inledning_offset":798,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":709,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["fågellivet","Storleken","storiska"],"dokument_id":"nvdok-1006207","dokument_namn":"Beslut Borgelemossarna 2004.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1006207","dokument_sha256":"1beb99f29c4d1fed8732105076d9d70a56ccebcc28241e2e22853f3c084b86de","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","svarshash_sha256":"089fc67e2a0b4acddf831b741fca1ac6f53b3aa62b7c61cf018f443f5cc1c8fc","hamtningsdatum":"2026-07-28","licens":"CC0"},"hamtningsdatum":"2026-07-28","geometri":{"type":"MultiPolygon","coordinates":[[[[11.79437115,58.951878],[11.79437038,58.95187864],[11.79437071,58.95187937],[11.79486965,58.95224334],[11.79726846,58.95397844],[11.80100878,58.95671551],[11.80045751,58.9