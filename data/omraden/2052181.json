{"nvrid":"2052181","slug":"lundbosjon","namn":"Lundbosjön","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Gävle, Ockelbo","lan":"Gävleborgs Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Gävleborgs län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2019-11-04","senaste_gallandedatum":"2019-11-30","area_ha":1113.34,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2052181","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Fågel","foreskriftstypKod":"2","foreskriftssubtypKod":"2","franDatum":"1/4","tillDatum":"31/7"}],"sasongsdata":[{"areaHa":null,"foreskriftstyp":"Tillträdesförbud","foreskriftssubtyp":"Fågel","foreskriftstypKod":"2","foreskriftssubtypKod":"2","franDatum":"1/4","tillDatum":"31/7"}],"dokument":[{"namn":"LUNDBOSJÖN Ihopslagen m bilagor utan sändlista.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019149","dokument_id":"nvdok-1019149","sha256":"d594c9fe825c994a90fd416f6b873b6bdc2ccd7cf11b29305b09869dc9410ec0","sidor":40,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"Lundbosjön karaktäriseras av sitt stora antal holmar och öar, de allra flesta\nbevuxna med gamla träd och på de större öarna naturskogsartad skog. Förutom\natt örikedomen ger sjön en vacker landskapsbild är de många öarna en\nförutsättning för den stora förekomsten av fiskgjuse, med flera häckande par\nvarje år. Lundbosjöns fiskgjusepopulation torde vara en av länets tätaste och\nutgör grunden för det fågelskyddsområde med tillträdesförbud som inrättades\n1984 (med beslutsändring 1991) för åtta av holmarna. Naturreservatet ersätter\ndet gamla fågelskyddsområdet och skall genom ett till aktuella häckningar\nanpassat tillträdesförbud ge ett mer ändamålsenligt skydd för de häckande\nrovfåglarna.","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":null,"sidnummer":4,"teckenoffset_pa_sidan":524,"klassificering":"störningsförbud-djurliv","konfidens":"hög","dokument_id":"nvdok-1019149","dokument_namn":"LUNDBOSJÖN Ihopslagen m bilagor utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019149","dokument_sha256":"d594c9fe825c994a90fd416f6b873b6bdc2ccd7cf11b29305b09869dc9410ec0","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"8.    framföra motordrivet fordon, annat än på väg som är avsedd för\n      motorfordonstrafik,","inledning":"Utöver vad som gäller enligt andra författningar är det förbjudet att","inledning_offset":621,"inledning_sidnummer":5,"punkt":"8.","sidnummer":5,"teckenoffset_pa_sidan":1455,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","dokument_id":"nvdok-1019149","dokument_namn":"LUNDBOSJÖN Ihopslagen m bilagor utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019149","dokument_sha256":"d594c9fe825c994a90fd416f6b873b6bdc2ccd7cf11b29305b09869dc9410ec0","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"3.    Skyltning och utmärkning av tillträdesförbud på platser med aktuella\n      konstaterade eller förmodade häckningsplatser för rovfåglar,","inledning":null,"inledning_offset":null,"inledning_sidnummer":null,"punkt":"3.","sidnummer":7,"teckenoffset_pa_sidan":633,"klassificering":"annat-läs-beslutet","konfidens":"hög","dokument_id":"nvdok-1019149","dokument_namn":"LUNDBOSJÖN Ihopslagen m bilagor utan sändlista.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1019149","dokument_sha256":"d594c9fe825c994a90fd416f6b873b6bdc2ccd7cf11b29305b09869dc9410ec0","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad nor