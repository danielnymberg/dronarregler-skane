{"nvrid":"2041887","slug":"stor-killer","namn":"Stor-Killer","skyddstyp":"Naturreservat","lager":"naturreservat","karnlager":true,"kommun":"Jokkmokk","lan":"Norrbottens Län","beslutsstatus":"Gällande","beslutsmyndighet":"Länsstyrelse","forvaltare":"Länsstyrelsen i Norrbottens län","tillsynsmyndighet":null,"urspr_beslutsdatum":"2014-08-27","senaste_gallandedatum":"2014-09-29","area_ha":189.68,"sknat_url":"https://skyddadnatur.naturvardsverket.se/sknat/?nvrid=2041887","svarslage":"reglerat-las-beslutet","luftfartslage":"storning","ocr":false,"foreskriftsomraden":[],"sasongsdata":[],"dokument":[{"namn":"Stor-Killer_Beslut_140827.pdf","url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1012781","dokument_id":"nvdok-1012781","sha256":"daa127e8bbd5bc02dae64d6d2ebde46a5e5e490b9bf9688baa5b10f843ca9515","sidor":22,"ocr":false,"beslutsstatus":"Gällande","fel":null}],"dokument_hoppade":[],"citat":[{"citat":"10. Framföra motordrivna fordon.","inledning":"Utöver vad som annars gäller enligt lag är det förbjudet att:","inledning_offset":1622,"inledning_sidnummer":2,"punkt":"10.","sidnummer":3,"teckenoffset_pa_sidan":578,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivna","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1012781","dokument_namn":"Stor-Killer_Beslut_140827.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1012781","dokument_sha256":"daa127e8bbd5bc02dae64d6d2ebde46a5e5e490b9bf9688baa5b10f843ca9515","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"4.   Fånga, skada eller döda ryggradsdjur. Insamla ägg eller störa djurlivet genom att\n     exempelvis klättra i boträd eller medvetet uppehålla sig i närheten av fågelbo, lya\n     eller gryt.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":595,"inledning_sidnummer":4,"punkt":"4.","sidnummer":4,"teckenoffset_pa_sidan":878,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["djurlivet","fågelbo","störa"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1012781","dokument_namn":"Stor-Killer_Beslut_140827.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1012781","dokument_sha256":"daa127e8bbd5bc02dae64d6d2ebde46a5e5e490b9bf9688baa5b10f843ca9515","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"9.   Framföra motordrivna fordon.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":595,"inledning_sidnummer":4,"punkt":"9.","sidnummer":4,"teckenoffset_pa_sidan":1406,"klassificering":"motorfordon-möjligen-relevant","konfidens":"medel","traffade_ord":["motordrivna","fordon"],"handlingar":["marken"],"dokument_id":"nvdok-1012781","dokument_namn":"Stor-Killer_Beslut_140827.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1012781","dokument_sha256":"daa127e8bbd5bc02dae64d6d2ebde46a5e5e490b9bf9688baa5b10f843ca9515","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"Den nordligaste delen av området utgörs främst av bördig barrblandskog. Till exempel i\nstora delar av sluttningen av Vaksavare växer det högbonitetsskog med grova och\nhögresta granar och tallar. Närmast myrarna skiftar skogen dock från barrblandskog till\nfrodig gransumpskog. Inslaget av grova lövträd, främst sälg och björk, är stort i hela\nsluttningen. Att det finns gott om grova lövträd gynnar hotade arter så som doftticka\nsamt lunglav vilket förekommer rikligt på både asp, sälg och björk.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":595,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":983,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["stora","stort","sälg"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1012781","dokument_namn":"Stor-Killer_Beslut_140827.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1012781","dokument_sha256":"daa127e8bbd5bc02dae64d6d2ebde46a5e5e490b9bf9688baa5b10f843ca9515","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"},{"citat":"På norra sidan av toppen på Stor-Killer har branden skapat en fläckvis lövdominerad\nblandbränna. Björken dominerar men inslaget av asp och sälg är stort. Högst uppe på\nberget övergår skogen i gammal urskogsartad granskog med gott om rötade granlågor.\nGranarna är draperade med enorma mängder av hänglavar, främst garnlav. På\ngranlågorna förekommer arter som rosenticka, lappticka och stjärntagging. Alla är arter\nsom är beroende av att det finns en god kontinuitet av granlågor. Även här i granskogen\nförekommer gamla, grova sälgar med lunglav. I sydsluttningen övergår skogen i en\nhögproduktiv, talldominerad barrblandskog där det finns rikligt med död ved.","inledning":"Utöver vad som annars gäller är det för allmänheten förbjudet att:","inledning_offset":595,"inledning_sidnummer":4,"punkt":null,"sidnummer":5,"teckenoffset_pa_sidan":1480,"klassificering":"störningsförbud-djurliv","konfidens":"medel","traffade_ord":["sälgar","stort","Stor"],"handlingar":["flyga","landa","lyfta"],"dokument_id":"nvdok-1012781","dokument_namn":"Stor-Killer_Beslut_140827.pdf","dokument_url":"https://geodata.naturvardsverket.se/handlingar/rest/dokument/1012781","dokument_sha256":"daa127e8bbd5bc02dae64d6d2ebde46a5e5e490b9bf9688baa5b10f843ca9515","ocr":false,"verifierad":true,"verifieringsmetod":"ordagrann strängmatchning efter dokumenterad normalisering"}],"geometri_kalla":{"tjanst":"Naturvårdsverket NVR WFS 2.0","url":"https://geodata.naturvardsverket.se/naturvardsregistret/wfs","typeName":"Naturvardsregistret_WFS:SkyddadeOmraden","